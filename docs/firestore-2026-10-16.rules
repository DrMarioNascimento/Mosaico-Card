rules_version = '2';
// Mosaico Card · projeto mosaico-card · 16/10/2026
// Abrir sala: só conta Google verificada da lista config/mestres (campo "emails").
// Entrar numa sala pelo código, jogar e responder: qualquer participante, inclusive anônimo.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function mestreAutorizado() {
      return signed()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/mestres)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/mestres).data.emails;
    }
    function criacaoValida(cod) {
      let d = request.resource.data;
      return mestreAutorizado()
        && d.mestre == request.auth.uid
        && d.codigo == cod
        && d.fase == 'lobby'
        && d.ativa == true;
    }
    // Mestre muda qualquer campo (menos dono e código). Os demais só mexem no jogo
    // (jogadores, ordem, snap…) enquanto a sala está ativa — nunca em fase, ativa ou config.
    function atualizacaoValida() {
      let mudou = request.resource.data.diff(resource.data).affectedKeys();
      return signed()
        && !mudou.hasAny(['mestre', 'codigo', 'schemaVersion', 'criado'])
        && (resource.data.mestre == request.auth.uid
            || (resource.data.ativa == true && !mudou.hasAny(['fase', 'ativa', 'config'])));
    }
    function respostaValida(col, cod, uid) {
      return signed()
        && uid == request.auth.uid
        && request.resource.data.jogadorId == request.auth.uid
        && get(/databases/$(database)/documents/$(col)/$(cod)).data.fase == 'fechamento';
    }


    match /config/mestres {
      allow read: if signed();
      allow write: if false;
    }


    // Novo Testamento
    match /salas/{cod} {
      allow get: if signed();
      allow list: if false;
      allow create: if criacaoValida(cod);
      allow update: if atualizacaoValida();
      allow delete: if false;
      match /respostasFinais/{uid} {
        allow read: if signed();
        allow create, update: if respostaValida('salas', cod, uid);
        allow delete: if false;
      }
    }


    // Filmes e Séries
    match /salas-cinema/{cod} {
      allow get: if signed();
      allow list: if false;
      allow create: if criacaoValida(cod);
      allow update: if atualizacaoValida();
      allow delete: if false;
      match /respostasFinais/{uid} {
        allow read: if signed();
        allow create, update: if respostaValida('salas-cinema', cod, uid);
        allow delete: if false;
      }
    }


    // Qualquer outro caminho fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
