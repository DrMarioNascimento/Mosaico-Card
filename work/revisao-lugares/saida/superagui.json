    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "superagui-viajante-P01",
            "factKey": "superagui-F01",
            "text": "É uma área protegida do litoral do Sul do Brasil, formada por ilhas e um trecho de continente.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_UNIFESP",
              "SUPER_EVEN3"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P02",
            "factKey": "superagui-F02",
            "text": "Para chegar à ilha principal, só de barco.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P03",
            "factKey": "superagui-F03",
            "text": "Fica no litoral norte do Paraná, perto da divisa com São Paulo.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "SUPER_VIAJE",
              "SUPER_UNIFESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P04",
            "factKey": "superagui-F04",
            "text": "Os barcos saem de Paranaguá, de Guaraqueçaba ou da Ilha do Mel, e a viagem leva umas três horas.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P05",
            "factKey": "superagui-F05",
            "text": "Na ilha principal não há carros, e as pousadas são simples, de madeira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P06",
            "factKey": "superagui-F06",
            "text": "A vila de pescadores tem casas de madeira coloridas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P07",
            "factKey": "superagui-F07",
            "text": "Uma praia selvagem de cerca de 38 km pede de quatro a sete horas de caminhada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P08",
            "factKey": "superagui-F08",
            "text": "A Praia Deserta, comprida e vazia, também pode ser percorrida de bicicleta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE",
              "SUPER_LEI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P09",
            "factKey": "superagui-F09",
            "text": "A Trilha da Lagoa, de uns 3 km, liga o vilarejo à praia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P10",
            "factKey": "superagui-F10",
            "text": "Em março e abril, a migração de aves faz dessa trilha um bom lugar para observar pássaros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P11",
            "factKey": "superagui-F11",
            "text": "Botos nadam entre os barcos de pesca ancorados em frente à vila.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P12",
            "factKey": "superagui-F12",
            "text": "Na Baía dos Golfinhos, guias locais levam visitantes de canoa para ver botos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_UNIFESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P13",
            "factKey": "superagui-F13",
            "text": "No fim da tarde, centenas de papagaios voltam para dormir nas árvores de uma ilha.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P14",
            "factKey": "superagui-F14",
            "text": "Um mico-leão de cara preta, ameaçado de extinção, vive nessas matas.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "SUPER_VIAJE",
              "SUPER_OECO1"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P15",
            "factKey": "superagui-F15",
            "text": "O principal dormitório coletivo do papagaio-de-cara-roxa no Paraná fica numa ilha do parque.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "SUPER_OECO2"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P16",
            "factKey": "superagui-F16",
            "text": "O fandango, dança popular do litoral paranaense, anima os fins de semana na vila.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE",
              "SUPER_OECO1"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P17",
            "factKey": "superagui-F17",
            "text": "A cataia, bebida apelidada de \"uísque caiçara\", é feita com folhas de um arbusto local.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P18",
            "factKey": "superagui-F18",
            "text": "A Ilha das Peças, entre a ilha principal e a Ilha do Mel, tem restaurantes de comida caseira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P19",
            "factKey": "superagui-F19",
            "text": "Na região, a Reserva do Sebuí atrai por cachoeiras de águas cristalinas, depois de barco e trilha na mata.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P20",
            "factKey": "superagui-F20",
            "text": "As ilhas do Pinheiro e do Pinheirinho são desabitadas e fechadas à visitação.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "SUPER_UNIFESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P21",
            "factKey": "superagui-F21",
            "text": "É apontado como o primeiro lugar do Paraná onde o Sol nasce.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE_SOL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P22",
            "factKey": "superagui-F22",
            "text": "O parque protege Mata Atlântica, restinga e manguezal.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_VIAJE_SOL",
              "SUPER_CNUC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P23",
            "factKey": "superagui-F23",
            "text": "Moradores caiçaras vivem da pesca artesanal dentro e em volta do parque.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_UNIFESP",
              "SUPER_EVEN3"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P24",
            "factKey": "superagui-F24",
            "text": "Réveillon e Carnaval são as épocas mais movimentadas da vila de pescadores.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_UNIFESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-viajante-P25",
            "factKey": "superagui-F25",
            "text": "Um canal estreito, de cerca de 6 km, permite navegar por dentro até Cananéia, em São Paulo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_AEN",
              "SUPER_VIAJE_CANAL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "superagui-geografo-P01",
            "factKey": "superagui-F01",
            "text": "A unidade combina ilhas costeiras e uma porção continental, num litoral recortado por baías e canais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_UNIFESP",
              "SUPER_LEI"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P02",
            "factKey": "superagui-F02",
            "text": "É uma unidade federal de proteção integral, criada para preservar amostras dos ecossistemas locais com uso público controlado.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_DECRETO",
              "SUPER_CNUC"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P03",
            "factKey": "superagui-F03",
            "text": "Foi criada por decreto em 1989, com cerca de 21.400 ha distribuídos em duas ilhas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_DECRETO",
              "SUPER_CNUC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P04",
            "factKey": "superagui-F04",
            "text": "Uma lei de 1997 ampliou a área para cerca de 33,9 mil ha, com trecho continental até a Serra do Rio Branco, na divisa estadual.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_LEI",
              "SUPER_CNUC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P05",
            "factKey": "superagui-F05",
            "text": "Terras acrescidas às ilhas por sedimentação e ação de marés e correntes passam automaticamente a integrar o parque.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_LEI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P06",
            "factKey": "superagui-F06",
            "text": "A ilha principal surgiu da abertura de um canal de cerca de 6 km, iniciada por moradores em 1820 e inaugurada em 1952.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_AEN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P07",
            "factKey": "superagui-F07",
            "text": "Esse canal ligava Paranaguá a Cananéia e servia ao transporte de produtos e passageiros entre os dois estados.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_AEN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P08",
            "factKey": "superagui-F08",
            "text": "A navegação pelo Canal do Varadouro é permitida por lei, e o canal figura como zona de uso conflitante no zoneamento.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_LEI",
              "SUPER_EVEN3"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P09",
            "factKey": "superagui-F09",
            "text": "Todo o município onde fica o parque é coberto por um conjunto de unidades de conservação.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "SUPER_UNIFESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P10",
            "factKey": "superagui-F10",
            "text": "Em 1997, áreas de uma APA e de uma estação ecológica vizinhas foram excluídas delas para formar o novo limite do parque.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "SUPER_LEI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "superagui-geografo-P11",
            "factKey": "superagui-F11",
            "text": "Nove comunidades caiçaras vivem dentro do perímetro e outras nove no entorno imediato.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUPER_EVEN3"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
