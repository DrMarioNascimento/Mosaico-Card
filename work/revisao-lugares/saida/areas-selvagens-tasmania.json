            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P24",
            "factKey": "areas-selvagens-tasmania-F49",
            "text": "Ocupa o sudoeste da Tasmânia e se estende de Cradle Mountain até a reserva marinha de Port Davey.",
            "relatedFields": [
