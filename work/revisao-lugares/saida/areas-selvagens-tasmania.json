          {
            "id": "areas-selvagens-tasmania-viajante-P01",
            "factKey": "areas-selvagens-tasmania-F01",
            "text": "Este destino é uma vasta região selvagem de montanhas, florestas, lagos e rios no sul da Oceania.",
