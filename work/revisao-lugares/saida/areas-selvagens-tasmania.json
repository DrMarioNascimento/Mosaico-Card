            "sources": [
              "TASW_PWS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P18",
            "factKey": "areas-selvagens-tasmania-F18",
            "text": "Pela mata ficam ruínas de antigos portos e vilas, entre elas um povoado que extraía osmirídio.",
