            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P16",
            "factKey": "areas-selvagens-tasmania-F16",
            "text": "Povos aborígines vivem nesta região há dezenas de milhares de anos e usavam as cavernas como abrigo.",
