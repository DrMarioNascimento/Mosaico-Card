            "factKey": "areas-selvagens-tasmania-F06",
            "text": "Um dos parques do conjunto não tem acesso por estrada: só dá para explorá-lo a pé.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASW_PWS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
