            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P20",
            "factKey": "areas-selvagens-tasmania-F45",
            "text": "Os dois maiores parques do conjunto somavam, nos dados de 2005, 618.190 ha e 446.342 ha.",
            "relatedFields": [
