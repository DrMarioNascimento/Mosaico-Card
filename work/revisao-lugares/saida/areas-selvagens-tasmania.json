            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P19",
            "factKey": "areas-selvagens-tasmania-F44",
            "text": "Ampliações em 1989, 2010, 2012 e 2013 redesenharam os limites do sítio.",
