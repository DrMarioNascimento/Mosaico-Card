            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P23",
            "factKey": "areas-selvagens-tasmania-F48",
            "text": "O conflito teve peso eleitoral: o governo trabalhista de Bob Hawke, eleito em março de 1983, se opôs à barragem.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
