              "TASW_PWS"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P08",
            "factKey": "areas-selvagens-tasmania-F08",
            "text": "Há passeios curtos até lagos e cachoeiras, além de caminhadas de vários dias.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASW_PWS"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P09",
            "factKey": "areas-selvagens-tasmania-F09",
            "text": "Para dormir, há desde cabanas na mata até áreas de camping e abrigos rústicos do governo.",
