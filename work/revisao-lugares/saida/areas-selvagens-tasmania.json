            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P21",
            "factKey": "areas-selvagens-tasmania-F46",
            "text": "A inscrição na UNESCO, sozinha, não impedia a barragem estadual; foi preciso uma lei federal, a World Heritage Properties Conservation Act 1983.",
            "relatedFields": [
