            "sources": [
              "TASW_PWS"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P10",
            "factKey": "areas-selvagens-tasmania-F10",
            "text": "Diabos-da-tasmânia e quolls, pequenos marsupiais carnívoros, ainda sobrevivem nestas florestas.",
