            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P22",
            "factKey": "areas-selvagens-tasmania-F47",
            "text": "Em 1983, a High Court decidiu que o Parlamento federal podia usar seus poderes de assuntos externos para proteger a área.",
