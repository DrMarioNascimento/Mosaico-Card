              "C1"
            ],
            "sources": [
              "TASW_PWS",
              "TASW_IUCN"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P17",
            "factKey": "areas-selvagens-tasmania-F17",
            "text": "Uma pequena ilha guarda as ruínas da colônia penal mais antiga do estado.",
