              "C1"
            ],
            "sources": [
              "TASW_PWS"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P05",
            "factKey": "areas-selvagens-tasmania-F05",
            "text": "Há travessias ainda mais duras, como uma de 72 km que leva de 6 a 9 dias e é classificada no grau 5 de dificuldade.",
