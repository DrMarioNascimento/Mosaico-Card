            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P18",
            "factKey": "areas-selvagens-tasmania-F43",
            "text": "Os critérios abrangem valores culturais (iii, iv e vi) e naturais (vii, viii, ix e x).",
