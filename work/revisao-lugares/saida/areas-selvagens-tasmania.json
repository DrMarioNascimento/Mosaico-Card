              "C4"
            ],
            "sources": [
              "TASW_NMA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P21",
            "factKey": "areas-selvagens-tasmania-F21",
            "text": "A represa ficaria no rio Gordon e inundaria outro rio selvagem e a mata em volta.",
