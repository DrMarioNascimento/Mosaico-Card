            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P16",
            "factKey": "areas-selvagens-tasmania-F41",
            "text": "Cavernas com depósitos de ocupação bem preservados registram a presença aborígine desde o Pleistoceno.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASW_IUCN",
              "TASW_PWS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-geografo-P17",
            "factKey": "areas-selvagens-tasmania-F42",
            "text": "O sítio cumpre sete dos dez critérios do Patrimônio Mundial, marca que só o Monte Taishan, na China, também alcança.",
