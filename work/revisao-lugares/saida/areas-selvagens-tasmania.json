              "C1"
            ],
            "sources": [
              "TASW_PWS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P19",
            "factKey": "areas-selvagens-tasmania-F19",
            "text": "No verão de 1982 para 1983, milhares de manifestantes bloquearam as obras de uma hidrelétrica, e mais de mil foram presos.",
