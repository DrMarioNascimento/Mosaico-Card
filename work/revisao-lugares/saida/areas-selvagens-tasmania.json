            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "areas-selvagens-tasmania-viajante-P20",
            "factKey": "areas-selvagens-tasmania-F20",
            "text": "O bloqueio foi liderado por Bob Brown e pela Wilderness Society.",
