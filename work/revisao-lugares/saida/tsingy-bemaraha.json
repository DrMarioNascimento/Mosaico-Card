    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "tsingy-bemaraha-viajante-P01",
            "factKey": "tsingy-bemaraha-F01",
            "text": "É uma área protegida com floresta seca, cânions, morros, lagos e até manguezais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P02",
            "factKey": "tsingy-bemaraha-F02",
            "text": "É um destino para quem gosta de aventura: há trilhas difíceis, cavernas e passeios de canoa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP"
            ],
            "clueType": "cultura",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P03",
            "factKey": "tsingy-bemaraha-F03",
            "text": "A paisagem é descrita como uma \"floresta de pedras afiadas\".",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_UNESCO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P04",
            "factKey": "tsingy-bemaraha-F04",
            "text": "Pináculos de pedra cinzenta chegam a 100 metros de altura e lembram catedrais.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_UNESCO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P05",
            "factKey": "tsingy-bemaraha-F05",
            "text": "Essas agulhas são de calcário formado no fundo de um mar muito antigo.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P06",
            "factKey": "tsingy-bemaraha-F06",
            "text": "Uma das trilhas mais difíceis tem uma ponte suspensa de 70 metros e termina com vista para o pôr do sol.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P07",
            "factKey": "tsingy-bemaraha-F07",
            "text": "Um rio abriu um cânion no maciço, e dá para percorrê-lo de canoa.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_MNP"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P08",
            "factKey": "tsingy-bemaraha-F08",
            "text": "As paredes desse desfiladeiro têm de 50 a 80 metros de altura.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TSINGY_MNP"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P09",
            "factKey": "tsingy-bemaraha-F09",
            "text": "A área protegida é limitada ao sul pelo rio Manambolo e ao norte pelo rio Soahany.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TSINGY_KBA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P10",
            "factKey": "tsingy-bemaraha-F10",
            "text": "Subindo o rio de canoa, chega-se a túmulos atribuídos ao antigo povo vazimba.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P11",
            "factKey": "tsingy-bemaraha-F11",
            "text": "Segundo a tradição, as formações de pedra guardam os túmulos dos ancestrais e são o descanso final de suas almas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P12",
            "factKey": "tsingy-bemaraha-F12",
            "text": "Há cavernas com estalactites e estalagmites, e algumas guardam sinais de presença humana antiga.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P13",
            "factKey": "tsingy-bemaraha-F13",
            "text": "Onze espécies de lêmures vivem ali.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P14",
            "factKey": "tsingy-bemaraha-F14",
            "text": "O sifaka-de-decken, um lêmure ameaçado, é um dos animais-símbolo da área.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_MNP"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P15",
            "factKey": "tsingy-bemaraha-F15",
            "text": "Uma espécie de lêmure-lanoso só existe nessa região e leva o nome do próprio planalto.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P16",
            "factKey": "tsingy-bemaraha-F16",
            "text": "O camaleão Brookesia perarmata e a lagartixa Uroplatus henkeli são répteis endêmicos destacados pelo parque.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP",
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P17",
            "factKey": "tsingy-bemaraha-F17",
            "text": "Mais de 90 espécies de aves foram registradas, entre elas a águia-pescadora-de-madagascar, criticamente ameaçada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P18",
            "factKey": "tsingy-bemaraha-F18",
            "text": "Nas fendas e cânions cresce uma floresta mais úmida; sobre a rocha exposta, só plantas suculentas que aguentam a seca.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P19",
            "factKey": "tsingy-bemaraha-F19",
            "text": "Entre junho e outubro, queimadas para renovar o pasto são uma das maiores ameaças à área.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_MNP"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P20",
            "factKey": "tsingy-bemaraha-F20",
            "text": "A primeira reserva natural do lugar foi criada em 1927.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P21",
            "factKey": "tsingy-bemaraha-F21",
            "text": "Entrou para a lista do Patrimônio Mundial da UNESCO em 1990.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP",
              "TSINGY_IUCN"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P22",
            "factKey": "tsingy-bemaraha-F22",
            "text": "Fica no interior, a 60–80 km da costa oeste de uma grande ilha africana.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_KBA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P23",
            "factKey": "tsingy-bemaraha-F23",
            "text": "A área soma cerca de 157 mil hectares, divididos entre uma reserva natural integral e um parque nacional.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P24",
            "factKey": "tsingy-bemaraha-F24",
            "text": "As agulhas de pedra do lugar são conhecidas como tsingy.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_MNP"
            ],
            "clueType": "cultura",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-viajante-P25",
            "factKey": "tsingy-bemaraha-F25",
            "text": "Fica na região de Melaky, no oeste de Madagascar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "tsingy-bemaraha-geografo-P01",
            "factKey": "tsingy-bemaraha-F26",
            "text": "O relevo resulta de erosão cárstica: fendas profundas, rios subterrâneos e cavernas separados por pináculos.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P02",
            "factKey": "tsingy-bemaraha-F27",
            "text": "A cobertura se divide quase igualmente entre floresta (48%) e savana (47%), com matas ciliares ao longo dos cursos d'água permanentes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_KBA"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P03",
            "factKey": "tsingy-bemaraha-F28",
            "text": "O planalto, com 250 km de comprimento, é de calcário de origem marinha do período Jurássico.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P04",
            "factKey": "tsingy-bemaraha-F04",
            "text": "A UNESCO descreve um maciço calcário muito dissecado, atravessado por uma garganta fluvial profunda, com pináculos de até 100 m.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "TSINGY_UNESCO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P05",
            "factKey": "tsingy-bemaraha-F29",
            "text": "A porção oeste é um planalto cárstico elevado e muito erodido, com dolinas alongadas e cânions profundos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_KBA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P06",
            "factKey": "tsingy-bemaraha-F30",
            "text": "A altitude varia de 150 a 838 metros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_KBA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P07",
            "factKey": "tsingy-bemaraha-F09",
            "text": "O cânion do Manambolo corta o maciço, e esse rio marca o limite sul da área protegida.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TSINGY_KBA",
              "TSINGY_IUCN"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P08",
            "factKey": "tsingy-bemaraha-F31",
            "text": "O planalto regula a hidrologia das terras a oeste, incluindo os complexos de lagos de Manambolomaty e Bemamba.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P09",
            "factKey": "tsingy-bemaraha-F18",
            "text": "A floresta seca decídua domina; a floresta mais perene ocupa dolinas e cânions, e um matagal suculento xerófilo cobre a rocha exposta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_KBA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P10",
            "factKey": "tsingy-bemaraha-F32",
            "text": "Pelo menos 583 espécies de plantas, de 102 famílias, foram registradas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P11",
            "factKey": "tsingy-bemaraha-F33",
            "text": "Dos 63 répteis registrados, 58 são endêmicos da ilha e 17 só existem no maciço.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P12",
            "factKey": "tsingy-bemaraha-F34",
            "text": "As 19 espécies de anfíbios formam a maior riqueza registrada numa área seca do país, e seis podem ser exclusivas do planalto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P13",
            "factKey": "tsingy-bemaraha-F13",
            "text": "Onze espécies de lêmures, de cinco famílias endêmicas, ocupam as florestas do maciço.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P14",
            "factKey": "tsingy-bemaraha-F15",
            "text": "O lêmure-lanoso Avahi cleesei é endêmico local, e o sifaka-de-decken está ameaçado de extinção.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P15",
            "factKey": "tsingy-bemaraha-F35",
            "text": "Entre os mamíferos vulneráveis está a fossa (Cryptoprocta ferox), carnívoro da família dos euplerídeos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_KBA",
              "TSINGY_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P16",
            "factKey": "tsingy-bemaraha-F36",
            "text": "Uma saracura florestal do lugar só foi descrita pela ciência em 2011.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "pesquisa",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P17",
            "factKey": "tsingy-bemaraha-F11",
            "text": "As formações são tidas como túmulos dos vazimba, ancestrais originários, e morada final das almas dos antepassados.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_MNP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P18",
            "factKey": "tsingy-bemaraha-F19",
            "text": "Queimadas anuais, de junho a outubro, renovam pastagens e abrem trilhas, sobretudo na periferia da área.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P19",
            "factKey": "tsingy-bemaraha-F37",
            "text": "A proteção natural do carste limita a maior parte dos impactos, mas o desmatamento para agricultura, o gado e a extração de madeira pressionam a floresta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_KBA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P20",
            "factKey": "tsingy-bemaraha-F38",
            "text": "Uma trilha sísmica aberta em 1984 e uma estrada da indústria do petróleo deram acesso a áreas antes isoladas; há gás natural sob a área.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_KBA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P21",
            "factKey": "tsingy-bemaraha-F20",
            "text": "A reserva integral de 1927 virou monumento natural em 1939; em 1997, a parte sul (72.340 ha) tornou-se parque nacional para o ecoturismo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_MNP"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P22",
            "factKey": "tsingy-bemaraha-F21",
            "text": "Inscrito em 1990, o bem foi ampliado em 2023 numa série de florestas secas da ilha, junto com Ankarana, Ankarafantsika e outras áreas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_UNESCO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P23",
            "factKey": "tsingy-bemaraha-F39",
            "text": "O maciço integra o centro de endemismo de Melaky, em florestas secas moldadas por mudanças paleoclimáticas dos últimos milhões de anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TSINGY_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P24",
            "factKey": "tsingy-bemaraha-F22",
            "text": "Situado a 60–80 km da costa oeste de Madagascar, é limitado pelos rios Manambolo, ao sul, e Soahany, ao norte.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "TSINGY_KBA"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tsingy-bemaraha-geografo-P25",
            "factKey": "tsingy-bemaraha-F24",
            "text": "Os pináculos calcários desse maciço malgaxe são chamados de tsingy.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "TSINGY_IUCN",
              "TSINGY_MNP"
            ],
            "clueType": "relevo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      }
