       "ATS_HSM_LISTA"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-denison-geografo-P23",
      "factKey": "cabo-denison-F23",
      "text": "O ingresso nas cabanas exige guia com qualificação em patrimônio cultural e instrução prévia sobre os valores do sítio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_DENISON"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-denison-geografo-P24",
      "factKey": "cabo-denison-F24",
      "text": "O aumento da umidade interna é um fator de deterioração das estruturas e dos artefatos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
