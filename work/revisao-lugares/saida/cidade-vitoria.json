      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "cidade-vitoria-geografo-P01",
            "factKey": "cidade-vitoria-F01",
            "text": "O sítio urbano fica entre uma baía e maciços rochosos, o que limitou cedo a expansão da cidade.",
