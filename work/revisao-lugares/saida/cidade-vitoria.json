            "sources": [
              "VIT_IBGE",
              "VIT_ESGOV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-viajante-P08",
            "factKey": "cidade-vitoria-F08",
            "text": "Panelas de barro pretas são feitas à mão por artesãs de um bairro da cidade.",
