            "sources": [
              "VIT_PANELEIRAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-viajante-P11",
            "factKey": "cidade-vitoria-F11",
            "text": "Nelas se faz a moqueca da terra; um ditado local diz que, fora dali, \"o resto é peixada\".",
