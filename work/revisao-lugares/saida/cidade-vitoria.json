              "C2"
            ],
            "sources": [
              "VIT_ESGOV",
              "VIT_PANELEIRAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-viajante-P12",
            "factKey": "cidade-vitoria-F12",
            "text": "O saber das artesãs dessas panelas foi o primeiro inscrito no Livro dos Saberes do Iphan, em 2002.",
