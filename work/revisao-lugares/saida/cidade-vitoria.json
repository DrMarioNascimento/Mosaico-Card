            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-viajante-P02",
            "factKey": "cidade-vitoria-F02",
            "text": "A maior parte da cidade fica numa ilha, entre uma baía e morros de pedra.",
