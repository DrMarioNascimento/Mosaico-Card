              "C1"
            ],
            "sources": [
              "VIT_IBGE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-geografo-P05",
            "factKey": "cidade-vitoria-F05",
            "text": "No bioma Mata Atlântica, unidades de conservação de uso sustentável ocupam cerca de 33% do município.",
