              "C1"
            ],
            "sources": [
              "VIT_IBGE",
              "VIT_ESGOV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-geografo-P04",
            "factKey": "cidade-vitoria-F04",
            "text": "Corpos d'água continentais cobrem cerca de 12,7% do território, e áreas artificiais, mais da metade.",
