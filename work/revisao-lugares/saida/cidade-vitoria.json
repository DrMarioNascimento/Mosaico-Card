            ],
            "sources": [
              "VIT_PANELEIRAS",
              "VIT_ESGOV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-viajante-P10",
            "factKey": "cidade-vitoria-F10",
            "text": "As panelas são queimadas em fogueira a céu aberto, sem forno.",
