              "C1"
            ],
            "sources": [
              "VIT_IBGE"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-geografo-P03",
            "factKey": "cidade-vitoria-F03",
            "text": "O território soma ilhas e uma porção continental; a área municipal é de 96,54 km², segundo o IBGE.",
