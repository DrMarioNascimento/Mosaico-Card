              "VIT_ESGOV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-viajante-P09",
            "factKey": "cidade-vitoria-F09",
            "text": "A cor escura das panelas vem de uma tinta tirada da casca do mangue-vermelho.",
