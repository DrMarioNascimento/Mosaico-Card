              "C1"
            ],
            "sources": [
              "VIT_UFF"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-vitoria-geografo-P02",
            "factKey": "cidade-vitoria-F02",
            "text": "O clima é tropical superúmido, com médias acima de 18 °C em todos os meses.",
