              "C1"
            ],
            "sources": [
              "CUSCO_PR"
            ],
            "clueType": "patrimonio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-cusco-geografo-P03",
            "factKey": "cidade-cusco-F03",
            "text": "Situa-se no centro-sul do Peru, no alto dos Andes.",
