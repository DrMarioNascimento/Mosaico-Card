            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-cusco-geografo-P04",
            "factKey": "cidade-cusco-F04",
            "text": "A cerca de 3.400 m, o centro ocupa a bacia onde se encontram os rios Huatanay, Tullumayo e Chunchul.",
