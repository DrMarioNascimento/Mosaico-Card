              "C3"
            ],
            "sources": [
              "CUSCO_PR"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-cusco-geografo-P07",
            "factKey": "cidade-cusco-F07",
            "text": "A reforma de Pachacútec drenou um brejo ao norte e deslocou para lá o coração cerimonial da cidade.",
