            "recommendedMoment": "late",
            "importance": "essential",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-cusco-viajante-P11",
            "factKey": "cidade-cusco-F11",
            "text": "O antigo templo do Sol da cidade era revestido com centenas de placas de ouro.",
