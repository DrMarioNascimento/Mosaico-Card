              "C1"
            ],
            "sources": [
              "CUSCO_PR",
              "CUSCO_WHE"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-cusco-geografo-P05",
            "factKey": "cidade-cusco-F05",
            "text": "A cidade se assenta num vale aluvial fértil dos Andes centrais, alimentado por vários rios.",
