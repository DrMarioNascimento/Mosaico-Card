            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-cusco-viajante-P09",
            "factKey": "cidade-cusco-F09",
            "text": "Diz-se que o traçado inca da cidade tinha a forma de um puma.",
