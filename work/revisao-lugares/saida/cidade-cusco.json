      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "cidade-cusco-geografo-P01",
            "factKey": "cidade-cusco-F01",
            "text": "O bem protege um centro urbano andino em que traçados pré-hispânico e colonial se sobrepõem.",
