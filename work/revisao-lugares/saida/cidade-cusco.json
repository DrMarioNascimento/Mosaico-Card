              "C1"
            ],
            "sources": [
              "CUSCO_PR"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-cusco-geografo-P06",
            "factKey": "cidade-cusco-F06",
            "text": "Era a sede do governo imperial do Tawantinsuyu, segundo a UNESCO.",
