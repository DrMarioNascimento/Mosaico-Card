            ],
            "clueType": "urbanismo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-cusco-geografo-P02",
            "factKey": "cidade-cusco-F02",
            "text": "A paisagem urbana resulta da confluência entre as culturas inca e hispânica, segundo a UNESCO.",
