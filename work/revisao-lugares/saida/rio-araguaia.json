      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-araguaia-viajante-P08",
      "factKey": "rio-araguaia-F08",
      "text": "A temporada de praias vai de junho a setembro e enche os acampamentos.",
