       "C1"
      ],
      "sources": [
       "RARAGUAIA_GOTUR_FOLDER"
      ],
      "clueType": "turismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-araguaia-viajante-P09",
      "factKey": "rio-araguaia-F09",
      "text": "Nas férias de julho, milhares de turistas vão para as praias do rio.",
