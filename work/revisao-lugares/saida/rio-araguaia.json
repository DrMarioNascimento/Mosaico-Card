      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-araguaia-viajante-P07",
      "factKey": "rio-araguaia-F07",
      "text": "Quando as águas baixam, surgem praias de areia clara nas margens.",
