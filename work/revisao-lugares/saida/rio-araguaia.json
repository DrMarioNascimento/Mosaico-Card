      ],
      "sources": [
       "RARAGUAIA_ARAGARCAS"
      ],
      "clueType": "turismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-araguaia-viajante-P10",
      "factKey": "rio-araguaia-F10",
      "text": "É considerado um dos rios mais piscosos do mundo, terra de piraíbas e pirararas.",
