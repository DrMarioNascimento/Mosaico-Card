       "RARAGUAIA_GOTUR_FOLDER"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-araguaia-viajante-P11",
      "factKey": "rio-araguaia-F11",
      "text": "Pintado, cachorra, corvina, pirarucu e dourado também aparecem nas pescarias.",
