            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "torres-rs-geografo-P17",
            "factKey": "torres-rs-geografo-F17",
            "text": "O pico de pinípedes no inverno e na primavera não coincide com o pico turístico de janeiro e fevereiro.",
