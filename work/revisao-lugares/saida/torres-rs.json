            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "torres-rs-geografo-P15",
            "factKey": "torres-rs-geografo-F15",
            "text": "A ilha é o ponto de descanso de pinípedes mais ao norte da costa brasileira, mas não uma colônia reprodutiva.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
