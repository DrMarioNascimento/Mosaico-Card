              "TORRES_BIOBR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "torres-rs-geografo-P16",
            "factKey": "torres-rs-geografo-F16",
            "text": "A reserva ecológica de 1983 virou refúgio de vida silvestre em 2005 e passou de 1,69 ha para 142,39 ha ao incluir águas vizinhas.",
