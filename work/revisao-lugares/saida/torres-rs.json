            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "torres-rs-geografo-P19",
            "factKey": "torres-rs-geografo-F19",
            "text": "A maria-luísa responde por cerca de metade da dieta dos leões-marinhos na área.",
