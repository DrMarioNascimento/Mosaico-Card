            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "torres-rs-geografo-P14",
            "factKey": "torres-rs-geografo-F14",
            "text": "A ilha em frente, a menos de 2 km da foz, tem origem ligada aos processos que formaram a Formação Serra Geral.",
