       "ATS_CUVERVILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P23",
      "factKey": "ilha-cuverville-F23",
      "text": "As diretrizes limitam a 100 os visitantes simultâneos em terra e vedam a presença em terra entre 22h e 4h.",
