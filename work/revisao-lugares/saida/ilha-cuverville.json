     },
     {
      "id": "ilha-cuverville-geografo-P13",
      "factKey": "ilha-cuverville-F13",
      "text": "Focas-de-weddell e lobos-marinhos-antárticos utilizam a orla regularmente para repouso.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_CUVERVILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P14",
      "factKey": "ilha-cuverville-F14",
      "text": "Tapetes de musgo e líquens dos gêneros Xanthoria, Buellia, Caloplaca e Usnea compõem a cobertura vegetal.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_CUVERVILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P15",
      "factKey": "ilha-cuverville-F15",
      "text": "Deschampsia antarctica e Colobanthus quitensis, plantas vasculares, ocorrem junto aos musgos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_CUVERVILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P16",
      "factKey": "ilha-cuverville-F16",
      "text": "Ossos de baleia dispersos na praia de desembarque registram a fase baleeira do início do século XX.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ATS_CUVERVILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P17",
      "factKey": "ilha-cuverville-F17",
      "text": "Uma barragem construída por baleeiros integra o conjunto de artefatos da praia de desembarque.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ATS_CUVERVILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P18",
      "factKey": "ilha-cuverville-F18",
      "text": "Em uma ilhota ao largo, um barco de água e uma corrente de amarração completam o patrimônio baleeiro.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ATS_CUVERVILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P19",
      "factKey": "ilha-cuverville-F19",
      "text": "A pichação no barco de água, registrada em 2010, é o impacto conhecido da visitação.",
