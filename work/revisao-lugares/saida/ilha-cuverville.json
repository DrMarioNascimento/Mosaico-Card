      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P22",
      "factKey": "ilha-cuverville-F22",
      "text": "Na muda tardia, a densidade de pinguins tende a restringir a visita às imediações da praia de desembarque.",
