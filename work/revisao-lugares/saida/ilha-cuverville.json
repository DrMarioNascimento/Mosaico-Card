      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P20",
      "factKey": "ilha-cuverville-F20",
      "text": "O desembarque preferencial usa a praia larga do extremo norte, evitando as colônias de gentoo do oeste.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_CUVERVILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-cuverville-geografo-P21",
      "factKey": "ilha-cuverville-F21",
      "text": "No extremo leste da praia, com menos espaço e mais risco de cortar rotas de pinguins, só circulam grupos de até 15 pessoas sob supervisão.",
