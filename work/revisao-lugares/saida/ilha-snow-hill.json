  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "ilha-snow-hill-viajante-P01",
      "factKey": "ilha-snow-hill-F01",
      "text": "Este destino é uma ilha antártica quase toda coberta de neve e gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P02",
      "factKey": "ilha-snow-hill-F02",
      "text": "Fica do lado leste da Península Antártica, de frente para o Mar de Weddell.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_KBA",
       "SNOWHILL_RAA",
       "SNOWHILL_FIB"
      ],
      "clueType": "localizacao",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P03",
      "factKey": "ilha-snow-hill-F03",
      "text": "A Ilha James Ross fica a só uns 5 km dali.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P04",
      "factKey": "ilha-snow-hill-F04",
      "text": "A base permanente mais próxima é a argentina Marambio, a uns 53 km, em outra ilha.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P05",
      "factKey": "ilha-snow-hill-F05",
      "text": "Da praia, o terreno sobe em terraços baixos e depois em encostas íngremes até uns 170 m.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P06",
      "factKey": "ilha-snow-hill-F06",
      "text": "As encostas guardam muitos fósseis de animais marinhos — e é proibido levar qualquer um.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P07",
      "factKey": "ilha-snow-hill-F07",
      "text": "Quase não há plantas; perto da cabana, só uns poucos casais de gaivota e de trinta-réis fazem ninho.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P08",
      "factKey": "ilha-snow-hill-F08",
      "text": "Na ponta sudoeste, milhares de pinguins grandes criam os filhotes sobre o mar congelado.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P09",
      "factKey": "ilha-snow-hill-F09",
      "text": "Num censo de 2004, contaram quase 3.900 filhotes nessa colônia.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P10",
      "factKey": "ilha-snow-hill-F10",
      "text": "A atração histórica da ilha é uma casinha de madeira montada em fevereiro de 1902.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_UKSI",
       "SNOWHILL_GUIA"
      ],
      "clueType": "patrimonio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P11",
      "factKey": "ilha-snow-hill-F11",
      "text": "A casa veio pronta, em peças, para servir de estação de pesquisa e moradia de inverno.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_GU"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P12",
      "factKey": "ilha-snow-hill-F12",
      "text": "Por dentro, tem três quartinhos e uma cozinha simples.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_RAA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P13",
      "factKey": "ilha-snow-hill-F13",
      "text": "Cabos prendem a casa na rocha para ela aguentar os ventos fortes.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_RAA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P14",
      "factKey": "ilha-snow-hill-F14",
      "text": "Seis homens moraram ali por 22 meses, entre eles um tenente argentino.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "SNOWHILL_GU"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P15",
      "factKey": "ilha-snow-hill-F15",
      "text": "O navio da expedição foi esmagado pelo gelo e afundou em fevereiro de 1903.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_FIB",
       "SNOWHILL_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P16",
      "factKey": "ilha-snow-hill-F16",
      "text": "Sem o navio, o grupo teve de encarar um segundo inverno no gelo.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_BRIT",
       "SNOWHILL_FIB"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P17",
      "factKey": "ilha-snow-hill-F17",
      "text": "O resgate chegou em novembro de 1903, num navio de um país vizinho do Brasil.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "SNOWHILL_BRIT",
       "SNOWHILL_FIB"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P18",
      "factKey": "ilha-snow-hill-F18",
      "text": "O navio do resgate se chamava Uruguay, mas não era uruguaio.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "SNOWHILL_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P19",
      "factKey": "ilha-snow-hill-F19",
      "text": "A expedição tinha zarpado de Gotemburgo em outubro de 1901.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P20",
      "factKey": "ilha-snow-hill-F20",
      "text": "Hoje a casa é um museu vivo, cuidado por argentinos e suecos.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "SNOWHILL_GUIA",
       "SNOWHILL_RAA"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P21",
      "factKey": "ilha-snow-hill-F21",
      "text": "Lá dentro ainda há objetos originais da expedição.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P22",
      "factKey": "ilha-snow-hill-F22",
      "text": "O degelo do chão está levando para o mar os morrinhos onde ficavam os laboratórios.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_RAA",
       "SNOWHILL_GU"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P23",
      "factKey": "ilha-snow-hill-F23",
      "text": "Para segurar o morro, usaram chapas de alumínio de pistas de pouso americanas usadas no Vietnã.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GU"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P24",
      "factKey": "ilha-snow-hill-F24",
      "text": "No máximo 100 visitantes podem estar em terra ao mesmo tempo, e só 5 entram juntos na casa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-viajante-P25",
      "factKey": "ilha-snow-hill-F25",
      "text": "O líder da expedição que morou na casinha foi o geólogo sueco Otto Nordenskjöld.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_UKSI",
       "SNOWHILL_BRIT",
       "SNOWHILL_FIB"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "ilha-snow-hill-geografo-P01",
      "factKey": "ilha-snow-hill-F01",
      "text": "Ilha do setor do Mar de Weddell quase inteiramente recoberta por neve e gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P02",
      "factKey": "ilha-snow-hill-F02",
      "text": "Situa-se ao largo da costa leste da Península Trinity, no norte da Península Antártica.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "localizacao",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P03",
      "factKey": "ilha-snow-hill-F03",
      "text": "Fica a sudeste da Ilha James Ross, a cerca de 5 km dela, e a sudoeste da Ilha Seymour.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P04",
      "factKey": "ilha-snow-hill-F04",
      "text": "A estação permanente mais próxima é Marambio, na Ilha Seymour, cerca de 53 km a nordeste.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P05",
      "factKey": "ilha-snow-hill-F05",
      "text": "Terraços sedimentares sobem até 5–10 m; acima, encostas de 15° a 40°, cortadas por vales fluviais profundos, chegam a ~170 m.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P06",
      "factKey": "ilha-snow-hill-F26",
      "text": "Diques de basalto de direção nordeste–sudoeste resistem melhor à erosão e se destacam no relevo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P07",
      "factKey": "ilha-snow-hill-F27",
      "text": "A feição mais marcante perto da cabana é Haslum Crag, um pequeno neck vulcânico.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P08",
      "factKey": "ilha-snow-hill-F06",
      "text": "As encostas íngremes concentram fósseis marinhos abundantes, protegidos por uma área fechada à visitação.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P09",
      "factKey": "ilha-snow-hill-F07",
      "text": "A flora é praticamente ausente; perto da cabana, a nidificação se resume a 3–5 ninhos de gaivota-dominicana e trinta-réis-antártico.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GUIA"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P10",
      "factKey": "ilha-snow-hill-F08",
      "text": "A colônia do extremo sudoeste se reproduz sobre gelo marinho fixo, a ~400 m das falésias de gelo da costa sul — hábito da maior espécie de pinguim.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P11",
      "factKey": "ilha-snow-hill-F09",
      "text": "A contagem em solo de novembro de 2004 registrou ~3.885 filhotes; a de satélite, em outubro de 2009, indicou 2.164 aves.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "SNOWHILL_KBA"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P12",
      "factKey": "ilha-snow-hill-F10",
      "text": "A cabana de madeira, de 4,0 × 6,3 m, foi erguida em fevereiro de 1902 pelo grupo principal de uma expedição polar escandinava.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_GU",
       "SNOWHILL_UKSI"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P13",
      "factKey": "ilha-snow-hill-F11",
      "text": "Pré-fabricada na Suécia, foi chamada pelos expedicionários de “Estação de Inverno”; hoje também a chamam de “Casa Suecia”.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_GU"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P14",
      "factKey": "ilha-snow-hill-F28",
      "text": "É o Sítio e Monumento Histórico nº 38 do Tratado da Antártida.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_GUIA",
       "SNOWHILL_UKSI"
      ],
      "clueType": "patrimonio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P15",
      "factKey": "ilha-snow-hill-F14",
      "text": "Seis homens passaram 22 meses na estação, com pesquisas de geografia, geologia, bacteriologia e meteorologia.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_GU"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P16",
      "factKey": "ilha-snow-hill-F29",
      "text": "Entre os que invernaram estava o tenente argentino José María Sobral.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "SNOWHILL_GU"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P17",
      "factKey": "ilha-snow-hill-F15",
      "text": "O navio da expedição, que tinha passado o inverno na Geórgia do Sul, foi esmagado pelo gelo ao voltar para buscá-los, em fevereiro de 1903.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_BRIT",
       "SNOWHILL_FIB"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P18",
      "factKey": "ilha-snow-hill-F16",
      "text": "O naufrágio impôs um segundo inverno, com os expedicionários espalhados em três locais diferentes.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_FIB"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P19",
      "factKey": "ilha-snow-hill-F17",
      "text": "Todos foram resgatados em 8 de novembro de 1903 por uma expedição de socorro argentina, no navio Uruguay.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "SNOWHILL_FIB",
       "SNOWHILL_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P20",
      "factKey": "ilha-snow-hill-F30",
      "text": "O navio perdido, o Antarctic, era comandado pelo capitão C. A. Larsen.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_FIB"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P21",
      "factKey": "ilha-snow-hill-F20",
      "text": "A cabana funciona como museu vivo, com objetos originais, sob gestão compartilhada de Argentina e Suécia.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "SNOWHILL_GUIA",
       "SNOWHILL_RAA"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P22",
      "factKey": "ilha-snow-hill-F22",
      "text": "O degelo do permafrost e a erosão por água de derretimento ameaçam o morro; partes da área de laboratórios já foram levadas ao mar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GU",
       "SNOWHILL_RAA"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P23",
      "factKey": "ilha-snow-hill-F23",
      "text": "Dos anos 1990 a meados da década de 2010, o morro foi reforçado com terraços de chapas de alumínio reaproveitadas de pistas militares temporárias.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "SNOWHILL_GU"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P24",
      "factKey": "ilha-snow-hill-F31",
      "text": "Em janeiro de 2020, uma equipe sueco-argentina documentou a cabana com escâner a laser, fotogrametria e drones.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "SNOWHILL_GU",
       "SNOWHILL_RAA"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-snow-hill-geografo-P25",
      "factKey": "ilha-snow-hill-F25",
      "text": "A expedição era liderada pelo sueco Otto Nordenskjöld, e seus resultados científicos saíram em volumes de 1905 a 1920.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "SNOWHILL_BRIT",
       "SNOWHILL_UKSI"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   }
