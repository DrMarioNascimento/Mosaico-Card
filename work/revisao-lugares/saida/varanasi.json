          {
            "id": "varanasi-geografo-P19",
            "factKey": "varanasi-F40",
            "text": "O templo Sankat Mochan, dedicado a Hanuman e atribuído a Tulsidas, fica a uns 300 m do templo Tulsi Manas.",
