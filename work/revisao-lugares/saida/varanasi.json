    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "varanasi-viajante-P01",
            "factKey": "varanasi-F01",
            "text": "É uma cidade muito antiga do norte da Índia, à beira de um grande rio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "localizacao",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P02",
            "factKey": "varanasi-F02",
            "text": "Em junho, a temperatura chega a cerca de 44 °C; em janeiro, cai para perto de 4,5 °C.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P03",
            "factKey": "varanasi-F03",
            "text": "A época mais agradável para visitar vai de outubro a março.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P04",
            "factKey": "varanasi-F04",
            "text": "A cidade fica na margem esquerda do rio Ganges, no sudeste do estado de Uttar Pradesh.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P05",
            "factKey": "varanasi-F05",
            "text": "Escadarias à beira do rio, os ghats, se estendem por uns 4 km e servem para banhos religiosos.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VARANASI_UP_NRI",
              "VARANASI_BRIT"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P06",
            "factKey": "varanasi-F06",
            "text": "Passear de barco pelo rio ao amanhecer é um dos programas mais marcantes.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P07",
            "factKey": "varanasi-F07",
            "text": "Todas as noites, num dos ghats, sacerdotes fazem a Ganga Aarti, com lamparinas de latão, conchas e sinos.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VARANASI_INCREDIBLE_DASH",
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P08",
            "factKey": "varanasi-F08",
            "text": "Durante a cerimônia, visitantes podem soltar no rio pequenas lamparinas sobre folhas.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VARANASI_INCREDIBLE_DASH"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P09",
            "factKey": "varanasi-F09",
            "text": "Um dos ghats é tido como um dos crematórios mais sagrados do hinduísmo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P10",
            "factKey": "varanasi-F10",
            "text": "É uma das sete cidades sagradas do hinduísmo, e muitos devotos desejam morrer ali na velhice.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P11",
            "factKey": "varanasi-F11",
            "text": "Mais de um milhão de peregrinos chegam todos os anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P12",
            "factKey": "varanasi-F12",
            "text": "Um dos templos mais venerados, o Vishwanath, é dedicado a Shiva e também é chamado de Templo Dourado.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT",
              "VARANASI_UP_NRI"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P13",
            "factKey": "varanasi-F13",
            "text": "Muitos macacos vivem nas árvores grandes em volta do templo da deusa Durga.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P14",
            "factKey": "varanasi-F14",
            "text": "A cerca de 10 km ao norte fica o lugar onde Buda fez seu primeiro sermão, para cinco discípulos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "VARANASI_UP_NRI",
              "VARANASI_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P15",
            "factKey": "varanasi-F15",
            "text": "Nesse lugar do primeiro sermão há estupas, mosteiros e um pilar do imperador Ashoka.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "VARANASI_UP_NRI",
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P16",
            "factKey": "varanasi-F16",
            "text": "Os sáris de seda da cidade, bordados com fios de ouro e prata, têm indicação geográfica.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE",
              "VARANASI_BRIT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P17",
            "factKey": "varanasi-F17",
            "text": "Também se fazem ali brinquedos de madeira, pulseiras de vidro e peças de latão.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P18",
            "factKey": "varanasi-F18",
            "text": "Na comida de rua há kachori com sabzi, tamatar chaat e lassi; o paan local tem selo de origem.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P19",
            "factKey": "varanasi-F19",
            "text": "Em março, um festival de música dhrupad dura cinco dias num dos ghats.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P20",
            "factKey": "varanasi-F20",
            "text": "Ravi Shankar, Bismillah Khan e Girija Devi estão entre os músicos ligados à cidade.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P21",
            "factKey": "varanasi-F21",
            "text": "Quinze dias depois do Diwali, milhares de lamparinas iluminam os ghats na festa de Dev Deepawali.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P22",
            "factKey": "varanasi-F22",
            "text": "Na margem oposta fica Ramnagar, onde a encenação do Ramlila dura um mês.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT",
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P23",
            "factKey": "varanasi-F23",
            "text": "Mark Twain escreveu que a cidade era “mais velha que a história, mais velha que a tradição, mais velha até que a lenda”.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P24",
            "factKey": "varanasi-F24",
            "text": "Um de seus nomes vem do sânscrito “kash”, brilhar, e lhe rendeu o apelido de “Cidade da Luz”.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE",
              "VARANASI_UP_NRI"
            ],
            "clueType": "cultura",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-viajante-P25",
            "factKey": "varanasi-F25",
            "text": "Pela tradição, a cidade é a terra que fica entre os rios Varuna e Assi.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_UP_NRI"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "varanasi-geografo-P01",
            "factKey": "varanasi-F26",
            "text": "Centro de peregrinação no sudeste de Uttar Pradesh, tido como uma das cidades habitadas sem interrupção mais antigas do mundo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P02",
            "factKey": "varanasi-F02",
            "text": "O clima tem grande amplitude anual: a faixa de temperatura vai de cerca de 4,5–27,9 °C em janeiro a 23,9–44,4 °C em junho.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_INCREDIBLE"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P03",
            "factKey": "varanasi-F27",
            "text": "Já no segundo milênio a.C., era um centro da religião e da filosofia védicas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P04",
            "factKey": "varanasi-F05",
            "text": "A frente urbana ocupa a margem esquerda do Ganges, onde os ghats formam uma faixa contínua de cerca de 4 km.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VARANASI_BRIT",
              "VARANASI_UP_NRI"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P05",
            "factKey": "varanasi-F28",
            "text": "Em 1910, os britânicos criaram um estado com sede em Ramnagar, na margem oposta, mas sem jurisdição sobre a cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P06",
            "factKey": "varanasi-F29",
            "text": "A cidade declinou em três séculos de domínio muçulmano a partir de 1194, quando muitos templos hindus foram destruídos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P07",
            "factKey": "varanasi-F30",
            "text": "A Grande Mesquita de Aurangzeb é outro edifício religioso de destaque na paisagem urbana.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P08",
            "factKey": "varanasi-F14",
            "text": "A uns 10 km ao norte, um sítio budista marca o primeiro sermão de Buda; um pilar de Ashoka fica diante da estupa principal.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "VARANASI_UP_NRI",
              "VARANASI_BRIT"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P09",
            "factKey": "varanasi-F31",
            "text": "As distâncias até Prayagraj (128 km), Patna (246 km) e Lucknow (286 km) ajudam a situar a cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_UP_NRI"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P10",
            "factKey": "varanasi-F32",
            "text": "No censo de 2011, a cidade tinha 1.198.491 habitantes, e a aglomeração urbana, 1.432.280.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_BRIT"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "varanasi-geografo-P11",
            "factKey": "varanasi-F33",
            "text": "A tecelagem faz dela um dos ricos centros têxteis da Índia, com padrões como jangla, tanchoi e butidar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VARANASI_UP_NRI"
            ],
