    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "dubrovnik-viajante-P01",
            "factKey": "dubrovnik-F01",
            "text": "Este destino preserva uma cidade antiga murada à beira-mar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P02",
            "factKey": "dubrovnik-F02",
            "text": "Fica numa costa europeia do Mediterrâneo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P03",
            "factKey": "dubrovnik-F03",
            "text": "A cidade fica na costa dálmata, à beira do mar Adriático.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P04",
            "factKey": "dubrovnik-F04",
            "text": "O lugar fica na Croácia.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS",
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P05",
            "factKey": "dubrovnik-F05",
            "text": "O centro antigo fica ao pé do monte Srđ.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P06",
            "factKey": "dubrovnik-F06",
            "text": "Muralhas de pedra com 1.940 metros envolvem a cidade antiga.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P07",
            "factKey": "dubrovnik-F07",
            "text": "A rua principal, a Placa, atravessa a cidade de leste a oeste até a praça central.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P08",
            "factKey": "dubrovnik-F08",
            "text": "O Palácio do Reitor, antiga sede do governo da cidade, tem origem no século XI.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P09",
            "factKey": "dubrovnik-F09",
            "text": "A antiga alfândega, o Palácio Sponza, é obra de várias mãos ao longo de muitos anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P10",
            "factKey": "dubrovnik-F10",
            "text": "Igrejas, mosteiros, palácios e fontes góticos, renascentistas e barrocos enchem a cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS",
              "DUBROVNIK_PR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P11",
            "factKey": "dubrovnik-F11",
            "text": "Os mosteiros franciscano e dominicano estão entre os grandes conjuntos religiosos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P12",
            "factKey": "dubrovnik-F12",
            "text": "Um terremoto danificou a cidade em 1667, e a catedral foi reconstruída depois dele.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P13",
            "factKey": "dubrovnik-F13",
            "text": "A cidade foi danificada de novo por conflitos armados nos anos 1990.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_PR",
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P14",
            "factKey": "dubrovnik-F14",
            "text": "Entre 1991 e 1998, a cidade esteve na lista do Patrimônio Mundial em Perigo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_PR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P15",
            "factKey": "dubrovnik-F15",
            "text": "A cidade foi capital de uma república independente até ser conquistada por Napoleão, em 1808.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P16",
            "factKey": "dubrovnik-F16",
            "text": "Uma fortaleza sobre um penhasco, citada num documento de 1301, fica fora das muralhas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS1993"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P17",
            "factKey": "dubrovnik-F17",
            "text": "A fortaleza Revelin, de 1449, vigiava o fosso do lado norte.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS1993"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P18",
            "factKey": "dubrovnik-F18",
            "text": "Uma ilha de vegetação exuberante, a uns 500 m da costa, também faz parte do patrimônio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS1993"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P19",
            "factKey": "dubrovnik-F19",
            "text": "Em 1023, essa ilha ganhou uma abadia beneditina.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS1993"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P20",
            "factKey": "dubrovnik-F20",
            "text": "Antigos lazaretos, construídos de 1627 a 1648, recebiam viajantes vindos de regiões com risco de peste.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS1993"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P21",
            "factKey": "dubrovnik-F21",
            "text": "Um quebra-mar de por volta de 1485 protege o porto antigo dos vendavais de sudeste.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS1993"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P22",
            "factKey": "dubrovnik-F22",
            "text": "Num bairro fora dos muros havia curtumes, fundição de canhões e fabricação de sabão.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS1993"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P23",
            "factKey": "dubrovnik-F23",
            "text": "A UNESCO reconheceu a cidade antiga em 1979 e ampliou a área em 1994.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_PR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P24",
            "factKey": "dubrovnik-F24",
            "text": "Ela é chamada de “Pérola do Adriático”.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS",
              "DUBROVNIK_PR"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-viajante-P25",
            "factKey": "dubrovnik-F25",
            "text": "O excesso de turistas e a saída de moradores pressionam a cidade antiga.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "dubrovnik-geografo-P01",
            "factKey": "dubrovnik-F01",
            "text": "A partir do século XIII, a cidade se tornou uma importante potência marítima do Mediterrâneo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_ICOMOS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P02",
            "factKey": "dubrovnik-F02",
            "text": "A UNESCO a descreve como exemplo bem preservado de cidade planejada do fim da Idade Média.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P03",
            "factKey": "dubrovnik-F03",
            "text": "Foi um forte polo marítimo e comercial na costa leste do Adriático, com apogeu nos séculos XV e XVI.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P04",
            "factKey": "dubrovnik-F04",
            "text": "Como cidade-Estado, sobreviveu até a conquista por Napoleão, em 1808.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P05",
            "factKey": "dubrovnik-F05",
            "text": "O núcleo murado fica ao pé do monte Srđ, junto ao mar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P06",
            "factKey": "dubrovnik-F06",
            "text": "Estatutos de 1272 já tratavam do desenvolvimento planejado da cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P07",
            "factKey": "dubrovnik-F07",
            "text": "A malha urbana tinha larguras de rua rigidamente prescritas e exigia pedra em vez de madeira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P08",
            "factKey": "dubrovnik-F08",
            "text": "A Placa, rua principal no sentido leste–oeste, termina na praça central da Luža.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P09",
            "factKey": "dubrovnik-F09",
            "text": "Esgoto, abastecimento de água, celeiro, quarentena, boticas, hospitais e orfanato compunham os serviços municipais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P10",
            "factKey": "dubrovnik-F10",
            "text": "Torres, baluartes, barbacãs, fosso e quebra-mar completam o sistema defensivo das muralhas de 1.940 m.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_SOUV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P11",
            "factKey": "dubrovnik-F11",
            "text": "Grandes torres de defesa representam a arquitetura militar dos séculos XIII ao XVII.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DUBROVNIK_PR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "dubrovnik-geografo-P12",
            "factKey": "dubrovnik-F12",
            "text": "Segundo a UNESCO, quase todas as etapas do desenvolvimento urbano ao longo dos séculos se conservaram na estrutura da cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
