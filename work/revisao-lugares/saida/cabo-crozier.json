      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P15",
      "factKey": "cabo-crozier-F15",
      "text": "Restos antigos e bem preservados de adélias têm valor científico particular para estudos genéticos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
