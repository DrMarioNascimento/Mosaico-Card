      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P16",
      "factKey": "cabo-crozier-F16",
      "text": "Uma colônia de skua-polar-do-sul, estimada em mil pares, ocupa o terreno livre de gelo em volta da colônia de adélias.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P17",
      "factKey": "cabo-crozier-F17",
      "text": "A foca-de-weddell se reproduz na área, com cerca de 20 filhotes registrados em anos recentes.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P18",
      "factKey": "cabo-crozier-F18",
      "text": "Focas-leopardo frequentam a área, e orcas são avistadas com frequência junto à costa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P19",
      "factKey": "cabo-crozier-F19",
      "text": "Algas da neve cobrem mais de 4 hectares junto às colônias de skuas e pinguins, um dos registros mais meridionais desse tipo de alga.",
      "relatedFields": [
