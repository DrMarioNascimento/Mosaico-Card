  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "cabo-crozier-viajante-P01",
      "factKey": "cabo-crozier-F01",
      "text": "É uma área protegida onde rocha, mar e gelo se encontram.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P02",
      "factKey": "cabo-crozier-F02",
      "text": "Duas espécies de pinguim têm colônias de reprodução por aqui.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P03",
      "factKey": "cabo-crozier-F03",
      "text": "O lugar fica na ponta leste de uma ilha antártica.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P04",
      "factKey": "cabo-crozier-F04",
      "text": "A parte de terra fica nas encostas baixas do Monte Terror.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P05",
      "factKey": "cabo-crozier-F05",
      "text": "Morros como Post Office Hill e Bomb Peak aparecem na paisagem.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P06",
      "factKey": "cabo-crozier-F06",
      "text": "A maior parte da área protegida fica no mar e no gelo, não em terra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P07",
      "factKey": "cabo-crozier-F07",
      "text": "Aqui uma enorme plataforma de gelo encosta na costa da ilha.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P08",
      "factKey": "cabo-crozier-F08",
      "text": "O gelo empurra a terra e abre grandes rachaduras, onde os imperadores criam filhotes.",
      "relatedFields": [
       "C3",
       "C4"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P09",
      "factKey": "cabo-crozier-F09",
      "text": "A colônia de imperadores muda de lugar de um ano para outro.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P10",
      "factKey": "cabo-crozier-F10",
      "text": "É a colônia de pinguins-imperadores mais ao sul que se conhece.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P11",
      "factKey": "cabo-crozier-F11",
      "text": "Essa colônia de imperadores foi descoberta em 1902.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P12",
      "factKey": "cabo-crozier-F12",
      "text": "Entre 2001 e 2005, icebergs gigantes atrapalharam a colônia, que depois voltou ao lugar de antes.",
      "relatedFields": [
       "C3",
       "C4"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P13",
      "factKey": "cabo-crozier-F13",
      "text": "Os pinguins-de-adélia formam dois grandes grupos, a cerca de 1 km um do outro.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P14",
      "factKey": "cabo-crozier-F14",
      "text": "Em 2012, os pinguins-de-adélia passaram de 270 mil casais.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P15",
      "factKey": "cabo-crozier-F15",
      "text": "Restos muito antigos de pinguins ajudam cientistas a estudar genética.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P16",
      "factKey": "cabo-crozier-F16",
      "text": "Cerca de mil casais de skua-polar-do-sul vivem ao redor dos pinguins.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P17",
      "factKey": "cabo-crozier-F17",
      "text": "Focas-de-weddell têm filhotes dentro da área.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P18",
      "factKey": "cabo-crozier-F18",
      "text": "Orcas costumam aparecer perto da costa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P19",
      "factKey": "cabo-crozier-F19",
      "text": "Manchas de algas colorem a neve perto das colônias de aves.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P20",
      "factKey": "cabo-crozier-F20",
      "text": "Há muitos líquens, mas os musgos são raros e pequenos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P21",
      "factKey": "cabo-crozier-F21",
      "text": "Foram achados ali dois líquens que nunca tinham sido registrados na Antártida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P22",
      "factKey": "cabo-crozier-F22",
      "text": "Um poste de 1902 servia para deixar recados aos navios de apoio de uma expedição.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124",
       "ATS_HSM_LISTA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P23",
      "factKey": "cabo-crozier-F23",
      "text": "Restos de um abrigo de pedra lembram uma viagem de inverno, em 1911, para buscar ovos de pinguim-imperador.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "ATS_HSM_LISTA",
       "CROZIER_ASPA124"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P24",
      "factKey": "cabo-crozier-F24",
      "text": "Quem fez o abrigo foi o grupo de Edward Wilson, de uma expedição britânica.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_HSM_LISTA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-viajante-P25",
      "factKey": "cabo-crozier-F25",
      "text": "A área é protegida desde 1966, e hoje só se entra com permissão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "cabo-crozier-geografo-P01",
      "factKey": "cabo-crozier-F01",
      "text": "A área protegida combina terreno livre de gelo, mar e um trecho de plataforma de gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P02",
      "factKey": "cabo-crozier-F02",
      "text": "O principal valor ecológico do sítio são as colônias reprodutoras de duas espécies de pinguim.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P03",
      "factKey": "cabo-crozier-F03",
      "text": "O sítio ocupa a extremidade oriental da Ilha Ross, no Mar de Ross.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P04",
      "factKey": "cabo-crozier-F04",
      "text": "A porção livre de gelo corresponde às encostas baixas do flanco leste do Monte Terror.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P05",
      "factKey": "cabo-crozier-F05",
      "text": "A área se situa nas vizinhanças de Post Office Hill (407 m), Bomb Peak (740 m) e The Knoll (360 m) e se estende até os cones Gamble, Topping e Kyle.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P06",
      "factKey": "cabo-crozier-F06",
      "text": "Dos cerca de 70 km² da área, cerca de 43 km² (61%) são marinhos, incluindo plataforma de gelo, e 27 km² são terrestres.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P07",
      "factKey": "cabo-crozier-F07",
      "text": "A Plataforma de Gelo Ross encontra a costa nesse ponto, e um trecho dela está dentro da área protegida.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P08",
      "factKey": "cabo-crozier-F08",
      "text": "Ao pressionar a terra, a plataforma de gelo abre grandes fendas, entre as quais se forma o gelo fixo usado pelos imperadores na reprodução.",
      "relatedFields": [
       "C3",
       "C4"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P09",
      "factKey": "cabo-crozier-F09",
      "text": "Como as fendas se deslocam com o movimento da plataforma, a posição da colônia de imperadores varia de ano para ano.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P10",
      "factKey": "cabo-crozier-F10",
      "text": "O plano de manejo de 2014 descreve a colônia de imperadores como a mais meridional conhecida e a de série de estudos mais longa.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P11",
      "factKey": "cabo-crozier-F11",
      "text": "A colônia de imperadores foi descoberta em outubro de 1902 por R. S. Skelton.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P12",
      "factKey": "cabo-crozier-F12",
      "text": "Os icebergs B15A e C16, presentes de 2001 a 2005, perturbaram a colônia de imperadores, que em 2006 voltou à posição anterior.",
      "relatedFields": [
       "C3",
       "C4"
      ],
      "sources": [
       "CROZIER_ASPA124"
      ],
