      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-crozier-geografo-P14",
      "factKey": "cabo-crozier-F14",
      "text": "A população de adélias gira em torno de 150 mil pares reprodutores, com pouco mais de 270 mil em 2012.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CROZIER_ASPA124"
