            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P16",
            "factKey": "ngorongoro-F36",
            "text": "A população de leões mais densa já conhecida, estimada em 68 animais em 1987, foi registrada ali.",
