            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P14",
            "factKey": "ngorongoro-F35",
            "text": "Cerca de 25 mil grandes animais, sobretudo ungulados, vivem na área, que ocupa a ponta sul de um ecossistema de migração muito maior.",
            "relatedFields": [
