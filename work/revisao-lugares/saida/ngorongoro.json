    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "ngorongoro-viajante-P01",
            "factKey": "ngorongoro-F01",
            "text": "Aqui dá para ver leões, hienas, zebras e grandes manadas de gnus.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P02",
            "factKey": "ngorongoro-F02",
            "text": "A paisagem mistura planícies de capim, savana com árvores, florestas, montanhas, lagos e pântanos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P03",
            "factKey": "ngorongoro-F03",
            "text": "Fica no norte da Tanzânia, na região de Arusha.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P04",
            "factKey": "ngorongoro-F04",
            "text": "Fica a sudeste do Parque Nacional do Serengeti.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P05",
            "factKey": "ngorongoro-F05",
            "text": "A grande atração é uma cratera gigante, com 16 a 19 km de uma borda à outra.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "NGORO_EB_CRATERA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P06",
            "factKey": "ngorongoro-F06",
            "text": "A borda, coberta de floresta, chega a 2.286 metros de altitude, e o fundo fica 610 metros abaixo dela.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "NGORO_EB_CRATERA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P07",
            "factKey": "ngorongoro-F07",
            "text": "O fundo da cratera tem cerca de 264 km², e muitos animais vivem lá dentro o ano todo.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "NGORO_EB_CRATERA",
              "NGORO_UNESCO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P08",
            "factKey": "ngorongoro-F08",
            "text": "A cratera nasceu há cerca de 2,5 milhões de anos, quando um grande vulcão desabou depois de uma erupção.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "NGORO_EB_CRATERA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P09",
            "factKey": "ngorongoro-F09",
            "text": "Outras duas crateras vulcânicas da área são Olmoti e Empakaai; nesta, um lago alcalino profundo cobre quase metade do fundo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P10",
            "factKey": "ngorongoro-F10",
            "text": "Flamingos estão entre as mais de 400 espécies de aves da área.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P11",
            "factKey": "ngorongoro-F11",
            "text": "O rinoceronte-negro, criticamente ameaçado, é uma das espécies raras protegidas ali.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_UNESCO",
              "NGORO_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P12",
            "factKey": "ngorongoro-F12",
            "text": "A área tem uma das maiores densidades de mamíferos predadores da África.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_UNESCO",
              "NGORO_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P13",
            "factKey": "ngorongoro-F13",
            "text": "Pastores maasai vivem ali com seus rebanhos, lado a lado com os animais selvagens.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "NGORO_UNESCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P14",
            "factKey": "ngorongoro-F14",
            "text": "Plantar lavouras é proibido, mas os pastores podem levar o gado para pastar.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P15",
            "factKey": "ngorongoro-F15",
            "text": "A área fazia parte do parque vizinho desde 1951 e virou uma unidade separada em 1959.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P16",
            "factKey": "ngorongoro-F16",
            "text": "Uma ravina profunda da área guarda fósseis de várias espécies humanas, dos australopitecos ao Homo sapiens.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "NGORO_UNESCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P17",
            "factKey": "ngorongoro-F17",
            "text": "Em 1959, a arqueóloga Mary Leakey achou ali dentes e fragmentos do crânio de um hominínio de cerca de 1,75 milhão de anos, apelidado de \"homem quebra-nozes\".",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "NGORO_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P18",
            "factKey": "ngorongoro-F18",
            "text": "As ferramentas de pedra achadas nessa ravina deram nome a uma tradição técnica: a olduvaiense.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "NGORO_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P19",
            "factKey": "ngorongoro-F19",
            "text": "Em outro sítio da área, Laetoli, ficaram pegadas fossilizadas de 3,6 milhões de anos ligadas ao andar sobre dois pés.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_UNESCO",
              "NGORO_IUCN"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P20",
            "factKey": "ngorongoro-F20",
            "text": "Entrou na lista do Patrimônio Mundial em 1979 pela natureza e, em 2010, também pela cultura.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_UNESCO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P21",
            "factKey": "ngorongoro-F21",
            "text": "Em 2014, a área recebeu cerca de 650 mil visitantes, e o fundo da cratera costuma ficar congestionado.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_IUCN"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P22",
            "factKey": "ngorongoro-F22",
            "text": "A altitude vai de cerca de 1.000 metros, junto ao lago Eyasi, a 3.600 metros no alto das montanhas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_IUCN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P23",
            "factKey": "ngorongoro-F23",
            "text": "Na migração anual, mais de 1 milhão de gnus, 72 mil zebras e cerca de 350 mil gazelas passam pela área.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_UNESCO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P24",
            "factKey": "ngorongoro-F24",
            "text": "Abriga a maior caldeira vulcânica intacta do mundo, no norte da Tanzânia.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "NGORO_UNESCO",
              "NGORO_EB"
            ],
            "clueType": "relevo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-viajante-P25",
            "factKey": "ngorongoro-F25",
            "text": "Na mesma área ficam a cratera gigante, a ravina dos fósseis estudada pelos Leakey e as pegadas de Laetoli.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "NGORO_UNESCO",
              "NGORO_EBSCO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "ngorongoro-geografo-P01",
            "factKey": "ngorongoro-F26",
            "text": "O território se estende das planícies de um grande parque vizinho, a noroeste, até o braço oriental do Grande Vale do Rift.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P02",
            "factKey": "ngorongoro-F27",
            "text": "O modelo de gestão tenta conciliar conservação da fauna, pastoreio e turismo no mesmo território.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_UNESCO"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P03",
            "factKey": "ngorongoro-F28",
            "text": "A região é geologicamente ativa desde o fim do Mesozoico e fica no flanco oeste do Grande Vale do Rift.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_IUCN"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P04",
            "factKey": "ngorongoro-F08",
            "text": "A caldeira resulta do colapso do cone de um grande vulcão ativo após uma erupção, há cerca de 2,5 milhões de anos.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "NGORO_EB_CRATERA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P05",
            "factKey": "ngorongoro-F29",
            "text": "Os principais edifícios vulcânicos da área, a caldeira central e os vulcões Olmoti e Empakaai, formaram-se entre 20 milhões e 2 milhões de anos atrás.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "NGORO_EB"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P06",
            "factKey": "ngorongoro-F06",
            "text": "A borda florestada, a 2.286 m, ergue-se 610 m acima do fundo da caldeira, que tem de 16 a 19 km de diâmetro.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "NGORO_EB_CRATERA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P07",
            "factKey": "ngorongoro-F30",
            "text": "Cinzas lançadas pelo vulcão vizinho Ol Doinyo Lengai aumentam a fertilidade dos campos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P08",
            "factKey": "ngorongoro-F31",
            "text": "Além dos vulcões, a área tem dunas de areia formadas pelo vento.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NGORO_IUCN"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P09",
            "factKey": "ngorongoro-F32",
            "text": "A erosão por rios sazonais expôs camadas com fósseis nas gargantas de Olduvai e Laetoli.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "NGORO_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P10",
            "factKey": "ngorongoro-F33",
            "text": "As camadas vulcânicas da ravina, divididas em quatro leitos, permitem datar fósseis e ferramentas por métodos radiométricos; o leito I tem mais de 2 milhões de anos.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "NGORO_EBSCO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
