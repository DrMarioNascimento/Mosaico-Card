            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P13",
            "factKey": "ngorongoro-F34",
            "text": "O registro arqueológico da área cobre quase 4 milhões de anos de evolução humana.",
