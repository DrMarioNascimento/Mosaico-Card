            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P15",
            "factKey": "ngorongoro-F07",
            "text": "Cercada pelas paredes da caldeira, uma fauna densa permanece no fundo o ano inteiro.",
