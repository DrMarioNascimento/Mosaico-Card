            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ngorongoro-geografo-P12",
            "factKey": "ngorongoro-F19",
            "text": "Pegadas fossilizadas de cerca de 3,6 milhões de anos registram o desenvolvimento do bipedalismo humano.",
