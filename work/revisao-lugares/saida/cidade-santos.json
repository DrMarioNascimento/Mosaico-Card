        "label": "Viajante",
        "cards": [
          {
            "id": "cidade-santos-viajante-P01",
            "factKey": "cidade-santos-F01",
            "text": "É uma cidade litorânea do Sudeste, com praias urbanas e um porto muito movimentado.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SAN_CATRACA",
              "SAN_PORTUS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-viajante-P02",
            "factKey": "cidade-santos-F02",
            "text": "Atrás da cidade, uma serra com cerca de 700 metros de desnível sobe até o planalto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SAN_PORTUS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-viajante-P03",
            "factKey": "cidade-santos-F03",
            "text": "A orla tem um jardim de 5,3 km registrado pelo Guinness como o maior jardim de orla do mundo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SAN_CATRACA"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-viajante-P04",
            "factKey": "cidade-santos-F04",
            "text": "Os jardins da praia começaram a ser feitos a partir dos anos 1930.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SAN_PORTUS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-viajante-P05",
            "factKey": "cidade-santos-F05",
            "text": "Mais de 60 prédios da orla são inclinados; eles são monitorados e considerados seguros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SAN_VISITE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-viajante-P06",
            "factKey": "cidade-santos-F06",
            "text": "Canais abertos atravessam a cidade e ajudam a escoar a água da chuva.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SAN_FAPESP",
              "SAN_LABVERDE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-viajante-P07",
            "factKey": "cidade-santos-F07",
            "text": "O primeiro desses canais foi entregue em 1907, sobre um antigo ribeirão.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SAN_FAPESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-viajante-P08",
            "factKey": "cidade-santos-F08",
            "text": "No centro histórico, o prédio de uma antiga bolsa de negócios virou museu.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SAN_MUSEU",
              "SAN_VISITE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-viajante-P09",
            "factKey": "cidade-santos-F09",
            "text": "Esse prédio, com torre de relógio e vitrais, foi inaugurado em 7 de setembro de 1922.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SAN_MUSEU"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
