      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "cidade-santos-geografo-P01",
            "factKey": "cidade-santos-F01",
            "text": "O sítio urbano ocupa uma planície costeira baixa, historicamente sujeita a inundações constantes.",
