              "C1"
            ],
            "sources": [
              "SAN_LABVERDE"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-geografo-P03",
            "factKey": "cidade-santos-F03",
            "text": "A escarpa da serra, com cerca de 700 m de desnível, foi por séculos o grande obstáculo entre o porto e o planalto.",
