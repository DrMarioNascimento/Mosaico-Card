            ],
            "sources": [
              "SAN_PORTUS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-geografo-P05",
            "factKey": "cidade-santos-F05",
            "text": "A ferrovia de 1867, construída por empresa britânica, ligou o porto ao planalto e canalizou a exportação do café.",
