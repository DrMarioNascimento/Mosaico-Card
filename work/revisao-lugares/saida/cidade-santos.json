            "factKey": "cidade-santos-F10",
            "text": "O porto se instalou em águas abrigadas do estuário, e o canal estuarino separa a cidade do Guarujá.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SAN_PORTUS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
