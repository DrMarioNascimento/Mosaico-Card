            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-geografo-P09",
            "factKey": "cidade-santos-F09",
            "text": "Um decreto de 1888 fez desse porto o pioneiro no modelo de \"porto organizado\" no país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SAN_PORTUS",
              "SAN_IBGE"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
