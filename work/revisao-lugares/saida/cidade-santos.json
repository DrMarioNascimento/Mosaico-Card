              "C2"
            ],
            "sources": [
              "SAN_MUSEU"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-geografo-P08",
            "factKey": "cidade-santos-F08",
            "text": "Em 1890 uma companhia de docas recebeu a concessão do porto por 90 anos; os primeiros 260 m de cais, de 1892, ficavam no Valongo.",
