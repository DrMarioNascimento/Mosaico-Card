              "C1"
            ],
            "sources": [
              "SAN_PORTUS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-geografo-P04",
            "factKey": "cidade-santos-F04",
            "text": "A Calçada do Lorena, de 1789, e depois a estrada de 1827 tentaram facilitar a subida da serra.",
