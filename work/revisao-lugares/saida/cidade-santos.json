              "C2"
            ],
            "sources": [
              "SAN_MUSEU"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-santos-geografo-P07",
            "factKey": "cidade-santos-F07",
            "text": "Uma bolsa oficial mediava os negócios de café num edifício eclético aberto em 1922, no centenário da Independência.",
