    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "cidade-do-cabo-viajante-P01",
            "factKey": "cidade-do-cabo-F01",
            "text": "É uma grande cidade portuária, com praias e mais de setenta montanhas dentro do município.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P02",
            "factKey": "cidade-do-cabo-F02",
            "text": "O clima é mediterrâneo: no verão, as máximas médias ficam perto de 21 °C.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P03",
            "factKey": "cidade-do-cabo-F03",
            "text": "Uma montanha de topo plano, com mais de 1 km de altura, aparece atrás dos prédios e do porto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EB",
              "CABO_EBSCO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P04",
            "factKey": "cidade-do-cabo-F04",
            "text": "Dá para chegar ao topo dessa montanha a pé ou de teleférico.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P05",
            "factKey": "cidade-do-cabo-F05",
            "text": "Um vento forte de sudeste, que os moradores chamam de \"Cape Doctor\", leva embora a poluição do ar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P06",
            "factKey": "cidade-do-cabo-F06",
            "text": "A cidade tem praias viradas para o oceano Atlântico e outras numa grande baía, a False Bay.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P07",
            "factKey": "cidade-do-cabo-F07",
            "text": "Numa praia de pedras enormes, a Boulders, vive uma colônia de pinguins dentro de um parque nacional.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO",
              "CABO_SANPARKS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P08",
            "factKey": "cidade-do-cabo-F08",
            "text": "O censo de 2026 contou 790 casais de pinguins-africanos nessa praia; a espécie está criticamente ameaçada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_SANPARKS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P09",
            "factKey": "cidade-do-cabo-F09",
            "text": "O primeiro capítulo europeu da sua história é português: foi Bartolomeu Dias quem batizou o cabo da Boa Esperança.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P10",
            "factKey": "cidade-do-cabo-F10",
            "text": "Em 1503, o português Antônio de Saldanha foi o primeiro europeu a ancorar na baía e a subir a montanha de topo plano.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EB_HIST",
              "CABO_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P11",
            "factKey": "cidade-do-cabo-F11",
            "text": "Em 7 de abril de 1652, Jan van Riebeeck desembarcou ali para escolher lugares para um forte e uma horta.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "CABO_EB_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P12",
            "factKey": "cidade-do-cabo-F12",
            "text": "Ele trabalhava para uma companhia holandesa de comércio que queria um posto de abastecimento para seus navios.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "CABO_EB_HIST",
              "CABO_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P13",
            "factKey": "cidade-do-cabo-F13",
            "text": "A horta do fundador virou um jardim histórico no centro, o Company's Garden.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P14",
            "factKey": "cidade-do-cabo-F14",
            "text": "O Castelo da Boa Esperança, antiga sede dos governos holandês e britânico, é a construção mais antiga do período colonial no país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P15",
            "factKey": "cidade-do-cabo-F15",
            "text": "A companhia começou a trazer pessoas escravizadas em 1658; um antigo alojamento delas virou museu, o Slave Lodge.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EB_HIST",
              "CABO_EB"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P16",
            "factKey": "cidade-do-cabo-F16",
            "text": "Os britânicos ocuparam a cidade em 1795 e de novo em 1806, depois de um breve retorno aos holandeses.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EB_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P17",
            "factKey": "cidade-do-cabo-F17",
            "text": "Em 1966, o governo do apartheid declarou o bairro District Six \"área branca\" e começou a despejar cerca de 50 mil moradores.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P18",
            "factKey": "cidade-do-cabo-F18",
            "text": "Mais de 200 vinícolas ficam a até um dia de carro da cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P19",
            "factKey": "cidade-do-cabo-F19",
            "text": "Em 2017 e 2018, a cidade temeu o \"Dia Zero\", quando a água das torneiras seria cortada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P20",
            "factKey": "cidade-do-cabo-F20",
            "text": "As encostas são cobertas pelo fynbos, uma vegetação de arbustos de folhas finas que só existe nessa região florística.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "CABO_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P21",
            "factKey": "cidade-do-cabo-F21",
            "text": "Um parque nacional vai da ponta da península até a cidade e faz parte do Patrimônio Mundial natural.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "CABO_TURISMO",
              "CABO_IUCN"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P22",
            "factKey": "cidade-do-cabo-F22",
            "text": "Em setembro de 1989, uma marcha pacífica de cerca de 40 mil pessoas na cidade ajudou a abrir caminho para a libertação de Nelson Mandela.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EB_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P23",
            "factKey": "cidade-do-cabo-F23",
            "text": "No litoral da False Bay fica Simon's Town, um porto da Marinha, e dali segue a estrada até a ponta da península, o Cape Point.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P24",
            "factKey": "cidade-do-cabo-F24",
            "text": "É a capital legislativa da África do Sul e a capital da província do Cabo Ocidental.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "CABO_EB",
              "CABO_EBSCO"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-viajante-P25",
            "factKey": "cidade-do-cabo-F25",
            "text": "É a segunda maior cidade sul-africana, atrás de Joanesburgo, com cerca de 4,9 milhões de habitantes na região metropolitana em 2023.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "cidade-do-cabo-geografo-P01",
            "factKey": "cidade-do-cabo-F26",
            "text": "O sítio urbano combina um grande porto com dezenas de montanhas e praias voltadas para duas frentes de mar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-geografo-P02",
            "factKey": "cidade-do-cabo-F27",
            "text": "A expansão urbana pressiona áreas protegidas vizinhas, numa das regiões de maior biodiversidade vegetal terrestre do planeta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-geografo-P03",
            "factKey": "cidade-do-cabo-F28",
            "text": "O núcleo urbano ocupa a extremidade norte de uma península, à beira de uma baía usada como ancoradouro pelos navegadores europeus.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EB",
              "CABO_EB_HIST"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-geografo-P04",
            "factKey": "cidade-do-cabo-F12",
            "text": "A cidade nasceu como posto de reabastecimento de navios da Companhia Holandesa das Índias Orientais.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "CABO_EB_HIST",
              "CABO_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-geografo-P05",
            "factKey": "cidade-do-cabo-F29",
            "text": "A escolha do local seguiu os relatos favoráveis de sobreviventes do naufrágio do navio Haerlem, em 1647.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "CABO_EB_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-geografo-P06",
            "factKey": "cidade-do-cabo-F30",
            "text": "A partir de 1658, pessoas escravizadas trazidas da Indonésia, do Ceilão, da península Malaia e de Madagascar passaram a compor a população.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EB_HIST",
              "CABO_EBSCO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-geografo-P07",
            "factKey": "cidade-do-cabo-F31",
            "text": "Para manter os khoisan, povos nativos da região, fora do povoamento, o fundador do posto plantou uma sebe de amendoeiras-amargas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EBSCO",
              "CABO_EB_HIST"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-do-cabo-geografo-P08",
            "factKey": "cidade-do-cabo-F32",
            "text": "Em 1657, a companhia começou a liberar funcionários para virarem agricultores livres, os free burghers.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CABO_EB_HIST"
            ],
            "clueType": "processo",
