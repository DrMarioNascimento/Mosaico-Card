      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "ruinas-kilwa-songo-geografo-P01",
            "factKey": "ruinas-kilwa-songo-F01",
            "text": "O sítio documenta cidades portuárias que viviam do comércio marítimo de longa distância.",
