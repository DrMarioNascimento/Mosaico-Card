          {
            "id": "ruinas-kilwa-songo-geografo-P19",
            "factKey": "ruinas-kilwa-songo-F19",
            "text": "Entrou na Lista do Patrimônio Mundial em Perigo em 2004, por deterioração das estruturas, e saiu em 2014.",
