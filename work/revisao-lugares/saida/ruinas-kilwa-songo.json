            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ruinas-kilwa-songo-geografo-P16",
            "factKey": "ruinas-kilwa-songo-F16",
            "text": "A Gereza, prisão erguida sobre as ruínas do forte português, tem uma torre omanita junto ao mar.",
