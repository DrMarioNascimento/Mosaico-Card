            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ruinas-kilwa-songo-geografo-P15",
            "factKey": "ruinas-kilwa-songo-F15",
            "text": "No início do século XVIII, Omã ocupou a costa leste-africana, mas a cidade não recuperou a antiga glória.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
