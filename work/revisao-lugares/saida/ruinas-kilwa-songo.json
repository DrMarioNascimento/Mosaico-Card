          {
            "id": "ruinas-kilwa-songo-geografo-P21",
            "factKey": "ruinas-kilwa-songo-F21",
            "text": "A gestão passou do setor de Antiguidades para a autoridade de vida selvagem da Tanzânia (TAWA).",
