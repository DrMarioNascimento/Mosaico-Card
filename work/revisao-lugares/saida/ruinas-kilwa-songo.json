            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ruinas-kilwa-songo-geografo-P13",
            "factKey": "ruinas-kilwa-songo-F13",
            "text": "A autenticidade se manteve porque as consolidações foram limitadas e feitas com a própria pedra de coral.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KILWA_UNESCO"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ruinas-kilwa-songo-geografo-P14",
            "factKey": "ruinas-kilwa-songo-F14",
            "text": "A ocupação portuguesa de 1505 e o forte do século XVI marcam o início do declínio das ilhas.",
