      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "sian-kaan-viajante-P07",
      "factKey": "sian-kaan-F07",
      "text": "A área protegida tem cerca de 120 km de litoral.",
