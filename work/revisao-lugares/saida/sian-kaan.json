       "C1"
      ],
      "sources": [
       "SIANKAAN_PR"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "sian-kaan-viajante-P03",
      "factKey": "sian-kaan-F03",
      "text": "Fica no México, na América do Norte.",
