      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "sian-kaan-viajante-P06",
      "factKey": "sian-kaan-F06",
      "text": "As praias dão para o mar do Caribe.",
