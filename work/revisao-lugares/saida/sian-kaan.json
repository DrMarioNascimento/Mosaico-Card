      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "sian-kaan-geografo-P12",
      "factKey": "sian-kaan-F12",
      "text": "O bem inclui um trecho relativamente intacto, de cerca de 120 km, do Recife Mesoamericano.",
