      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "sian-kaan-viajante-P02",
      "factKey": "sian-kaan-F02",
      "text": "Os muitos tons de azul das lagoas e do mar chamam a atenção.",
