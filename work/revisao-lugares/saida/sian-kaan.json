      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "sian-kaan-geografo-P10",
      "factKey": "sian-kaan-F10",
      "text": "Segundo a IUCN, os manguezais sustentam 90% das espécies de peixes de valor comercial.",
