            ],
            "sources": [
              "SETECIDADES_ICM2025"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-sete-cidades-geografo-P23",
            "factKey": "parque-sete-cidades-F23",
            "text": "O plano de manejo antigo nunca foi formalizado oficialmente, e o conselho consultivo só foi criado em 2010.",
