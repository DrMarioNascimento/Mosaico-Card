      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P14",
      "factKey": "domo-a-F31",
      "text": "Cerca de 50 anos depois de detectada, a cordilheira foi mapeada por um levantamento aéreo de sete países.",
