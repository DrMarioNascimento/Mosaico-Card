       "DOMOA_CAS"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P18",
      "factKey": "domo-a-F13",
      "text": "Entre os objetivos estão testemunhos de gelo profundos, a exploração das montanhas subglaciais e observações astronômicas e geomagnéticas.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
