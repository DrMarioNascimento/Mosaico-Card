      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P15",
      "factKey": "domo-a-F07",
      "text": "Os primeiros visitantes chegaram em janeiro de 2005, com a 21ª Expedição Antártica Nacional Chinesa, numa travessia de ~1.200 km desde Zhongshan.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_RAA",
       "DOMOA_CAS"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P16",
      "factKey": "domo-a-F10",
      "text": "A terceira estação chinesa no continente começou a operar ali em 2 de fevereiro de 2009.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_AAD"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P17",
      "factKey": "domo-a-F11",
      "text": "Projetada para 25 pessoas e vida útil de 25 anos, a estação ainda opera só no verão.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
