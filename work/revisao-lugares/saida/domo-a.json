  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "domo-a-viajante-P01",
      "factKey": "domo-a-F01",
      "text": "Este destino é um ponto alto e quase plano no meio do gelo antártico.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_SCINEWS",
       "DOMOA_SCARGAZ"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P02",
      "factKey": "domo-a-F02",
      "text": "Debaixo dos pés há só gelo, com espessura de centenas de metros a vários quilômetros.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_AGLAC"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P03",
      "factKey": "domo-a-F03",
      "text": "É o ponto mais alto de todo o manto de gelo da Antártida.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "DOMOA_AAD",
       "DOMOA_CAS",
       "DOMOA_SCARGAZ"
      ],
      "clueType": "relevo",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P04",
      "factKey": "domo-a-F04",
      "text": "A altitude passa dos 4 mil metros.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "DOMOA_SCARGAZ",
       "DOMOA_SCINEWS"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P05",
      "factKey": "domo-a-F05",
      "text": "Fica perto do paralelo de 80° sul, no interior da Antártida Oriental.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_RAA",
       "DOMOA_SCARGAZ",
       "DOMOA_AGLAC"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P06",
      "factKey": "domo-a-F06",
      "text": "No inverno, a temperatura fica entre –50 °C e –80 °C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_RAA",
       "DOMOA_CAS"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P07",
      "factKey": "domo-a-F07",
      "text": "As primeiras pessoas só pisaram ali em janeiro de 2005.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_RAA",
       "DOMOA_CAS"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P08",
      "factKey": "domo-a-F08",
      "text": "Elas chegaram por terra, numa travessia de uns 1.200 km a partir de uma base na costa.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_RAA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P09",
      "factKey": "domo-a-F09",
      "text": "Essa primeira expedição era chinesa.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_RAA",
       "DOMOA_CAS"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P10",
      "factKey": "domo-a-F10",
      "text": "Em 2009, começou a funcionar ali uma estação de pesquisa da China.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_AAD"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P11",
      "factKey": "domo-a-F11",
      "text": "A estação tem lugar para até 25 pessoas e, por enquanto, só é usada no verão.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_AAD",
       "DOMOA_CAS"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P12",
      "factKey": "domo-a-F12",
      "text": "É a terceira estação chinesa na Antártida.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_AAD"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P13",
      "factKey": "domo-a-F13",
      "text": "Cientistas querem tirar dali cilindros de gelo de grande profundidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_AAD"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P14",
      "factKey": "domo-a-F14",
      "text": "Debaixo do gelo se esconde uma cordilheira inteira, com picos e vales.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_SCINEWS",
       "DOMOA_AGLAC"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P15",
      "factKey": "domo-a-F15",
      "text": "Essas montanhas enterradas têm pelo menos 750 km de comprimento.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_AGLAC"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P16",
      "factKey": "domo-a-F16",
      "text": "Os vales lá embaixo lembram os dos Alpes, cavados por antigas geleiras.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_SCINEWS"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P17",
      "factKey": "domo-a-F17",
      "text": "Talvez tenha sido ali que nasceu o grande manto de gelo da Antártida.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_SCINEWS",
       "DOMOA_AGLAC"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P18",
      "factKey": "domo-a-F18",
      "text": "Para astrônomos, é o melhor lugar da Terra para observar o céu com telescópios ópticos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_CAS"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P19",
      "factKey": "domo-a-F19",
      "text": "As estrelas ali “tremem” muito menos que nos melhores observatórios do Havaí e do Chile.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_CAS",
       "DOMOA_NATURE"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P20",
      "factKey": "domo-a-F20",
      "text": "Os aparelhos que mediram isso ficavam numa torre de só 8 m e trabalharam sozinhos o inverno todo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_CAS",
       "DOMOA_NATURE"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P21",
      "factKey": "domo-a-F21",
      "text": "As auroras quase sempre ficam baixas, perto do horizonte.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_RAA"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P22",
      "factKey": "domo-a-F22",
      "text": "Por ano, há cerca de um mês seguido de escuridão total.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_RAA"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P23",
      "factKey": "domo-a-F23",
      "text": "Fica numa área reivindicada pela Austrália, perto da divisa com a Terra da Rainha Maud.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_AAD",
       "DOMOA_SCARGAZ"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P24",
      "factKey": "domo-a-F24",
      "text": "O nome oficial remete ao mito grego de Jasão e dos Argonautas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_SCARGAZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-viajante-P25",
      "factKey": "domo-a-F25",
      "text": "No topo fica a estação chinesa Kunlun.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "DOMOA_AAD",
       "DOMOA_CAS"
      ],
      "clueType": "pesquisa",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "domo-a-geografo-P01",
      "factKey": "domo-a-F01",
      "text": "Culminação suave do manto de gelo, onde a superfície forma uma cúpula ampla e relativamente plana.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_SCINEWS",
       "DOMOA_SCARGAZ"
      ],
      "clueType": "relevo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P02",
      "factKey": "domo-a-F26",
      "text": "Situa-se no centro da Antártida Oriental, longe do litoral, no alto do planalto.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_AGLAC"
      ],
      "clueType": "localizacao",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P03",
      "factKey": "domo-a-F03",
      "text": "O gazetteer do SCAR a registra como a feição de gelo mais alta da Antártida, a ~4.090 m.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "DOMOA_SCARGAZ"
      ],
      "clueType": "relevo",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P04",
      "factKey": "domo-a-F05",
      "text": "As coordenadas variam pouco entre as fontes: ~80°21′–80°22′ S e ~77°21′–77°24′ L.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_SCARGAZ",
       "DOMOA_RAA"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P05",
      "factKey": "domo-a-F23",
      "text": "Fica no Território Antártico Australiano, perto do limite oeste com a Terra da Rainha Maud.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_SCARGAZ",
       "DOMOA_AAD"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P06",
      "factKey": "domo-a-F27",
      "text": "O relevo do gelo foi mapeado em detalhe por radioecossondagem do Scott Polar Research Institute; o nome foi aprovado em 1982.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "DOMOA_SCARGAZ"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P07",
      "factKey": "domo-a-F14",
      "text": "Sob a cúpula jaz uma cordilheira subglacial: os picos da crista central têm em média 1,5 a 2,5 km de altitude.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_AGLAC",
       "DOMOA_SCARGAZ"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P08",
      "factKey": "domo-a-F15",
      "text": "A cordilheira enterrada mede pelo menos 750 × 250 km; sem o peso do gelo, os picos teriam 2,5 a 3,5 km.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_AGLAC"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P09",
      "factKey": "domo-a-F28",
      "text": "O gelo vai de menos de 400 m sobre alguns picos a mais de 4,5 km no flanco norte da cordilheira.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_AGLAC"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P10",
      "factKey": "domo-a-F16",
      "text": "Vales de perfil quase semicircular e cabeceiras em paredão indicam erosão por geleiras de montanha, como nos Alpes.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_SCINEWS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P11",
      "factKey": "domo-a-F29",
      "text": "Os vales têm 20–25 km de largura e 100–200 km de comprimento, num desenho que lembra uma rede de drenagem fluvial.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_AGLAC"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P12",
      "factKey": "domo-a-F17",
      "text": "A cordilheira teria sido o berço do manto de gelo da Antártida Oriental, há mais de 34 milhões de anos.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "DOMOA_AGLAC",
