      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "domo-a-geografo-P19",
      "factKey": "domo-a-F19",
      "text": "Medições noturnas publicadas em 2020 deram seeing mediano de 0,31″ e mínimo de 0,13″, contra 0,6–0,8″ nos melhores sítios de latitude média.",
      "relatedFields": [
       "C1"
