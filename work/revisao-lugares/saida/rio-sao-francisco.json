    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "rio-sao-francisco-viajante-P01",
            "factKey": "rio-sao-francisco-F01",
            "text": "É um rio perene, que não seca nem na estiagem.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P02",
            "factKey": "rio-sao-francisco-F02",
            "text": "Nasce e deságua dentro do Brasil, depois de percorrer cerca de 2.700 km.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS",
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P03",
            "factKey": "rio-sao-francisco-F03",
            "text": "A nascente histórica fica num parque nacional mineiro, num chapadão a 1.428 m de altitude.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P04",
            "factKey": "rio-sao-francisco-F04",
            "text": "Deságua no oceano Atlântico, na divisa entre dois estados do Nordeste.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SF_IBGE_RETRATOS",
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P05",
            "factKey": "rio-sao-francisco-F05",
            "text": "Logo no começo do percurso, forma uma cachoeira com perto de 200 m de queda.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "CANASTRA_WIKI",
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P06",
            "factKey": "rio-sao-francisco-F06",
            "text": "Perto da foz, as margens têm mangues e dunas.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P07",
            "factKey": "rio-sao-francisco-F07",
            "text": "Ao longo do leito há grandes hidrelétricas, como Três Marias, Sobradinho e Xingó.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS",
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P08",
            "factKey": "rio-sao-francisco-F08",
            "text": "Do lado sergipano da foz fica o município de Brejo Grande, com cerca de 8 mil habitantes (estimativa de 2018).",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P09",
            "factKey": "rio-sao-francisco-F09",
            "text": "Nos barcos antigos, a proa levava carrancas, esculturas de madeira que surgiram por volta de 1880.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P10",
            "factKey": "rio-sao-francisco-F10",
            "text": "O carranqueiro mais famoso nasceu em 1884 em Santa Maria da Vitória, na Bahia, e fez cerca de oitenta peças.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P11",
            "factKey": "rio-sao-francisco-F11",
            "text": "Os indígenas o chamavam de Opará, o \"rio-mar\".",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P12",
            "factKey": "rio-sao-francisco-F12",
            "text": "Uma obra que leva sua água ao Nordeste Setentrional inclui um túnel de 15 km, apontado como o maior de transporte de água da América Latina.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_ANA_PISF"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P13",
            "factKey": "rio-sao-francisco-F13",
            "text": "Quase 14 milhões de pessoas viviam na sua bacia no Censo de 2010.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P14",
            "factKey": "rio-sao-francisco-F14",
            "text": "Em 2025, o governo federal autorizou estudos para reativar a navegação comercial de cargas no rio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_AGENCIAGOV_HIDROVIA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P15",
            "factKey": "rio-sao-francisco-F15",
            "text": "Em um trecho, o rio corre encaixado num cânion de cerca de 60 km.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P16",
            "factKey": "rio-sao-francisco-F16",
            "text": "O trecho navegável soma 1.371 km, entre Pirapora (MG), Juazeiro (BA) e Petrolina (PE).",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_AGENCIAGOV_HIDROVIA"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P17",
            "factKey": "rio-sao-francisco-F17",
            "text": "O Rio das Velhas e o Paraopeba estão entre os rios que deságuam nele.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P18",
            "factKey": "rio-sao-francisco-F18",
            "text": "O Rio Paracatu é outro de seus afluentes.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P19",
            "factKey": "rio-sao-francisco-F19",
            "text": "Em 1913, Delmiro Gouveia construiu às suas margens a usina de Angiquinho, que funcionou até 1960.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P20",
            "factKey": "rio-sao-francisco-F20",
            "text": "Entre 1852 e 1854, a mando de Dom Pedro II, o engenheiro Halfeld navegou o rio de Pirapora até a foz.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P21",
            "factKey": "rio-sao-francisco-F21",
            "text": "Parte de sua água é bombeada por canais que abastecem Pernambuco, Paraíba, Ceará e Rio Grande do Norte.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_ANA_PISF"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P22",
            "factKey": "rio-sao-francisco-F22",
            "text": "Oito espécies de peixes do rio estão ameaçadas de extinção.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P23",
            "factKey": "rio-sao-francisco-F23",
            "text": "Gesso, calcário, soja, milho e algodão estão entre as cargas previstas para os barcos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_AGENCIAGOV_HIDROVIA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P24",
            "factKey": "rio-sao-francisco-F24",
            "text": "Segundo o governo, um só comboio de barcaças pode substituir até 1,2 mil caminhões.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_AGENCIAGOV_HIDROVIA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-viajante-P25",
            "factKey": "rio-sao-francisco-F25",
            "text": "Junto à cachoeira de Paulo Afonso, na Bahia, funciona um conjunto de usinas hidrelétricas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "rio-sao-francisco-geografo-P01",
            "factKey": "rio-sao-francisco-F01",
            "text": "Rio perene de cerca de 2.700 km, cuja bacia drena em torno de 640 mil km², cerca de 8% do território nacional.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS",
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-geografo-P02",
            "factKey": "rio-sao-francisco-F02",
            "text": "Forma a maior bacia hidrográfica inteiramente brasileira, alimentada por 36 rios afluentes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_IBGE_RETRATOS",
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-geografo-P03",
            "factKey": "rio-sao-francisco-F03",
            "text": "Apesar da nascente histórica num chapadão de parque nacional, na prática o rio nasce ao longo de todo o divisor de águas da bacia.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-geografo-P04",
            "factKey": "rio-sao-francisco-F04",
            "text": "A bacia abrange Minas Gerais, Bahia, Pernambuco, Alagoas e Sergipe, além de pontas de Goiás e do Distrito Federal.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-geografo-P05",
            "factKey": "rio-sao-francisco-F05",
            "text": "O eixo fluvial faz a ligação estratégica entre o Sudeste e o Nordeste, numa bacia de 507 municípios.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-geografo-P06",
            "factKey": "rio-sao-francisco-F06",
            "text": "A divisão fisiográfica tem quatro trechos: o alto vai das cabeceiras a Pirapora, e o baixo começa na cachoeira de Paulo Afonso.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS",
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-geografo-P07",
            "factKey": "rio-sao-francisco-F07",
            "text": "O alto curso é o mais populoso, com cerca de 6,95 milhões de habitantes em 2010, contra 1,59 milhão no baixo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_IBGE_RETRATOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-geografo-P08",
            "factKey": "rio-sao-francisco-F08",
            "text": "A chuva cai de 1.000–1.500 mm por ano no alto curso para 350–800 mm no submédio, o trecho mais seco da bacia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-sao-francisco-geografo-P09",
            "factKey": "rio-sao-francisco-F09",
            "text": "Cerca de 60% da bacia está no Polígono das Secas, e a Caatinga ocupa perto de um quarto da área.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
