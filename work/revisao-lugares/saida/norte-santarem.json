       "C2"
      ],
      "sources": [
       "SANTAREM_DIARIO"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-santarem-viajante-P07",
      "factKey": "norte-santarem-F07",
      "text": "As duas águas seguem sem se misturar por cerca de 8 km.",
