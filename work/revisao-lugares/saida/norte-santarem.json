      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-santarem-viajante-P05",
      "factKey": "norte-santarem-F05",
      "text": "Bem em frente à cidade, dois rios de cores diferentes correm lado a lado.",
