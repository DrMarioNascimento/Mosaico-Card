      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-santarem-viajante-P08",
      "factKey": "norte-santarem-F08",
      "text": "Quem mergulha entre os dois rios sente água morna de um lado e fria do outro.",
