   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "norte-santarem-geografo-P01",
      "factKey": "norte-santarem-F01",
      "text": "O destino é um centro urbano amazônico da região Norte do Brasil.",
      "relatedFields": [
       "C1"
      ],
