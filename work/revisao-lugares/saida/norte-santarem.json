      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-santarem-viajante-P06",
      "factKey": "norte-santarem-F06",
      "text": "Um dos rios é azul-esverdeado e o outro tem cor de barro.",
