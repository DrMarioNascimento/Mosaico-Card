            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "nan-madol-viajante-P10",
            "factKey": "nan-madol-F10",
            "text": "Havia palácios, templos, construções funerárias e áreas de moradia.",
