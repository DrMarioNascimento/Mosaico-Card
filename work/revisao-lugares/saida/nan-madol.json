              "NANMADOL_UNESCO_DEC"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "nan-madol-viajante-P11",
            "factKey": "nan-madol-F11",
            "text": "A maior construção é um templo real de muros altos, com o túmulo dos grandes chefes.",
