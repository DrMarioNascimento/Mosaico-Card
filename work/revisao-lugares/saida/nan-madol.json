            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "nan-madol-viajante-P09",
            "factKey": "nan-madol-F09",
            "text": "Segundo a lenda, dois irmãos feiticeiros que viajavam de canoa construíram a cidade.",
