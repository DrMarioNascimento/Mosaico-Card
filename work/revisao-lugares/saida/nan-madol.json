            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "nan-madol-viajante-P02",
            "factKey": "nan-madol-F02",
            "text": "Fica no Pacífico, junto à costa de uma ilha.",
