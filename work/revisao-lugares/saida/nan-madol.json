        "label": "Viajante",
        "cards": [
          {
            "id": "nan-madol-viajante-P01",
            "factKey": "nan-madol-F01",
            "text": "Ruínas de pedra escura se erguem sobre ilhotas no meio de uma laguna tropical.",
