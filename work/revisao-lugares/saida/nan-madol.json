            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "nan-madol-viajante-P04",
            "factKey": "nan-madol-F04",
            "text": "As ilhotas foram feitas por gente, sobre um recife de coral raso.",
