            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "nan-madol-viajante-P07",
            "factKey": "nan-madol-F07",
            "text": "As pedras vieram de pedreiras do outro lado da ilha.",
