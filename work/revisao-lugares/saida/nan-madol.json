            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "nan-madol-viajante-P08",
            "factKey": "nan-madol-F08",
            "text": "Uma tradição oral diz que as pedras foram trazidas até ali por magia.",
