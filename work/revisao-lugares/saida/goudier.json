    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "goudier-viajante-P01",
            "factKey": "goudier-F01",
            "text": "É uma ilhota rochosa e baixa no litoral da Península Antártica.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS",
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P02",
            "factKey": "goudier-F02",
            "text": "Em volta há montanhas e geleiras, no encontro de três passagens marítimas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT",
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P03",
            "factKey": "goudier-F03",
            "text": "No começo da temporada, gelo preso à costa costuma cercar boa parte da ilha.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P04",
            "factKey": "goudier-F04",
            "text": "No verão a neve recua, e o chão pode ficar enlameado e escorregadio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P05",
            "factKey": "goudier-F05",
            "text": "A ilhota fica num porto abrigado junto à costa oeste de uma ilha maior.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "GOUDIER_ATS",
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P06",
            "factKey": "goudier-F06",
            "text": "A ilha maior vizinha se chama Wiencke.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P07",
            "factKey": "goudier-F07",
            "text": "O porto foi descoberto em 1904 pelo francês Jean-Baptiste Charcot.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P08",
            "factKey": "goudier-F08",
            "text": "O nome do porto homenageia Édouard Lockroy, político francês que ajudou a financiar a expedição.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P09",
            "factKey": "goudier-F09",
            "text": "No início do século XX, frotas baleeiras usavam o porto como ancoradouro seguro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P10",
            "factKey": "goudier-F10",
            "text": "O desembarque preferido fica ao lado das velhas correntes de amarração dos baleeiros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P11",
            "factKey": "goudier-F11",
            "text": "Uma antiga base britânica de 1944 virou museu, com loja e agência de correio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P12",
            "factKey": "goudier-F12",
            "text": "O \"correio dos pinguins\" local é apontado como o sítio mais visitado da Antártida.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_BAMT",
              "GOUDIER_UKAHT_FACES"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P13",
            "factKey": "goudier-F13",
            "text": "O sítio recebe até 18 mil visitantes por temporada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT",
              "GOUDIER_BAMT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P14",
            "factKey": "goudier-F14",
            "text": "O dinheiro da loja e do correio paga a manutenção do lugar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P15",
            "factKey": "goudier-F15",
            "text": "O maior prédio se chama Bransfield House.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT",
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P16",
            "factKey": "goudier-F16",
            "text": "Um galpão de barcos de 1957 também faz parte do conjunto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P17",
            "factKey": "goudier-F17",
            "text": "A equipe dorme numa réplica de cabana Nissen, montada em duas metades para não atrapalhar ninhos de pinguins.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES",
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P18",
            "factKey": "goudier-F18",
            "text": "Pinguins-gentoo fazem ninhos na ilha há mais de 30 anos.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES",
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P19",
            "factKey": "goudier-F19",
            "text": "A pomba-antártica também se reproduz na ilhota.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P20",
            "factKey": "goudier-F20",
            "text": "Gaivotas-dominicanas e skuas fazem ninho numa ilhota vizinha.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P21",
            "factKey": "goudier-F21",
            "text": "Focas-de-weddell costumam descansar nas pedras da ilha.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P22",
            "factKey": "goudier-F22",
            "text": "No máximo 60 visitantes podem estar na ilha ao mesmo tempo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P23",
            "factKey": "goudier-F23",
            "text": "Antes de entrar no museu, é preciso limpar as botas e tirar a neve.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P24",
            "factKey": "goudier-F24",
            "text": "O lado leste da ilha fica isolado por cordas, sem visitação.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-viajante-P25",
            "factKey": "goudier-F25",
            "text": "A operação que criou a base levou o nome de uma casa noturna de Paris.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "GOUDIER_BAMT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "goudier-geografo-P01",
            "factKey": "goudier-F01",
            "text": "No lado oeste da Península Antártica, o patrimônio de uma antiga base científica e uma colônia de pinguins dividem a mesma ilhota.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "GOUDIER_UKAHT",
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P02",
            "factKey": "goudier-F02",
            "text": "O local foi escolhido por oferecer ancoradouro seguro e uma área plana para erguer uma cabana.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P03",
            "factKey": "goudier-F03",
            "text": "As coordenadas aproximadas são 64°49' S e 63°29' O.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_ATS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P04",
            "factKey": "goudier-F04",
            "text": "Em 1944, gelo perigoso e falta de combustível fizeram a expedição desistir de Hope Bay e se instalar ali.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P05",
            "factKey": "goudier-F05",
            "text": "A base foi criada em 11 de fevereiro de 1944, numa missão secreta britânica do tempo da guerra.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "GOUDIER_UKAHT",
              "GOUDIER_BAMT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P06",
            "factKey": "goudier-F06",
            "text": "A missão buscava negar ancoradouros a navios corsários alemães e reforçar reivindicações territoriais britânicas.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "GOUDIER_BAMT",
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P07",
            "factKey": "goudier-F07",
            "text": "É a única base que sobrevive do primeiro ano da Operação Tabarin.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P08",
            "factKey": "goudier-F08",
            "text": "Em 1945, passou ao Falkland Islands Dependencies Survey, antecessor do British Antarctic Survey.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P09",
            "factKey": "goudier-F09",
            "text": "O trabalho científico principal era a pesquisa ionosférica, útil às comunicações por rádio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P10",
            "factKey": "goudier-F10",
            "text": "A primeira leitura ionosférica da Antártida foi feita ali em 9 de março de 1948.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P11",
            "factKey": "goudier-F11",
            "text": "Em 1957, registrou-se ali o primeiro \"whistler\", onda de rádio de baixa frequência gerada por raios.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "GOUDIER_UKAHT_FACES"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "goudier-geografo-P12",
            "factKey": "goudier-F12",
            "text": "A estação também era central de comunicações sem fio para bases mais ao sul.",
