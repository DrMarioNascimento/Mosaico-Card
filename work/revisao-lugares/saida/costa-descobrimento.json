       "C2"
      ],
      "sources": [
       "COSTA_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "costa-descobrimento-geografo-P10",
      "factKey": "costa-descobrimento-F10",
      "text": "Três reservas privadas, com quase 3 mil hectares, ampliaram a conexão entre dois componentes vizinhos.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "COSTA_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
