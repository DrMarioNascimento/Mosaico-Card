   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "costa-descobrimento-geografo-P01",
      "factKey": "costa-descobrimento-F01",
      "text": "É um bem natural seriado: várias unidades separadas, reconhecidas em conjunto.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "COSTA_IUCN",
       "COSTA_CNUC_UNA"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "costa-descobrimento-geografo-P02",
      "factKey": "costa-descobrimento-F02",
      "text": "Protege remanescentes de uma das regiões florestais mais fragmentadas e degradadas do planeta.",
