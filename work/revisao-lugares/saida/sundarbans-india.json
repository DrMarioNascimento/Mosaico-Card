    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "sundarbans-india-viajante-P01",
            "factKey": "sundarbans-india-F01",
            "text": "Este destino é uma floresta costeira inundada pelas marés, no sul da Ásia.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P02",
            "factKey": "sundarbans-india-F02",
            "text": "Por dentro da área protegida, só se circula de barco ou lancha.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SUND_WBFD"
            ],
            "clueType": "turismo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P03",
            "factKey": "sundarbans-india-F03",
            "text": "O parque fica na Índia, no extremo sul do estado de Bengala Ocidental.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_STR2022"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P04",
            "factKey": "sundarbans-india-F04",
            "text": "Ao sul, a área termina na Baía de Bengala.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_STR2022",
              "SUND_WBFD"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P05",
            "factKey": "sundarbans-india-F05",
            "text": "As marés não param de redesenhar ilhas, canais e margens.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P06",
            "factKey": "sundarbans-india-F06",
            "text": "A paisagem faz parte de um delta formado pelos rios Ganges e Brahmaputra.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P07",
            "factKey": "sundarbans-india-F07",
            "text": "A região tem 102 ilhas: 54 habitadas e 48 cobertas de floresta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P08",
            "factKey": "sundarbans-india-F08",
            "text": "O terreno é muito baixo: fica, em média, a uns 7 metros acima do nível do mar.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P09",
            "factKey": "sundarbans-india-F09",
            "text": "Esse delta abriga a maior floresta contínua de mangue do mundo.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P10",
            "factKey": "sundarbans-india-F10",
            "text": "Os tigres daqui nadam muito bem e se adaptaram à água salgada.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SUND_WBFD"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P11",
            "factKey": "sundarbans-india-F11",
            "text": "O parque é o núcleo de uma reserva de tigres criada em 1973.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_STR2022"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P12",
            "factKey": "sundarbans-india-F12",
            "text": "Crocodilos-de-água-salgada vivem nos rios e canais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_IUCN_WHO",
              "SUND_STR2022"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P13",
            "factKey": "sundarbans-india-F13",
            "text": "Golfinhos-do-ganges e golfinhos-do-irrawaddy nadam nessas águas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_IUCN_WHO",
              "SUND_STR2022"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P14",
            "factKey": "sundarbans-india-F14",
            "text": "O gato-pescador, um felino ameaçado, também vive no manguezal.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_IUCN_WHO",
              "SUND_STR2022"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P15",
            "factKey": "sundarbans-india-F15",
            "text": "Tantas espécies de martim-pescador vivem ali que a região é chamada de paraíso dessas aves.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_STR2022"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P16",
            "factKey": "sundarbans-india-F16",
            "text": "A tartaruga-oliva está entre as tartarugas marinhas que desovam na área.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_STR2022",
              "SUND_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P17",
            "factKey": "sundarbans-india-F17",
            "text": "Hindus e muçulmanos veneram Bonbibi, a “senhora da floresta”, que protege contra os tigres.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_IUCN_WHO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P18",
            "factKey": "sundarbans-india-F18",
            "text": "Em abril e maio, coletores de mel entram na mata com licença do governo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_STR2022",
              "SUND_WBFD"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P19",
            "factKey": "sundarbans-india-F19",
            "text": "Muitos moradores vivem da pesca e da coleta de filhotes de camarão.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_WBFD"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P20",
            "factKey": "sundarbans-india-F20",
            "text": "Chove cerca de 1.900 mm por ano, e a melhor época para visitar vai de outubro a fevereiro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_WBFD"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P21",
            "factKey": "sundarbans-india-F21",
            "text": "Ciclones como o Aila (2009) e o Amphan (2020) castigaram a região.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P22",
            "factKey": "sundarbans-india-F22",
            "text": "Cercas de rede de náilon ajudam a impedir que tigres entrem nas aldeias.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SUND_IUCN_WHO",
              "SUND_STR2022"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P23",
            "factKey": "sundarbans-india-F23",
            "text": "A UNESCO reconheceu o parque como Patrimônio Mundial em 1987.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_IUCN_WHO",
              "SUND_WBFD"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P24",
            "factKey": "sundarbans-india-F24",
            "text": "Torres de observação como Sajnekhali, Sudhanyakhali e Dobanki recebem os visitantes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_STR2022"
            ],
            "clueType": "turismo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-viajante-P25",
            "factKey": "sundarbans-india-F25",
            "text": "Do outro lado do rio Raimangal, a leste, a mesma floresta continua em Bangladesh.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_IUCN_WHO"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "sundarbans-india-geografo-P01",
            "factKey": "sundarbans-india-F01",
            "text": "A unidade protege um ecossistema costeiro de manguezal no delta de grandes rios do sul da Ásia.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P02",
            "factKey": "sundarbans-india-F02",
            "text": "A ação das marés remodela a paisagem: a erosão predomina nos estuários e a deposição, nas margens.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P03",
            "factKey": "sundarbans-india-F03",
            "text": "Inundação pelas marés, assoreamento, colonização por plantas e formação do delta são processos em curso.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P04",
            "factKey": "sundarbans-india-F04",
            "text": "Ocupa o extremo sul do baixo delta do Ganges, entre o rio Matla, a oeste, e a fronteira com Bangladesh, a leste.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_STR2022",
              "SUND_WBFD"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P05",
            "factKey": "sundarbans-india-F05",
            "text": "O conjunto de mangue soma cerca de 10 mil km² de terra e água, mais da metade na Índia e o restante em Bangladesh.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P06",
            "factKey": "sundarbans-india-F06",
            "text": "O parque nacional, de 1.330 km², é o núcleo de uma reserva de tigres de cerca de 2.585 km².",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SUND_WBFD",
              "SUND_STR2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P07",
            "factKey": "sundarbans-india-F07",
            "text": "As árvores do mangue retêm sedimentos e matéria orgânica, estabilizando o solo do delta.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P08",
            "factKey": "sundarbans-india-F08",
            "text": "Na parte indiana, 21.025 ha de terras se perderam entre 1969 e 2009; nas ilhas, a erosão supera a acreção.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P09",
            "factKey": "sundarbans-india-F09",
            "text": "Com altitude média de cerca de 7 m, o delta é muito vulnerável à subida do nível do mar.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SUND_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
