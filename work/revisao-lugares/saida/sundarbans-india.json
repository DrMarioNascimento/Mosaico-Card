            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P14",
            "factKey": "sundarbans-india-F14",
            "text": "Ciclones e rompimentos de diques deslocam tigres, que acabam entrando nas aldeias em busca de comida.",
