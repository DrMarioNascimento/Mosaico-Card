            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sundarbans-india-geografo-P13",
            "factKey": "sundarbans-india-F13",
            "text": "O conflito entre pessoas e tigres se concentra nas áreas de amortecimento e nas bordas do núcleo.",
