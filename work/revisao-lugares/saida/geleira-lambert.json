  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "geleira-lambert-viajante-P01",
      "factKey": "geleira-lambert-F01",
      "text": "Um imenso rio de gelo desce do planalto antártico rumo ao mar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "LAMBERT_SCAR_GAZ"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P02",
      "factKey": "geleira-lambert-F02",
      "text": "Fica na parte leste da Antártida, num setor reivindicado pela Austrália.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "LAMBERT_GUINNESS",
       "LAMBERT_NASA_AMERY"
      ],
      "clueType": "localizacao",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P03",
      "factKey": "geleira-lambert-F12",
      "text": "Pelas contas do Serviço Geológico dos EUA, ela tem uns 435 km de comprimento.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "LAMBERT_LIVESCIENCE"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P04",
      "factKey": "geleira-lambert-F11",
      "text": "No ponto mais largo, passa de 96 km de uma margem à outra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "LAMBERT_LIVESCIENCE"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P05",
      "factKey": "geleira-lambert-F13",
      "text": "No meio dela, o gelo chega a 2.500 m de espessura.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "LAMBERT_LIVESCIENCE"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P06",
      "factKey": "geleira-lambert-F14",
      "text": "O gelo avança de 400 a 800 m por ano.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "LAMBERT_LIVESCIENCE"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P07",
      "factKey": "geleira-lambert-F06",
      "text": "Vários braços de gelo se juntam antes de chegar à costa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "LAMBERT_GUINNESS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P08",
      "factKey": "geleira-lambert-F27",
      "text": "Perto do litoral, o gelo começa a flutuar e forma uma enorme plataforma.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "LAMBERT_GUINNESS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P09",
      "factKey": "geleira-lambert-F07",
      "text": "Essa plataforma flutuante cobre cerca de 69 mil km².",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "LAMBERT_GUINNESS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P10",
      "factKey": "geleira-lambert-F17",
      "text": "A plataforma ocupa o fundo de uma grande reentrância do litoral, formada por duas baías.",
