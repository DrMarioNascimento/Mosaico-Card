      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P15",
      "factKey": "geleira-lambert-F15",
      "text": "O gelo corre num vale entre uma cordilheira e uma grande escarpa.",
