      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P17",
      "factKey": "geleira-lambert-F16",
      "text": "Em 1960, já era descrita como uma das maiores geleiras de vale do mundo.",
