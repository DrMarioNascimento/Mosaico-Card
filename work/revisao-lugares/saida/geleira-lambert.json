      "sources": [
       "LAMBERT_NASA_AMERY"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P14",
      "factKey": "geleira-lambert-F22",
      "text": "Todo ano, riachos de água de degelo correm sobre a plataforma.",
