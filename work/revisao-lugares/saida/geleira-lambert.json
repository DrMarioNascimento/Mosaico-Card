      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P16",
      "factKey": "geleira-lambert-F24",
      "text": "As montanhas ficam a oeste do vale, ao sul da plataforma de gelo.",
