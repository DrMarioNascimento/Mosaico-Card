       "C2"
      ],
      "sources": [
       "LAMBERT_NASA_AMERY"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P12",
      "factKey": "geleira-lambert-F20",
      "text": "Rachaduras enormes cortam a plataforma, e um iceberg gigante apelidado de “dente mole” vem se soltando há anos.",
