     },
     {
      "id": "geleira-lambert-geografo-P22",
      "factKey": "geleira-lambert-F04",
      "text": "O topônimo australiano homenageia o então diretor do Mapeamento Nacional do Departamento de Desenvolvimento Nacional.",
      "relatedFields": [
