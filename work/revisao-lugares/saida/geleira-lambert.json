       "C2"
      ],
      "sources": [
       "LAMBERT_POLARRECORD"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P11",
      "factKey": "geleira-lambert-F19",
      "text": "A plataforma é bem menor que as gigantes de Ross e Filchner-Ronne.",
