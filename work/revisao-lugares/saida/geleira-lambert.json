      ],
      "sources": [
       "LAMBERT_NASA_AMERY"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P13",
      "factKey": "geleira-lambert-F21",
      "text": "No começo dos anos 1960, a plataforma soltou uma ilha de gelo de uns 140 por 70 km.",
