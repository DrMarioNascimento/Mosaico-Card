      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-lambert-viajante-P18",
      "factKey": "geleira-lambert-F28",
      "text": "Medições soviéticas sugeriram que ela é bem mais longa que a Geleira Beardmore.",
