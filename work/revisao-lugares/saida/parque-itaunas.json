  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "parque-itaunas-viajante-P01",
      "factKey": "parque-itaunas-F01",
      "text": "É uma área protegida no litoral, com praias, dunas e mata de restinga.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_ESGOV"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P02",
      "factKey": "parque-itaunas-F02",
      "text": "Além das dunas, a área protege rios, terrenos alagados, plantas e animais.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_DECRETO"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P03",
      "factKey": "parque-itaunas-F03",
      "text": "É a unidade de conservação mais visitada do seu estado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_ESGOV"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P04",
      "factKey": "parque-itaunas-F04",
      "text": "Mais de 100 mil turistas passam por ali a cada ano (dado de 2023).",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_ESGOV"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P05",
      "factKey": "parque-itaunas-F05",
      "text": "A praia do parque tem mais de 25 km de extensão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P06",
      "factKey": "parque-itaunas-F06",
      "text": "As dunas passam de 30 metros de altura.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P07",
      "factKey": "parque-itaunas-F07",
      "text": "Uma antiga vila com cerca de 300 casas foi aos poucos coberta pela areia.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_ESGOV",
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P08",
      "factKey": "parque-itaunas-F08",
      "text": "A vila tinha duas ruas, duas padarias, correio e escola antes de sumir sob as dunas.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P09",
      "factKey": "parque-itaunas-F09",
      "text": "A vila antiga ficava entre o mar e o rio, no caminho de um vento forte que vem do nordeste.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P10",
      "factKey": "parque-itaunas-F10",
      "text": "As últimas famílias saíram da vila antiga entre o fim dos anos 1960 e o começo dos anos 1970.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P11",
      "factKey": "parque-itaunas-F11",
      "text": "Às vezes ainda aparece na areia parte do mastro da antiga igreja.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P12",
      "factKey": "parque-itaunas-F12",
      "text": "A igreja de São Sebastião foi reconstruída na vila nova.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P13",
      "factKey": "parque-itaunas-F13",
      "text": "A vila nova, a cerca de 1 km da antiga, virou sede de distrito.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P14",
      "factKey": "parque-itaunas-F14",
      "text": "A explicação oficial para o soterramento é o desmatamento da restinga, que segurava a areia.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P15",
      "factKey": "parque-itaunas-F15",
      "text": "Antigos moradores contestam essa versão, e há até a lenda de uma praga de padre.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P16",
      "factKey": "parque-itaunas-F16",
      "text": "Na maré baixa, rochas escuras de arenito aparecem na praia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P17",
      "factKey": "parque-itaunas-F17",
      "text": "Tartarugas marinhas são acompanhadas por um projeto de conservação na região.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_DECRETO",
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P18",
      "factKey": "parque-itaunas-F18",
      "text": "O parque começa na divisa com a Bahia, na foz de um riacho.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ITAUNAS_DECRETO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P19",
      "factKey": "parque-itaunas-F19",
      "text": "Uma trilha de longo curso do parque faz parte da Rede Brasileira de Trilhas.",
