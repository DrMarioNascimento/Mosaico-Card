   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "parque-itaunas-geografo-P01",
      "factKey": "parque-itaunas-F01",
      "text": "Unidade de conservação estadual costeira, criada para proteger dunas, rios, áreas úmidas, flora e fauna.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_DECRETO"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P02",
      "factKey": "parque-itaunas-F02",
      "text": "O mosaico litorâneo combina praias, campos de dunas e floresta de restinga.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_ESGOV"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P03",
      "factKey": "parque-itaunas-F03",
      "text": "A antiga vila ocupava a faixa entre o mar e o rio, na rota do forte vento nordeste.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P04",
      "factKey": "parque-itaunas-F04",
      "text": "A versão oficial liga o soterramento ao desmatamento da restinga, vegetação que estabiliza as areias.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P05",
      "factKey": "parque-itaunas-F05",
      "text": "Outras hipóteses citam a abertura de áreas para lavouras anuais e o corte de árvores para lenha.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P06",
      "factKey": "parque-itaunas-F06",
      "text": "Medições indicam deslocamento das areias de cerca de 5 metros por ano.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P07",
      "factKey": "parque-itaunas-F07",
      "text": "Por volta de 2012, o órgão ambiental estadual replantou espécies nativas nas dunas para evitar novo soterramento.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P08",
      "factKey": "parque-itaunas-F08",
      "text": "O governo comprou uma propriedade rural na margem sul do rio para reassentar a população, e a vila nova surgiu em 1958.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P09",
      "factKey": "parque-itaunas-F09",
      "text": "O abandono foi gradual: o último registro de saída de família da vila antiga é de 1972.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-geografo-P10",
      "factKey": "parque-itaunas-F10",
      "text": "A igreja foi a segunda construção alcançada pela areia; parte de seu mastro ainda reaparece às vezes.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
