       "C1"
      ],
      "sources": [
       "ITAUNAS_ESGOV"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P20",
      "factKey": "parque-itaunas-F20",
      "text": "Em julho, a vila ao lado do parque recebe um festival nacional de forró.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_ESGOV"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P21",
      "factKey": "parque-itaunas-F21",
      "text": "Em janeiro, a festa de São Sebastião e São Benedito reúne Ticumbi, Alardo, Jongo e Reis de Bois.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITAUNAS_ESGOV"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P22",
      "factKey": "parque-itaunas-F22",
      "text": "O parque fica no litoral norte do Espírito Santo.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ITAUNAS_GAZETA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itaunas-viajante-P23",
      "factKey": "parque-itaunas-F23",
      "text": "O parque fica no município de Conceição da Barra.",
