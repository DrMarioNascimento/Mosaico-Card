          },
          {
            "id": "cidade-velha-lamu-viajante-P20",
            "factKey": "cidade-velha-lamu-F20",
            "text": "Uma das joias do museu é a siwa de marfim de Pate, ligada ao governo suaíli.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK_MUSEU"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P21",
            "factKey": "cidade-velha-lamu-F21",
            "text": "Os manguezais da ilha vizinha de Manda fazem parte da área protegida em volta da cidade.",
