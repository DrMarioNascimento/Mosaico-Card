        "cards": [
          {
            "id": "cidade-velha-lamu-viajante-P01",
            "factKey": "cidade-velha-lamu-F01",
            "text": "É uma cidade antiga à beira do oceano Índico, de ruas estreitas e casas de pedra.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_EB",
              "LAMU_NMK"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P02",
            "factKey": "cidade-velha-lamu-F02",
            "text": "É vista como um dos exemplos mais bem preservados da cultura suaíli na África Oriental.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_EB"
            ],
            "clueType": "cultura",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P03",
            "factKey": "cidade-velha-lamu-F03",
            "text": "Fica numa ilha, perto da costa da África Oriental.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_EB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P04",
            "factKey": "cidade-velha-lamu-F04",
            "text": "As ruas estreitas e sinuosas formam um labirinto, dividido em pequenos bairros chamados mitaa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P05",
            "factKey": "cidade-velha-lamu-F05",
            "text": "As casas são de pedra de coral, com telhados sobre troncos de mangue e argamassa de cal.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_EB",
              "LAMU_NMK"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P06",
            "factKey": "cidade-velha-lamu-F06",
            "text": "Por dentro, as casas têm nichos decorativos nas paredes, tetos pintados e porcelana chinesa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK",
              "LAMU_UNESCO_NOMINACAO"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P07",
            "factKey": "cidade-velha-lamu-F07",
            "text": "As portas de madeira, entalhadas com capricho, são uma marca da cidade; o museu local tem uma galeria só delas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_EB",
              "LAMU_UNESCO_NOMINACAO",
              "LAMU_NMK_MUSEU"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P08",
            "factKey": "cidade-velha-lamu-F08",
            "text": "Vista do mar, a orla tem prédios com arcadas e varandas abertas que deixam a paisagem uniforme.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P09",
            "factKey": "cidade-velha-lamu-F09",
            "text": "A arquitetura mistura estilos suaíli, árabe, persa, indiano e europeu.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK",
              "LAMU_ZAMANI"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P10",
            "factKey": "cidade-velha-lamu-F10",
            "text": "O centro histórico de pedra é pequeno: cerca de 16 hectares.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK",
              "LAMU_UNESCO_NOMINACAO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P11",
            "factKey": "cidade-velha-lamu-F11",
            "text": "É a cidade mais antiga do seu tipo ainda existente no país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_EB"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P12",
            "factKey": "cidade-velha-lamu-F12",
            "text": "Até o fim do século XIX, disputava com Mombaça o comércio de ouro, especiarias e pessoas escravizadas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_EB"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P13",
            "factKey": "cidade-velha-lamu-F13",
            "text": "Os portugueses invadiram a cidade em 1506.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_UNESCO_NOMINACAO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P14",
            "factKey": "cidade-velha-lamu-F14",
            "text": "Depois que os portugueses foram expulsos, em 1698, veio o domínio de Omã.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_UNESCO_NOMINACAO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P15",
            "factKey": "cidade-velha-lamu-F15",
            "text": "Um forte erguido por omanis entre 1813 e 1821 fica no canto sul da cidade de pedra.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_ZAMANI",
              "LAMU_UNESCO_NOMINACAO"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P16",
            "factKey": "cidade-velha-lamu-F16",
            "text": "Esse forte foi prisão de 1910 a 1984 e hoje recebe casamentos, reuniões e teatro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK_MUSEU",
              "LAMU_UNESCO_NOMINACAO",
              "LAMU_ZAMANI"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P17",
            "factKey": "cidade-velha-lamu-F17",
            "text": "Todo ano, a festa do Maulidi atrai muçulmanos da África Oriental e Central, do Norte da África e do Golfo.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "LAMU_UNESCO_NOMINACAO",
              "LAMU_NMK"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P18",
            "factKey": "cidade-velha-lamu-F18",
            "text": "A cidade é um centro de estudo da cultura islâmica e suaíli e tem uma faculdade islâmica.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK",
              "LAMU_UNESCO_NOMINACAO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-viajante-P19",
            "factKey": "cidade-velha-lamu-F19",
            "text": "O museu principal ocupa um casarão do começo do século XX e mostra objetos dos povos suaíli, boni, sanye, pokomo e orma.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "LAMU_NMK_MUSEU"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
