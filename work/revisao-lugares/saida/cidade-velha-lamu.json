              "LAMU_NMK"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-geografo-P15",
            "factKey": "cidade-velha-lamu-F17",
            "text": "O alcance do festival anual do Maulidi ultrapassa a costa suaíli: chegam fiéis do Norte da África e do Golfo.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "LAMU_UNESCO_NOMINACAO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-geografo-P16",
            "factKey": "cidade-velha-lamu-F32",
            "text": "Inscrita no Patrimônio Mundial em 2001 pelos critérios (ii), (iv) e (vi), é descrita como berço da civilização suaíli.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
