              "LAMU_EB"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-geografo-P17",
            "factKey": "cidade-velha-lamu-F21",
            "text": "A zona de proteção definida na inscrição, de cerca de 3 por 4 km, incluía os manguezais da ilha vizinha de Manda.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
