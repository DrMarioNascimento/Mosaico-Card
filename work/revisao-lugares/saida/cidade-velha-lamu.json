            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-velha-lamu-geografo-P19",
            "factKey": "cidade-velha-lamu-F23",
            "text": "O corredor de transporte LAPSSET, que liga o porto local ao Sudão do Sul e à Etiópia, tinha em 2021 os três primeiros berços do porto em obras.",
            "relatedFields": [
              "C1"
