              "ARRAIAL_EM",
              "ARRAIAL_IEAPM_SAVI"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "arraial-do-cabo-viajante-P07",
            "factKey": "arraial-do-cabo-F07",
            "text": "A cidade fica a só 12 km de Cabo Frio.",
