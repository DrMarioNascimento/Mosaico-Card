            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "arraial-do-cabo-viajante-P03",
            "factKey": "arraial-do-cabo-F03",
            "text": "Mesmo no verão, a água pode cair a 14 °C, e quem mergulha precisa de roupa de neoprene.",
