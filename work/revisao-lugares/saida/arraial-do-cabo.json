        "cards": [
          {
            "id": "arraial-do-cabo-viajante-P01",
            "factKey": "arraial-do-cabo-F01",
            "text": "É uma cidade de praia no litoral do Sudeste, famosa pelo mar de azul intenso e pela água muito transparente.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ARRAIAL_TUPI",
