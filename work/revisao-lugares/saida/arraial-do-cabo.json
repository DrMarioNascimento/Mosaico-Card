              "ARRAIAL_IEAPM_REVISTA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "arraial-do-cabo-viajante-P05",
            "factKey": "arraial-do-cabo-F05",
            "text": "É chamada de capital do mergulho, e a melhor época para mergulhar vai de abril a outubro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ARRAIAL_TUPI",
              "ARRAIAL_EM"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "arraial-do-cabo-viajante-P06",
            "factKey": "arraial-do-cabo-F06",
            "text": "Fica a cerca de 165 km do Rio de Janeiro, umas 2h30 de carro.",
