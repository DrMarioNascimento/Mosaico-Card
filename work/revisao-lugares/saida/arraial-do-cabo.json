            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "arraial-do-cabo-geografo-P21",
            "factKey": "arraial-do-cabo-F44",
            "text": "Os primeiros grupos humanos chegaram há cerca de 5 mil anos: nômades que viviam no alto dos morros e desciam para pescar e coletar moluscos.",
