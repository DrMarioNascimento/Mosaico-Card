            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "arraial-do-cabo-viajante-P08",
            "factKey": "arraial-do-cabo-F08",
            "text": "O passeio de barco clássico dura cerca de quatro horas, com paradas nas principais enseadas.",
