            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "arraial-do-cabo-viajante-P02",
            "factKey": "arraial-do-cabo-F02",
            "text": "Por causa da cor do mar, ganhou o apelido de Caribe brasileiro.",
