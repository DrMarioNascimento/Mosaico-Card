      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P18",
      "factKey": "montes-transantarticos-F30",
      "text": "Das quatro grandes geleiras de descarga estudadas em 2011 — David, Mulock, Byrd e Nimrod —, só a David não despeja gelo na Plataforma Ross.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
