      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P19",
      "factKey": "montes-transantarticos-F24",
      "text": "O relevo íngreme canaliza o manto em rios de gelo rápidos: uma corrente de ~160 km, com leito rochoso, num vale de ~24 km de largura.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "TRANSANT_NASA_BYRD"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P20",
      "factKey": "montes-transantarticos-F15",
      "text": "Essa corrente é a que mais fornece gelo à Plataforma Ross, deslocando-se cerca de 800 m por ano.",
      "relatedFields": [
