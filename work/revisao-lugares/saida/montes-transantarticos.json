      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P16",
      "factKey": "montes-transantarticos-F11",
      "text": "O registro fóssil inclui anfíbios e répteis primitivos de água doce.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P17",
      "factKey": "montes-transantarticos-F13",
      "text": "Geleiras de descarga que cruzam a cordilheira são vias importantes de drenagem do manto de gelo da Antártida Oriental.",
