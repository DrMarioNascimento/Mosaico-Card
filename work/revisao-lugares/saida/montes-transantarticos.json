  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "montes-transantarticos-viajante-P01",
      "factKey": "montes-transantarticos-F01",
      "text": "Este destino é um conjunto enorme de montanhas, em boa parte coberto de gelo e de grandes geleiras.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P02",
      "factKey": "montes-transantarticos-F02",
      "text": "É uma cordilheira que corta o continente gelado de ponta a ponta.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "TRANSANT_EARTHDATE",
       "TRANSANT_AAJ"
      ],
      "clueType": "relevo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P03",
      "factKey": "montes-transantarticos-F03",
      "text": "Tem mais de 3 mil km de comprimento: é uma das cordilheiras mais longas da Terra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT",
       "TRANSANT_EARTHDATE",
       "TRANSANT_AAJ"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P04",
      "factKey": "montes-transantarticos-F04",
      "text": "Divide o continente em duas partes: uma a leste, maior, e outra a oeste, menor.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "TRANSANT_EARTHDATE",
       "TRANSANT_BRIT"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P05",
      "factKey": "montes-transantarticos-F05",
      "text": "Começa no norte da Terra de Vitória e vai até as margens do Mar de Weddell.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT",
       "TRANSANT_AAJ"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P06",
      "factKey": "montes-transantarticos-F06",
      "text": "O pico mais alto chega a 4.528 m.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "TRANSANT_BRIT",
       "TRANSANT_EARTHDATE",
       "TRANSANT_AAJ"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P07",
      "factKey": "montes-transantarticos-F07",
      "text": "Esse pico mais alto fica de frente para a borda da enorme Plataforma de Gelo Ross.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "TRANSANT_EARTHDATE"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P08",
      "factKey": "montes-transantarticos-F08",
      "text": "Em vários trechos aparecem grandes paredões de arenito amarelado, formado por antigos rios.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_SWISSEDUC"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P09",
      "factKey": "montes-transantarticos-F09",
      "text": "Uma rocha magmática que forma penhascos atravessa esses arenitos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_SWISSEDUC",
       "TRANSANT_USGS"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P10",
      "factKey": "montes-transantarticos-F10",
      "text": "Debaixo dessas montanhas há muito carvão, talvez uma das maiores reservas do mundo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P11",
      "factKey": "montes-transantarticos-F11",
      "text": "Ali já acharam fósseis de anfíbios e répteis primitivos de água doce.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P12",
      "factKey": "montes-transantarticos-F12",
      "text": "A história dessas montanhas está ligada à quebra de um antigo supercontinente do sul.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_EARTHDATE"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P13",
      "factKey": "montes-transantarticos-F13",
      "text": "Do alto do planalto, grandes geleiras descem por vales entre os picos, como rios de gelo.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "TRANSANT_STEARNS",
       "TRANSANT_NASA_BYRD"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P14",
      "factKey": "montes-transantarticos-F14",
      "text": "Uma dessas geleiras corre num vale de uns 24 km de largura.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "TRANSANT_NASA_BYRD"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P15",
      "factKey": "montes-transantarticos-F15",
      "text": "Essa geleira entrega à Plataforma Ross mais gelo do que qualquer outra.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "TRANSANT_NASA_BYRD"
      ],
      "clueType": "agua",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P16",
      "factKey": "montes-transantarticos-F16",
      "text": "O gelo dela avança uns 800 m por ano rumo à plataforma.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "TRANSANT_NASA_BYRD"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P17",
      "factKey": "montes-transantarticos-F17",
      "text": "De um lado fica a parte mais antiga do continente; do outro, terrenos geologicamente mais jovens.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "TRANSANT_EARTHDATE"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P18",
      "factKey": "montes-transantarticos-F18",
      "text": "Nas encostas aparecem rochas de quase todas as eras da história da Terra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_EARTHDATE"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P19",
      "factKey": "montes-transantarticos-F19",
      "text": "Reúne vários grupos de montanhas com nome próprio, como as Montanhas Rainha Maud e Shackleton.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P20",
      "factKey": "montes-transantarticos-F20",
      "text": "As Montanhas Pensacola, Horlick e Admiralty também fazem parte do conjunto.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P21",
      "factKey": "montes-transantarticos-F21",
      "text": "Os Estados Unidos já mantiveram estações de pesquisa ao pé dessas montanhas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P22",
      "factKey": "montes-transantarticos-F22",
      "text": "Montanhistas citam outro gigante da cordilheira, o Monte Markham, com 4.350 m.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "TRANSANT_AAJ"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P23",
      "factKey": "montes-transantarticos-F23",
      "text": "Ao contrário do Himalaia, ela não nasceu do choque entre placas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_USGS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P24",
      "factKey": "montes-transantarticos-F24",
      "text": "Uma das geleiras que a atravessam forma uma corrente de gelo de uns 160 km, com fundo de rocha.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "TRANSANT_NASA_BYRD"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-viajante-P25",
      "factKey": "montes-transantarticos-F25",
      "text": "O pico mais alto da cordilheira se chama Kirkpatrick.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "TRANSANT_BRIT",
       "TRANSANT_EARTHDATE",
       "TRANSANT_AAJ"
      ],
      "clueType": "relevo",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "montes-transantarticos-geografo-P01",
      "factKey": "montes-transantarticos-F01",
      "text": "Sistema montanhoso em grande parte recoberto por manto de gelo e por uma rede de grandes geleiras.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P02",
      "factKey": "montes-transantarticos-F03",
      "text": "Está entre os cinturões de montanhas mais longos da Terra, com mais de 3.000 km de extensão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_EARTHDATE",
       "TRANSANT_BRIT",
       "TRANSANT_AAJ"
      ],
      "clueType": "relevo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P03",
      "factKey": "montes-transantarticos-F04",
      "text": "Subdivide o continente numa região oriental, maior, e numa ocidental, menor.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "TRANSANT_BRIT",
       "TRANSANT_EARTHDATE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P04",
      "factKey": "montes-transantarticos-F17",
      "text": "Marca o limite entre o antigo núcleo cratônico do leste e os sistemas tectônicos mais jovens do oeste.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "TRANSANT_EARTHDATE"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P05",
      "factKey": "montes-transantarticos-F05",
      "text": "Estende-se da Costa Oates, no norte da Terra de Vitória, até a Terra de Edith Ronne, no setor do Mar de Weddell.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_AAJ",
       "TRANSANT_BRIT"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P06",
      "factKey": "montes-transantarticos-F23",
      "text": "É o maior cinturão montanhoso não compressional do mundo: não resulta do encurtamento da crosta por colisão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_USGS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P07",
      "factKey": "montes-transantarticos-F26",
      "text": "Topografia subglacial e gravimetria indicam soerguimento flexural da borda da Antártida Oriental, com espessura elástica de ~85 km.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_USGS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P08",
      "factKey": "montes-transantarticos-F27",
      "text": "Antes do soerguimento, essa borda do leste estaria a cerca de 700 m de altitude.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_USGS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P09",
      "factKey": "montes-transantarticos-F12",
      "text": "O relevo se liga ao rifte entre leste e oeste e à fragmentação do Gondwana; a idade do soerguimento varia entre os estudos.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "TRANSANT_EARTHDATE",
       "TRANSANT_USGS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P10",
      "factKey": "montes-transantarticos-F18",
      "text": "Os afloramentos expõem rochas do Pré-Cambriano ao Cenozoico.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_EARTHDATE"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P11",
      "factKey": "montes-transantarticos-F08",
      "text": "O Supergrupo Beacon aflora em falésias de arenito amarelado, depositado sobretudo por rios.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_SWISSEDUC"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P12",
      "factKey": "montes-transantarticos-F09",
      "text": "O dolerito Ferrar, formador de penhascos, intrude os estratos Beacon, como perto da Geleira Shackleton.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_SWISSEDUC"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P13",
      "factKey": "montes-transantarticos-F28",
      "text": "Os basaltos de inundação Ferrar continuam por pelo menos 100 km para oeste, por baixo do gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_USGS"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P14",
      "factKey": "montes-transantarticos-F29",
      "text": "Os sedimentos Beacon afinam gradualmente sob o gelo, num perfil parecido com o de bacias de antepaís.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_USGS"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P15",
      "factKey": "montes-transantarticos-F10",
      "text": "Abriga extensos depósitos de carvão, estimados entre as maiores reservas do mundo.",
      "relatedFields": [
