      "twoPlayerSuitable": true
     },
     {
      "id": "montes-transantarticos-geografo-P21",
      "factKey": "montes-transantarticos-F19",
      "text": "Entre as subdivisões estão as montanhas Rainha Maud, Shackleton, Pensacola, Horlick, Rainha Alexandra, Britannia, Príncipe Alberto, Dufek e Admiralty.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TRANSANT_BRIT"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
