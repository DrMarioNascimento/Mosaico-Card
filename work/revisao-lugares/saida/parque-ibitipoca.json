              "C1"
            ],
            "sources": [
              "IBITIPOCA_WIKI",
              "IBITIPOCA_UAI"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P15",
            "factKey": "parque-ibitipoca-F15",
            "text": "Nas trilhas, os guias mostram cactos que florescem à noite, canelas-de-ema e candeias.",
