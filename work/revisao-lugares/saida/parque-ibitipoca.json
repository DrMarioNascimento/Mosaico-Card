              "IBITIPOCA_MGBIOTA",
              "IBITIPOCA_SOCNAT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P04",
            "factKey": "parque-ibitipoca-F04",
            "text": "As grutas não são de calcário: elas se abrem numa rocha considerada rara para cavernas.",
