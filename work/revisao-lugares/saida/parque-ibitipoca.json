    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "parque-ibitipoca-viajante-P01",
            "factKey": "parque-ibitipoca-F01",
            "text": "É uma área protegida no alto de uma serra mineira, com trilhas, cachoeiras, grutas e mirantes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IBITIPOCA_WIKI",
              "IBITIPOCA_UAI"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P02",
            "factKey": "parque-ibitipoca-F02",
            "text": "A gerente diz que o parque é relativamente pequeno, mas tem uma concentração enorme de belezas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IBITIPOCA_AGMINAS"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P03",
            "factKey": "parque-ibitipoca-F03",
            "text": "A área protegida soma cerca de 1.488 hectares.",
