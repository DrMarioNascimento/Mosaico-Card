              "C1"
            ],
            "sources": [
              "IBITIPOCA_MGBIOTA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P19",
            "factKey": "parque-ibitipoca-F19",
            "text": "Em 2026, quatro muriquis-do-norte, o maior primata das Américas, foram levados de Peçanha para a região do parque.",
