              "C2"
            ],
            "sources": [
              "IBITIPOCA_UAI",
              "IBITIPOCA_SOCNAT"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P05",
            "factKey": "parque-ibitipoca-F05",
            "text": "Rios e poços têm água cor de chá, que vai do dourado ao marrom.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IBITIPOCA_UAI",
              "IBITIPOCA_WIKI"
            ],
            "clueType": "agua",
