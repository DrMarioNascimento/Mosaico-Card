              "C1"
            ],
            "sources": [
              "IBITIPOCA_UAI"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P20",
            "factKey": "parque-ibitipoca-F20",
            "text": "Recebe cerca de 90 mil visitantes por ano, e a entrada tem limite diário de pessoas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IBITIPOCA_AGMINAS",
              "IBITIPOCA_UAI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P21",
            "factKey": "parque-ibitipoca-F21",
            "text": "É apontado como a unidade de conservação mais visitada de Minas Gerais.",
