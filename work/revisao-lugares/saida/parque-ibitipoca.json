            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P06",
            "factKey": "parque-ibitipoca-F06",
            "text": "Guias e moradores falam de cachoeiras de águas acobreadas.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IBITIPOCA_TRIBUNA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P07",
            "factKey": "parque-ibitipoca-F07",
            "text": "Ao longo dos dois rios principais do parque aparecem pequenas praias de rio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IBITIPOCA_SOCNAT"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P08",
            "factKey": "parque-ibitipoca-F08",
            "text": "Uma das trilhas mais famosas leva à Janela do Céu, um mirante sobre uma cachoeira de várias quedas.",
