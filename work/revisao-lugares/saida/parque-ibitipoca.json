            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P13",
            "factKey": "parque-ibitipoca-F13",
            "text": "A Capela do Pião, erguida em 1930 num dos pontos mais altos, foi danificada por raios e hoje só resta o altar.",
