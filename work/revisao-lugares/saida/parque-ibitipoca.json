          },
          {
            "id": "parque-ibitipoca-viajante-P24",
            "factKey": "parque-ibitipoca-F24",
            "text": "Lima Duarte, na Zona da Mata mineira, é um dos seus municípios; Juiz de Fora é a cidade grande mais próxima.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IBITIPOCA_WIKI",
              "IBITIPOCA_MGBIOTA",
