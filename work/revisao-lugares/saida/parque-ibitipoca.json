            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P12",
            "factKey": "parque-ibitipoca-F12",
            "text": "O ponto mais alto, o Pico da Lombada, passa dos 1.700 m e tem vista de 360 graus.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IBITIPOCA_WIKI",
              "IBITIPOCA_UFRJ",
              "IBITIPOCA_SOCNAT"
            ],
            "clueType": "relevo",
