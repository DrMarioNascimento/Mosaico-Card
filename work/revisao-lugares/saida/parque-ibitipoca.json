              "C1"
            ],
            "sources": [
              "IBITIPOCA_AGMINAS"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P18",
            "factKey": "parque-ibitipoca-F18",
            "text": "Sauá, mico-estrela, barbado e macaco-prego vivem no parque e nas matas em volta.",
