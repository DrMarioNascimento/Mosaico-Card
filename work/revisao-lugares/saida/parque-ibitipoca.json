              "C1"
            ],
            "sources": [
              "IBITIPOCA_TRIBUNA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P14",
            "factKey": "parque-ibitipoca-F14",
            "text": "O verão é ameno e chuvoso, e o inverno, mais seco, é a época de maior movimento de turistas.",
