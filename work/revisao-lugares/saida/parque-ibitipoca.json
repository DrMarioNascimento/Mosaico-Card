            "sources": [
              "IBITIPOCA_AGMINAS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P16",
            "factKey": "parque-ibitipoca-F16",
            "text": "Orquídeas vermelhas que antes enfeitavam a Ponte de Pedra hoje são raras.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IBITIPOCA_TRIBUNA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P17",
            "factKey": "parque-ibitipoca-F17",
            "text": "Antigamente, moradores colhiam ali a macela para encher travesseiros.",
