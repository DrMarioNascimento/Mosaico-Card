              "C1",
              "C2"
            ],
            "sources": [
              "IBITIPOCA_SOCNAT",
              "IBITIPOCA_TRIBUNA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P11",
            "factKey": "parque-ibitipoca-F11",
            "text": "A Gruta dos Viajantes tem galerias que já serviram de abrigo a tropeiros.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "IBITIPOCA_UAI",
              "IBITIPOCA_SOCNAT"
            ],
            "clueType": "historia",
