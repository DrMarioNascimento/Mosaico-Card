      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "parque-ibitipoca-geografo-P01",
            "factKey": "parque-ibitipoca-F26",
            "text": "Protege o topo de uma serra que se ergue como relevo morfoestrutural no sudeste de Minas Gerais.",
