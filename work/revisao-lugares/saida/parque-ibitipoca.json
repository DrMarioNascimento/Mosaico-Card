              "C1"
            ],
            "sources": [
              "IBITIPOCA_AGMINAS",
              "IBITIPOCA_SOCNAT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P22",
            "factKey": "parque-ibitipoca-F22",
            "text": "Foi inaugurado em julho de 1973 e festejou 50 anos com um bolo de cinco metros.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "IBITIPOCA_AGMINAS",
              "IBITIPOCA_WIKI",
              "IBITIPOCA_TRIBUNA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P23",
            "factKey": "parque-ibitipoca-F23",
            "text": "No século XVIII, a extração de ouro num córrego local fez a região chegar a cerca de 7 mil habitantes.",
