              "C1"
            ],
            "sources": [
              "IBITIPOCA_UAI",
              "IBITIPOCA_WIKI"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P09",
            "factKey": "parque-ibitipoca-F09",
            "text": "Lago dos Espelhos, Cachoeira dos Macacos e Cachoeirinha estão entre os pontos de visita.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IBITIPOCA_WIKI",
              "IBITIPOCA_SOCNAT"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-ibitipoca-viajante-P10",
            "factKey": "parque-ibitipoca-F10",
            "text": "Numa formação chamada Ponte de Pedra, o rio passa por dentro da rocha.",
