      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P22",
      "factKey": "lago-vostok-F27",
      "text": "O anúncio do rompimento do gelo veio do Instituto de Pesquisa do Ártico e da Antártida, da Rússia.",
