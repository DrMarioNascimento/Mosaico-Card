  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "lago-vostok-viajante-P01",
      "factKey": "lago-vostok-F01",
      "text": "Este destino é um lago que ninguém vê: fica escondido debaixo do gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS",
       "VOSTOK_AMSCI"
      ],
      "clueType": "agua",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P02",
      "factKey": "lago-vostok-F02",
      "text": "Sob o gelo da Antártida existem centenas de lagos como este.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS",
       "VOSTOK_SNEXPLORES"
      ],
      "clueType": "agua",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P03",
      "factKey": "lago-vostok-F05",
      "text": "Tem uns 230 km de comprimento e até 50 km de largura.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS",
       "VOSTOK_AMSCI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P04",
      "factKey": "lago-vostok-F04",
      "text": "Sua área é de cerca de 14 mil km², umas 20 vezes a do Lago de Genebra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P05",
      "factKey": "lago-vostok-F06",
      "text": "Por uma estimativa, guarda quase tanta água quanto o Lago Michigan.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_SNEXPLORES"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P06",
      "factKey": "lago-vostok-F07",
      "text": "Em alguns pontos, a água tem cerca de 500 m de profundidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P07",
      "factKey": "lago-vostok-F08",
      "text": "Por cima dele há quase 4 km de gelo.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P08",
      "factKey": "lago-vostok-F09",
      "text": "Lá em cima, sobre o lago, o gelo forma uma planície muito lisa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P09",
      "factKey": "lago-vostok-F13",
      "text": "Na superfície do gelo, a temperatura fica em torno de –60 °C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P10",
      "factKey": "lago-vostok-F14",
      "text": "Mesmo um pouco abaixo de 0 °C, a água continua líquida por causa do peso do gelo.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P11",
      "factKey": "lago-vostok-F15",
      "text": "O lago está provavelmente isolado sob o gelo há pelo menos 15 milhões de anos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_SNEXPLORES",
       "VOSTOK_NATGEO"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P12",
      "factKey": "lago-vostok-F16",
      "text": "Fica sob uma região apelidada de “Polo do Frio”.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P13",
      "factKey": "lago-vostok-F17",
      "text": "Uma estação vizinha registrou –89,2 °C em 1983, a menor temperatura já medida na Terra.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "VOSTOK_WMO"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P14",
      "factKey": "lago-vostok-F27",
      "text": "Cientistas russos furaram o gelo a partir de uma estação ao lado do lago.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "VOSTOK_GUINNESS",
       "VOSTOK_NATGEO"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P15",
      "factKey": "lago-vostok-F10",
      "text": "Nos anos 1970, radares a bordo de aviões revelaram a água sob o gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P16",
      "factKey": "lago-vostok-F25",
      "text": "Em 1961, um piloto russo já tinha visto áreas planas no gelo e as chamou de “lagos”.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P17",
      "factKey": "lago-vostok-F11",
      "text": "A descoberta foi anunciada oficialmente em 1996.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P18",
      "factKey": "lago-vostok-F18",
      "text": "A broca alcançou a água em fevereiro de 2012, depois de mais de 20 anos de perfuração.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "pesquisa",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P19",
      "factKey": "lago-vostok-F19",
      "text": "Quando o furo chegou ao lago, a água subiu dezenas de metros pelo buraco e congelou.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P20",
      "factKey": "lago-vostok-F20",
      "text": "As primeiras amostras dessa água congelada saíram em janeiro de 2013.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "VOSTOK_GUINNESS",
       "VOSTOK_SNEXPLORES"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P21",
      "factKey": "lago-vostok-F22",
      "text": "Só dá para trabalhar ali no verão do sul, de novembro a fevereiro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_NATGEO"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P22",
      "factKey": "lago-vostok-F23",
      "text": "Cientistas esperam achar micróbios vivendo no escuro, em água muito pobre em nutrientes.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI",
       "VOSTOK_NATGEO"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P23",
      "factKey": "lago-vostok-F21",
      "text": "Para não sujar o lago, os últimos metros foram furados com água quente.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "VOSTOK_NATGEO"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P24",
      "factKey": "lago-vostok-F12",
      "text": "O lago ocupa uma fenda funda na crosta da Terra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_SNEXPLORES"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-viajante-P25",
      "factKey": "lago-vostok-F03",
      "text": "É o maior lago escondido sob o gelo que se conhece.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "agua",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "lago-vostok-geografo-P01",
      "factKey": "lago-vostok-F01",
      "text": "Um corpo de água líquida jaz na base do manto de gelo antártico, sem contato com a atmosfera.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS",
       "VOSTOK_AMSCI"
      ],
      "clueType": "agua",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P02",
      "factKey": "lago-vostok-F02",
      "text": "Integra uma rede de lagos subglaciais detectados por radar que penetra o gelo — quase 400 já conhecidos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS",
       "VOSTOK_SNEXPLORES"
      ],
      "clueType": "pesquisa",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P03",
      "factKey": "lago-vostok-F05",
      "text": "A bacia alongada mede ~230 km por até ~50 km.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS",
       "VOSTOK_AMSCI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P04",
      "factKey": "lago-vostok-F07",
      "text": "A lâmina d’água chega a ~500 m no sul e cai para ~10 m ou menos no extremo norte, segundo o radar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P05",
      "factKey": "lago-vostok-F08",
      "text": "O gelo tem ~3.700 m de espessura sobre a ponta sul e ~4.200 m sobre o lado norte.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P06",
      "factKey": "lago-vostok-F28",
      "text": "Apesar dessa diferença, a superfície é só ~50 m mais alta no norte: o gelo praticamente flutua sobre o lago.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P07",
      "factKey": "lago-vostok-F09",
      "text": "O atrito quase nulo entre gelo e água deixa a superfície plana, ao contrário do gelo que se arrasta sobre a rocha ao redor.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P08",
      "factKey": "lago-vostok-F29",
      "text": "No início dos anos 1990, a altimetria do satélite ERS-1 mapeou essa planície de gelo acima do lago.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P09",
      "factKey": "lago-vostok-F13",
      "text": "O calor do interior da Terra, absorvido na base do gelo, mantém a água líquida sob uma superfície a ~–60 °C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P10",
      "factKey": "lago-vostok-F14",
      "text": "A pressão na interface equivale ao peso de ~4 km de gelo, o que mantém a água líquida a poucos graus abaixo de zero.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "VOSTOK_AMSCI",
       "VOSTOK_GUINNESS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P11",
      "factKey": "lago-vostok-F12",
      "text": "É um lago de rifte, alojado numa fenda da crosta, talvez com fontes vulcânicas no fundo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_SNEXPLORES"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P12",
      "factKey": "lago-vostok-F06",
      "text": "O volume é comparável ao do Lago Michigan numa estimativa; outra, de 1999, falava em ~2.000 km³.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_SNEXPLORES",
       "VOSTOK_AMSCI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P13",
      "factKey": "lago-vostok-F03",
      "text": "Com ~14 mil km², detém o recorde de maior lago subglacial conhecido.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "agua",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P14",
      "factKey": "lago-vostok-F15",
      "text": "Provavelmente isolado há pelo menos 15 milhões de anos, o lago tem água com ao menos 700 mil anos e taxa de renovação desconhecida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_SNEXPLORES",
       "VOSTOK_AMSCI"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P15",
      "factKey": "lago-vostok-F16",
      "text": "Situa-se sob o chamado “Polo do Frio”, ao lado de uma estação de pesquisa russa.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "VOSTOK_GUINNESS"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P16",
      "factKey": "lago-vostok-F17",
      "text": "A estação meteorológica de altitude vizinha detém o recorde mundial de frio: –89,2 °C em 21 de julho de 1983.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "VOSTOK_WMO"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P17",
      "factKey": "lago-vostok-F25",
      "text": "Em 1961, um piloto russo descreveu áreas planas no gelo como “lagos”, possíveis sinais superficiais de água subglacial.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P18",
      "factKey": "lago-vostok-F26",
      "text": "Um levantamento sísmico de 1964 passou sobre o lago sem reconhecê-lo; o registro só foi reexaminado anos depois.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P19",
      "factKey": "lago-vostok-F10",
      "text": "Nos anos 1970, o radar aerotransportado do grupo de Gordon Robin revelou o grande corpo de água.",
      "relatedFields": [
