       "C4"
      ],
      "sources": [
       "VOSTOK_AMSCI"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lago-vostok-geografo-P21",
      "factKey": "lago-vostok-F18",
      "text": "A perfuração atingiu a superfície do lago em 5 de fevereiro de 2012, a ~3.768 m, após mais de 20 anos.",
      "relatedFields": [
