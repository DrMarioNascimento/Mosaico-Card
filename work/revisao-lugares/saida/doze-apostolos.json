    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "doze-apostolos-viajante-P01",
            "factKey": "doze-apostolos-F01",
            "text": "Este destino é um trecho de litoral selvagem, com falésias altas e mar bravo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_VHD"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P02",
            "factKey": "doze-apostolos-F02",
            "text": "O cenário é formado por pilares de rocha que se erguem do mar, junto da costa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_BRIT",
              "TWA_GORCAPA"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P03",
            "factKey": "doze-apostolos-F03",
            "text": "A cor das rochas muda ao longo do dia: dourado suave de manhã, laranja e vermelho no pôr do sol.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "TWA_GORCAPA"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P04",
            "factKey": "doze-apostolos-F04",
            "text": "O pôr do sol é um dos horários preferidos para fotografar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_BRIT",
              "TWA_GORCAPA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P05",
            "factKey": "doze-apostolos-F05",
            "text": "No meio do dia o lugar costuma lotar; para ver com mais calma, vá cedo ou no fim da tarde.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_GORCAPA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P06",
            "factKey": "doze-apostolos-F06",
            "text": "É preciso reservar para usar o centro de visitantes, o estacionamento e os mirantes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_GORCAPA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P07",
            "factKey": "doze-apostolos-F07",
            "text": "Uma caminhada curta leva da área de visitantes a mirantes varridos pelo vento.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_GORCAPA"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P08",
            "factKey": "doze-apostolos-F08",
            "text": "Ao entardecer, pequenos pinguins voltam para a praia lá embaixo e às vezes deixam pegadas na areia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_GORCAPA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P09",
            "factKey": "doze-apostolos-F09",
            "text": "O centro de visitantes daqui se chama Keerray Woorroong.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_GORCAPA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P10",
            "factKey": "doze-apostolos-F10",
            "text": "Fica a cerca de 275 km (170 milhas) a oeste de Melbourne.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_BRIT"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P11",
            "factKey": "doze-apostolos-F11",
            "text": "No século XX o conjunto tinha só nove pilares, menos do que o nome promete.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TWA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P12",
            "factKey": "doze-apostolos-F12",
            "text": "Um pilar de uns 50 m desabou em 2005, e outro caiu em 2009.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TWA_BRIT",
              "TWA_SCIALERT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P13",
            "factKey": "doze-apostolos-F13",
            "text": "Do mirante principal dá para ver seis dos pilares que ainda estão de pé.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TWA_BRIT"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P14",
            "factKey": "doze-apostolos-F14",
            "text": "Antes, as rochas eram chamadas de Pinnacles e, junto com uma ilha vizinha, de \"Porca e Leitões\" (Sow and Piglets).",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P15",
            "factKey": "doze-apostolos-F15",
            "text": "Ondas e vento continuam desgastando os pilares, e um dia eles vão desaparecer.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "TWA_BRIT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P16",
            "factKey": "doze-apostolos-F16",
            "text": "Cada pilar guarda milhões de minúsculos fósseis marinhos.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "TWA_BRIT"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P17",
            "factKey": "doze-apostolos-F17",
            "text": "Este litoral ganhou o apelido de \"Costa dos Naufrágios\" (Shipwreck Coast).",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_VHD"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P18",
            "factKey": "doze-apostolos-F18",
            "text": "As falésias da região chegam a 70 m de altura, com charneca no alto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_VHD"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P19",
            "factKey": "doze-apostolos-F19",
            "text": "No mar em frente há um parque marinho com arcos, cânions e recifes, esponjas amarelas e laranjas e florestas de algas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_GORCAPA_MAR"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P20",
            "factKey": "doze-apostolos-F20",
            "text": "Drones são um problema aqui: em 2022, mais de 40 pilotos foram multados.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_GORCAPA_MAR"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P21",
            "factKey": "doze-apostolos-F21",
            "text": "A estrada que traz os visitantes foi construída por mais de 3.000 ex-combatentes da Primeira Guerra, entre 1919 e 1932.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TWA_NAA",
              "TWA_VHD_GOR"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P22",
            "factKey": "doze-apostolos-F22",
            "text": "Essa estrada de 242 km é dedicada aos soldados mortos na Primeira Guerra e conta como memorial de guerra.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TWA_NAA",
              "TWA_VHD_GOR"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P23",
            "factKey": "doze-apostolos-F23",
            "text": "A região é terra tradicional dos povos aborígines Eastern Maar e Wadawurrung, reconhecidos pelo órgão que administra o parque.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_GORCAPA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P24",
            "factKey": "doze-apostolos-F24",
            "text": "Os pilares ficam no Parque Nacional Port Campbell, no sudoeste do estado de Victoria, na Austrália.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_BRIT",
              "TWA_GORCAPA"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-viajante-P25",
            "factKey": "doze-apostolos-F25",
            "text": "É uma das atrações mais populares da Great Ocean Road.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "TWA_BRIT"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "doze-apostolos-geografo-P01",
            "factKey": "doze-apostolos-F26",
            "text": "A paisagem é um litoral de falésias em recuo, moldado pela energia contínua de um oceano aberto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_VHD"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P02",
            "factKey": "doze-apostolos-F27",
            "text": "Fica na costa sul da Austrália continental, voltada para o Oceano Austral.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_BRIT"
            ],
            "clueType": "localizacao",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P03",
            "factKey": "doze-apostolos-F28",
            "text": "As camadas de calcário se depositaram em mares rasos durante o Mioceno.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "TWA_SCIALERT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P04",
            "factKey": "doze-apostolos-F29",
            "text": "A formação local é dominada por arenitos calcários amarelos estratificados, com intercalações de folhelho.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "TWA_VHD"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P05",
            "factKey": "doze-apostolos-F30",
            "text": "Depois que a Austrália se separou da Antártida e derivou para o norte, a compressão dobrou e ergueu o calcário acima do mar.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "TWA_SCIALERT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P06",
            "factKey": "doze-apostolos-F31",
            "text": "As camadas, antes horizontais, estão inclinadas alguns graus, e pequenas falhas nas falésias são atribuídas a antigos terremotos dessa compressão.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "TWA_SCIALERT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P07",
            "factKey": "doze-apostolos-F32",
            "text": "Depois da última era glacial o mar subiu cerca de 125 m e voltou a atacar as rochas soerguidas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_SCIALERT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P08",
            "factKey": "doze-apostolos-F33",
            "text": "As ondas abrem cavernas nas falésias, que viram arcos; quando o topo do arco desaba, sobra um pilar isolado.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "TWA_BRIT",
              "TWA_SCIALERT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P09",
            "factKey": "doze-apostolos-F34",
            "text": "Na forma atual, as falésias e os pilares têm só alguns milhares de anos, bem menos que a rocha.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_SCIALERT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "doze-apostolos-geografo-P10",
            "factKey": "doze-apostolos-F35",
            "text": "Um estudo da Universidade de Melbourne, publicado em 2026 no Australian Journal of Earth Sciences, reconstituiu essa história geológica.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TWA_SCIALERT"
            ],
            "clueType": "pesquisa",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
