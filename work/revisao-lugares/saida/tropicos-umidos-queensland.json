      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "tropicos-umidos-queensland-geografo-P01",
            "factKey": "tropicos-umidos-queensland-F26",
            "text": "É um bem natural que cumpre os quatro critérios naturais do Patrimônio Mundial: beleza cênica, história da Terra, processos ecológicos e biodiversidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN",
              "WT_QLDSOE"
            ],
            "clueType": "patrimonio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P02",
            "factKey": "tropicos-umidos-queensland-F27",
            "text": "Ocupa uma fração mínima do território australiano, mas reúne cerca de 30% das espécies de marsupiais do país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN",
              "WT_WTMA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P03",
            "factKey": "tropicos-umidos-queensland-F28",
            "text": "É a maior porção da região australásica em que a floresta tropical persistiu de forma contínua desde a época de Gondwana.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P04",
            "factKey": "tropicos-umidos-queensland-F29",
            "text": "Guarda relíquias da floresta de Gondwana que cobria a Austrália entre 50 e 100 milhões de anos atrás.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_QLDSOE"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P05",
            "factKey": "tropicos-umidos-queensland-F30",
            "text": "Das 28 linhagens de plantas com flores primitivas do mundo, 16 crescem aqui.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P06",
            "factKey": "tropicos-umidos-queensland-F31",
            "text": "A flora é um registro vivo da evolução das plantas terrestres, das pteridófitas às cicadáceas, coníferas e plantas com flores.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P07",
            "factKey": "tropicos-umidos-queensland-F32",
            "text": "Os marsupiais australianos surgiram em ecossistemas de floresta tropical, e seus parentes vivos mais próximos estão aqui.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_QLDSOE"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P08",
            "factKey": "tropicos-umidos-queensland-F33",
            "text": "Nas margens ocidentais, mais secas, florestas altas e abertas fazem a transição da floresta tropical para a floresta esclerófila.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P09",
            "factKey": "tropicos-umidos-queensland-F34",
            "text": "Cerca de 700 espécies de plantas vasculares da área não existem em nenhum outro lugar do mundo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA",
              "WT_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P10",
            "factKey": "tropicos-umidos-queensland-F35",
            "text": "A maioria das bacias drena para leste, rumo ao Mar de Coral; o rio Mitchell é a exceção e corre para oeste, até o Golfo de Carpentária.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P11",
            "factKey": "tropicos-umidos-queensland-F07",
            "text": "Um dos picos tem média de 8.140 mm de chuva por ano em 38 anos de registros; em 2000, chegou a 12.461 mm.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P12",
            "factKey": "tropicos-umidos-queensland-F11",
            "text": "A maior das quedas-d’água, as Cataratas Wallaman, tem 305 m de queda única, a mais longa do país.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P13",
            "factKey": "tropicos-umidos-queensland-F09",
            "text": "O ponto culminante é o pico sul do Monte Bartle Frere, com 1.622 m, a montanha mais alta do estado.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "WT_WTMA",
              "WT_TNQ"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P14",
            "factKey": "tropicos-umidos-queensland-F36",
            "text": "O bem é formado por 14 seções separadas, com perímetro total de cerca de 3.000 km.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P15",
            "factKey": "tropicos-umidos-queensland-F37",
            "text": "Na inscrição, em 1988, só cerca de 14% da área eram protegidos; hoje, as áreas protegidas cobrem a grande maioria dela.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P16",
            "factKey": "tropicos-umidos-queensland-F38",
            "text": "É gerido por uma autoridade criada por uma lei de 1993 e financiada pelos governos federal e estadual.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P17",
            "factKey": "tropicos-umidos-queensland-F39",
            "text": "A mudança climática é apontada como a maior ameaça ao valor universal excepcional do bem.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P18",
            "factKey": "tropicos-umidos-queensland-F40",
            "text": "Desde a inscrição, a população da raposa-voadora-de-óculos caiu para menos de 10% do que era.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P19",
            "factKey": "tropicos-umidos-queensland-F41",
            "text": "As práticas de manejo do fogo dos aborígines da floresta tropical estão na Lista do Patrimônio Nacional australiano.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P20",
            "factKey": "tropicos-umidos-queensland-F42",
            "text": "Faz parte do hotspot global de biodiversidade \"Florestas do Leste da Austrália\".",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_QLDSOE"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P21",
            "factKey": "tropicos-umidos-queensland-F43",
            "text": "Em 2013, foi classificado como o segundo bem natural mais insubstituível do Patrimônio Mundial.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P22",
            "factKey": "tropicos-umidos-queensland-F44",
            "text": "Os primeiros parques nacionais da área surgiram em 1921, 1932 e 1934; o de 1932 protege uma ilha, Hinchinbrook.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P23",
            "factKey": "tropicos-umidos-queensland-F13",
            "text": "Os lagos Barrine e Eacham são crateras gêmeas formadas pela ação de água subterrânea superaquecida.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_TNQ",
              "WT_WTMA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P24",
            "factKey": "tropicos-umidos-queensland-F45",
            "text": "A área se estende pela faixa costeira entre Cooktown, ao norte, e Townsville, ao sul.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-geografo-P25",
            "factKey": "tropicos-umidos-queensland-F17",
            "text": "Em 2021, mais de 160 mil hectares no Cabo York, incluindo o parque nacional mais famoso da área, voltaram ao povo Kuku Yalanji Oriental, em gestão compartilhada com o governo estadual.",
            "relatedFields": [
              "C4"
