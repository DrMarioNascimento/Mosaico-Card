              "C4"
            ],
            "sources": [
              "WT_QLDGOV",
              "WT_NPR"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P17",
            "factKey": "tropicos-umidos-queensland-F17",
            "text": "Desde 2021, o povo Kuku Yalanji Oriental é dono do parque nacional mais famoso desta floresta e divide a gestão com o governo estadual.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "WT_QLDGOV",
              "WT_NPR"
            ],
            "clueType": "cultura",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P18",
            "factKey": "tropicos-umidos-queensland-F18",
            "text": "Entrou na lista do Patrimônio Mundial da UNESCO em 1988.",
