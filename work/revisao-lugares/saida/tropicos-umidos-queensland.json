              "C1"
            ],
            "sources": [
              "WT_IUCN",
              "WT_QLDSOE"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P19",
            "factKey": "tropicos-umidos-queensland-F19",
            "text": "Quando a área virou Patrimônio Mundial, em 1988, a cidade de Ravenshoe, que vivia da extração de madeira, ficou dividida.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_TNQ"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P20",
            "factKey": "tropicos-umidos-queensland-F20",
            "text": "Um passeio conhecido é a Caminhada do Tempo do Sonho (Dreamtime Walk), na Garganta de Mossman.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_TNQ"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P21",
            "factKey": "tropicos-umidos-queensland-F21",
            "text": "Entre os passeios estão as passarelas Mamu Tropical Skywalk e Jindalba Boardwalk.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_TNQ"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P22",
            "factKey": "tropicos-umidos-queensland-F22",
            "text": "Cerca de cinco milhões de visitantes passam por aqui a cada ano.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P23",
            "factKey": "tropicos-umidos-queensland-F23",
            "text": "Há uma árvore tão rara que restam só cerca de 400 indivíduos dela.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P24",
            "factKey": "tropicos-umidos-queensland-F24",
            "text": "A maior parte da área é hoje parque nacional, e dezenas de parques nacionais têm terras dentro dela.",
