    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "tropicos-umidos-queensland-viajante-P01",
            "factKey": "tropicos-umidos-queensland-F01",
            "text": "A paisagem é de floresta tropical densa, cortada por rios selvagens, cachoeiras e gargantas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P02",
            "factKey": "tropicos-umidos-queensland-F02",
            "text": "A área se estende ao longo da costa nordeste da Austrália.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "localizacao",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P03",
            "factKey": "tropicos-umidos-queensland-F03",
            "text": "Em alguns trechos, a floresta desce até praias de areia branca, com recifes de coral bem perto da costa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P04",
            "factKey": "tropicos-umidos-queensland-F04",
            "text": "O casuar, uma das maiores aves do mundo, que não voa, é um dos animais-símbolo daqui.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P05",
            "factKey": "tropicos-umidos-queensland-F05",
            "text": "Duas espécies de canguru que vivem em árvores são destaque da fauna e só existem nesta região.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_TNQ",
              "WT_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P06",
            "factKey": "tropicos-umidos-queensland-F06",
            "text": "Mais da metade das espécies de borboletas da Austrália voa nestas matas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_IUCN",
              "WT_WTMA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P07",
            "factKey": "tropicos-umidos-queensland-F07",
            "text": "Chove muito: um dos picos daqui é reconhecido como o lugar mais chuvoso da Austrália.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P08",
            "factKey": "tropicos-umidos-queensland-F08",
            "text": "Ciclones fortes fazem parte da vida local; um dos mais recentes, o Jasper, passou em dezembro de 2023.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_WTMA",
              "WT_IUCN"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P09",
            "factKey": "tropicos-umidos-queensland-F09",
            "text": "O pico mais alto tem 1.622 m.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "WT_WTMA",
              "WT_TNQ"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P10",
            "factKey": "tropicos-umidos-queensland-F10",
            "text": "As duas montanhas mais altas do estado ficam aqui, ao sul de Cairns.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "WT_WTMA",
              "WT_TNQ"
            ],
            "clueType": "relevo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P11",
            "factKey": "tropicos-umidos-queensland-F11",
            "text": "Uma das cachoeiras despenca 305 m e é tida como a maior queda única do país.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P12",
            "factKey": "tropicos-umidos-queensland-F12",
            "text": "Barron, Tully, Murray e Roaring Meg estão entre as quedas-d’água conhecidas da região.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "WT_WTMA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P13",
            "factKey": "tropicos-umidos-queensland-F13",
            "text": "Dois lagos de cratera vizinhos, cercados de floresta, têm cerca de 65 m de profundidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WT_TNQ"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tropicos-umidos-queensland-viajante-P14",
            "factKey": "tropicos-umidos-queensland-F14",
            "text": "Mais de 20 grupos aborígines da floresta tropical mantêm laços com estas terras.",
            "relatedFields": [
              "C1",
