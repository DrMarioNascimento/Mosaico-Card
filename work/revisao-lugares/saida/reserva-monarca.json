  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "reserva-monarca-viajante-P01",
      "factKey": "reserva-monarca-F01",
      "text": "Este destino protege florestas em montanhas acidentadas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P02",
      "factKey": "reserva-monarca-F02",
      "text": "Todo outono, o lugar recebe visitantes que viajam milhares de quilômetros.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P03",
      "factKey": "reserva-monarca-F03",
      "text": "Fica no México, na América do Norte.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P04",
      "factKey": "reserva-monarca-F04",
      "text": "A reserva fica a cerca de 100 km a noroeste da Cidade do México.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P05",
      "factKey": "reserva-monarca-F05",
      "text": "Ela se divide entre Michoacán e o Estado do México.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P06",
      "factKey": "reserva-monarca-F06",
      "text": "As montanhas fazem parte da Cordilheira Neovulcânica.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "MONARCA_IUCN08"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P07",
      "factKey": "reserva-monarca-F07",
      "text": "A floresta mais importante da reserva fica acima de uns 2.900 metros de altitude.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P08",
      "factKey": "reserva-monarca-F08",
      "text": "Um abeto de montanha chamado oyamel forma essas florestas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P09",
      "factKey": "reserva-monarca-F09",
      "text": "Quase toda a área pertence a comunidades rurais ou a donos particulares.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P10",
      "factKey": "reserva-monarca-F10",
      "text": "Cerca de 27 mil pessoas vivem em 80 comunidades agrárias em volta das áreas centrais.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P11",
      "factKey": "reserva-monarca-F11",
      "text": "Pagamentos por serviços ambientais ajudam as comunidades a conservar a floresta.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P12",
      "factKey": "reserva-monarca-F12",
      "text": "O corte ilegal de árvores ainda não foi totalmente controlado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P13",
      "factKey": "reserva-monarca-F13",
      "text": "Plantações de abacate avançam na faixa em volta das áreas centrais.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "agricultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P14",
      "factKey": "reserva-monarca-F14",
      "text": "Os incêndios florestais vêm aumentando na região.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P15",
      "factKey": "reserva-monarca-F15",
      "text": "Visitantes mal orientados podem perturbar o espetáculo natural que atrai o turismo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "turismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P16",
      "factKey": "reserva-monarca-F16",
      "text": "Insetos chegam todo ano de lugares tão distantes quanto o Canadá.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P17",
      "factKey": "reserva-monarca-F17",
      "text": "No inverno, os insetos migrantes se juntam em poucas manchas de floresta.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08",
       "MONARCA_WHO"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P18",
      "factKey": "reserva-monarca-F18",
      "text": "Os insetos se concentram tanto que as árvores ficam alaranjadas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P19",
      "factKey": "reserva-monarca-F19",
      "text": "O peso dos insetos chega a envergar os galhos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P20",
      "factKey": "reserva-monarca-F20",
      "text": "O bater de tantas asas lembra o som de uma chuva fina.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P21",
      "factKey": "reserva-monarca-F21",
      "text": "Os insetos passam uns cinco meses na floresta e, no fim de março, começam a ir embora.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08",
       "MONARCA_WHO"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P22",
      "factKey": "reserva-monarca-F22",
      "text": "Na viagem de ida e volta ao Canadá, nascem e morrem quatro gerações.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P23",
      "factKey": "reserva-monarca-F23",
      "text": "São borboletas, e podem chegar a cerca de um bilhão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P24",
      "factKey": "reserva-monarca-F24",
      "text": "A UNESCO incluiu a reserva no Patrimônio Mundial em 2008.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-viajante-P25",
      "factKey": "reserva-monarca-F25",
      "text": "Herbicidas e perda de hábitat nos Estados Unidos e no Canadá também afetam essa migração.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "reserva-monarca-geografo-P01",
      "factKey": "reserva-monarca-F01",
      "text": "O bem protege florestas de montanha cujo dossel cria microclimas essenciais a um fenômeno sazonal.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO"
      ],
      "clueType": "processo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P02",
      "factKey": "reserva-monarca-F02",
      "text": "O bem natural foi inscrito só pelo critério vii, que reconhece fenômenos naturais excepcionais.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "patrimonio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P03",
      "factKey": "reserva-monarca-F03",
      "text": "A reserva fica na Cordilheira Neovulcânica, a cerca de 100 km a oeste e noroeste da Cidade do México.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "MONARCA_IUCN08",
       "MONARCA_WHO"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P04",
      "factKey": "reserva-monarca-F04",
      "text": "O território se reparte entre os estados de Michoacán e do México.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P05",
      "factKey": "reserva-monarca-F05",
      "text": "São 56.259 ha: três zonas núcleo (13.552 ha) formam o bem, cercadas por duas zonas de amortecimento (42.707 ha).",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08",
       "MONARCA_WHO"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P06",
      "factKey": "reserva-monarca-F06",
      "text": "A floresta de oyamel acima de cerca de 2.900 m oferece o ambiente de invernada.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08",
       "MONARCA_WHO"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P07",
      "factKey": "reserva-monarca-F07",
      "text": "A floresta em pé regula o microclima das colônias; por isso o corte de árvores é a principal ameaça direta.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_WHO",
       "MONARCA_IUCN08"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P08",
      "factKey": "reserva-monarca-F08",
      "text": "Quase 4 mil ha de floresta foram degradados entre 1971 e 2005, segundo a avaliação da IUCN.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P09",
      "factKey": "reserva-monarca-F09",
      "text": "A migração de outono da população oriental percorre de 3.500 a mais de 4.500 km.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reserva-monarca-geografo-P10",
      "factKey": "reserva-monarca-F10",
      "text": "Dias mais curtos e o frio disparam a migração no fim de agosto; de novembro a abril, a floresta fria e úmida abriga a invernada.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "MONARCA_IUCN08"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
