            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P12",
            "factKey": "purnululu-F12",
            "text": "Mais de 130 espécies de aves aparecem por aqui, como abelharucos-arco-íris e periquitos-australianos.",
