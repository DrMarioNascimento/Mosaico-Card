            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P15",
            "factKey": "purnululu-F15",
            "text": "Sobrevoos de helicóptero saem de dentro do parque, de Kununurra ou de Warmun.",
