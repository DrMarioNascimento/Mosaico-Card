              "C1"
            ],
            "sources": [
              "PURN_PARKS_DESTAQUE"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P16",
            "factKey": "purnululu-F16",
            "text": "Drones são proibidos, e não se deve acenar para helicópteros, a não ser em emergência.",
