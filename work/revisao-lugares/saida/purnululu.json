    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "purnululu-viajante-P01",
            "factKey": "purnululu-F01",
            "text": "Aqui quase toda a chuva do ano, uns 600 mm, cai num verão curto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_DEC"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P02",
            "factKey": "purnululu-F02",
            "text": "As paredes de rocha mudam de cor ao longo do dia: do marrom ao vermelho, ao laranja e ao dourado.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_PARKS_DESTAQUE"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P03",
            "factKey": "purnululu-F03",
            "text": "Os morros de arenito têm forma de colmeia e são listrados, em faixas alaranjadas e escuras.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "PURN_PARKS",
              "PURN_DBCA_WHA"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P04",
            "factKey": "purnululu-F04",
            "text": "Esses domos passam de 250 m de altura.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_LANDSCOPE",
              "PURN_PARKS_DESTAQUE"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P05",
            "factKey": "purnululu-F05",
            "text": "Uma trilha de 2 km, ida e volta, leva a um anfiteatro natural de rocha vermelha.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_PARKS"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P06",
            "factKey": "purnululu-F06",
            "text": "Num cânion estreito, as paredes chegam a 200 m de altura e, em alguns pontos, mal passam de 1 m de largura.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_PARKS"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P07",
            "factKey": "purnululu-F07",
            "text": "Palmeiras pré-históricas do gênero Livistona crescem nos desfiladeiros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_PARKS",
              "PURN_LANDSCOPE"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P08",
            "factKey": "purnululu-F08",
            "text": "O parque só abre de abril a novembro, se o tempo deixar; na estação chuvosa, fica fechado.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_PARKS",
              "PURN_LANDSCOPE"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P09",
            "factKey": "purnululu-F09",
            "text": "Só se chega de 4x4 de chassi alto, por uma estrada de terra de 53 km.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_PARKS",
              "PURN_LANDSCOPE"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P10",
            "factKey": "purnululu-F10",
            "text": "Esse trecho de terra até o centro de visitantes leva de 1,5 a 3 horas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_PARKS"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-viajante-P11",
            "factKey": "purnululu-F11",
            "text": "Um mirante numa crista de calcário dá vista de 360 graus e é ótimo para o nascer e o pôr do sol.",
            "relatedFields": [
              "C1"
