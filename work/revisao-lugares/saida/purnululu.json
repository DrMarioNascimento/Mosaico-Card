      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "purnululu-geografo-P01",
            "factKey": "purnululu-F26",
            "text": "O arenito que forma este relevo foi depositado há cerca de 360 milhões de anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_LANDSCOPE",
              "PURN_DBCA_WHA",
              "PURN_DEC"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P02",
            "factKey": "purnululu-F27",
            "text": "Nos últimos 20 milhões de anos, a erosão de rios e córregos e o intemperismo esculpiram domos, fendas e desfiladeiros.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "PURN_DBCA_WHA",
              "PURN_LANDSCOPE"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P03",
            "factKey": "purnululu-F28",
            "text": "O conjunto é citado como o exemplo mais notável do mundo de carste em cones formado em arenito.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "PURN_DBCA_WHA",
              "PURN_IUCN"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P04",
            "factKey": "purnululu-F29",
            "text": "As faixas escuras são crostas de cianobactérias que crescem nas camadas onde a umidade se acumula.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "PURN_LANDSCOPE",
              "PURN_DBCA_WHA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P05",
            "factKey": "purnululu-F30",
            "text": "As faixas alaranjadas são camadas com compostos de ferro oxidados, que secam rápido demais para as cianobactérias se fixarem.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "PURN_DBCA_WHA",
              "PURN_LANDSCOPE"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P06",
            "factKey": "purnululu-F31",
            "text": "As palmeiras Livistona e a crosta de cianobactérias são vulneráveis ao fogo, por isso o manejo usa queimadas prescritas.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "PURN_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P07",
            "factKey": "purnululu-F32",
            "text": "Os desfiladeiros sinuosos e estreitos, de paredes verticais, são cortados por cachoeiras e poços sazonais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_IUCN"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P08",
            "factKey": "purnululu-F33",
            "text": "Os desfiladeiros abrigados guardam as manchas de floresta tropical mais ao sul do leste de Kimberley.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_DBCA_WHA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P09",
            "factKey": "purnululu-F34",
            "text": "Com 13 espécies, o parque tem a maior concentração de capins spinifex da Austrália, inclusive uma endêmica.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_DBCA_WHA",
              "PURN_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P10",
            "factKey": "purnululu-F35",
            "text": "Já foram registradas cerca de 619 espécies de plantas vasculares, nove delas conhecidas só daqui.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P11",
            "factKey": "purnululu-F36",
            "text": "Entre as aves ameaçadas estão a carriça-de-coroa-roxa, em perigo, e o falcão-cinzento; o diamante-de-gould também ocorre aqui.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P12",
            "factKey": "purnululu-F37",
            "text": "O parque soma mais de 85 espécies de répteis, 32 de mamíferos nativos e 12 de rãs, além de ao menos um lagarto endêmico.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_DBCA_WHA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P13",
            "factKey": "purnululu-F38",
            "text": "Nos anos 1980 e 1990, cerca de 25 mil bois, 4 mil burros e alguns camelos foram retirados da área.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_IUCN"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P14",
            "factKey": "purnululu-F39",
            "text": "Sapos-cururus invasores foram confirmados no parque em 2012–13, e o capim-buffel altera o regime de fogo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_IUCN"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P15",
            "factKey": "purnululu-F40",
            "text": "A área protegida reúne 239.723 ha de parque nacional e 79.602 ha de reserva de conservação.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_LANDSCOPE",
              "PURN_DEC",
              "PURN_PARKS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P16",
            "factKey": "purnululu-F41",
            "text": "O parque fica entre uma reserva de conservação e uma reserva de regeneração do rio Ord.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_PARKS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P17",
            "factKey": "purnululu-F42",
            "text": "Os limites do parque seguem sobretudo cursos de água, e não divisores de bacias, o que já foi apontado na inscrição.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_IUCN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P18",
            "factKey": "purnululu-F43",
            "text": "Foi inscrito no Patrimônio Mundial em 2003 por dois critérios naturais: beleza excepcional e valor geológico.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "PURN_DBCA_WHA",
              "PURN_IUCN"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P19",
            "factKey": "purnululu-F44",
            "text": "Os povos Jaru, Gija e Malngin, do leste de Kimberley, são reconhecidos como detentores de título nativo da área.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "PURN_LANDSCOPE",
              "PURN_PARKS_DESTAQUE"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P20",
            "factKey": "purnululu-F45",
            "text": "Os aborígines locais mantêm o vínculo com a paisagem por meio de histórias, canções, arte e visitas, e ainda usam recursos que os sustentam há milhares de anos.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "PURN_DBCA_WHA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P21",
            "factKey": "purnululu-F21",
            "text": "O nome oficial da cordilheira só entrou em uso em 1983, ano do documentário que a levou à TV nacional; o parque foi criado quatro anos depois, em 1987.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_DEC"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P22",
            "factKey": "purnululu-F20",
            "text": "Fica a cerca de 300 km ao sul de Kununurra e 150 km a nordeste de Halls Creek.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_DBCA_WHA"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P23",
            "factKey": "purnululu-F46",
            "text": "O barulho dos helicópteros de turismo preocupa o manejo, e trilhas foram desviadas em 2013 para reduzir a erosão.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_IUCN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P24",
            "factKey": "purnululu-F47",
            "text": "Os domos em forma de colmeia da cordilheira Bungle Bungle ocupam cerca de 45 mil hectares do parque.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "PURN_PARKS"
            ],
            "clueType": "relevo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "purnululu-geografo-P25",
            "factKey": "purnululu-F48",
            "text": "O nome Bungle Bungle foi usado primeiro por um pecuarista, em 1930, como nome de fazenda, e só virou oficial para a cordilheira em 1983.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PURN_DEC"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      }
