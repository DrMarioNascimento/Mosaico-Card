      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-geografo-P17",
      "factKey": "tiwanaku-F17",
      "text": "A cidade antiga, sobretudo de adobe, ficou em grande parte sob o povoado moderno.",
      "relatedFields": [
