      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-geografo-P20",
      "factKey": "tiwanaku-F20",
      "text": "Umidade, chuva, vento e poeira desgastam as estruturas expostas.",
      "relatedFields": [
