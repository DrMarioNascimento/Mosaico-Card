      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-geografo-P21",
      "factKey": "tiwanaku-F21",
      "text": "O crescimento urbano e a agricultura ameaçam vestígios enterrados no entorno.",
