       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P24",
      "factKey": "tiwanaku-F24",
      "text": "A UNESCO incluiu o sítio no Patrimônio Mundial em 2000.",
