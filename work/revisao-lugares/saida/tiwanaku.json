      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-geografo-P18",
      "factKey": "tiwanaku-F18",
      "text": "O bem soma 71,5 ha, e um decreto de 2000 fixou os limites de proteção em três áreas.",
      "relatedFields": [
