       "C4"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P17",
      "factKey": "tiwanaku-F17",
      "text": "Canais de drenagem muito bem conservados cercam a pirâmide principal.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P18",
      "factKey": "tiwanaku-F18",
      "text": "Um grande templo retangular a céu aberto pode ter servido de observatório.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P19",
      "factKey": "tiwanaku-F19",
      "text": "Num templo semienterrado, cabeças de pedra esculpidas ficam encaixadas nas paredes.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "patrimonio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P20",
      "factKey": "tiwanaku-F20",
      "text": "Na região há quase 50 mil campos de cultivo elevados, com irrigação.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "agricultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P21",
      "factKey": "tiwanaku-F21",
      "text": "As técnicas agrícolas desenvolvidas ali se espalharam até a região de Cusco.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "agricultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P22",
      "factKey": "tiwanaku-F22",
      "text": "Os aimarás de hoje podem descender dos construtores da cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_EB"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P23",
      "factKey": "tiwanaku-F23",
      "text": "Todo 21 de junho, um ritual reúne multidões nas ruínas.",
