  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "tiwanaku-viajante-P01",
      "factKey": "tiwanaku-F01",
      "text": "Este destino guarda ruínas de templos e monumentos de pedra muito antigos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "patrimonio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P02",
      "factKey": "tiwanaku-F02",
      "text": "As ruínas ficam num planalto alto dos Andes.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "relevo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P03",
      "factKey": "tiwanaku-F03",
      "text": "Fica na América do Sul, na Bolívia.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "TIWANAKU_PR",
       "TIWANAKU_EB"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P04",
      "factKey": "tiwanaku-F04",
      "text": "O sítio fica perto da margem sul de um grande lago.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "TIWANAKU_PR",
       "TIWANAKU_EB"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P05",
      "factKey": "tiwanaku-F05",
      "text": "O lago Titicaca fica perto das ruínas.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "TIWANAKU_PR",
       "TIWANAKU_EB"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P06",
      "factKey": "tiwanaku-F06",
      "text": "As ruínas estão a cerca de 3.850 metros de altitude.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P07",
      "factKey": "tiwanaku-F07",
      "text": "Ficam no departamento de La Paz, e a estrada que vem da cidade de La Paz vive cheia de carros.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "mobilidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P08",
      "factKey": "tiwanaku-F08",
      "text": "A cidade foi a capital de um império poderoso que durou vários séculos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P09",
      "factKey": "tiwanaku-F09",
      "text": "Ela é mais antiga que o Império Inca.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P10",
      "factKey": "tiwanaku-F10",
      "text": "A influência dessa cultura chegou ao sul do Peru, ao norte do Chile e ao noroeste da Argentina.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_EB"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P11",
      "factKey": "tiwanaku-F11",
      "text": "A maior parte da cidade antiga era feita de adobe.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P12",
      "factKey": "tiwanaku-F12",
      "text": "O povoado atual foi construído por cima de boa parte das ruínas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P13",
      "factKey": "tiwanaku-F13",
      "text": "Os construtores cortavam e poliam as pedras com grande precisão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P14",
      "factKey": "tiwanaku-F14",
      "text": "Um grande portal foi esculpido num único bloco de pedra, com uma figura central segurando bastões.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR",
       "TIWANAKU_EB"
      ],
      "clueType": "patrimonio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P15",
      "factKey": "tiwanaku-F15",
      "text": "Os relevos de um portal de pedra do sítio já foram interpretados como um calendário agrícola.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TIWANAKU_PR"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "tiwanaku-viajante-P16",
      "factKey": "tiwanaku-F16",
      "text": "Uma pirâmide de plataformas tem muros de pedra com mais de 18 metros de altura.",
