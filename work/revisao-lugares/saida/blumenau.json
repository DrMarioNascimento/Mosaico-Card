  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "blumenau-viajante-P01",
      "factKey": "blumenau-F01",
      "text": "É uma cidade do Sul do Brasil, num vale cortado ao meio por um grande rio.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "BLU_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P02",
      "factKey": "blumenau-F02",
      "text": "O clima é subtropical úmido, com verões que chegam perto dos 30 °C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P03",
      "factKey": "blumenau-F03",
      "text": "Antes dos colonos, a região era habitada por povos Kaingang e Xokleng.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_IBGE",
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P04",
      "factKey": "blumenau-F04",
      "text": "Algumas famílias já moravam às margens do ribeirão Garcia antes da colônia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P05",
      "factKey": "blumenau-F05",
      "text": "Em 1850, o fundador recebeu do governo provincial terras para uma colônia agrícola de imigrantes europeus.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P06",
      "factKey": "blumenau-F06",
      "text": "Os primeiros 17 colonos chegaram em setembro de 1850.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BLU_IBGE",
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P07",
      "factKey": "blumenau-F07",
      "text": "No começo, a colônia era particular e proibia o trabalho escravo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P08",
      "factKey": "blumenau-F08",
      "text": "Em 1860, o governo imperial assumiu a colônia, mas o fundador seguiu na direção até 1880.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P09",
      "factKey": "blumenau-F09",
      "text": "Os lotes dos colonos foram demarcados ao longo de rios e ribeirões.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BLU_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P10",
      "factKey": "blumenau-F10",
      "text": "Depois dos alemães, chegaram italianos e poloneses.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P11",
      "factKey": "blumenau-F11",
      "text": "Os primeiros colonos plantavam milho, cana, mandioca e fumo em pequenos sítios de família.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P12",
      "factKey": "blumenau-F12",
      "text": "Nos anos 1880 já havia dezenas de serrarias, além de olarias e cervejarias.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P13",
      "factKey": "blumenau-F13",
      "text": "De 1880 a 1949, barcos a vapor levaram gente e carga pelo rio até Itajaí.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P14",
      "factKey": "blumenau-F14",
      "text": "No mesmo ano em que virou município, 1880, uma grande enchente destruiu pontes e estradas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P15",
      "factKey": "blumenau-F15",
      "text": "Fábricas de tecido, como a da família Hering, fizeram da cidade um polo têxtil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB",
       "BLU_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P16",
      "factKey": "blumenau-F16",
      "text": "A nova prefeitura, de 1982, foi construída no estilo enxaimel.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P17",
      "factKey": "blumenau-F17",
      "text": "Um \"castelo\" de 1978 imita a prefeitura de uma cidade alemã.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P18",
      "factKey": "blumenau-F18",
      "text": "As enchentes de 1983 e 1984 passaram dos 15 metros e deixaram a cidade isolada por semanas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB",
       "BLU_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P19",
      "factKey": "blumenau-F19",
      "text": "Numa festa típica, há concurso de quem bebe mais rápido um copo de chope de um metro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_OKTWIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P20",
      "factKey": "blumenau-F20",
      "text": "Essa festa ocupa o Parque Vila Germânica em outubro, por cerca de 18 dias.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_OKTWIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P21",
      "factKey": "blumenau-F21",
      "text": "A cidade tem os apelidos de \"Alemanha Tropical\" e \"Cidade Jardim\".",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P22",
      "factKey": "blumenau-F22",
      "text": "É reconhecida como capital nacional da cerveja.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P23",
      "factKey": "blumenau-F23",
      "text": "Em 2008, cheias e deslizamentos mataram 24 pessoas só nesta cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P24",
      "factKey": "blumenau-F24",
      "text": "Sua Oktoberfest nasceu em 1984 para reanimar a cidade depois das cheias.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB",
       "BLU_OKTWIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-viajante-P25",
      "factKey": "blumenau-F25",
      "text": "A cidade leva o sobrenome do alemão que fundou a colônia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_IBGE",
       "BLU_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "blumenau-geografo-P01",
      "factKey": "blumenau-F01",
      "text": "A cidade fica num vale fluvial de baixa altitude (cerca de 21 m), numa bacia que deságua no Atlântico.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "BLU_WIKI",
       "BLU_JICA"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P02",
      "factKey": "blumenau-F02",
      "text": "A bacia hidrográfica em que está soma cerca de 15 mil km², toda no bioma Mata Atlântica.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BLU_SGB"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P03",
      "factKey": "blumenau-F03",
      "text": "O rio principal ganha esse nome em Rio do Sul, onde se juntam seus formadores do Sul e do Oeste.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BLU_JICA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P04",
      "factKey": "blumenau-F04",
      "text": "A cidade marca a passagem do médio para o baixo vale, trecho de declividade muito baixa e com influência da maré.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BLU_JICA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P05",
      "factKey": "blumenau-F05",
      "text": "A jusante, uma planície extensa, baixa e pouco drenada favorece o acúmulo de água nas cheias.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_SGB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P06",
      "factKey": "blumenau-F06",
      "text": "Num estudo de 2011, tinha a maior densidade demográfica da bacia: 454 hab/km².",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_SGB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P07",
      "factKey": "blumenau-F07",
      "text": "Uma barragem de contenção de cheias em José Boiteux, em operação desde 1992, tem esta cidade como principal ponto de controle.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_DEFCIVIL"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P08",
      "factKey": "blumenau-F08",
      "text": "Na operação das barragens, a cidade é o segundo ponto mais sensível da bacia, depois de Rio do Sul.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_DEFCIVIL"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P09",
      "factKey": "blumenau-F09",
      "text": "As cheias de julho de 1983 e agosto de 1984 tiveram vazões de pico estimadas como eventos de cerca de 100 anos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_JICA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P10",
      "factKey": "blumenau-F10",
      "text": "Em 2008, chuva concentrada no baixo vale, após um período muito úmido, provocou cheia e deslizamentos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_JICA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P11",
      "factKey": "blumenau-F11",
      "text": "A ocupação seguiu a hidrografia: os lotes coloniais foram medidos ao longo de rios e ribeirões.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BLU_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P12",
      "factKey": "blumenau-F12",
      "text": "A colônia, aberta em 1850 numa concessão de duas léguas, foi encampada pelo governo imperial em 1860.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BLU_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "blumenau-geografo-P13",
      "factKey": "blumenau-F13",
      "text": "A colonização particular vetava mão de obra escravizada e se apoiava em pequenas propriedades familiares.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BLU_FURB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
