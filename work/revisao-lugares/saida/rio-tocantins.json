  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "rio-tocantins-viajante-P01",
      "factKey": "rio-tocantins-F01",
      "text": "Este destino é um grande rio brasileiro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P02",
      "factKey": "rio-tocantins-F02",
      "text": "O rio nasce no Cerrado, no planalto central do Brasil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA",
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P03",
      "factKey": "rio-tocantins-F03",
      "text": "As nascentes ficam em Goiás, a cerca de mil metros de altitude.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_ECYCLE_IPAM",
       "RTOC_BRITANNICA"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P04",
      "factKey": "rio-tocantins-F04",
      "text": "Ele corre para o norte, cruzando Goiás e depois um estado criado em 1989.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA",
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P05",
      "factKey": "rio-tocantins-F05",
      "text": "O rio tem cerca de 2.700 km de extensão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P06",
      "factKey": "rio-tocantins-F06",
      "text": "Num trecho, ele faz a divisa entre um estado do Norte e o Maranhão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P07",
      "factKey": "rio-tocantins-F07",
      "text": "Ele recebe as águas de um único afluente realmente grande.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P08",
      "factKey": "rio-tocantins-F08",
      "text": "O encontro com esse afluente acontece perto do Bico do Papagaio.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P09",
      "factKey": "rio-tocantins-F09",
      "text": "O rio nasce no Cerrado e chega à Amazônia, ligando os dois biomas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P10",
      "factKey": "rio-tocantins-F10",
      "text": "Cachoeiras e corredeiras interrompem seu curso em muitos trechos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P11",
      "factKey": "rio-tocantins-F11",
      "text": "Uma hidrelétrica gigante, no Pará, barra o rio.",
      "relatedFields": [
       "C3",
       "C4"
      ],
      "sources": [
       "RTOC_BRITANNICA",
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P12",
      "factKey": "rio-tocantins-F12",
      "text": "O lago dessa usina tem quase 3 mil km².",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P13",
      "factKey": "rio-tocantins-F13",
      "text": "Duas eclusas ajudam os barcos a vencer um desnível de 72 metros nessa barragem.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RTOC_DIARIO_ECLUSA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P14",
      "factKey": "rio-tocantins-F14",
      "text": "A obra da eclusa levou cerca de três décadas, de 1984 a 2010.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RTOC_AGENCIAINFRA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P15",
      "factKey": "rio-tocantins-F15",
      "text": "A usina de Lajeado, no mesmo rio, atende a capital Palmas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P16",
      "factKey": "rio-tocantins-F16",
      "text": "Em Goiás, a usina de Serra da Mesa ajuda a abastecer Brasília.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P17",
      "factKey": "rio-tocantins-F17",
      "text": "Um trecho de pedras de cerca de 43 km atrapalha a navegação, sobretudo na seca.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_DIARIO_PEDRAL",
       "RTOC_AGENCIAINFRA"
      ],
      "clueType": "mobilidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P18",
      "factKey": "rio-tocantins-F18",
      "text": "Barcaças levam grãos do agronegócio pelo rio até a região de Belém.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "RTOC_AGENCIAINFRA",
       "RTOC_DIARIO_ECLUSA"
      ],
      "clueType": "mobilidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P19",
      "factKey": "rio-tocantins-F19",
      "text": "Imperatriz e Marabá aparecem nos planos de terminais de carga do rio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_ANA_HIDROVIA"
      ],
      "clueType": "mobilidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P20",
      "factKey": "rio-tocantins-F20",
      "text": "Perto da foz, as marés do oceano influenciam os últimos 150 km do rio.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P21",
      "factKey": "rio-tocantins-F21",
      "text": "Na boca do rio, pesca-se muito o mapará, um bagre que se alimenta de plâncton.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P22",
      "factKey": "rio-tocantins-F22",
      "text": "O curimatá sobe os rios da bacia no começo das cheias para desovar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P23",
      "factKey": "rio-tocantins-F23",
      "text": "A bacia abastece cerca de 2,5 milhões de pessoas em 453 municípios.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P24",
      "factKey": "rio-tocantins-F24",
      "text": "O grande afluente que ele recebe é o Araguaia.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS",
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "agua",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-viajante-P25",
      "factKey": "rio-tocantins-F25",
      "text": "Depois de passar pela usina de Tucuruí, o rio deságua no Pará, ao sul da Ilha de Marajó.",
      "relatedFields": [
       "C3",
       "C4"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS",
       "RTOC_BRITANNICA"
      ],
      "clueType": "agua",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "rio-tocantins-geografo-P01",
      "factKey": "rio-tocantins-F01",
      "text": "O curso de água tem toda a sua bacia em território brasileiro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P02",
      "factKey": "rio-tocantins-F02",
      "text": "A bacia ultrapassa 750 mil km², mais que o dobro da área do Equador.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "agua",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P03",
      "factKey": "rio-tocantins-F03",
      "text": "Várias cabeceiras no planalto central goiano, logo ao sul de Brasília, formam o rio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA",
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P04",
      "factKey": "rio-tocantins-F04",
      "text": "O rio nasce a cerca de 1.000 m de altitude, no Cerrado, e desce até o domínio amazônico, como um corredor entre biomas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P05",
      "factKey": "rio-tocantins-F05",
      "text": "Depois de correr para o norte, o rio faz uma curva para oeste e serve de limite entre um estado do Norte e o Maranhão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P06",
      "factKey": "rio-tocantins-F06",
      "text": "A junção com o único grande afluente, no extremo norte do estado homônimo, devolve o curso ao rumo norte.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RTOC_BRITANNICA",
       "RTOC_AGUAS_AMAZONICAS",
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P07",
      "factKey": "rio-tocantins-F07",
      "text": "O rio e seu grande afluente formam uma das maiores bacias do Brasil, que alcança seis unidades da federação.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RTOC_DIARIO_PEDRAL",
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P08",
      "factKey": "rio-tocantins-F08",
      "text": "Por desaguar no rio Pará, braço do delta amazônico, costuma ser visto como afluente do Amazonas, embora seja um sistema tecnicamente separado.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "RTOC_BRITANNICA",
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P09",
      "factKey": "rio-tocantins-F09",
      "text": "Os últimos 150 km formam uma grande baía de foz, fortemente influenciada pelas marés.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P10",
      "factKey": "rio-tocantins-F10",
      "text": "Corredeiras e quedas d’água interrompem frequentemente o curso e limitam a navegação.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_BRITANNICA"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P11",
      "factKey": "rio-tocantins-F11",
      "text": "O Pedral do Lourenço, cerca de 43 km de rochas em Itupiranga, entre Marabá e Tucuruí, trava a navegação na estiagem.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_DIARIO_PEDRAL"
      ],
      "clueType": "mobilidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P12",
      "factKey": "rio-tocantins-F12",
      "text": "O derrocamento do pedral, licenciado em 2025, busca viabilizar de 20 a 60 milhões de toneladas de carga por ano.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_DIARIO_PEDRAL"
      ],
      "clueType": "mobilidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P13",
      "factKey": "rio-tocantins-F13",
      "text": "A grande usina do baixo curso é apontada como a primeira grande barragem num grande rio amazônico.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P14",
      "factKey": "rio-tocantins-F14",
      "text": "A transposição dessa barragem usa duas eclusas de 210 m que vencem 72 m de desnível pela margem esquerda.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RTOC_DIARIO_ECLUSA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P15",
      "factKey": "rio-tocantins-F15",
      "text": "Na década seguinte à obra, o reservatório multiplicou por dez a biomassa de peixes comerciais.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P16",
      "factKey": "rio-tocantins-F16",
      "text": "Depois da barragem, a pesca do mapará na baía de foz entrou em colapso.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P17",
      "factKey": "rio-tocantins-F17",
      "text": "Em lista do setor de transportes de 2010, Serra da Mesa, Cana Brava, Peixe Angical, Lajeado e Estreito aparecem entre as usinas do rio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_ANA_HIDROVIA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P18",
      "factKey": "rio-tocantins-F18",
      "text": "Projetos de eclusas previam vencer 38 m de desnível em Lajeado e 25 m em Estreito.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_ANA_HIDROVIA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P19",
      "factKey": "rio-tocantins-F19",
      "text": "Mais de 20 barragens foram planejadas para o rio e seu grande afluente.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P20",
      "factKey": "rio-tocantins-F20",
      "text": "Serra da Mesa, em Goiás, abastece Brasília, e Lajeado atende Palmas, a mais de 300 km uma da outra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P21",
      "factKey": "rio-tocantins-F21",
      "text": "O trecho navegável apontado pelo IPAM vai de Lajeado até Belém.",
