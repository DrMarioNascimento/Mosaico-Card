       "C4"
      ],
      "sources": [
       "RTOC_ECYCLE_IPAM"
      ],
      "clueType": "mobilidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-tocantins-geografo-P22",
      "factKey": "rio-tocantins-F22",
      "text": "Imperatriz, no Maranhão, e Marabá, no Pará, aparecem nos planos de terminais de carga da hidrovia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
