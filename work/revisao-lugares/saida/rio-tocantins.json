     },
     {
      "id": "rio-tocantins-geografo-P23",
      "factKey": "rio-tocantins-F23",
      "text": "A expansão de soja, pecuária, mineração e barragens segue transformando a bacia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RTOC_AGUAS_AMAZONICAS"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
