          },
          {
            "id": "cracovia-geografo-P25",
            "factKey": "cracovia-F50",
            "text": "Foi capital do reino polonês de 1320 até a mudança da sede para Varsóvia, concluída até 1611.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CRACOVIA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
