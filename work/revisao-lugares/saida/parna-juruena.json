      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P07",
      "factKey": "parna-juruena-F07",
      "text": "Ele acompanha um grande rio, numa área entre o Tapajós e o Madeira.",
