      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P11",
      "factKey": "parna-juruena-F11",
      "text": "Quase metade do parque é planície, e áreas montanhosas são raras.",
