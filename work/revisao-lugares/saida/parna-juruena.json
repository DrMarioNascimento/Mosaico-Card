   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "parna-juruena-geografo-P01",
      "factKey": "parna-juruena-F01",
      "text": "A unidade federal de proteção integral é administrada pelo ICMBio.",
