      ],
      "clueType": "conservacao",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P02",
      "factKey": "parna-juruena-F02",
      "text": "O cadastro oficial registra toda a área da unidade no bioma Amazônia.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "JURUENA_CNUC"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P03",
      "factKey": "parna-juruena-F03",
      "text": "O perímetro abrange duas unidades da federação e liga os recortes Norte e Centro-Oeste.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "JURUENA_CNUC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P04",
      "factKey": "parna-juruena-F04",
      "text": "Um decreto de 5 de junho de 2006 criou a unidade, com cerca de 1,96 milhão de hectares.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JURUENA_CNUC",
       "JURUENA_WIKI"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P05",
      "factKey": "parna-juruena-F05",
      "text": "O objetivo legal é proteger a biodiversidade do baixo curso do rio homônimo e do Teles Pires e do alto Tapajós.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JURUENA_CNUC"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P06",
      "factKey": "parna-juruena-F06",
      "text": "A unidade fica no norte de Mato Grosso e no sul do Amazonas, no interflúvio entre o Tapajós e o Madeira.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "JURUENA_WIKI"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P07",
      "factKey": "parna-juruena-F07",
      "text": "Cerca de 49% da área é plana e só 1% é montanhosa, com altitudes de 39 a 457 m.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JURUENA_WIKI"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P08",
      "factKey": "parna-juruena-F08",
      "text": "A unidade ocupa uma zona de transição entre a floresta amazônica e o Cerrado.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "JURUENA_WIKI"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P09",
      "factKey": "parna-juruena-F09",
      "text": "Florestas ombrófilas densas ou abertas cobrem 53,4% da vegetação; áreas de contato e encraves somam 36,35%.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "JURUENA_WIKI"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P10",
      "factKey": "parna-juruena-F10",
      "text": "Corpos d’água ocupam cerca de 22,8 mil hectares da unidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JURUENA_WIKI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-geografo-P11",
      "factKey": "parna-juruena-F11",
      "text": "Das 412 espécies de aves identificadas, 40 são endêmicas do sul da Amazônia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
