       "JURUENA_ARTIGO_APIAKA"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P21",
      "factKey": "parna-juruena-F21",
      "text": "Uma das cachoeiras do parque é sagrada para os Apiaká.",
