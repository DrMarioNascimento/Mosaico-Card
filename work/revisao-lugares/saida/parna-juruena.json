      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P09",
      "factKey": "parna-juruena-F09",
      "text": "Perto das cachoeiras há cavernas onde morcegos se abrigam durante o dia.",
