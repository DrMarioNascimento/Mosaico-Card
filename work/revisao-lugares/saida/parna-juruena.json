      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P23",
      "factKey": "parna-juruena-F23",
      "text": "Apiacás, em Mato Grosso, e Apuí, no Amazonas, estão entre esses municípios.",
