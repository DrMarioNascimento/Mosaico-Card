      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P14",
      "factKey": "parna-juruena-F14",
      "text": "Mais de 400 espécies de aves já foram identificadas no parque.",
