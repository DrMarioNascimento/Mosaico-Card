       "C1"
      ],
      "sources": [
       "JURUENA_WIKI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P08",
      "factKey": "parna-juruena-F08",
      "text": "O rio que dá nome ao parque tem grandes cachoeiras.",
