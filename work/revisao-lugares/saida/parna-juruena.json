      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P12",
      "factKey": "parna-juruena-F12",
      "text": "As temperaturas costumam ficar entre 17 °C e 34 °C.",
