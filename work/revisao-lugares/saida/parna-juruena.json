      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-juruena-viajante-P22",
      "factKey": "parna-juruena-F22",
      "text": "Três municípios de Mato Grosso e dois do Amazonas têm parte do parque.",
