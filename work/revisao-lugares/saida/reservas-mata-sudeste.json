      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reservas-mata-sudeste-viajante-P19",
      "factKey": "reservas-mata-sudeste-F19",
      "text": "As áreas ficam perto da região do porto de Paranaguá, que planeja crescer.",
