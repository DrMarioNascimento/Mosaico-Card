   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "reservas-mata-sudeste-geografo-P01",
      "factKey": "reservas-mata-sudeste-F01",
      "text": "O bem natural é seriado: reúne dezenas de unidades protegidas separadas.",
