      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reservas-mata-sudeste-viajante-P21",
      "factKey": "reservas-mata-sudeste-F21",
      "text": "A região de Guaraqueçaba junta floresta, manguezais, baías e comunidades tradicionais.",
