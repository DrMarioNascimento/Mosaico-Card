      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reservas-mata-sudeste-geografo-P02",
      "factKey": "reservas-mata-sudeste-F02",
      "text": "O território se estende de uma serra costeira até a planície litorânea, num gradiente de ambientes.",
