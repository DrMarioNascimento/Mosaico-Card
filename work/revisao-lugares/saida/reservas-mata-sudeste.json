      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reservas-mata-sudeste-viajante-P12",
      "factKey": "reservas-mata-sudeste-F12",
      "text": "O papagaio-de-cara-roxa, uma ave ameaçada, é alvo de um projeto de conservação na região.",
