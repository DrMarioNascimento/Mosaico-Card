      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reservas-mata-sudeste-viajante-P11",
      "factKey": "reservas-mata-sudeste-F11",
      "text": "O guará, ave grande de penas vermelhas, é um símbolo local.",
