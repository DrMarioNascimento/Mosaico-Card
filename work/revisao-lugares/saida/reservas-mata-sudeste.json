       "C2"
      ],
      "sources": [
       "MATASE_AGENCIAGOV"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "reservas-mata-sudeste-geografo-P03",
      "factKey": "reservas-mata-sudeste-F03",
      "text": "Foi inscrito em 1999 pelos critérios vii (beleza natural), ix e x.",
