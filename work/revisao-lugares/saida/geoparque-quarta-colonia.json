      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "quarta-colonia-geografo-P09",
      "factKey": "quarta-colonia-geografo-F09",
      "text": "Os níveis mais antigos da Formação Caturrita, que costuma recobrir a Santa Maria, têm cerca de 225 milhões de anos.",
