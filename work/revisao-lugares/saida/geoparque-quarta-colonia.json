   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "quarta-colonia-geografo-P01",
      "factKey": "quarta-colonia-geografo-F01",
      "text": "O território marca a transição entre a Depressão Periférica, ao sul, e o planalto da Serra Geral, ao norte.",
