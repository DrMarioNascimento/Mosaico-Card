      ],
      "sources": [
       "QC_SGB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "quarta-colonia-geografo-P05",
      "factKey": "quarta-colonia-geografo-F05",
      "text": "As escarpas arenítico-basálticas expõem arenito eólico e derrames vulcânicos sobre camadas triássicas mais antigas.",
