       "C2"
      ],
      "sources": [
       "QC_FAPESP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "quarta-colonia-geografo-P08",
      "factKey": "quarta-colonia-geografo-F08",
      "text": "Os depósitos fossilíferos destacados no geoparque datam de cerca de 233 a 225 milhões de anos.",
