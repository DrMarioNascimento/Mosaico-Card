       "C1"
      ],
      "sources": [
       "QC_JC2025"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "quarta-colonia-geografo-P07",
      "factKey": "quarta-colonia-geografo-F07",
      "text": "As rochas carnianas da Formação Santa Maria têm idade máxima de cerca de 233 milhões de anos.",
