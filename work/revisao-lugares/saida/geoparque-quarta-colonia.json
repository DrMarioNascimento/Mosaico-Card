       "C1"
      ],
      "sources": [
       "QC_UFSM",
       "QC_SGB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "quarta-colonia-geografo-P06",
      "factKey": "quarta-colonia-geografo-F06",
      "text": "Rios como o Jacuí erodiram o basalto e expuseram as camadas com fósseis.",
