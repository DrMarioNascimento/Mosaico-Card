      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "quarta-colonia-geografo-P04",
      "factKey": "quarta-colonia-geografo-F04",
      "text": "A sucessão de rochas vai do Triássico Inferior ao Cretáceo Inferior, na bacia do Chaco-Paraná.",
