      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "quarta-colonia-geografo-P10",
      "factKey": "quarta-colonia-geografo-F10",
      "text": "Macrocollum itaquii e Sacisaurus agudoensis vêm da Formação Caturrita.",
