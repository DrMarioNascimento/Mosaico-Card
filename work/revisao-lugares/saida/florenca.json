            ],
            "sources": [
              "FLORENCA_BRIT_SUM"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "florenca-geografo-P24",
            "factKey": "florenca-F39",
            "text": "Uma contagem preliminar de 2001 registrou 352.227 habitantes.",
