       "C1"
      ],
      "sources": [
       "CNO_GOTUR_FICHA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caldas-novas-go-geografo-P08",
      "factKey": "caldas-novas-go-F08",
      "text": "Um parque estadual de 1970, na divisa com o município vizinho, protege a área de captação que alimenta o lençol termal.",
