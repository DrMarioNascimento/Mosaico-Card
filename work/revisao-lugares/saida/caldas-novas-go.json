      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caldas-novas-go-geografo-P03",
      "factKey": "caldas-novas-go-F03",
      "text": "Integra a Região Turística das Águas Quentes, com dois municípios vizinhos.",
