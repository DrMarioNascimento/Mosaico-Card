      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caldas-novas-go-geografo-P04",
      "factKey": "caldas-novas-go-F04",
      "text": "A chuva infiltra por fissuras das rochas, desce a grandes profundidades e se aquece pelo gradiente geotérmico, sem vulcão envolvido.",
