       "C2"
      ],
      "sources": [
       "CNO_GOTUR_FICHA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caldas-novas-go-geografo-P06",
      "factKey": "caldas-novas-go-F06",
      "text": "No topo dessa serra, a permeabilidade dos solos favorece a infiltração que alimenta o aquífero.",
