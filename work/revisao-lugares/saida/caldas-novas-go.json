       "CNO_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caldas-novas-go-geografo-P05",
      "factKey": "caldas-novas-go-F05",
      "text": "O aquífero termal tem várias áreas de recarga; uma das principais é uma serra de topo plano a 1.043 m de altitude.",
