       "C2"
      ],
      "sources": [
       "CNO_GOTUR_FICHA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caldas-novas-go-geografo-P07",
      "factKey": "caldas-novas-go-F07",
      "text": "A escarpa íngreme da serra desce em média cerca de 300 m, e nela brotam muitas nascentes.",
