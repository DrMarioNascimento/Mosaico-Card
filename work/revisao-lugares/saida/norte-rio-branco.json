  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "norte-rio-branco-viajante-P01",
      "factKey": "norte-rio-branco-F01",
      "text": "Esta cidade é uma capital estadual brasileira.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_IBGE_HIST",
       "RIOBRANCO_PA_CAPITAL"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P02",
      "factKey": "norte-rio-branco-F02",
      "text": "Ela fica na Amazônia, na região Norte do país.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P03",
      "factKey": "norte-rio-branco-F03",
      "text": "A cidade nasceu na beira de um rio amazônico.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "RIOBRANCO_PA_CAPITAL",
       "RIOBRANCO_PA_136"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P04",
      "factKey": "norte-rio-branco-F04",
      "text": "Hoje a cidade se espalha pelas duas margens desse rio.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P05",
      "factKey": "norte-rio-branco-F05",
      "text": "Tudo começou com um seringal, lugar de onde se tirava o látex das seringueiras.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RIOBRANCO_PA_CAPITAL",
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P06",
      "factKey": "norte-rio-branco-F06",
      "text": "A borracha foi o grande motor do crescimento da cidade.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P07",
      "factKey": "norte-rio-branco-F07",
      "text": "O fundador do seringal era cearense, e muitos nordestinos vieram morar na região.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P08",
      "factKey": "norte-rio-branco-F08",
      "text": "A data aceita de fundação é 28 de dezembro de 1882.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_136",
       "RIOBRANCO_PA_CAPITAL",
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P09",
      "factKey": "norte-rio-branco-F09",
      "text": "Quando o povoado surgiu, a região ainda era considerada território boliviano.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RIOBRANCO_IBGE_HIST"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P10",
      "factKey": "norte-rio-branco-F10",
      "text": "Uma gameleira centenária na beira do rio marca o ponto onde a cidade começou.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_SETE",
       "RIOBRANCO_PA_GAMELEIRA",
       "RIOBRANCO_OPOVO"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P11",
      "factKey": "norte-rio-branco-F11",
      "text": "O calçadão junto dessa árvore foi a primeira rua da cidade e foi tombado em 1981.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_SETE"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P12",
      "factKey": "norte-rio-branco-F12",
      "text": "Casarões desse calçadão lembram a época da borracha e da castanha-do-brasil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_GAMELEIRA"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P13",
      "factKey": "norte-rio-branco-F13",
      "text": "Em 1902, o lugar foi palco de combates entre brasileiros e bolivianos.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RIOBRANCO_PA_CAPITAL"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P14",
      "factKey": "norte-rio-branco-F14",
      "text": "O nome atual homenageia um barão diplomata, ligado à anexação do território ao Brasil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ",
       "RIOBRANCO_PA_136"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P15",
      "factKey": "norte-rio-branco-F15",
      "text": "Uma passarela sobre o rio oferece uma bela vista da água e da cidade.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "RIOBRANCO_OPOVO"
      ],
      "clueType": "turismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P16",
      "factKey": "norte-rio-branco-F16",
      "text": "No Novo Mercado Velho há ervas amazônicas, comidas típicas e artesanato.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_OPOVO"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P17",
      "factKey": "norte-rio-branco-F17",
      "text": "No café da manhã faz sucesso a baixaria: cuscuz de milho com carne moída, ovo frito e cheiro-verde.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_OPOVO"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P18",
      "factKey": "norte-rio-branco-F18",
      "text": "Um parque comprido acompanha um igarapé no centro, com ciclovia, quadras e pista de corrida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_SETE",
       "RIOBRANCO_OPOVO"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P19",
      "factKey": "norte-rio-branco-F19",
      "text": "Por causa dos muitos parques, a cidade ganhou o apelido de Cidade Verde.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_136"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P20",
      "factKey": "norte-rio-branco-F20",
      "text": "Um museu da cidade é dedicado à história da borracha.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RIOBRANCO_PA_136",
       "RIOBRANCO_OPOVO"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P21",
      "factKey": "norte-rio-branco-F21",
      "text": "Um parque ambiental tem trilhas e um memorial ao seringueiro.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RIOBRANCO_OPOVO"
      ],
      "clueType": "turismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P22",
      "factKey": "norte-rio-branco-F22",
      "text": "O Censo de 2022 contou mais de 360 mil moradores no município.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_GAZETA_POP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P23",
      "factKey": "norte-rio-branco-F23",
      "text": "É a cidade mais antiga do seu estado, um ano mais velha que Xapuri.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RIOBRANCO_PA_CAPITAL"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P24",
      "factKey": "norte-rio-branco-F24",
      "text": "Entre 1909 e 1912, a sede do município ficou do outro lado do rio, numa vila chamada Penápolis.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_IBGE_HIST",
       "RIOBRANCO_PA_136"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-viajante-P25",
      "factKey": "norte-rio-branco-F25",
      "text": "O rio que atravessa a cidade tem o mesmo nome do estado: é o rio Acre.",
      "relatedFields": [
       "C4",
       "C3"
      ],
      "sources": [
       "RIOBRANCO_PA_CAPITAL",
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "norte-rio-branco-geografo-P01",
      "factKey": "norte-rio-branco-F01",
      "text": "O destino exerce função de capital estadual no território brasileiro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_IBGE_HIST",
       "RIOBRANCO_PA_CAPITAL"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P02",
      "factKey": "norte-rio-branco-F02",
      "text": "A cidade integra a rede urbana amazônica da região Norte.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P03",
      "factKey": "norte-rio-branco-F03",
      "text": "O sítio original foi a beira de um rio navegável, onde o seringal logo se tornou porto comercial.",
      "relatedFields": [
       "C4",
       "C2"
      ],
      "sources": [
       "RIOBRANCO_PA_CAPITAL"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P04",
      "factKey": "norte-rio-branco-F04",
      "text": "A expansão urbana atravessou o curso fluvial e passou a ocupar as duas margens.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ",
       "RIOBRANCO_PA_136"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P05",
      "factKey": "norte-rio-branco-F05",
      "text": "A gênese urbana liga-se à economia extrativa do látex das seringueiras das florestas equatoriais.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P06",
      "factKey": "norte-rio-branco-F06",
      "text": "A função portuária fez desse seringal o primeiro do estado a evoluir para povoado e espaço público.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "RIOBRANCO_PA_CAPITAL"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P07",
      "factKey": "norte-rio-branco-F07",
      "text": "O povoamento inicial resultou da migração de nordestinos para a fronteira oeste do Brasil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P08",
      "factKey": "norte-rio-branco-F08",
      "text": "A fundação, em 1882, fez parte de uma leva de seringais abertos ao longo do mesmo rio, como o Bagaço e o de Xapuri.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "RIOBRANCO_IBGE_HIST"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P09",
      "factKey": "norte-rio-branco-F09",
      "text": "No momento da fundação, o vale era tido como boliviano; a posse brasileira veio com o Tratado de Petrópolis.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "RIOBRANCO_IBGE_HIST",
       "RIOBRANCO_PA_AZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-rio-branco-geografo-P10",
      "factKey": "norte-rio-branco-F10",
      "text": "Em 1902, combates da Revolução Acreana ocorreram no núcleo, então chamado Volta da Empresa.",
      "relatedFields": [
