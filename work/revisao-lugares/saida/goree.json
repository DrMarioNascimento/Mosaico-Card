      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-viajante-P07",
      "factKey": "goree-F07",
      "text": "Ruas, praças e casas antigas fazem parte do passeio pela ilha.",
