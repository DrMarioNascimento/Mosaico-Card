      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-geografo-P18",
      "factKey": "goree-F19",
      "text": "Destino de peregrinação da diáspora africana, o lugar é associado a ideais de reconciliação e perdão.",
