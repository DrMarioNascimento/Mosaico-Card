      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-viajante-P09",
      "factKey": "goree-F09",
      "text": "Portugueses, holandeses, ingleses e franceses dominaram a ilha, um depois do outro.",
