      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-viajante-P06",
      "factKey": "goree-F06",
      "text": "A pequena cidade ocupa quase a ilha inteira.",
