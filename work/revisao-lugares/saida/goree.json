       "C1",
       "C3"
      ],
      "sources": [
       "GOREE_SOUV"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-viajante-P05",
      "factKey": "goree-F05",
      "text": "Fica logo ao sul da península do Cabo Verde, no litoral do continente.",
