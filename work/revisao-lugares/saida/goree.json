       "GOREE_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-viajante-P02",
      "factKey": "goree-F02",
      "text": "O chão da ilha é de rocha vulcânica, bem árida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "GOREE_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-viajante-P03",
      "factKey": "goree-F03",
      "text": "Fica no litoral do Senegal.",
      "relatedFields": [
