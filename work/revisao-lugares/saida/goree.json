      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-geografo-P07",
      "factKey": "goree-F08",
      "text": "Do século XV ao XIX, potências europeias usaram a ilha, sucessivamente, como escala e mercado de escravizados.",
