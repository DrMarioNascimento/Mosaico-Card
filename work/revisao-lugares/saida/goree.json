      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-viajante-P04",
      "factKey": "goree-F04",
      "text": "A ilha está a uns 3,5 km da costa de Dakar.",
