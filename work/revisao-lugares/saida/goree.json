      ],
      "sources": [
       "GOREE_SOUV"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "goree-viajante-P08",
      "factKey": "goree-F08",
      "text": "Do século XV ao XIX, a ilha foi um grande centro do tráfico de pessoas escravizadas.",
