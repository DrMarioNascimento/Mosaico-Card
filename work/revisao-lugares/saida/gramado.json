      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P14",
      "factKey": "gramado-F14",
      "text": "Uma regra urbanística exige estilo arquitetônico alemão nas construções.",
