       "C1"
      ],
      "sources": [
       "GRA_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P04",
      "factKey": "gramado-F04",
      "text": "A chuva média anual fica em torno de 2.000 mm.",
