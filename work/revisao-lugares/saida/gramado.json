       "C1"
      ],
      "sources": [
       "GRA_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P05",
      "factKey": "gramado-F05",
      "text": "O povoamento começou em 1875, com uma família que se fixou onde hoje fica a cidade.",
