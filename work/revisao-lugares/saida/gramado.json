       "C1"
      ],
      "sources": [
       "GRA_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P07",
      "factKey": "gramado-F07",
      "text": "Em 1904 criou-se um distrito chamado Linha Nova, subordinado a Taquara do Mundo Novo.",
