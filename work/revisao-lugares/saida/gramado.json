       "C1"
      ],
      "sources": [
       "GRA_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P08",
      "factKey": "gramado-F08",
      "text": "Em 1913, a sede distrital foi transferida para o local atual e o distrito mudou de nome.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "GRA_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P09",
      "factKey": "gramado-F09",
      "text": "Correio e escritório bancário chegaram em 1918; a iluminação por usina própria, em 1920.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "GRA_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P10",
      "factKey": "gramado-F10",
      "text": "A chegada dos trilhos da Viação Férrea, em 1919 segundo o IBGE, integrou o núcleo à rede ferroviária estadual.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "GRA_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P11",
      "factKey": "gramado-F11",
      "text": "A emancipação veio pela Lei Estadual nº 2.522, de dezembro de 1954, com instalação em julho de 1955.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "GRA_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P12",
      "factKey": "gramado-F12",
      "text": "Povoados como Várzea Grande e Linha 28 já constavam do território distrital em 1926.",
