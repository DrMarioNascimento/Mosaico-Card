   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "gramado-geografo-P01",
      "factKey": "gramado-F01",
      "text": "O município se situa na Serra Gaúcha, a cerca de 850 m de altitude, com clima Cfb.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "GRA_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P02",
      "factKey": "gramado-F02",
      "text": "Pequeno em área (cerca de 237 km²), é formado apenas pelo distrito sede.",
