       "C1"
      ],
      "sources": [
       "GRA_WIKI",
       "GRA_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P03",
      "factKey": "gramado-F03",
      "text": "O clima de altitude traz verões com média em torno de 22 °C e invernos com geadas fortes e neve ocasional.",
