       "C1"
      ],
      "sources": [
       "GRA_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P06",
      "factKey": "gramado-F06",
      "text": "A portugueses seguiram-se alemães, por volta de 1880, e italianos vindos de Caxias do Sul.",
