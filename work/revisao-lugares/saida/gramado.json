       "C1"
      ],
      "sources": [
       "GRA_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "gramado-geografo-P13",
      "factKey": "gramado-F13",
      "text": "O Censo de 2022 contou cerca de 40 mil habitantes no município.",
