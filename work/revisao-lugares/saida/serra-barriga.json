            ],
            "sources": [
              "BARRIGA_AGBR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-barriga-geografo-P07",
            "factKey": "serra-barriga-F07",
            "text": "A Agência Brasil situa essa resistência entre 1597 e 1704, mais de um século do período colonial.",
