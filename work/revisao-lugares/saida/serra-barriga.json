            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-barriga-geografo-P08",
            "factKey": "serra-barriga-F08",
            "text": "A sucessão de lideranças inclui Acotirene, Ganga Zumba e Zumbi.",
