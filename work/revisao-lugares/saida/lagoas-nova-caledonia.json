              "NC_TURISMO_SITIOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-viajante-P19",
            "factKey": "lagoas-nova-caledonia-F19",
            "text": "As comunidades indígenas estão sendo incluídas na gestão das áreas marinhas.",
