          },
          {
            "id": "lagoas-nova-caledonia-viajante-P02",
            "factKey": "lagoas-nova-caledonia-F02",
            "text": "O bem é dividido em seis áreas marinhas separadas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
