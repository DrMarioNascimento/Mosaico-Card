              "C1"
            ],
            "sources": [
              "NC_TURISMO_SITIOS"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-viajante-P13",
            "factKey": "lagoas-nova-caledonia-F13",
            "text": "No norte, o estuário do Diahot tem o maior manguezal do território.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NC_TURISMO_SITIOS"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-viajante-P14",
            "factKey": "lagoas-nova-caledonia-F14",
            "text": "Mantas, peixes-napoleão e tubarões aparecem nas lagoas.",
