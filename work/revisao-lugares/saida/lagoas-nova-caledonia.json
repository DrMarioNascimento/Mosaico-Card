            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-viajante-P03",
            "factKey": "lagoas-nova-caledonia-F03",
            "text": "A barreira de recifes, dupla em alguns trechos, tem quase 1.600 km.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NC_TURISMO",
              "NC_TURISMO_SITIOS"
            ],
            "clueType": "paisagem",
