              "C1"
            ],
            "sources": [
              "NC_TURISMO_SITIOS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-viajante-P15",
            "factKey": "lagoas-nova-caledonia-F15",
            "text": "Uma das áreas reúne atóis afastados, onde aves marinhas e tartarugas-verdes se reproduzem.",
