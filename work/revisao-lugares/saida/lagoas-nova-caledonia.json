              "C1"
            ],
            "sources": [
              "NC_TURISMO_SITIOS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-viajante-P16",
            "factKey": "lagoas-nova-caledonia-F16",
            "text": "Esses atóis afastados ficam dentro do Parque Natural do Mar de Coral.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NC_TURISMO_SITIOS"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-viajante-P17",
            "factKey": "lagoas-nova-caledonia-F17",
            "text": "A grande lagoa do norte cobre mais de um terço de toda a área de lagoas do território.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "NC_TURISMO_SITIOS"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-viajante-P18",
            "factKey": "lagoas-nova-caledonia-F18",
            "text": "Há um só atol habitado no território, e ele faz parte do bem.",
