            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lagoas-nova-caledonia-geografo-P25",
            "factKey": "lagoas-nova-caledonia-F46",
            "text": "A grande lagoa do norte fica junto às ilhas Belep, e a do sul banha o extremo sul da Grande Terre e a Ilha dos Pinheiros.",
            "relatedFields": [
