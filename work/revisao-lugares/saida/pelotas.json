            "sources": [
              "PELOTAS_UFPEL_INV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "pelotas-viajante-P09",
            "factKey": "pelotas-viajante-F09",
            "text": "Em 2018, essas tradições doceiras foram reconhecidas como patrimônio imaterial pelo Iphan.",
