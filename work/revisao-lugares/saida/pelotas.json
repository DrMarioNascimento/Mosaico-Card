            ],
            "sources": [
              "PELOTAS_UFPEL_INV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "pelotas-viajante-P07",
            "factKey": "pelotas-viajante-F07",
            "text": "Pessegada, passa de pêssego e marmelada branca estão entre os doces de fruta da região.",
