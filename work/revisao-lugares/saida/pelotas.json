            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "pelotas-viajante-P06",
            "factKey": "pelotas-viajante-F06",
            "text": "Há dois tipos de tradição: os doces finos, de bandeja, e os doces coloniais, de frutas.",
