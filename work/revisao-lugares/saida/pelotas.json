              "C3"
            ],
            "sources": [
              "PELOTAS_UFPEL_INV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "pelotas-viajante-P08",
            "factKey": "pelotas-viajante-F08",
            "text": "No interior, a fruta era descascada à mão e cozida em tachos de cobre no fogão a lenha.",
