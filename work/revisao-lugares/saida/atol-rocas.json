  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "atol-rocas-viajante-P01",
      "factKey": "atol-rocas-F01",
      "text": "É uma área protegida no meio do oceano, longe do continente.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P02",
      "factKey": "atol-rocas-F02",
      "text": "O lugar fica em águas tropicais do Atlântico Sul.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR",
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P03",
      "factKey": "atol-rocas-F03",
      "text": "Turistas não podem visitar: só entram equipes de pesquisa e monitoramento.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR",
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P04",
      "factKey": "atol-rocas-F04",
      "text": "A proteção oficial do lugar começou em 1979.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR",
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P05",
      "factKey": "atol-rocas-F05",
      "text": "O recife tem formato quase oval, com cerca de 3,7 km no lado maior.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P06",
      "factKey": "atol-rocas-F06",
      "text": "Dentro do anel de recifes ficam duas pequenas ilhas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P07",
      "factKey": "atol-rocas-F07",
      "text": "Uma dessas ilhas se chama Ilha do Farol.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P08",
      "factKey": "atol-rocas-F08",
      "text": "A outra ilha tem o nome de Ilha do Cemitério.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P09",
      "factKey": "atol-rocas-F09",
      "text": "Na maré baixa, aparecem lagoas e piscinas naturais cheias de peixes.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P10",
      "factKey": "atol-rocas-F10",
      "text": "Quem construiu o recife foram sobretudo algas que fabricam calcário, e não corais.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P11",
      "factKey": "atol-rocas-F11",
      "text": "A vegetação das ilhas é baixa, de ervas e capins que aguentam o sal.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P12",
      "factKey": "atol-rocas-F12",
      "text": "Tartarugas-verdes usam o lugar para se reproduzir.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR",
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P13",
      "factKey": "atol-rocas-F13",
      "text": "A tartaruga-de-pente também se reproduz por lá.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P14",
      "factKey": "atol-rocas-F14",
      "text": "O tubarão-limão usa essas águas como berçário.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P15",
      "factKey": "atol-rocas-F15",
      "text": "Mais de 150 mil aves marinhas já foram contadas no lugar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P16",
      "factKey": "atol-rocas-F16",
      "text": "Alguns moluscos encontrados ali não existem em nenhum outro lugar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P17",
      "factKey": "atol-rocas-F17",
      "text": "Pesquisadores acharam ali esponjas que provavelmente eram novas para a ciência.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P18",
      "factKey": "atol-rocas-F18",
      "text": "Uma espécie de lagosta tem ali uma população muito abundante.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P19",
      "factKey": "atol-rocas-F19",
      "text": "Quem administra a área é o ICMBio, órgão federal de conservação.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P20",
      "factKey": "atol-rocas-F20",
      "text": "Fica a uns 267 km de Natal, mar adentro.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "ROCAS_RAMSAR",
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P21",
      "factKey": "atol-rocas-F21",
      "text": "Administrativamente, a área faz parte do Rio Grande do Norte.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P22",
      "factKey": "atol-rocas-F22",
      "text": "O lugar é Patrimônio Mundial da UNESCO desde 2001.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P23",
      "factKey": "atol-rocas-F23",
      "text": "Esse título da UNESCO é dividido com um arquipélago vizinho.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P24",
      "factKey": "atol-rocas-F24",
      "text": "Fica cerca de 148 km a oeste de Fernando de Noronha.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-viajante-P25",
      "factKey": "atol-rocas-F25",
      "text": "É o único atol do Atlântico Sul.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "atol-rocas-geografo-P01",
      "factKey": "atol-rocas-F01",
      "text": "É uma unidade federal de conservação marinha isolada em mar aberto.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P02",
      "factKey": "atol-rocas-F02",
      "text": "Situa-se em baixa latitude, no setor equatorial do Atlântico Sul.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_UFC",
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P03",
      "factKey": "atol-rocas-F03",
      "text": "A estrutura recifal carbonática assenta-se sobre uma base de origem vulcânica.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P04",
      "factKey": "atol-rocas-F04",
      "text": "O arcabouço do recife foi construído predominantemente por algas coralináceas, não por corais.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ROCAS_RAMSAR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P05",
      "factKey": "atol-rocas-F05",
      "text": "O anel recifal é levemente elíptico: cerca de 3,7 km no eixo leste-oeste e 2,5 km no norte-sul.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P06",
      "factKey": "atol-rocas-F06",
      "text": "No platô recifal, a laguna e um depósito arenoso intermaré concentram a sedimentação.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_UFC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P07",
      "factKey": "atol-rocas-F07",
      "text": "Na baixa-mar, o recife exposto compartimenta o platô em lagunas e piscinas de maré.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P08",
      "factKey": "atol-rocas-F08",
      "text": "Duas ilhas baixas emergem no interior do anel recifal.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_UFC",
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P09",
      "factKey": "atol-rocas-F09",
      "text": "Por ser muito baixo, o conjunto é vulnerável à elevação do nível do mar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P10",
      "factKey": "atol-rocas-F10",
      "text": "A cobertura vegetal é herbácea e resistente ao sal, típica de praias arenosas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P11",
      "factKey": "atol-rocas-F11",
      "text": "Em 2015, cerca de 35 mil hectares da área foram designados sítio Ramsar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_RAMSAR",
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "atol-rocas-geografo-P12",
      "factKey": "atol-rocas-F12",
      "text": "É considerado o segundo sítio de reprodução mais importante do Brasil para tartarugas-verdes e de pente.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ROCAS_IUCN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
