      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-royds-geografo-P20",
      "factKey": "cabo-royds-F20",
      "text": "A cabana integra a Área Antártica Especialmente Protegida nº 157, com entrada só por permissão e com guia treinado.",
