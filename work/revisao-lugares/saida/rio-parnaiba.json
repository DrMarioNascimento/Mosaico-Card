            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-parnaiba-geografo-P08",
            "factKey": "rio-parnaiba-F08",
            "text": "O Poti nasce no Ceará, estado que detém cerca de 5% da bacia.",
