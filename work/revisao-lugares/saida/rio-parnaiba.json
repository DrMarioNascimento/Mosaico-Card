              "C1"
            ],
            "sources": [
              "PARNAIBA_SGB2017",
              "PARNAIBA_SGB2021"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
