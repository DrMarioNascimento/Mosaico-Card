            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-parnaiba-viajante-P09",
            "factKey": "rio-parnaiba-F09",
            "text": "Na foz, o rio se abre em vários braços e ilhas antes de chegar ao mar.",
