            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-parnaiba-geografo-P06",
            "factKey": "rio-parnaiba-F06",
            "text": "A sub-bacia do Canindé é a mais seca (746,5 mm/ano), e a do Longá, no baixo curso, a mais chuvosa (1.370,4 mm).",
