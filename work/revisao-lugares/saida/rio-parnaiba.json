            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "rio-parnaiba-viajante-P07",
            "factKey": "rio-parnaiba-F07",
            "text": "Uma capital estadual fica às suas margens.",
