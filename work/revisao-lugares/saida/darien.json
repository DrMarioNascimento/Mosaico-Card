            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P19",
            "factKey": "darien-F19",
            "text": "Os povos emberá, wounaan e guna têm presença enraizada na região; o uso tradicional manteve florestas antigas intactas em grande parte de 125 mil hectares indígenas.",
            "relatedFields": [
