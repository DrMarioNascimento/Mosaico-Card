            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P14",
            "factKey": "darien-F14",
            "text": "O endemismo é alto tanto entre vertebrados quanto entre invertebrados.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DARIEN_IUCN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P15",
            "factKey": "darien-F15",
            "text": "Predadores de topo, como a onça-pintada, e também a suçuarana integram a fauna.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DARIEN_IUCN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P16",
            "factKey": "darien-F16",
            "text": "Mamíferos ameaçados como a anta-de-baird, o queixada e o macaco-aranha-de-cabeça-castanha ocorrem ali.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "DARIEN_IUCN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P17",
            "factKey": "darien-F17",
            "text": "A harpia, classificada como vulnerável, mantém ali uma de suas populações importantes.",
            "relatedFields": [
