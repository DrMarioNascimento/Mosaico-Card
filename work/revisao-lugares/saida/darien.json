            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P22",
            "factKey": "darien-F22",
            "text": "A área começou a ser protegida em 1972, como reserva florestal, e entrou na Lista do Patrimônio Mundial em 1981.",
            "relatedFields": [
