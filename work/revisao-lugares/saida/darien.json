            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P21",
            "factKey": "darien-F21",
            "text": "O sítio fica inteiramente dentro de uma reserva da biosfera de 859.333 ha, cerca de 280 mil ha maior que o parque.",
            "relatedFields": [
              "C1"
