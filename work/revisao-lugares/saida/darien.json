            "sources": [
              "DARIEN_IUCN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P18",
            "factKey": "darien-F18",
            "text": "O cachorro-vinagre, quase ameaçado, figura entre os mamíferos registrados.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
