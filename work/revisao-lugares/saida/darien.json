            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "darien-geografo-P20",
            "factKey": "darien-F20",
            "text": "A falta de direitos de terra legalmente reconhecidos para os indígenas que vivem no parque é apontada como fragilidade.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
