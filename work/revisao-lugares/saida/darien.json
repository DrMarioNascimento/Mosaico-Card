          },
          {
            "id": "darien-geografo-P13",
            "factKey": "darien-F13",
            "text": "Integra uma ecorregião reconhecida internacionalmente como hotspot de biodiversidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
