              "C1"
            ],
            "sources": [
              "PARNA_AMAZ_PA50"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parna-amazonia-geografo-P07",
            "factKey": "norte-parna-amazonia-F07",
            "text": "A oeste, a unidade faz limite com a Floresta Nacional de Pau-Rosa, criada em 2001.",
