            ],
            "sources": [
              "PARNA_AMAZ_CNUC"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parna-amazonia-geografo-P03",
            "factKey": "norte-parna-amazonia-F03",
            "text": "A unidade foi criada pelo Decreto nº 73.683, de 19 de fevereiro de 1974, com 1 milhão de hectares.",
