              "C3"
            ],
            "sources": [
              "PARNA_AMAZ_CNUC"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parna-amazonia-geografo-P06",
            "factKey": "norte-parna-amazonia-F06",
            "text": "A gestão cabe a uma unidade avançada do ICMBio em Itaituba, que administra outras 11 unidades de conservação.",
