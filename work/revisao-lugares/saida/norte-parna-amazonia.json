            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parna-amazonia-geografo-P04",
            "factKey": "norte-parna-amazonia-F04",
            "text": "Os limites foram revistos em 1985, ampliados em 2006 e alterados novamente por lei em 2012.",
