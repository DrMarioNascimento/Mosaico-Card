              "PARNA_AMAZ_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parna-amazonia-geografo-P08",
            "factKey": "norte-parna-amazonia-F08",
            "text": "O rio principal nasce em antigas rochas ígneas e transporta poucos sedimentos.",
