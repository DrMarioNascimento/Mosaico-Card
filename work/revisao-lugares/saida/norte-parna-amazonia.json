              "C2"
            ],
            "sources": [
              "PARNA_AMAZ_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parna-amazonia-geografo-P09",
            "factKey": "norte-parna-amazonia-F09",
            "text": "O rio funciona como barreira que impede algumas plantas e animais de passar de uma margem à outra.",
