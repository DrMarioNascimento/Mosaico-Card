              "C1"
            ],
            "sources": [
              "PARNA_AMAZ_CNUC",
              "PARNA_AMAZ_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parna-amazonia-geografo-P05",
            "factKey": "norte-parna-amazonia-F05",
            "text": "A unidade se distribui por Itaituba e Aveiro, no Pará, e Maués, no Amazonas.",
