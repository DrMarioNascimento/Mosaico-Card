      ],
      "clueType": "construcao",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P25",
      "factKey": "praga-F25",
      "text": "É a capital e o principal centro econômico e cultural da República Tcheca.",
