  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "praga-viajante-P01",
      "factKey": "praga-F01",
      "text": "É uma capital da Europa Central com um centro histórico pontuado de torres, igrejas e palácios.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "patrimonio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P02",
      "factKey": "praga-F02",
      "text": "O lugar já era habitado no século IX.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT",
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "historia",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P03",
      "factKey": "praga-F03",
      "text": "O centro histórico ocupa as duas margens de um rio.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P04",
      "factKey": "praga-F04",
      "text": "Esse rio é o Vltava.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PRAGA_UNESCO",
       "PRAGA_BRIT"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P05",
      "factKey": "praga-F05",
      "text": "Uma ponte gótica, começada em 1357, liga a Cidade Velha à Cidade Pequena, do outro lado do rio.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA",
       "PRAGA_UNESCO"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P06",
      "factKey": "praga-F06",
      "text": "Na margem esquerda ficam o castelo e a catedral de São Vito.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA",
       "PRAGA_UNESCO"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P07",
      "factKey": "praga-F07",
      "text": "A praça da Cidade Velha é cercada de casas góticas com arcadas e núcleos românicos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P08",
      "factKey": "praga-F08",
      "text": "Na torre da antiga prefeitura há um relógio astronômico instalado em 1410.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "PRAGA_RELOGIO"
      ],
      "clueType": "patrimonio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P09",
      "factKey": "praga-F09",
      "text": "A cada hora, das 9h às 23h, uma procissão dos doze apóstolos aparece no relógio.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "PRAGA_RELOGIO"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P10",
      "factKey": "praga-F10",
      "text": "No relógio, um esqueleto toca o sino e vira uma ampulheta.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "PRAGA_RELOGIO"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P11",
      "factKey": "praga-F11",
      "text": "Uma sinagoga do início do gótico, chamada Velha-Nova, fica no bairro judeu.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P12",
      "factKey": "praga-F12",
      "text": "Mozart está entre as figuras célebres ligadas à cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P13",
      "factKey": "praga-F13",
      "text": "Em 1348, um imperador fundou ali a primeira universidade da Europa Central.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA",
       "PRAGA_UNESCO"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P14",
      "factKey": "praga-F14",
      "text": "Esse imperador, Carlos IV, teve sua capital na cidade de 1346 a 1378.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P15",
      "factKey": "praga-F15",
      "text": "Ele mandou construir uma Cidade Nova, pensada como uma Nova Jerusalém.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P16",
      "factKey": "praga-F16",
      "text": "A Cidade Pequena foi fundada em 1257, ao pé das muralhas do castelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P17",
      "factKey": "praga-F17",
      "text": "Em 1419 e em 1618, revoltosos jogaram autoridades pela janela, episódios chamados de defenestrações.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA",
       "PRAGA_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P18",
      "factKey": "praga-F18",
      "text": "Em 1620, os protestantes sofreram uma derrota decisiva na batalha da Montanha Branca, perto da cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P19",
      "factKey": "praga-F19",
      "text": "Em 1918, a cidade virou capital de uma Tchecoslováquia independente.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P20",
      "factKey": "praga-F20",
      "text": "Em 1968, tropas soviéticas e de outros países do Pacto de Varsóvia ocuparam a cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P21",
      "factKey": "praga-F21",
      "text": "Em 1989, a cidade foi o centro do movimento que derrubou pacificamente o governo comunista.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P22",
      "factKey": "praga-F22",
      "text": "A cidade é famosa por sua música, sua literatura e sua arquitetura.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P23",
      "factKey": "praga-F23",
      "text": "Barreiras móveis contra enchentes protegeram o centro histórico nas cheias de junho de 2013.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PRAGA_RP_CICLO3",
       "PRAGA_UNESCO"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P24",
      "factKey": "praga-F24",
      "text": "Um parque paisagístico de 1885, a sudeste da cidade, também faz parte desse patrimônio da UNESCO.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-viajante-P25",
      "factKey": "praga-F25",
      "text": "É a capital da República Tcheca.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "praga-geografo-P01",
      "factKey": "praga-F26",
      "text": "Para a UNESCO, o centro ilustra o crescimento urbano contínuo da Idade Média até hoje.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "urbanismo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P02",
      "factKey": "praga-F27",
      "text": "No século XIV, a cidade já era um dos principais centros culturais e comerciais da Europa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT"
      ],
      "clueType": "processo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P03",
      "factKey": "praga-F03",
      "text": "O centro se estende pelas duas margens do Vltava, com edifícios dos séculos XI ao XVIII.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P04",
      "factKey": "praga-F29",
      "text": "O núcleo mais antigo foi Vyšehrad, numa colina da margem direita; depois surgiu Hradčany, na margem esquerda.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P05",
      "factKey": "praga-F30",
      "text": "A dinastia dos Přemyslidas, de cerca de 800 a 1306, fez da cidade a base política do Estado boêmio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P06",
      "factKey": "praga-F31",
      "text": "Uma área de mercado virou a Cidade Velha, que por volta de 1230 já tinha estatuto de burgo e muralhas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P07",
      "factKey": "praga-F16",
      "text": "A Cidade Pequena nasceu em 1257 sob as muralhas do castelo, e a ponte de 1357 a ligou à Cidade Velha.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P08",
      "factKey": "praga-F15",
      "text": "O traçado medieval planejado da Cidade Nova cresceu sob o imperador que teve sua capital ali de 1346 a 1378.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA",
       "PRAGA_UNESCO"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P09",
      "factKey": "praga-F13",
      "text": "A universidade de 1348 foi a primeira da Europa Central, e seu ambiente ajudou a formar as ideias do movimento hussita.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "PRAGA_BRIT_HISTORIA",
       "PRAGA_UNESCO"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P10",
      "factKey": "praga-F35",
      "text": "A UNESCO vê no movimento hussita os primeiros passos da Reforma europeia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_UNESCO"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P11",
      "factKey": "praga-F36",
      "text": "A cidade foi foco de oposição aos Habsburgo no início do século XVII, até a derrota protestante de 1620.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT",
       "PRAGA_BRIT_HISTORIA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "praga-geografo-P12",
      "factKey": "praga-F37",
      "text": "O tratado que encerrou a Guerra Austro-Prussiana foi assinado ali em 1866.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PRAGA_BRIT"
      ],
      "clueType": "historia",
