      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P21",
      "factKey": "parque-pireneus-go-F21",
      "text": "A capela do cume foi de madeira em 1932, caiu numa tempestade em 1950 e, já de alvenaria, queimou em 1983.",
