      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P12",
      "factKey": "parque-pireneus-go-F12",
      "text": "A unidade fica no planalto do Alto Tocantins-Paranaíba, em terreno acidentado.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
