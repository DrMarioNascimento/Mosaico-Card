      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P13",
      "factKey": "parque-pireneus-go-F13",
      "text": "O pico de 1.385 m é o segundo ponto mais alto do estado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
