      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P14",
      "factKey": "parque-pireneus-go-F14",
      "text": "Cerrado rupestre, cerrado stricto sensu, campo limpo úmido, veredas e mata de galeria formam o mosaico do Morro Cabeludo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PIR_PARQUESGO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P15",
      "factKey": "parque-pireneus-go-F15",
      "text": "No cerrado rupestre, cactos, orquídeas e bromélias endêmicos crescem sobre a rocha.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PIR_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P16",
      "factKey": "parque-pireneus-go-F16",
      "text": "O Morro Cabeludo é área de nidificação da águia-chilena, de alta relevância para a conservação da espécie.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PIR_PARQUESGO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P17",
      "factKey": "parque-pireneus-go-F17",
      "text": "A temperatura média é de 22 °C, com variação diária de 19 a 33 °C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PIR_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P18",
      "factKey": "parque-pireneus-go-F18",
      "text": "Uma Área de Proteção Ambiental envolve todo o entorno, para proteger os recursos naturais e controlar o ecoturismo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PIR_PARQUESGO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P19",
      "factKey": "parque-pireneus-go-F19",
      "text": "A cascata do córrego Capitão do Mato desce em sete quedas e poços sucessivos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PIR_PARQUESGO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-pireneus-go-geografo-P20",
      "factKey": "parque-pireneus-go-F20",
      "text": "Afloramentos rochosos de formas variadas atraem a escalada em boulder.",
