    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "ilhas-whitsunday-viajante-P01",
            "factKey": "ilhas-whitsunday-F01",
            "text": "São ilhas de morros cobertos de mata, cercadas de praias brancas e águas azul-turquesa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS",
              "WS_NASA",
              "WS_QPWS_HILL"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P02",
            "factKey": "ilhas-whitsunday-F02",
            "text": "O destino fica na costa leste da Austrália, entre o continente e os recifes mais afastados do litoral.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_NASA"
            ],
            "clueType": "localizacao",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P03",
            "factKey": "ilhas-whitsunday-F03",
            "text": "A marca registrada daqui são praias de areia branca de sílica pura.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "WS_TW",
              "WS_QPWS"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P04",
            "factKey": "ilhas-whitsunday-F04",
            "text": "A praia mais famosa tem uns 7 km de areia de sílica.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "WS_TW"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P05",
            "factKey": "ilhas-whitsunday-F05",
            "text": "Numa enseada no norte dessa praia, a maré mistura areia branca e água turquesa em desenhos que mudam o tempo todo.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "WS_QPWS_HILL",
              "WS_TW"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P06",
            "factKey": "ilhas-whitsunday-F06",
            "text": "Uma trilha curta, de 1,3 km ida e volta, leva a mirantes sobre essa enseada.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "WS_QPWS_HILL",
              "WS_TW"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P07",
            "factKey": "ilhas-whitsunday-F07",
            "text": "Não há balsa pública até a praia famosa: chega-se em barcos de passeio.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "WS_TW"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P08",
            "factKey": "ilhas-whitsunday-F08",
            "text": "Voos panorâmicos de hidroavião e helicóptero sobrevoam a enseada, e alguns pousam na praia.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "WS_TW"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P09",
            "factKey": "ilhas-whitsunday-F09",
            "text": "A maioria dos visitantes sai de Airlie Beach, no continente.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_TW"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P10",
            "factKey": "ilhas-whitsunday-F10",
            "text": "A alta temporada é o inverno, de junho a agosto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_TW"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P11",
            "factKey": "ilhas-whitsunday-F11",
            "text": "No inverno, baleias-jubarte são comuns nestas águas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P12",
            "factKey": "ilhas-whitsunday-F12",
            "text": "Tartarugas marinhas, tubarões, raias e centenas de peixes de recife aparecem por aqui.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P13",
            "factKey": "ilhas-whitsunday-F13",
            "text": "Nos meses mais quentes, os passeios fornecem roupas de proteção contra águas-vivas para quem vai nadar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_TW"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P14",
            "factKey": "ilhas-whitsunday-F14",
            "text": "Nas ilhas vive um pequeno canguru-das-rochas, o wallaby-das-rochas-simples (unadorned rock-wallaby).",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P15",
            "factKey": "ilhas-whitsunday-F15",
            "text": "Estas ilhas estão entre as mais livres de pragas do mundo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P16",
            "factKey": "ilhas-whitsunday-F16",
            "text": "Os donos tradicionais, chamados de \"Povo das Canoas\", estão ligados a estas ilhas há pelo menos 9 mil anos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P17",
            "factKey": "ilhas-whitsunday-F17",
            "text": "Eles navegavam em canoas feitas de três pedaços de casca de árvore costurados com raízes.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P18",
            "factKey": "ilhas-whitsunday-F18",
            "text": "Numa enseada de uma das ilhas há arte rupestre aborígine.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS",
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P19",
            "factKey": "ilhas-whitsunday-F19",
            "text": "Há armadilhas de pedra para peixes espalhadas pelas ilhas.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P20",
            "factKey": "ilhas-whitsunday-F20",
            "text": "Uma das ilhas tem uma pista de pouso feita para receber voos diretos das grandes cidades australianas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_NASA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P21",
            "factKey": "ilhas-whitsunday-F21",
            "text": "No século XIX, madeireiros acampavam nas ilhas para cortar araucárias (hoop pine) e abastecer a cidade de Bowen.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P22",
            "factKey": "ilhas-whitsunday-F22",
            "text": "Algumas ilhas já viraram parque nacional no fim da década de 1930.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P23",
            "factKey": "ilhas-whitsunday-F23",
            "text": "As ilhas Molle, deste arquipélago, foram batizadas em 1815 pelo tenente Charles Jeffreys.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P24",
            "factKey": "ilhas-whitsunday-F24",
            "text": "O nome do arquipélago vem do domingo de Pentecostes, em inglês: James Cook passou por aqui nessa época, em junho de 1770.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_NASA",
              "WS_QPWS_CULT"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-viajante-P25",
            "factKey": "ilhas-whitsunday-F25",
            "text": "A Praia Whitehaven fica na maior ilha do arquipélago, que tem o mesmo nome do grupo.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "WS_NASA",
              "WS_TW"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "ilhas-whitsunday-geografo-P01",
            "factKey": "ilhas-whitsunday-F26",
            "text": "São ilhas continentais, e não de coral: terras altas de rocha, com penhascos e cobertas de mata.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "WS_BRIT"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P02",
            "factKey": "ilhas-whitsunday-F27",
            "text": "O arquipélago reúne dezenas de ilhas altas no litoral leste da Austrália, de frente para o continente.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_BRIT",
              "WS_NASA"
            ],
            "clueType": "localizacao",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P03",
            "factKey": "ilhas-whitsunday-F28",
            "text": "Os morros das ilhas são os antigos topos de uma cordilheira costeira que o mar \"afogou\" ao subir.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "WS_QPWS"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P04",
            "factKey": "ilhas-whitsunday-F29",
            "text": "Esse afogamento ocorreu enquanto as calotas polares derretiam, entre 19 mil e 6 mil anos atrás.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "WS_QPWS"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P05",
            "factKey": "ilhas-whitsunday-F30",
            "text": "Em volta das ilhas, manchas azul-claras na água revelam fundos arenosos e recifes de franja rasos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_NASA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P06",
            "factKey": "ilhas-whitsunday-F31",
            "text": "A maior parte da cadeia de ilhas é parque nacional, encaixado dentro de um parque marinho maior.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_NASA",
              "WS_QPWS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P07",
            "factKey": "ilhas-whitsunday-F32",
            "text": "Mais de 96% dos cerca de 30 mil hectares administrados pelo serviço de parques são áreas protegidas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P08",
            "factKey": "ilhas-whitsunday-F33",
            "text": "Em 1820, o capitão Phillip King fez o levantamento de um conjunto maior de ilhas, batizado em homenagem ao duque de Cumberland, de que estas fazem parte.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P09",
            "factKey": "ilhas-whitsunday-F34",
            "text": "A arqueologia indica ocupação aborígine há pelo menos 9 mil anos; numa caverna com arte rupestre, restos de conchas e ossos mostram uso há cerca de 2.500 anos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P10",
            "factKey": "ilhas-whitsunday-F35",
            "text": "Navegadores europeus registraram remadores aborígines percorrendo 21 km de canoa entre duas ilhas.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P11",
            "factKey": "ilhas-whitsunday-F36",
            "text": "Numa pedreira na Ilha South Molle foram achados machados e ferramentas de corte de pedra.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P12",
            "factKey": "ilhas-whitsunday-F37",
            "text": "Arpões destacáveis serviam para caçar dugongos, e redes de capim trançado pegavam peixes e mariscos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P13",
            "factKey": "ilhas-whitsunday-F38",
            "text": "Fibra de hibisco nativo virava sacolas, linhas e redes; a casuarina costeira dava casca medicinal e madeira dura para lanças.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P14",
            "factKey": "ilhas-whitsunday-F39",
            "text": "O fogo era usado para aquecer, cozinhar e manejar os campos de capim das ilhas.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P15",
            "factKey": "ilhas-whitsunday-F40",
            "text": "A partir da década de 1880, muitos aborígines foram removidos à força das ilhas; nos anos 1930, poucos restavam.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P16",
            "factKey": "ilhas-whitsunday-F21",
            "text": "A ocupação europeia começou nos anos 1860, com acampamentos de corte de araucária que abasteceram Bowen por cerca de 40 anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P17",
            "factKey": "ilhas-whitsunday-F41",
            "text": "As primeiras tentativas de criar gado falharam; só no fim do século XIX a criação de ovelhas se firmou.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P18",
            "factKey": "ilhas-whitsunday-F42",
            "text": "O porto de Shute Harbour fica 10 km além de Airlie Beach, e a Ilha Hamilton está 20 km a sudeste dele.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS_HILL"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P19",
            "factKey": "ilhas-whitsunday-F43",
            "text": "No litoral do continente, em frente às ilhas, fica parte do Parque Nacional de Conway.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_NASA"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P20",
            "factKey": "ilhas-whitsunday-F44",
            "text": "Na Segunda Guerra Mundial, as águas entre o continente e as ilhas serviram de abrigo contra tempestades à Marinha dos EUA antes da Batalha do Mar de Coral.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_NASA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P21",
            "factKey": "ilhas-whitsunday-F24",
            "text": "James Cook entrou no arquipélago em 1º de junho de 1770 e batizou a passagem dois dias depois, em 3 de junho.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS_CULT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P22",
            "factKey": "ilhas-whitsunday-F45",
            "text": "Por um erro de data, a chegada de Cook foi na verdade numa segunda-feira, e não no domingo que inspirou o nome — mas o nome ficou.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_NASA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P23",
            "factKey": "ilhas-whitsunday-F46",
            "text": "Entre as plantas raras das ilhas está uma espécie de árvore-garrafa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WS_QPWS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P24",
            "factKey": "ilhas-whitsunday-F47",
            "text": "A trilha do mirante sai de Tongue Point, no lado norte de Hill Inlet, e o parque nacional fica a uns 25 km a leste de Airlie Beach.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "WS_QPWS_HILL"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "ilhas-whitsunday-geografo-P25",
            "factKey": "ilhas-whitsunday-F48",
            "text": "Os donos tradicionais são os Ngaro, o \"Povo das Canoas\", cuja arte rupestre está na enseada de Nara, na Ilha Hook.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WS_QPWS_CULT",
              "WS_QPWS"
            ],
            "clueType": "cultura",
