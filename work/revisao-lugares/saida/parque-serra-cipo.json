          },
          {
            "id": "parque-serra-cipo-viajante-P04",
            "factKey": "parque-serra-cipo-F04",
            "text": "O verão é chuvoso e o inverno é seco; de junho a agosto é a época indicada para banhos e mirantes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_EM_2026"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-viajante-P05",
            "factKey": "parque-serra-cipo-F05",
            "text": "Muitas cachoeiras caem em piscinas naturais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_EM_2026"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-viajante-P06",
            "factKey": "parque-serra-cipo-F06",
            "text": "As altitudes vão de cerca de 750 m até quase 1.670 m.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_FOGO_HIST"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-viajante-P07",
            "factKey": "parque-serra-cipo-F07",
            "text": "Uma das cachoeiras mais procuradas é uma sequência de sete quedas, alcançada por uma trilha de cerca de 8 km.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_EM_2026",
              "CIPO_GEODIV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-viajante-P08",
            "factKey": "parque-serra-cipo-F08",
            "text": "Um cânion com cerca de 6 km de paredões é um dos cenários mais impressionantes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_EM_2026",
              "CIPO_GEODIV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-viajante-P09",
            "factKey": "parque-serra-cipo-F09",
            "text": "Uma cachoeira larga, com uns 10 m de altura e 60 m de largura, fica a 1 km de trilha leve.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_EM_2026"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-viajante-P10",
            "factKey": "parque-serra-cipo-F10",
            "text": "São mais de 60 cachoeiras protegidas, além de cânions, sítios arqueológicos e trilhas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_EM_2026"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-viajante-P11",
            "factKey": "parque-serra-cipo-F11",
            "text": "Abrigos sob as rochas foram usados por antigos caçadores-coletores, e alguns guardam pinturas rupestres.",
