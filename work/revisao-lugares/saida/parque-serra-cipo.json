              "C1"
            ],
            "sources": [
              "CIPO_FOGO_HIST"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-geografo-P04",
            "factKey": "parque-serra-cipo-F04",
            "text": "A serra age como divisor atmosférico: barra a umidade e diferencia a vegetação de cada vertente.",
