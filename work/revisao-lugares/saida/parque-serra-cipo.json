              "C1"
            ],
            "sources": [
              "CIPO_GEODIV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-geografo-P06",
            "factKey": "parque-serra-cipo-F06",
            "text": "A crista é o divisor de águas entre as bacias do São Francisco e do Doce.",
