          },
          {
            "id": "parque-serra-cipo-geografo-P24",
            "factKey": "parque-serra-cipo-F24",
            "text": "A área se reparte de forma desigual: cerca de 65,6% em Jaboticatubas, 18,8% em Morro do Pilar, 8,3% em Santana do Riacho e 7,3% em Itambé do Mato Dentro.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
