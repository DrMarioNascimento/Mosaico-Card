            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-geografo-P09",
            "factKey": "parque-serra-cipo-F09",
            "text": "O clima é tropical de altitude (Cwb), com 1.300 a 1.600 mm de chuva por ano e duas estações bem definidas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_FOGO_HIST"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
