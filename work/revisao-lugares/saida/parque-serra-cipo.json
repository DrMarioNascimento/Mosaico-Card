            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-geografo-P08",
            "factKey": "parque-serra-cipo-F08",
            "text": "O vale do Ribeirão Mascates guarda as menores altitudes do parque, em torno de 800 m.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_GEODIV",
              "CIPO_FOGO_HIST"
            ],
            "clueType": "territorio",
