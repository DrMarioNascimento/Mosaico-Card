      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "parque-serra-cipo-geografo-P01",
            "factKey": "parque-serra-cipo-F01",
            "text": "Unidade de conservação federal em serras de quartzito, cujas partes altas formam um enclave de campos rupestres.",
