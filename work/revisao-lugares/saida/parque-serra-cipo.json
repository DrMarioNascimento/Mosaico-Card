              "C1"
            ],
            "sources": [
              "CIPO_FOGO_HIST",
              "SUDESTE_CIPO_FOGO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-geografo-P07",
            "factKey": "parque-serra-cipo-F07",
            "text": "O rio que dá nome à serra começa na junção dos ribeirões Mascates e Bocaina.",
