              "C1"
            ],
            "sources": [
              "CIPO_GEODIV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-viajante-P12",
            "factKey": "parque-serra-cipo-F12",
            "text": "A região tem quase 200 cavernas conhecidas, e 15 delas ficam dentro do parque.",
