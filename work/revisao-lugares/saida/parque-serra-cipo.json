            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-geografo-P02",
            "factKey": "parque-serra-cipo-F02",
            "text": "Está oficialmente no bioma Cerrado, mas faz transição para a Mata Atlântica na vertente leste.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CIPO_FOGO_HIST"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-geografo-P03",
            "factKey": "parque-serra-cipo-F03",
            "text": "Corresponde à porção meridional de uma cadeia de cerca de 1.000 km que se estende para o norte até a Bahia.",
