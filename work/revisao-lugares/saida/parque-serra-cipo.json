              "C1"
            ],
            "sources": [
              "CIPO_GEODIV"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-serra-cipo-geografo-P05",
            "factKey": "parque-serra-cipo-F05",
            "text": "A vertente oeste é uma escarpa íngreme, enquanto a leste desce em encostas mais suaves.",
