     },
     {
      "id": "half-moon-geografo-P14",
      "factKey": "half-moon-F14",
      "text": "A população reprodutora de skua-polar-do-sul (103 casais em 1995/96) qualifica a ilha como Área-Chave de Biodiversidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
