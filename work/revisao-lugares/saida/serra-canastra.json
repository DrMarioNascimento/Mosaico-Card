      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "serra-canastra-geografo-P01",
            "factKey": "serra-canastra-F01",
            "text": "Dois chapadões isolados de quartzito metamórfico, separados por um grande vale, formam o núcleo da unidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P02",
            "factKey": "serra-canastra-F02",
            "text": "A cobertura é de Cerrado, com alguma influência da Mata Atlântica.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P03",
            "factKey": "serra-canastra-F03",
            "text": "As escarpas resultam da erosão diferencial: rochas mais brandas se desgastam sob capas de quartzo resistentes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P04",
            "factKey": "serra-canastra-F04",
            "text": "A unidade fica sobre o divisor entre a bacia do Paranaíba, do sistema Paraná–Prata, e a de um grande rio que corre para leste a partir do parque.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL",
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P05",
            "factKey": "serra-canastra-F05",
            "text": "Ao sul, as águas seguem para o Rio Grande; ao norte, para o Araguari, afluente do Paranaíba. Grande e Paranaíba se unem para formar o Paraná.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P06",
            "factKey": "serra-canastra-F06",
            "text": "A nascente histórica de um rio de cerca de 2.700 km fica na serra que dá nome ao parque, a 1.480 m segundo a UNESCO.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P07",
            "factKey": "serra-canastra-F07",
            "text": "Uma queda de 186 m é descrita como a primeira cachoeira desse rio.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P08",
            "factKey": "serra-canastra-F08",
            "text": "A estação seca dura cerca de cinco meses, e abaixo dos 1.000 m a temperatura média fica perto de 20 °C.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P09",
            "factKey": "serra-canastra-F09",
            "text": "Predominam campos rupestres e cerrado, com capões de mata ciliar em vales e ravinas.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P10",
            "factKey": "serra-canastra-F10",
            "text": "Os habitats incluem campos úmidos (campo limpo e veredas), campo rupestre, cerradão e matas de galeria ao longo dos rios maiores.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-geografo-P11",
            "factKey": "serra-canastra-F11",
            "text": "A herpetofauna inclui anfíbios endêmicos, como a perereca Hyla ibitiguara.",
