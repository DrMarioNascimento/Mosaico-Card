            "sources": [
              "CANASTRA_UNESCO_TL",
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P11",
            "factKey": "serra-canastra-F11",
            "text": "Entre as aves estão a ema, a seriema e o tucanuçu.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P12",
            "factKey": "serra-canastra-F12",
            "text": "Também vivem ali o veado-campeiro, o cachorro-vinagre e a lontra.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P13",
            "factKey": "serra-canastra-F13",
            "text": "Um pato criticamente ameaçado, com menos de 250 indivíduos no total, tem ali uma de suas áreas de ocorrência.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CANASTRA_PATO_ICMBIO",
