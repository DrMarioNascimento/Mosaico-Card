            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P10",
            "factKey": "serra-canastra-F10",
            "text": "O tamanduá-bandeira também está entre os mamíferos.",
            "relatedFields": [
