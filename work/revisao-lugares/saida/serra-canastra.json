              "C1",
              "C4"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P22",
            "factKey": "serra-canastra-F22",
            "text": "Passos é apontada como a cidade mais próxima.",
