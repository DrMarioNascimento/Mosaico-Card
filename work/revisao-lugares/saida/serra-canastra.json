            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P07",
            "factKey": "serra-canastra-F07",
            "text": "Uma das cachoeiras tem cerca de 200 m de altura.",
