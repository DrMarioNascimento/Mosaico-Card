            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P06",
            "factKey": "serra-canastra-F06",
            "text": "Centenas de riachos despencam do alto das chapadas em cascatas e cachoeiras.",
