              "C1"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P08",
            "factKey": "serra-canastra-F08",
            "text": "Garagem de Pedras e Curral de Pedras estão entre os atrativos.",
