              "C1"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P19",
            "factKey": "serra-canastra-F19",
            "text": "É ali que fica a nascente histórica do maior rio totalmente brasileiro.",
