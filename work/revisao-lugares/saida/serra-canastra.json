            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P03",
            "factKey": "serra-canastra-F03",
            "text": "As temperaturas vão de 1 °C a 29 °C, com média de 18 °C.",
