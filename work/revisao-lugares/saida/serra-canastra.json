        "cards": [
          {
            "id": "serra-canastra-viajante-P01",
            "factKey": "serra-canastra-F01",
            "text": "É um parque nacional de chapadas altas, cercadas de paredões e cachoeiras.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CANASTRA_UNESCO_TL"
