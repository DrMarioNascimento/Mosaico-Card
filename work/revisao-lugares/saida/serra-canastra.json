              "C1"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P23",
            "factKey": "serra-canastra-F23",
            "text": "Cerca de 45 espécies de plantas são endêmicas: só existem ali.",
