              "SF_CODEVASF_ATLAS"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P20",
            "factKey": "serra-canastra-F20",
            "text": "Foi criado por decreto em abril de 1972, no governo Médici.",
