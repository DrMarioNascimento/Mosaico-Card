            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P24",
            "factKey": "serra-canastra-F24",
            "text": "Seus limites passam por municípios como São Roque de Minas, Vargem Bonita e Delfinópolis.",
