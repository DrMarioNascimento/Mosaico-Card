              "C4"
            ],
            "sources": [
              "CANASTRA_DECRETO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P21",
            "factKey": "serra-canastra-F21",
            "text": "Em 1998, o Brasil o indicou para a lista de candidatos a Patrimônio Mundial da UNESCO.",
