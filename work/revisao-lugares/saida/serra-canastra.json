              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P16",
            "factKey": "serra-canastra-F16",
            "text": "O clima fica na transição entre o tropical quente e o temperado.",
