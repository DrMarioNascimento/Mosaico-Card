              "C1"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P18",
            "factKey": "serra-canastra-F18",
            "text": "O parque fica no sudoeste de Minas Gerais, ao norte do Rio Grande.",
