              "C1"
            ],
            "sources": [
              "CANASTRA_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P05",
            "factKey": "serra-canastra-F05",
            "text": "Com tempo bom, dá para chegar de carro a mirantes por estradas de terra.",
