              "CANASTRA_UNESCO_TL"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "serra-canastra-viajante-P17",
            "factKey": "serra-canastra-F17",
            "text": "Onças-pardas e jaguatiricas também fazem parte da fauna.",
