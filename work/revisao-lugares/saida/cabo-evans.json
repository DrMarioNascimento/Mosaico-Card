      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-evans-geografo-P20",
      "factKey": "cabo-evans-F20",
      "text": "A foca-de-weddell usa regularmente a costa para repouso; a foca-leopardo surge ocasionalmente.",
