      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-evans-geografo-P18",
      "factKey": "cabo-evans-F18",
      "text": "Entre as aves, apenas a skua-polar-do-sul tem reprodução confirmada no cabo.",
