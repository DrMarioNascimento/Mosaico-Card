      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-evans-geografo-P17",
      "factKey": "cabo-evans-F17",
      "text": "Numerosos artefatos permanecem dentro da cabana (Sítio Histórico nº 16) e espalhados pelo entorno.",
