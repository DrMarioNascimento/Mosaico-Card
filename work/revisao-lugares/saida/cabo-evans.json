      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-evans-geografo-P21",
      "factKey": "cabo-evans-F21",
      "text": "Líquens crostosos são a flora registrada nas diretrizes do sítio.",
