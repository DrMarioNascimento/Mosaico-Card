    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "alhambra-granada-viajante-P01",
            "factKey": "alhambra-granada-F01",
            "text": "É um conjunto de palácios e fortificações no alto de uma colina, de onde se vê a cidade lá embaixo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT",
              "ALHAMBRA_RP"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P02",
            "factKey": "alhambra-granada-F02",
            "text": "A pressão do turismo sobre o lugar é considerada significativa e crescente.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_RP"
            ],
            "clueType": "cultura",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P03",
            "factKey": "alhambra-granada-F03",
            "text": "O conjunto ocupa uma de duas colinas vizinhas separadas por um rio; na outra fica um bairro histórico de moradias.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_RP",
              "ALHAMBRA_BRIT"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P04",
            "factKey": "alhambra-granada-F04",
            "text": "O nome vem do árabe e quer dizer, mais ou menos, \"a vermelha\".",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P05",
            "factKey": "alhambra-granada-F05",
            "text": "A cor avermelhada viria da taipa, a terra socada, usada nas muralhas externas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P06",
            "factKey": "alhambra-granada-F06",
            "text": "A maior parte foi construída entre 1238 e 1358.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P07",
            "factKey": "alhambra-granada-F07",
            "text": "Quem começou a obra foi Ibn al-Ahmar, fundador de uma dinastia muçulmana, seguido por seus sucessores.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P08",
            "factKey": "alhambra-granada-F08",
            "text": "Essa dinastia é a dos nasridas, cuja arte e cujas inscrições marcam o conjunto.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "ALHAMBRA_BRIT",
              "ALHAMBRA_RP"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P09",
            "factKey": "alhambra-granada-F09",
            "text": "Inscrições em árabe nas paredes formam uma \"arquitetura falante\", com textos religiosos, políticos e poéticos.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "ALHAMBRA_RP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P10",
            "factKey": "alhambra-granada-F10",
            "text": "Um pátio comprido tem um espelho d'água no centro, ladeado por murtas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P11",
            "factKey": "alhambra-granada-F11",
            "text": "O maior salão, o dos Embaixadores, fica dentro de uma torre e tem uma cúpula de cerca de 23 m de altura.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P12",
            "factKey": "alhambra-granada-F12",
            "text": "Um pátio famoso é cercado por uma galeria de 124 colunas de mármore branco.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P13",
            "factKey": "alhambra-granada-F13",
            "text": "No centro desse pátio, uma fonte é sustentada por 12 leões de mármore.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "ALHAMBRA_BRIT",
              "ALHAMBRA_ARCHNET"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P14",
            "factKey": "alhambra-granada-F14",
            "text": "O palácio desse pátio foi construído pelo sultão Muhammad V no seu segundo reinado, entre 1362 e 1391.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "ALHAMBRA_PATRONATO_LEONES"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P15",
            "factKey": "alhambra-granada-F15",
            "text": "Há indícios de que esse pátio já teve plantas: um relato de 1502, contestado, fala de seis laranjeiras nos cantos.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "ALHAMBRA_ARCHNET"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P16",
            "factKey": "alhambra-granada-F16",
            "text": "A água chegava por um canal que a captava num rio, cerca de 11 km acima.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_PATRONATO_ACEQUIA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P17",
            "factKey": "alhambra-granada-F17",
            "text": "Ao lado fica uma residência de campo dos sultões, com pátios, jardins em terraços e fontes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT",
              "ALHAMBRA_SPAININFO"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P18",
            "factKey": "alhambra-granada-F18",
            "text": "Nessa residência de campo, o Pátio da Acequia tem dois blocos de edifícios nas pontas e um tanque no meio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_SPAININFO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P19",
            "factKey": "alhambra-granada-F19",
            "text": "Em 1526 começou a ser erguido, dentro do conjunto, um palácio renascentista projetado por Pedro Machuca para Carlos V.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P20",
            "factKey": "alhambra-granada-F20",
            "text": "Os mouros foram expulsos em 1492; depois disso, boa parte dos interiores foi danificada ou saqueada.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P21",
            "factKey": "alhambra-granada-F21",
            "text": "Em 1812, tropas francesas explodiram algumas torres.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P22",
            "factKey": "alhambra-granada-F22",
            "text": "Um terremoto em 1821 causou mais estragos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P23",
            "factKey": "alhambra-granada-F23",
            "text": "A restauração começou em 1828, com José Contreras, e a família dele continuou o trabalho por décadas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P24",
            "factKey": "alhambra-granada-F24",
            "text": "O conjunto entrou na lista do Patrimônio Mundial em 1984.",
