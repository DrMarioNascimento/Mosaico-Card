          },
          {
            "id": "alhambra-granada-geografo-P07",
            "factKey": "alhambra-granada-F31",
            "text": "A mesma água servia palácios, banhos, mesquitas, casas, cisternas, fontes, jardins, lavouras e ofícios.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_PATRONATO_ACEQUIA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
