              "C1"
            ],
            "sources": [
              "ALHAMBRA_RP",
              "ALHAMBRA_ICOMOS_1994"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-viajante-P25",
            "factKey": "alhambra-granada-F25",
            "text": "Na colina em frente fica o Albaicín, que a UNESCO considera a cidade hispano-muçulmana mais bem preservada do sul da Espanha.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_RP",
