          },
          {
            "id": "alhambra-granada-geografo-P08",
            "factKey": "alhambra-granada-F32",
            "text": "O efeito de grande pomar da residência de campo dos sultões veio do desvio do rio Darro por canais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "ALHAMBRA_SPAININFO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
