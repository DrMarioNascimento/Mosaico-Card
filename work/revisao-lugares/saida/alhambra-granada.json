      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "alhambra-granada-geografo-P01",
            "factKey": "alhambra-granada-F03",
            "text": "O bem protegido se estende por duas colinas vizinhas separadas por um rio, acima da cidade baixa moderna.",
