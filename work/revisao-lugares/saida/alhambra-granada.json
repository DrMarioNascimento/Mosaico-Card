            ],
            "sources": [
              "ALHAMBRA_PATRONATO_ACEQUIA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-geografo-P06",
            "factKey": "alhambra-granada-F30",
            "text": "O canal contornava a encosta norte do Cerro del Sol e tornou habitável a colina da Sabika.",
