            ],
            "sources": [
              "ALHAMBRA_BRIT"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "alhambra-granada-geografo-P05",
            "factKey": "alhambra-granada-F16",
            "text": "A água era captada num rio cerca de 11 km a montante e levada por um canal, a Acequia Real.",
