            "sources": [
              "FIORDES_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P22",
            "factKey": "fiordes-oeste-noruega-F47",
            "text": "Focas-comuns, salmão-do-atlântico e truta-marinha usam as águas; o lúcio e o pinheiro Pinus contorta aparecem como espécies invasoras.",
            "relatedFields": [
