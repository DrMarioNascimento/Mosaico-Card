            "sources": [
              "FIORDES_UNESCO",
              "FIORDES_RIKSANT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P16",
            "factKey": "fiordes-oeste-noruega-F41",
            "text": "Numa das áreas, 12 pequenas fazendas ainda funcionam e outras 24 mantêm pastagens, sobretudo de cabras e ovelhas.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "FIORDES_IUCN"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P17",
            "factKey": "fiordes-oeste-noruega-F42",
            "text": "Cerca de 85% das terras são privadas, e a maior parte do bem é Paisagem Protegida (categoria V da IUCN).",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "FIORDES_UNESCO",
              "FIORDES_RIKSANT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P18",
            "factKey": "fiordes-oeste-noruega-F43",
            "text": "Perto de uma das áreas extrai-se peridotito; na outra, há extração subterrânea de anortosito.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "FIORDES_UNESCO",
              "FIORDES_RIKSANT"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P19",
            "factKey": "fiordes-oeste-noruega-F44",
            "text": "Os navios de cruzeiro passaram de 308 em 2002 para 328 em 2019, e os passageiros, de 265.585 para 617.545.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "FIORDES_IUCN"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P20",
            "factKey": "fiordes-oeste-noruega-F45",
            "text": "Desde 2000, as geleiras da área perderam 33,2% de sua massa.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "FIORDES_IUCN"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P21",
            "factKey": "fiordes-oeste-noruega-F46",
            "text": "Regras de emissão zero para navios turísticos e balsas passam a valer na área em 2026.",
            "relatedFields": [
              "C1"
