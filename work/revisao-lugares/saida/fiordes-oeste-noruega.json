            ],
            "clueType": "pesquisa",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P24",
            "factKey": "fiordes-oeste-noruega-F49",
            "text": "O bem soma 122.712 ha, dos quais 10.746 ha são de mar.",
