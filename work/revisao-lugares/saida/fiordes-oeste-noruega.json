          },
          {
            "id": "fiordes-oeste-noruega-geografo-P08",
            "factKey": "fiordes-oeste-noruega-F33",
            "text": "Cicatrizes de deslizamentos e depósitos de avalanches marcam as vertentes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "FIORDES_UNESCO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P09",
            "factKey": "fiordes-oeste-noruega-F34",
            "text": "Avalanches, quedas de rochas e deslizamentos são riscos persistentes em várias partes da área e exigem planos de prevenção.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "FIORDES_UNESCO",
              "FIORDES_IUCN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P10",
            "factKey": "fiordes-oeste-noruega-F35",
            "text": "Paredes de rocha cristalina sobem até 1.400 m acima do mar e se prolongam até 500 m abaixo do nível do mar.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "FIORDES_UNESCO",
              "FIORDES_IUCN",
              "FIORDES_RIKSANT"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P11",
            "factKey": "fiordes-oeste-noruega-F36",
            "text": "As duas áreas pertencem a uma paisagem de vales marinhos que se estende por cerca de 500 km, de Stavanger, ao sul, a Åndalsnes, a nordeste.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "FIORDES_UNESCO",
              "FIORDES_RIKSANT"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P12",
            "factKey": "fiordes-oeste-noruega-F37",
            "text": "Os dois vales marinhos estão entre os mais longos e profundos do mundo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "FIORDES_UNESCO",
              "FIORDES_RIKSANT"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P13",
            "factKey": "fiordes-oeste-noruega-F38",
            "text": "Entre cerca de 200 vales marinhos da costa oeste do país, estes são os menos afetados por barragens hidrelétricas e infraestrutura.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "FIORDES_UNESCO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P14",
            "factKey": "fiordes-oeste-noruega-F39",
            "text": "Uma das áreas fica no condado de Møre og Romsdal; a outra, no condado de Vestland.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "FIORDES_RIKSANT"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "fiordes-oeste-noruega-geografo-P15",
            "factKey": "fiordes-oeste-noruega-F40",
            "text": "Restos de antigas fazendas transumantes, hoje quase todas abandonadas, dão uma dimensão cultural à paisagem natural.",
            "relatedFields": [
              "C4"
