      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "centro-penedo-geografo-P08",
      "factKey": "centro-penedo-F08",
      "text": "O topônimo da cidade deriva da formação rochosa em que ela se assenta.",
