      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P17",
      "factKey": "nasca-palpa-F17",
      "text": "A inscrição se apoia em três critérios: realização artística única, testemunho de tradições mágico-religiosas e paisagem cultural simbólica.",
