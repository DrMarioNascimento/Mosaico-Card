  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "nasca-palpa-viajante-P01",
      "factKey": "nasca-palpa-F01",
      "text": "Este destino guarda desenhos enormes feitos no próprio chão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR",
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P02",
      "factKey": "nasca-palpa-F02",
      "text": "A paisagem é uma planície desértica, muito seca e quase sem chuva.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P03",
      "factKey": "nasca-palpa-F03",
      "text": "Fica na América do Sul, numa planície perto da costa.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P04",
      "factKey": "nasca-palpa-F04",
      "text": "O sítio fica no Peru.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "NASCA_PR",
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P05",
      "factKey": "nasca-palpa-F05",
      "text": "Fica a cerca de 400 quilômetros ao sul de Lima.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P06",
      "factKey": "nasca-palpa-F06",
      "text": "Linhas retas cruzam a planície, e algumas têm vários quilômetros de comprimento.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P07",
      "factKey": "nasca-palpa-F07",
      "text": "Triângulos, espirais e retângulos aparecem entre as formas desenhadas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P08",
      "factKey": "nasca-palpa-F08",
      "text": "Algumas linhas saem de uma pequena elevação, como raios, ou dão a volta nela.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P09",
      "factKey": "nasca-palpa-F09",
      "text": "Também há desenhos de plantas, flores e árvores.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR",
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P10",
      "factKey": "nasca-palpa-F10",
      "text": "Aves, insetos e outros animais aparecem entre as figuras.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P11",
      "factKey": "nasca-palpa-F11",
      "text": "Há figuras de seres fantásticos e de objetos do dia a dia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P12",
      "factKey": "nasca-palpa-F12",
      "text": "A figura de um pelicano tem cerca de 285 metros de comprimento.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P13",
      "factKey": "nasca-palpa-F13",
      "text": "Uma ave parecida com um condor mede cerca de 135 metros.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P14",
      "factKey": "nasca-palpa-F14",
      "text": "Entre os animais desenhados estão um macaco, uma aranha, uma orca e um beija-flor.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P15",
      "factKey": "nasca-palpa-F15",
      "text": "Para fazer os traços, tiraram as pedrinhas escuras da superfície e deixaram à vista o chão mais claro.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P16",
      "factKey": "nasca-palpa-F16",
      "text": "O clima seco e o vento, que tira a areia de dentro dos sulcos, conservam os traçados.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P17",
      "factKey": "nasca-palpa-F17",
      "text": "Os desenhos resistem há mais de dois mil anos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P18",
      "factKey": "nasca-palpa-F18",
      "text": "Algumas faixas largas parecem ter sido feitas para reunir muita gente.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P19",
      "factKey": "nasca-palpa-F19",
      "text": "Plataformas na ponta de muitas figuras sugerem que se caminhava sobre elas em procissão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P20",
      "factKey": "nasca-palpa-F20",
      "text": "Pedaços de uma concha marinha achados numa plataforma sugerem rituais ligados à água.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P21",
      "factKey": "nasca-palpa-F21",
      "text": "Uma pesquisadora alemã passou anos estudando o sítio e lutando por sua preservação.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P22",
      "factKey": "nasca-palpa-F22",
      "text": "Para essa pesquisadora, o conjunto funcionava como um enorme calendário astronômico.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P23",
      "factKey": "nasca-palpa-F23",
      "text": "Em 1941, um historiador norte-americano observou as linhas de dentro de um avião.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P24",
      "factKey": "nasca-palpa-F24",
      "text": "A Rodovia Pan-Americana Sul atravessa a área protegida e danificou alguns traçados.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-viajante-P25",
      "factKey": "nasca-palpa-F25",
      "text": "Lixo, mineração e entradas não autorizadas estão entre as ameaças ao lugar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "nasca-palpa-geografo-P01",
      "factKey": "nasca-palpa-F01",
      "text": "O bem é uma paisagem cultural de grande escala, traçada sobre uma planície árida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P02",
      "factKey": "nasca-palpa-F02",
      "text": "Índices de chuva entre os mais baixos do mundo explicam a conservação de traçados expostos ao ar livre.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P03",
      "factKey": "nasca-palpa-F03",
      "text": "Ocupa a planície costeira desértica do sul do Peru.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P04",
      "factKey": "nasca-palpa-F04",
      "text": "Situa-se cerca de 400 km ao sul de Lima, nas planícies desérticas da bacia do Rio Grande.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P05",
      "factKey": "nasca-palpa-F05",
      "text": "Os traçados resultam da retirada do cascalho superficial intemperizado, que expõe o substrato mais claro logo abaixo.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P06",
      "factKey": "nasca-palpa-F06",
      "text": "O vento remove a areia acumulada nos sulcos e, junto com o clima seco, mantém as linhas visíveis.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P07",
      "factKey": "nasca-palpa-F07",
      "text": "Sociedades pré-hispânicas da costa sul produziram os geoglifos entre o século VIII a.C. e o século VIII d.C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P08",
      "factKey": "nasca-palpa-F08",
      "text": "Parte das figuras é anterior à fase principal e se atribui à cultura Paracas, de 400 a 200 a.C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR",
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P09",
      "factKey": "nasca-palpa-F09",
      "text": "As imagens de aparência humana da fase Paracas lembram petróglifos ainda mais antigos da região.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_EB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P10",
      "factKey": "nasca-palpa-F10",
      "text": "Linhas retas, triângulos, retângulos, espirais e linhas onduladas formam a categoria geométrica dos traçados.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P11",
      "factKey": "nasca-palpa-F11",
      "text": "Alguns feixes de linhas irradiam de uma elevação central ou a circundam.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NASCA_PR"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P12",
      "factKey": "nasca-palpa-F12",
      "text": "Certas faixas, chamadas de pistas, parecem ter sido traçadas para acomodar grandes grupos de pessoas.",
