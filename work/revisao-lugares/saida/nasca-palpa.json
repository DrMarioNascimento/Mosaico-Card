      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P18",
      "factKey": "nasca-palpa-F18",
      "text": "Plataformas numa das pontas de muitas figuras indicam um uso cerimonial em procissões.",
