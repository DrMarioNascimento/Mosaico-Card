      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "nasca-palpa-geografo-P19",
      "factKey": "nasca-palpa-F19",
      "text": "Fragmentos de concha Spondylus numa plataforma escavada sugerem rituais ligados à água.",
