  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "balneario-camboriu-viajante-P01",
      "factKey": "balneario-camboriu-viajante-F01",
      "text": "É uma cidade de praia no Sul do Brasil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P02",
      "factKey": "balneario-camboriu-viajante-F02",
      "text": "Na orla central, uma avenida à beira-mar reúne a maior parte dos hotéis.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_JP"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P03",
      "factKey": "balneario-camboriu-viajante-F03",
      "text": "O nome tem origem indígena e lembra cercados de pesca armados nas marés.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P04",
      "factKey": "balneario-camboriu-viajante-F04",
      "text": "Muito antes dos europeus, povos dos sambaquis sepultaram seus mortos numa das praias locais.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P05",
      "factKey": "balneario-camboriu-viajante-F05",
      "text": "O povoamento europeu começou em 1758, com famílias vindas de Porto Belo.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "BC_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P06",
      "factKey": "balneario-camboriu-viajante-F06",
      "text": "O núcleo mais antigo é o bairro da Barra, à margem de um rio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC",
       "BC_OPOVO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P07",
      "factKey": "balneario-camboriu-viajante-F07",
      "text": "No alto de uma escadaria da Barra, uma capela de pedra é bem mais velha que o próprio município.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_OPOVO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P08",
      "factKey": "balneario-camboriu-viajante-F08",
      "text": "Essa capela foi erguida com pedra bruta, conchas e areia, com trabalho de pessoas escravizadas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_OPOVO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P09",
      "factKey": "balneario-camboriu-viajante-F09",
      "text": "A capela se chamava Nossa Senhora do Bom Sucesso e só ganhou o nome de Santo Amaro em 1967.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P10",
      "factKey": "balneario-camboriu-viajante-F10",
      "text": "Nos anos 1920, a pesca artesanal era a principal atividade econômica do lugar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P11",
      "factKey": "balneario-camboriu-viajante-F11",
      "text": "Os primeiros veranistas vieram de Itajaí e Blumenau, muitos de origem alemã, a partir dos anos 1920.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P12",
      "factKey": "balneario-camboriu-viajante-F12",
      "text": "Os primeiros hotéis surgiram para esses veranistas entre o fim dos anos 1920 e os anos 1930.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC",
       "BC_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P13",
      "factKey": "balneario-camboriu-viajante-F13",
      "text": "Separada da orla central por um morro, há uma praia de mar calmo cercada de restaurantes.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_JP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P14",
      "factKey": "balneario-camboriu-viajante-F14",
      "text": "Bondinhos aéreos ligam a orla central a essa praia, passando pelo alto de um morro com Mata Atlântica.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BC_JP",
       "BC_LP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P15",
      "factKey": "balneario-camboriu-viajante-F15",
      "text": "A estação do meio fica no topo do morro, a cerca de 240 metros, com mirantes.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BC_JP",
       "BC_LP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P16",
      "factKey": "balneario-camboriu-viajante-F16",
      "text": "Um barco pirata faz passeios pela orla até a mesma praia de mar calmo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_JP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P17",
      "factKey": "balneario-camboriu-viajante-F17",
      "text": "A Passarela da Barra é reduto de pescadores e de restaurantes de frutos do mar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_JP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P18",
      "factKey": "balneario-camboriu-viajante-F18",
      "text": "Uma estrada panorâmica aberta em 1979 leva a praias de pescadores mais ao sul.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P19",
      "factKey": "balneario-camboriu-viajante-F19",
      "text": "Uma comunidade quilombola vive há mais de 100 anos num morro do município.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P20",
      "factKey": "balneario-camboriu-viajante-F20",
      "text": "Um monumento que se ilumina em cores à noite oferece vista panorâmica da cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_JP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P21",
      "factKey": "balneario-camboriu-viajante-F21",
      "text": "Uma roda-gigante de 65 metros, inaugurada em 2020, fica no extremo norte da orla.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_JP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P22",
      "factKey": "balneario-camboriu-viajante-F22",
      "text": "Hoje, arranha-céus colados à praia são a marca da paisagem urbana.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_JP",
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P23",
      "factKey": "balneario-camboriu-viajante-F23",
      "text": "O município foi criado em 1964, ao se separar da cidade vizinha da qual era distrito.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BC_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P24",
      "factKey": "balneario-camboriu-viajante-F24",
      "text": "Em 1986, uma de suas praias foi a primeira do Brasil a oficializar o naturismo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-viajante-P25",
      "factKey": "balneario-camboriu-viajante-F25",
      "text": "Como os prédios sombreavam a areia à tarde, uma obra de 2021 alargou a faixa de praia de 25 para 75 metros.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_TNH1"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "balneario-camboriu-geografo-P01",
      "factKey": "balneario-camboriu-geografo-F01",
      "text": "Segundo o IBGE, o município é constituído apenas pelo distrito sede.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P02",
      "factKey": "balneario-camboriu-geografo-F02",
      "text": "A expansão urbana deste município litorâneo foi puxada pelo turismo de veraneio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P03",
      "factKey": "balneario-camboriu-geografo-F03",
      "text": "Um sítio de sambaqui escavado nos anos 1970, com 165 sepultamentos, atesta ocupação costeira pré-colonial.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P04",
      "factKey": "balneario-camboriu-geografo-F04",
      "text": "O topônimo indígena alude às camboas, tapagens que retinham peixes na vazante das marés.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P05",
      "factKey": "balneario-camboriu-geografo-F05",
      "text": "O povoado iniciado em 1758, sob uma invocação mariana, tornou-se freguesia em 1849.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BC_IBGE",
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P06",
      "factKey": "balneario-camboriu-geografo-F06",
      "text": "Até o início do século XX, o bairro junto ao rio era o núcleo mais povoado; a centralidade depois migrou para a orla.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P07",
      "factKey": "balneario-camboriu-geografo-F07",
      "text": "A demanda de veraneio vinda do Vale do Itajaí levou à instalação dos primeiros hotéis na avenida de orla.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P08",
      "factKey": "balneario-camboriu-geografo-F08",
      "text": "Em 1954, criou-se um distrito praiano subordinado ao município vizinho, embrião da futura emancipação.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BC_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P09",
      "factKey": "balneario-camboriu-geografo-F09",
      "text": "Na emancipação, propôs-se usar o rio principal como divisa entre os dois municípios, mas o traçado não foi aprovado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P10",
      "factKey": "balneario-camboriu-geografo-F10",
      "text": "A elevação a município veio por lei estadual em 1964, com instalação em julho daquele ano.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BC_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P11",
      "factKey": "balneario-camboriu-geografo-F11",
      "text": "O nome atual do município só foi fixado por outra lei estadual, em 1979.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_IBGE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P12",
      "factKey": "balneario-camboriu-geografo-F12",
      "text": "A verticalização começou com um hotel de 1957 na Barra Sul, primeiro edifício com quatro ou mais pavimentos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P13",
      "factKey": "balneario-camboriu-geografo-F13",
      "text": "O primeiro prédio residencial de apartamentos é de 1959; nos anos 1970, o crescimento urbano e turístico se acelerou.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P14",
      "factKey": "balneario-camboriu-geografo-F14",
      "text": "Na Segunda Guerra, a vigilância costeira fechou a colônia de pescadores, que só voltou a funcionar em 1963.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P15",
      "factKey": "balneario-camboriu-geografo-F15",
      "text": "Uma estrada panorâmica aberta em 1979 passou a dar acesso às localidades pesqueiras do sul do município.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P16",
      "factKey": "balneario-camboriu-geografo-F16",
      "text": "Entre a orla central e uma praia de águas calmas ergue-se um morro de cerca de 240 metros com Mata Atlântica.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BC_LP",
       "BC_JP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P17",
      "factKey": "balneario-camboriu-geografo-F17",
      "text": "Esse relevo é vencido por um sistema de três estações, com a intermediária no topo do morro.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BC_JP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P18",
      "factKey": "balneario-camboriu-geografo-F18",
      "text": "O parque desse transporte mantém uma reserva urbana de cerca de 6 hectares cortada por trilhas.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BC_LP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P19",
      "factKey": "balneario-camboriu-geografo-F19",
      "text": "A comunidade quilombola do Morro do Boi descende de pessoas escravizadas citadas num inventário de 1864.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P20",
      "factKey": "balneario-camboriu-geografo-F20",
      "text": "As obras da BR-101, iniciadas em 1997, atingiram casas dessa comunidade sem consulta nem indenização.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P21",
      "factKey": "balneario-camboriu-geografo-F21",
      "text": "A densidade de torres junto ao mar passou a sombrear a faixa de areia a partir das 15h.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_TNH1"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P22",
      "factKey": "balneario-camboriu-geografo-F22",
      "text": "A resposta foi uma engorda de praia, com areia dragada a até 40 metros de profundidade numa jazida a 15 km.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_TNH1"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P23",
      "factKey": "balneario-camboriu-geografo-F23",
      "text": "A faixa de areia da obra soma 5,8 km e, no trecho sul, vai até um molhe.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_TNH1"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P24",
      "factKey": "balneario-camboriu-geografo-F24",
      "text": "A engorda iniciada em 2021 triplicou a largura da faixa de areia, de 25 para 75 metros.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_TNH1"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "balneario-camboriu-geografo-P25",
      "factKey": "balneario-camboriu-geografo-F25",
      "text": "O município abriga a primeira praia do país a oficializar o naturismo, em 1986.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BC_FCBC"
      ],
      "clueType": "territorio",
