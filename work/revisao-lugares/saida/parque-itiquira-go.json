   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "parque-itiquira-go-geografo-P01",
      "factKey": "parque-itiquira-go-F01",
      "text": "Unidade municipal de lazer e conservação na borda de um planalto do Brasil central.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008",
       "ITI_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P02",
      "factKey": "parque-itiquira-go-F02",
      "text": "Situa-se num município chamado de \"Berço das Águas\", com nascentes das três principais bacias da América do Sul.",
      "relatedFields": [
       "C3",
       "C4"
      ],
      "sources": [
       "ITI_GOTUR_FORMOSA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P03",
      "factKey": "parque-itiquira-go-F03",
      "text": "O município funciona como divisor entre as bacias do Paraná, do São Francisco e do Tocantins.",
      "relatedFields": [
       "C3",
       "C4"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P04",
      "factKey": "parque-itiquira-go-F04",
      "text": "O rio do salto é afluente do Paranã e pertence à bacia do Tocantins.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ITI_GOTUR_FORMOSA",
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P05",
      "factKey": "parque-itiquira-go-F05",
      "text": "A queda despenca do planalto central, ao norte da cidade, para o vale profundo do Paranã.",
      "relatedFields": [
       "C2",
       "C4"
      ],
      "sources": [
       "ITI_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P06",
      "factKey": "parque-itiquira-go-F06",
      "text": "O salto está na Serra Geral do Paranã, num relevo de estrutura falhada.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P07",
      "factKey": "parque-itiquira-go-F07",
      "text": "A escarpa é de falha inversa, com capa de quartzitos do Grupo Paranoá; ao cruzá-la, o rio formou a queda.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P08",
      "factKey": "parque-itiquira-go-F08",
      "text": "Com 168 m de queda livre, é tida como a mais alta cachoeira de visitação aberta do país.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ITI_UNB_2008",
       "ITI_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P09",
      "factKey": "parque-itiquira-go-F09",
      "text": "A vegetação segue um gradiente: campo na entrada, cerradão nas trilhas e matas de galeria e ciliares junto ao rio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-geografo-P10",
      "factKey": "parque-itiquira-go-F10",
      "text": "O clima é tropical úmido a subúmido, no domínio do Cerrado.",
      "relatedFields": [
       "C1"
      ],
