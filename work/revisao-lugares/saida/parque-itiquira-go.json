      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P07",
      "factKey": "parque-itiquira-go-F07",
      "text": "A atração principal é uma queda-d'água de 168 metros.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ITI_PREF_MASCOTE",
       "ITI_UNB_2008",
       "ITI_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P08",
      "factKey": "parque-itiquira-go-F08",
      "text": "É apontada como a cachoeira mais alta do Brasil aberta à visitação.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ITI_UNB_2008",
       "ITI_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P09",
      "factKey": "parque-itiquira-go-F09",
      "text": "Uma trilha calçada, com pontes, leva em cerca de 15 minutos até um mirante.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P10",
      "factKey": "parque-itiquira-go-F10",
      "text": "Outra trilha, de cerca de 1,2 km, é bem mais difícil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P11",
      "factKey": "parque-itiquira-go-F11",
      "text": "Há poços para banho, restaurante e estacionamento.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008",
       "ITI_PREF_MASCOTE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P12",
      "factKey": "parque-itiquira-go-F12",
      "text": "Em volta há campo, cerradão e matas ao longo do rio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P13",
      "factKey": "parque-itiquira-go-F13",
      "text": "Ipês, angicos e jatobás estão entre as árvores do parque.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P14",
      "factKey": "parque-itiquira-go-F14",
      "text": "Lobo-guará, seriema e tamanduá-bandeira estão entre os bichos citados no parque.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P15",
      "factKey": "parque-itiquira-go-F15",
      "text": "Em certas épocas, dá para ver mais de 120 espécies de aves.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P16",
      "factKey": "parque-itiquira-go-F16",
      "text": "Caça e pesca são proibidas no parque.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P17",
      "factKey": "parque-itiquira-go-F17",
      "text": "A maior parte das visitas acontece em fins de semana e feriados.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P18",
      "factKey": "parque-itiquira-go-F18",
      "text": "A cachoeira é tratada como símbolo natural da cidade.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "ITI_PREF_MASCOTE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P19",
      "factKey": "parque-itiquira-go-F19",
      "text": "Acima do salto, uma fábrica engarrafa a água do rio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P20",
      "factKey": "parque-itiquira-go-F20",
      "text": "A cidade do parque é conhecida como \"Berço das Águas\".",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITI_GOTUR_FORMOSA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P21",
      "factKey": "parque-itiquira-go-F21",
      "text": "A região turística oficial se chama Águas e Cavernas do Cerrado.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ITI_GOTUR_FORMOSA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P22",
      "factKey": "parque-itiquira-go-F22",
      "text": "O rio do salto deságua no rio Paranã.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ITI_GOTUR_FORMOSA",
       "ITI_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P23",
      "factKey": "parque-itiquira-go-F23",
      "text": "O nome do parque vem do tupi e tem a ver com água.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ITI_PREF_MASCOTE",
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P24",
      "factKey": "parque-itiquira-go-F24",
      "text": "A área foi desapropriada pelo município de Formosa em 1973.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parque-itiquira-go-viajante-P25",
      "factKey": "parque-itiquira-go-F25",
      "text": "Fica cerca de 34 km ao norte de Formosa, em Goiás.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "ITI_WIKI",
       "ITI_UNB_2008"
      ],
      "clueType": "territorio",
