      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "mesa-verde-geografo-P09",
      "factKey": "mesa-verde-F09",
      "text": "Além das moradias nos paredões, outros 4.300 sítios arqueológicos foram descobertos.",
