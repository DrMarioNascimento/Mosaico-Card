      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "mesa-verde-geografo-P12",
      "factKey": "mesa-verde-F12",
      "text": "A UNESCO destaca Cliff Palace, Balcony House e Square Tower House entre as moradias sob os paredões.",
