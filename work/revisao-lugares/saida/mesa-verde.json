      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "mesa-verde-geografo-P10",
      "factKey": "mesa-verde-F10",
      "text": "A boa conservação reflete a engenharia dos construtores e o ambiente seco das reentrâncias rochosas.",
