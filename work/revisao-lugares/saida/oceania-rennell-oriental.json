          },
          {
            "id": "oceania-rennell-oriental-geografo-P22",
            "factKey": "oceania-rennell-oriental-F22",
            "text": "Está na Lista do Patrimônio Mundial em Perigo desde 2013, em parte por impactos da mudança do clima.",
            "relatedFields": [
