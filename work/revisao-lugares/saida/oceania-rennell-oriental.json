            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "oceania-rennell-oriental-geografo-P17",
            "factKey": "oceania-rennell-oriental-F17",
            "text": "A exploração de madeira e a mineração de bauxita no oeste da ilha chegaram perto do limite: corte a cerca de 200 m e minas a até 12 km.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "RENNELL_IUCN"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "oceania-rennell-oriental-geografo-P18",
            "factKey": "oceania-rennell-oriental-F18",
            "text": "Em 2019, um navio cargueiro encalhou na baía de Kangava e causou um derramamento de óleo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "RENNELL_IUCN"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "oceania-rennell-oriental-geografo-P19",
            "factKey": "oceania-rennell-oriental-F19",
            "text": "A terra está sob propriedade e manejo consuetudinários das comunidades.",
            "relatedFields": [
              "C1"
