            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "oceania-rennell-oriental-geografo-P20",
            "factKey": "oceania-rennell-oriental-F20",
            "text": "Cerca de 1.200 pessoas de origem polinésia viviam em quatro aldeias na inscrição; hoje cerca de 350 residem dentro do bem.",
