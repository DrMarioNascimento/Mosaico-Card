            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "oceania-rennell-oriental-geografo-P21",
            "factKey": "oceania-rennell-oriental-F21",
            "text": "A subsistência combina roças, caça e pesca, incluindo a coleta do caranguejo-dos-coqueiros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "RENNELL_IUCN"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
