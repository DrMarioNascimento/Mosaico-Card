            ],
            "sources": [
              "SULSM_CB",
              "SULSM_JC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P12",
            "factKey": "santa-maria-rs-viajante-F12",
            "text": "Essas casas foram projetadas por um engenheiro belga no começo do século XX.",
