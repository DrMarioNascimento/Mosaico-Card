        "label": "Viajante",
        "cards": [
          {
            "id": "santa-maria-rs-viajante-P01",
            "factKey": "santa-maria-rs-viajante-F01",
            "text": "É uma cidade do interior do Sul do Brasil, cercada por morros.",
