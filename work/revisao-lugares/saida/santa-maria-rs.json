            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P03",
            "factKey": "santa-maria-rs-viajante-F03",
            "text": "Fica no centro do estado, a cerca de 290 km da capital.",
