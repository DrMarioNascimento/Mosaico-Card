      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "santa-maria-rs-geografo-P01",
            "factKey": "santa-maria-rs-geografo-F01",
            "text": "A posição no centro do território gaúcho ajuda a explicar o peso regional da cidade.",
