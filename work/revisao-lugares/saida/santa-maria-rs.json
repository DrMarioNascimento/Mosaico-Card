            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P05",
            "factKey": "santa-maria-rs-viajante-F05",
            "text": "Virou um dos principais entroncamentos ferroviários do Sul do país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
