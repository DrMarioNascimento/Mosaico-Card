            "sources": [
              "SULSM_CB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P18",
            "factKey": "santa-maria-rs-viajante-F18",
            "text": "A universidade tem um planetário de 1971, nascido de um esboço de Oscar Niemeyer.",
