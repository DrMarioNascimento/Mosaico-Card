          },
          {
            "id": "santa-maria-rs-viajante-P02",
            "factKey": "santa-maria-rs-viajante-F02",
            "text": "No inverno faz frio de verdade, com geadas frequentes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
