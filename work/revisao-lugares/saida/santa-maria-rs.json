            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P17",
            "factKey": "santa-maria-rs-viajante-F17",
            "text": "O campus da universidade fica no bairro Camobi e ocupa mais de 1.800 hectares.",
