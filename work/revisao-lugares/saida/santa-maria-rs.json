              "SULSM_JC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P06",
            "factKey": "santa-maria-rs-viajante-F06",
            "text": "A antiga estação, conhecida como Gare, fica no fim de uma avenida central.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "SULSM_IPAT",
              "SULSM_CB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P07",
            "factKey": "santa-maria-rs-viajante-F07",
            "text": "A estação tem um prédio central de dois pavimentos, com portas e janelas de detalhes neoclássicos.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "SULSM_IPAT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P08",
            "factKey": "santa-maria-rs-viajante-F08",
            "text": "A plataforma de embarque tem cobertura de ferro com enfeites art nouveau.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "SULSM_IPAT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P09",
            "factKey": "santa-maria-rs-viajante-F09",
            "text": "Hoje o prédio da estação abriga um ateliê de artistas e a secretaria municipal de cultura.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "SULSM_IPAT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P10",
            "factKey": "santa-maria-rs-viajante-F10",
            "text": "Os trens de passageiros deixaram de circular por ali em 1996.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SULSM_IPAT"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "santa-maria-rs-viajante-P11",
            "factKey": "santa-maria-rs-viajante-F11",
            "text": "Uma vila de 84 casas geminadas foi construída para os ferroviários.",
            "relatedFields": [
              "C1",
