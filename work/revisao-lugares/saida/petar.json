    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "petar-viajante-P01",
            "factKey": "petar-F01",
            "text": "É uma grande área protegida de Mata Atlântica no Sudeste, cheia de trilhas, rios e cachoeiras.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ANPTUR",
              "PETAR_CNN"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P02",
            "factKey": "petar-F02",
            "text": "O passeio mais procurado ali é entrar em cavernas, sempre com lanterna na mão.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SEMIL_CONCESSAO",
              "PETAR_ALESP"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P03",
            "factKey": "petar-F03",
            "text": "Fica no sul do estado de São Paulo, numa região de serras e floresta conhecida como Vale do Ribeira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SEMIL_ECOTURISMO",
              "PETAR_CNN"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P04",
            "factKey": "petar-F04",
            "text": "Da capital paulista até lá são mais de 300 km de estrada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_CNN",
              "PETAR_OECO"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P05",
            "factKey": "petar-F05",
            "text": "A UNESCO reconhece o parque como Patrimônio Mundial.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SEMIL_CONCESSAO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P06",
            "factKey": "petar-F06",
            "text": "Para entrar nas cavernas é obrigatório ir com um monitor local, levar lanterna e usar calça comprida até o tornozelo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ALESP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P07",
            "factKey": "petar-F07",
            "text": "Há centenas de cavernas catalogadas, mas só 12 estão abertas à visitação.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ALESP",
              "PETAR_CNN"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P08",
            "factKey": "petar-F08",
            "text": "Mais da metade dos visitantes de cada ano são estudantes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ALESP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P09",
            "factKey": "petar-F09",
            "text": "A visita é organizada em quatro núcleos, cada um com suas cavernas e trilhas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ALESP",
              "PETAR_ANPTUR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P10",
            "factKey": "petar-F10",
            "text": "No núcleo mais visitado, uma caverna de vários quilômetros tem passarelas e pontes de madeira nos cerca de 800 m abertos ao público.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_CNN",
              "PETAR_OECO",
              "PETAR_ALESP"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P11",
            "factKey": "petar-F11",
            "text": "Numa das cavernas o percurso é feito todo dentro d'água, às vezes com a água no pescoço.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_CNN"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P12",
            "factKey": "petar-F12",
            "text": "Dentro de outra caverna há uma cachoeira onde dá para tomar banho.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_CNN"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P13",
            "factKey": "petar-F13",
            "text": "Uma trilha de cerca de uma hora à beira de um rio leva a uma caverna e termina numa cachoeira de 35 m.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_CNN"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P14",
            "factKey": "petar-F14",
            "text": "Lá dentro, as cavernas são enfeitadas por estalactites e estalagmites.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "PETAR_OECO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P15",
            "factKey": "petar-F15",
            "text": "Uma das cavernas tem uma entrada tão alta que é citada como o maior pórtico de caverna do mundo.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "PETAR_ALESP",
              "PETAR_SEMIL_CAVERNAS",
              "PETAR_OECO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P16",
            "factKey": "petar-F16",
            "text": "A caverna do pórtico gigante dá nome a um dos núcleos, que está entre os menos visitados.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "PETAR_ALESP",
              "PETAR_ANPTUR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P17",
            "factKey": "petar-F17",
            "text": "Onças-pintadas e muriquis, o maior macaco das Américas, vivem nessas matas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SEMIL_ECOTURISMO",
              "PETAR_SEMIL_CONCESSAO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P18",
            "factKey": "petar-F18",
            "text": "Na mata mais antiga, com árvores de 25 a 30 m, crescem canelas, cedros e a palmeira-juçara.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SEMIL_ECOTURISMO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P19",
            "factKey": "petar-F19",
            "text": "Um bagre cego e sem cor vive em algumas cavernas da região.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SEMIL_CAVERNAS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P20",
            "factKey": "petar-F20",
            "text": "Desde os anos 1990, além das cavernas, o lugar atrai quem pratica boia-cross, canionismo e ciclismo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ALESP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P21",
            "factKey": "petar-F21",
            "text": "O parque foi criado no fim dos anos 1950 e está entre os parques estaduais mais antigos de São Paulo.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "PETAR_CNN",
              "PETAR_ALESP"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P22",
            "factKey": "petar-F22",
            "text": "Comunidades quilombolas vivem na região e fazem parte da sua riqueza cultural.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ANPTUR",
              "PETAR_ALESP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P23",
            "factKey": "petar-F23",
            "text": "São cerca de 35 mil hectares de Mata Atlântica preservada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ALESP",
              "PETAR_SEMIL_CONCESSAO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P24",
            "factKey": "petar-F24",
            "text": "A principal porta de entrada é um bairro do município de Iporanga, onde ficam pousadas e campings.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ANPTUR"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-viajante-P25",
            "factKey": "petar-F25",
            "text": "Entre os núcleos de visitação estão Santana, Ouro Grosso e Caboclos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_ALESP",
              "PETAR_ANPTUR",
              "PETAR_CNN"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "petar-geografo-P01",
            "factKey": "petar-F01",
            "text": "A unidade protege Mata Atlântica associada a um relevo de exceção, com sistemas de cavernas que guardam paisagens subterrâneas e sítios paleontológicos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SEMIL_ECOTURISMO",
              "PETAR_SBE"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P02",
            "factKey": "petar-F14",
            "text": "É um terreno cárstico: cavernas, abismos e rios subterrâneos se formam numa rocha que a água consegue dissolver.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "PETAR_SBE",
              "PETAR_OECO",
              "PETAR_SEMIL_CAVERNAS"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P03",
            "factKey": "petar-F26",
            "text": "As cavernas se desenvolvem em metacalcários cinza do Subgrupo Lajeado, intercalados com metapsamitos, filitos e metarritmitos.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "PETAR_SBE"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P04",
            "factKey": "petar-F27",
            "text": "Essas rochas fazem parte do Grupo Açungui, uma sequência vulcano-sedimentar do Meso ao Neoproterozoico, de metamorfismo fraco a moderado.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "PETAR_SBE"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P05",
            "factKey": "petar-F28",
            "text": "A área fica no setor sudoeste da Faixa Ribeira, sobre um embasamento arqueano de gnaisses e migmatitos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SBE"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P06",
            "factKey": "petar-F29",
            "text": "Entre as estruturas geológicas descritas na área estão o Sinclinal do Bairro da Serra e o Anticlinal da Biquinha.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_SBE"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P07",
            "factKey": "petar-F30",
            "text": "O rio Betari atravessa a unidade, e várias de suas cavernas são percorridas por rios subterrâneos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "PETAR_OECO",
              "PETAR_CNN"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P08",
            "factKey": "petar-F31",
            "text": "Os espeleotemas crescem muito devagar: as estimativas vão de 1 cm a só 1 mm a cada 30 a 100 anos.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "PETAR_OECO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P09",
            "factKey": "petar-F15",
            "text": "Um dos núcleos leva o nome de uma caverna cujo pórtico, com cerca de 215 m de altura, é citado por órgãos paulistas como o maior do mundo.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "PETAR_ALESP",
              "PETAR_SEMIL_CAVERNAS"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "petar-geografo-P10",
            "factKey": "petar-F16",
            "text": "O fluxo turístico é desigual: Santana e Ouro Grosso concentram a visita, enquanto Caboclos e Casa de Pedra recebem poucos visitantes.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "PETAR_ANPTUR"
            ],
            "clueType": "territorio",
