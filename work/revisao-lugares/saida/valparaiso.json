      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "valparaiso-geografo-P14",
      "factKey": "valparaiso-F14",
      "text": "Sua posição o tornou escala das rotas que uniam Atlântico e Pacífico pelo Estreito de Magalhães.",
