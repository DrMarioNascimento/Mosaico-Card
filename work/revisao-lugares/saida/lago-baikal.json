    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "lago-baikal-viajante-P01",
            "factKey": "lago-baikal-F01",
            "text": "Este destino é um grande lago de água doce no interior da Ásia, cercado de montanhas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P02",
            "factKey": "lago-baikal-F02",
            "text": "No inverno a superfície congela, e o gelo só derrete em maio ou junho.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_BRITANNICA",
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P03",
            "factKey": "lago-baikal-F03",
            "text": "A água é tão transparente que, da superfície, dá para enxergar até uns 40 metros de profundidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P04",
            "factKey": "lago-baikal-F04",
            "text": "No auge do inverno, o gelo pode chegar a 2 metros de espessura.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P05",
            "factKey": "lago-baikal-F05",
            "text": "À beira do lago o clima é mais ameno que no território em volta, mas a média de inverno ainda fica perto de −21 °C.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P06",
            "factKey": "lago-baikal-F06",
            "text": "Algumas montanhas ao redor sobem mais de 2.000 metros acima da superfície da água.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P07",
            "factKey": "lago-baikal-F07",
            "text": "É o lago mais fundo do planeta.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO",
              "BAIKAL_BRITANNICA",
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P08",
            "factKey": "lago-baikal-F08",
            "text": "Sozinho, guarda cerca de um quinto da água doce da superfície da Terra.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO",
              "BAIKAL_BRITANNICA",
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P09",
            "factKey": "lago-baikal-F09",
            "text": "Seu volume de água se compara ao dos cinco Grandes Lagos da América do Norte somados.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P10",
            "factKey": "lago-baikal-F10",
            "text": "Mais de 300 rios e riachos desembocam nele.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BAIKAL_BRITANNICA",
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P11",
            "factKey": "lago-baikal-F11",
            "text": "Só um rio leva a água para fora do lago, e ele depois deságua no Ienissei.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BAIKAL_BRITANNICA",
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P12",
            "factKey": "lago-baikal-F12",
            "text": "O maior rio que chega ao lago traz quase metade de toda a água que ele recebe.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P13",
            "factKey": "lago-baikal-F13",
            "text": "A maior das suas ilhas, com cerca de 72 km de comprimento, atrai cada vez mais turistas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_LIVESCIENCE",
              "BAIKAL_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P14",
            "factKey": "lago-baikal-F14",
            "text": "A estrela da fauna é uma foca que vive só em água doce.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BAIKAL_LIVESCIENCE",
              "BAIKAL_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P15",
            "factKey": "lago-baikal-F15",
            "text": "Um peixe sem escamas e muito oleoso, que dá à luz filhotes vivos, só existe ali.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_BRITANNICA",
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P16",
            "factKey": "lago-baikal-F16",
            "text": "O omul, um peixe branco, é um dos pratos mais famosos da região.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P17",
            "factKey": "lago-baikal-F17",
            "text": "A pesca comercial do omul foi proibida em 2018 para tentar recuperar a espécie.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P18",
            "factKey": "lago-baikal-F18",
            "text": "O lago fica no sul da Sibéria oriental, entre a Buriácia e a região de Irkutsk.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P19",
            "factKey": "lago-baikal-F19",
            "text": "Uma fábrica de celulose aberta em 1966 na margem sul provocou fortes protestos ambientais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P20",
            "factKey": "lago-baikal-F20",
            "text": "Algas fora do comum se espalharam pelas margens, um dos sinais de que a água está sendo poluída.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P21",
            "factKey": "lago-baikal-F21",
            "text": "Os buriates, um povo de origem mongol, vivem há séculos na maior ilha do lago.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_CALVERT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P22",
            "factKey": "lago-baikal-F22",
            "text": "Numa rocha com caverna, na maior ilha, a lenda diz que mora o senhor do lago; a entrada é proibida.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_CALVERT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P23",
            "factKey": "lago-baikal-F23",
            "text": "Com 20 a 25 milhões de anos, é o lago mais antigo do mundo; a UNESCO o fez Patrimônio Mundial em 1996.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "BAIKAL_BRITANNICA",
              "BAIKAL_IUCN_WHO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P24",
            "factKey": "lago-baikal-F24",
            "text": "A maior cidade perto das margens é Irkutsk.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_LIVESCIENCE"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-viajante-P25",
            "factKey": "lago-baikal-F25",
            "text": "A ilha de Olkhon, a maior do lago, é vista como um centro sagrado do xamanismo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_CALVERT",
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "cultura",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "lago-baikal-geografo-P01",
            "factKey": "lago-baikal-F01",
            "text": "Ocupa uma depressão estrutural profunda, cercada de montanhas, no interior do continente asiático.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-geografo-P02",
            "factKey": "lago-baikal-F26",
            "text": "É um lago de rifte, de origem tectônica, numa zona onde a crosta continua ativa.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO",
              "BAIKAL_IUCN_1996"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-geografo-P03",
            "factKey": "lago-baikal-F27",
            "text": "A atividade tectônica faz o lago crescer cerca de 1,5 cm por ano, segundo a avaliação da IUCN de 1996.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BAIKAL_IUCN_1996"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-geografo-P04",
            "factKey": "lago-baikal-F28",
            "text": "Fraturas na crosta alimentam fontes termais perto das margens.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-geografo-P05",
            "factKey": "lago-baikal-F23",
            "text": "Com 20 a 25 milhões de anos, é o lago mais antigo existente, palco de processos evolutivos contínuos reconhecidos pela UNESCO.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "BAIKAL_BRITANNICA",
              "BAIKAL_IUCN_WHO",
              "BAIKAL_IUCN_1996"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-geografo-P06",
            "factKey": "lago-baikal-F29",
            "text": "Mais da metade das espécies animais é endêmica, o que rendeu ao lago o apelido de “Galápagos da Rússia”.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO",
              "BAIKAL_IUCN_1996"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-geografo-P07",
            "factKey": "lago-baikal-F30",
            "text": "Esponjas endêmicas que funcionavam como biofiltros da zona costeira sofreram mortandade em massa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-geografo-P08",
            "factKey": "lago-baikal-F20",
            "text": "A proliferação maciça e atípica de algas Spirogyra ao longo da costa é um dos sinais de degradação da água.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "lago-baikal-geografo-P09",
            "factKey": "lago-baikal-F08",
            "text": "Graças à profundidade, concentra cerca de 20% da água doce não congelada do planeta, mais que qualquer outro lago.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BAIKAL_IUCN_WHO",
              "BAIKAL_BRITANNICA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
