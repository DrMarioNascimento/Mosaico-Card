    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "wellington-viajante-P01",
            "factKey": "wellington-F01",
            "text": "Esta cidade compacta fica espremida entre o mar e morros cobertos de mata.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P02",
            "factKey": "wellington-F02",
            "text": "Aqui as ventanias sopram tanto do norte quanto do sul.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P03",
            "factKey": "wellington-F03",
            "text": "Fica na ponta sul da Ilha Norte, na beira do Estreito de Cook.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "WELLINGTON_TEARA",
              "WELLINGTON_TEARA_CAP"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P04",
            "factKey": "wellington-F04",
            "text": "O porto é quase circular, com uns 10 km de diâmetro, cercado de morros e com uma entrada estreita para o mar.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P05",
            "factKey": "wellington-F05",
            "text": "Um recife na entrada do porto desafia os navegantes quando sopra forte o vento sul.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P06",
            "factKey": "wellington-F06",
            "text": "Boa parte do centro foi construída sobre aterros no porto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P07",
            "factKey": "wellington-F07",
            "text": "A cidade está sobre uma grande falha ativa, e os tremores de terra são frequentes.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P08",
            "factKey": "wellington-F08",
            "text": "Em 23 de janeiro de 1855, um terremoto de magnitude 8,2 sacudiu a região por cerca de 50 segundos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WELLINGTON_NZH_1855"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P09",
            "factKey": "wellington-F09",
            "text": "Dez minutos depois do tremor de 1855, uma onda de 4 m entrou no porto e inundou a rua da orla, Lambton Quay.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WELLINGTON_NZH_1855"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P10",
            "factKey": "wellington-F10",
            "text": "O tremor de 1855 secou um pântano onde depois nasceu o campo de críquete Basin Reserve.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WELLINGTON_NZH_1855",
              "WELLINGTON_WCC_PRE"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P11",
            "factKey": "wellington-F11",
            "text": "Na tradição maori, o navegador Kupe foi o primeiro a visitar o porto.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P12",
            "factKey": "wellington-F12",
            "text": "A âncora de pedra de Kupe está exposta no museu nacional Te Papa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P13",
            "factKey": "wellington-F13",
            "text": "O museu nacional Te Papa abriu em 1998, à beira d'água.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA_CAP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P14",
            "factKey": "wellington-F14",
            "text": "Um bondinho de cabo sobe do centro para os morros desde 1902.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P15",
            "factKey": "wellington-F15",
            "text": "Na Oriental Bay, uma praia de areia e um amplo calçadão ficam de frente para o porto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P16",
            "factKey": "wellington-F16",
            "text": "O Jardim Botânico foi criado em 1869, entre os bairros de Thorndon e Kelburn.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P17",
            "factKey": "wellington-F17",
            "text": "No bairro de Karori, uma cerca à prova de predadores protege uma espécie de \"ilha\" de natureza em terra firme.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P18",
            "factKey": "wellington-F18",
            "text": "Muitos moradores trabalham no serviço público, e várias missões diplomáticas ficam na cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA_CAP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P19",
            "factKey": "wellington-F19",
            "text": "Aqui ficam o Parlamento e a ala executiva apelidada de \"Colmeia\" (Beehive).",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA_CAP"
            ],
            "clueType": "construcao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P20",
            "factKey": "wellington-F20",
            "text": "Os primeiros colonos britânicos desembarcaram em 1840 em Petone, no fundo do porto, antes de mudar o povoado de lugar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_WCC_PRE"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P21",
            "factKey": "wellington-F21",
            "text": "Em 1839, a Companhia da Nova Zelândia escolheu este porto para seu primeiro assentamento britânico.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P22",
            "factKey": "wellington-F22",
            "text": "Os lotes urbanos dos primeiros colonos foram distribuídos por sorteio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_WCC_PRE"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P23",
            "factKey": "wellington-F23",
            "text": "Em 1865, a cidade passou a sediar o Parlamento, que antes ficava em Auckland.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA",
              "WELLINGTON_WCC_1865",
              "WELLINGTON_TEARA_CAP"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P24",
            "factKey": "wellington-F24",
            "text": "Em 2011, um guia de viagem a chamou de \"a pequena capital mais legal do mundo\".",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA_CAP"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-viajante-P25",
            "factKey": "wellington-F25",
            "text": "É a capital nacional mais ao sul do planeta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA_CAP"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "wellington-geografo-P01",
            "factKey": "wellington-F26",
            "text": "O porto e os morros definem a cidade: o mar e as encostas com mata limitam a expansão de um núcleo compacto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P02",
            "factKey": "wellington-F27",
            "text": "Em 2013, a cidade tinha 190.959 habitantes, e seus moradores tinham a maior renda per capita do país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P03",
            "factKey": "wellington-F28",
            "text": "O soerguimento ao longo de uma falha ajudou a formar a bacia do porto e elevou o bloco oeste numa escarpa até o vale do Hutt.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P04",
            "factKey": "wellington-F29",
            "text": "O terremoto de 1855, de magnitude 8,2, teve centro a cerca de 25 km da cidade e foi sentido até Canterbury.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WELLINGTON_WCC_PRE"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P05",
            "factKey": "wellington-F30",
            "text": "Em 1855, o extremo sul da cordilheira Remutaka subiu cerca de 6 m.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WELLINGTON_NZH_1855"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P06",
            "factKey": "wellington-F31",
            "text": "Em alguns pontos, a costa subiu 1,5 m em 1855, e as plataformas rochosas erguidas em volta do porto viraram caminhos naturais para estrada e ferrovia.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WELLINGTON_WCC_PRE",
              "WELLINGTON_TEARA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P07",
            "factKey": "wellington-F32",
            "text": "A terra erguida em 1855, somada a aterros posteriores, formou grande parte do centro comercial.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WELLINGTON_NZH_1855"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P08",
            "factKey": "wellington-F33",
            "text": "Os aterros do porto começaram na década de 1850, e um grande aterro dos anos 1960 serviu ao transporte de contêineres.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "WELLINGTON_TEARA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P09",
            "factKey": "wellington-F34",
            "text": "Em 1855, as casas térreas de madeira em geral resistiram, enquanto a câmara do conselho, de dois andares, desabou.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "WELLINGTON_NZH_1855"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "wellington-geografo-P10",
            "factKey": "wellington-F35",
            "text": "Pela tradição maori, o nome do porto homenageia Tara, filho do chefe Whātonga.",
