              "C4"
            ],
            "sources": [
              "WELLINGTON_WCC_PRE",
              "WELLINGTON_TEARA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
