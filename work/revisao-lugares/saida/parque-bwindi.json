            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P23",
            "factKey": "parque-bwindi-F23",
            "text": "A UNESCO reconheceu o parque como Patrimônio Mundial em 1994.",
