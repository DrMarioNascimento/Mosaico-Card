              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P21",
            "factKey": "parque-bwindi-F21",
            "text": "Doenças respiratórias levadas por pessoas são um risco sério para os gorilas.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BWINDI_APES",
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P22",
            "factKey": "parque-bwindi-F22",
            "text": "A mata é protegida desde 1932 e virou parque nacional em 1991.",
