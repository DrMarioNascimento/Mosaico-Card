      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "parque-bwindi-geografo-P01",
            "factKey": "parque-bwindi-F01",
            "text": "A unidade protege um bloco de floresta tropical de montanha na África equatorial.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P02",
            "factKey": "parque-bwindi-F02",
            "text": "Situa-se na borda do ramo ocidental do rifte africano, em terras altas de relevo acidentado.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "BWINDI_IUCN1994",
              "BWINDI_APES",
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P03",
            "factKey": "parque-bwindi-F03",
            "text": "Ocupa o sudoeste de Uganda, junto à fronteira com a República Democrática do Congo.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BWINDI_IUCN_WHO",
              "BWINDI_IUCN1994"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P04",
            "factKey": "parque-bwindi-F04",
            "text": "A amplitude altitudinal, de 1.190 m a mais de 2.500 m, explica a grande diversidade de habitats.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P05",
            "factKey": "parque-bwindi-F05",
            "text": "A mata cobre a transição contínua entre floresta de baixada e floresta montana, rara na África Oriental.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BWINDI_IUCN_WHO",
              "BWINDI_IUCN1994"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P06",
            "factKey": "parque-bwindi-F06",
            "text": "Com mais de 25 mil anos, a floresta foi apontada pela IUCN como provável refúgio do Pleistoceno.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BWINDI_APES",
              "BWINDI_IUCN1994"
            ],
            "clueType": "historia-natural",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P07",
            "factKey": "parque-bwindi-F07",
            "text": "A riqueza arbórea passa de 200 espécies, com 10 endêmicas, e há ao menos mil plantas com flores.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P08",
            "factKey": "parque-bwindi-F08",
            "text": "Com cerca de 104 espécies, a diversidade de samambaias é a maior da África Oriental.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO",
              "BWINDI_IUCN1994"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P09",
            "factKey": "parque-bwindi-F09",
            "text": "As 202 espécies de borboletas de floresta montana equivalem a 84% do total ugandense.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-geografo-P10",
            "factKey": "parque-bwindi-F10",
            "text": "Cerca de 350 espécies de aves em apenas 321 km² fazem da área uma Área Importante para Aves.",
