    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "parque-bwindi-viajante-P01",
            "factKey": "parque-bwindi-F01",
            "text": "Este destino protege uma floresta de montanha na África, perto da linha do equador.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P02",
            "factKey": "parque-bwindi-F02",
            "text": "Chove bastante por lá, e a mata é muito fechada.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "BWINDI_IUCN_WHO",
              "BWINDI_UWA"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P03",
            "factKey": "parque-bwindi-F03",
            "text": "O parque fica no sudoeste de Uganda.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P04",
            "factKey": "parque-bwindi-F04",
            "text": "A oeste, a floresta chega à fronteira com a República Democrática do Congo.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "BWINDI_IUCN1994",
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P05",
            "factKey": "parque-bwindi-F05",
            "text": "O terreno é acidentado, e a altitude vai de cerca de 1.200 a mais de 2.500 metros.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BWINDI_IUCN_WHO",
              "BWINDI_IUCN1994"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P06",
            "factKey": "parque-bwindi-F06",
            "text": "A mata passa da floresta de baixada à floresta de montanha sem interrupção.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P07",
            "factKey": "parque-bwindi-F07",
            "text": "Há mais de 200 espécies de árvores, dez delas endêmicas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P08",
            "factKey": "parque-bwindi-F08",
            "text": "Mais de cem espécies de samambaias crescem na floresta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P09",
            "factKey": "parque-bwindi-F09",
            "text": "São cerca de 200 espécies de borboletas de floresta de montanha, a grande maioria das que existem no país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO",
              "BWINDI_IUCN1994"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P10",
            "factKey": "parque-bwindi-F10",
            "text": "Cerca de 350 espécies de aves vivem nessa floresta relativamente pequena.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P11",
            "factKey": "parque-bwindi-F11",
            "text": "Elefantes também vivem na mata, mas são poucos: algumas dezenas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P12",
            "factKey": "parque-bwindi-F12",
            "text": "Chimpanzés e o ameaçado macaco-de-l’Hoest também vivem na floresta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P13",
            "factKey": "parque-bwindi-F13",
            "text": "Cerca de metade de todos os gorilas-das-montanhas do mundo vive nesta floresta.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BWINDI_IUCN_WHO",
              "BWINDI_UWA"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P14",
            "factKey": "parque-bwindi-F14",
            "text": "O número de gorilas cresceu: eram menos de 300 em 1997 e passaram de 450 em 2018.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BWINDI_APES"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P15",
            "factKey": "parque-bwindi-F15",
            "text": "Ver os gorilas exige caminhar de 2 a 7 horas na mata, para ficar uma hora com a família.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BWINDI_UWA"
            ],
            "clueType": "turismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P16",
            "factKey": "parque-bwindi-F16",
            "text": "Grupos de gorilas acostumados a pessoas começaram a receber turistas em 1993.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BWINDI_APES",
              "BWINDI_IUCN1994"
            ],
            "clueType": "turismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P17",
            "factKey": "parque-bwindi-F17",
            "text": "A floresta é uma ilha verde cercada por roças numa região muito povoada.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P18",
            "factKey": "parque-bwindi-F18",
            "text": "Animais que saem da mata para comer as plantações são o maior atrito com os vizinhos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P19",
            "factKey": "parque-bwindi-F19",
            "text": "Parte do dinheiro das entradas e das licenças para ver gorilas vai para projetos das comunidades vizinhas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BWINDI_IUCN_WHO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-bwindi-viajante-P20",
            "factKey": "parque-bwindi-F20",
            "text": "O povo batwa viveu nessa floresta por séculos antes de ser retirado dela.",
