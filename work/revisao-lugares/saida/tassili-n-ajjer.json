          },
          {
            "id": "tassili-n-ajjer-geografo-P10",
            "factKey": "tassili-n-ajjer-F10",
            "text": "Quatro espécies de peixes relictos da família das tilápias vivem nas águas do Iherir.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P11",
            "factKey": "tassili-n-ajjer-F11",
            "text": "O cipreste-do-saara (Cupressus dupreziana), paleoendemismo relicto, tem menos de 240 exemplares, e o clima atual impede sua reprodução.",
