            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P15",
            "factKey": "tassili-n-ajjer-F15",
            "text": "As pinturas, de cerca de 6000 a.C. aos primeiros séculos da era atual, registram a passagem de um ambiente mais favorável à ocupação humana ao deserto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
