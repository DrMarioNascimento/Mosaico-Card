            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P18",
            "factKey": "tassili-n-ajjer-F18",
            "text": "Datações por radiocarbono situam os vestígios arqueológicos entre cerca de 6000 e 2000 a.C.",
