    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "tassili-n-ajjer-viajante-P01",
            "factKey": "tassili-n-ajjer-F01",
            "text": "Este destino é um planalto no deserto, com milhares de pinturas e gravuras antigas nas rochas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO",
              "TASSILI_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P02",
            "factKey": "tassili-n-ajjer-F02",
            "text": "A paisagem é tão estranha que costuma ser comparada à superfície da Lua.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P03",
            "factKey": "tassili-n-ajjer-F03",
            "text": "O vento esculpiu as rochas em formas que lembram ruínas, as chamadas “florestas de pedra”.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TASSILI_WCMC",
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P04",
            "factKey": "tassili-n-ajjer-F04",
            "text": "As rochas do planalto são de arenito.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TASSILI_WCMC",
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P05",
            "factKey": "tassili-n-ajjer-F05",
            "text": "Há penhascos, gargantas e vales profundamente escavados pela erosão.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P06",
            "factKey": "tassili-n-ajjer-F06",
            "text": "O planalto tem altitude média de cerca de 1.500 metros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_ICOMOS"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P07",
            "factKey": "tassili-n-ajjer-F07",
            "text": "O clima é hiperárido: chovem em média só 30 milímetros por ano.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P08",
            "factKey": "tassili-n-ajjer-F08",
            "text": "Mesmo assim, sempre há água guardada em gargantas fundas e sombreadas e em poças que duram depois das chuvas, as gueltas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P09",
            "factKey": "tassili-n-ajjer-F09",
            "text": "Por ali corre o único rio permanente do Saara central.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P10",
            "factKey": "tassili-n-ajjer-F10",
            "text": "Peixes de espécies relictas vivem nas águas desse rio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P11",
            "factKey": "tassili-n-ajjer-F11",
            "text": "Um crocodilo-anão do Saara viveu ali até o século XX; os últimos foram mortos nos anos 1940.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P12",
            "factKey": "tassili-n-ajjer-F12",
            "text": "Uma árvore rara, o cipreste-do-saara, sobrevive ali com menos de 240 exemplares.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "TASSILI_IUCN_WHO",
              "TASSILI_WCMC"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P13",
            "factKey": "tassili-n-ajjer-F13",
            "text": "Também cresce ali uma murta-do-saara, outra planta relíquia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P14",
            "factKey": "tassili-n-ajjer-F14",
            "text": "Entre os animais estão o carneiro-da-barbária, a gazela-dorcas e até o guepardo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO",
              "TASSILI_WCMC"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P15",
            "factKey": "tassili-n-ajjer-F15",
            "text": "Mais de 15 mil desenhos e gravuras já foram catalogados, e o total pode ser o dobro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO",
              "TASSILI_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P16",
            "factKey": "tassili-n-ajjer-F16",
            "text": "As pinturas vão de cerca de 6000 a.C. aos primeiros séculos da era atual.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P17",
            "factKey": "tassili-n-ajjer-F17",
            "text": "Os desenhos mostram cavalos, rebanhos de bois, dromedários e até hipopótamos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_ICOMOS",
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P18",
            "factKey": "tassili-n-ajjer-F18",
            "text": "O período com mais pinturas é o “bovidiano”, dos rebanhos de bois, entre cerca de 4000 e 1500 a.C.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P19",
            "factKey": "tassili-n-ajjer-F19",
            "text": "As pinturas mais recentes, da época dos dromedários, trazem letras da escrita tifinague.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P20",
            "factKey": "tassili-n-ajjer-F20",
            "text": "Também há restos do Neolítico, como esculturas, cerâmica e pedras de moer.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P21",
            "factKey": "tassili-n-ajjer-F21",
            "text": "É a terra dos tuaregues, que ainda percorrem o planalto com seus rebanhos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO",
              "TASSILI_ICOMOS"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P22",
            "factKey": "tassili-n-ajjer-F22",
            "text": "Turistas deixam lixo e pichações, e há até roubo de pedaços de pinturas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P23",
            "factKey": "tassili-n-ajjer-F23",
            "text": "Chuvas fortes e enxurradas atingiram a região no verão de 2024.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P24",
            "factKey": "tassili-n-ajjer-F24",
            "text": "O planalto fica no sudeste do Saara argelino, perto das fronteiras com a Líbia e o Níger.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TASSILI_WCMC",
              "TASSILI_ICOMOS"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-viajante-P25",
            "factKey": "tassili-n-ajjer-F25",
            "text": "Virou Patrimônio Mundial em 1982, tanto pela natureza quanto pela arte rupestre.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO",
              "TASSILI_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "tassili-n-ajjer-geografo-P01",
            "factKey": "tassili-n-ajjer-F01",
            "text": "A unidade combina valores naturais e culturais: relevo desértico de grande interesse geológico e arte rupestre pré-histórica.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P02",
            "factKey": "tassili-n-ajjer-F02",
            "text": "O planalto pertence a uma camada de arenito que contorna o maciço do Hoggar, no Saara.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P03",
            "factKey": "tassili-n-ajjer-F03",
            "text": "A erosão eólica deixou “florestas de pedra”, formações que lembram ruínas.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TASSILI_WCMC",
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P04",
            "factKey": "tassili-n-ajjer-F04",
            "text": "A geologia combina elementos cristalinos pré-cambrianos e sucessões de arenito, cortadas por penhascos e gargantas.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P05",
            "factKey": "tassili-n-ajjer-F05",
            "text": "O maciço tem forma aproximadamente triangular, com o lado maior de cerca de 700 km.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P06",
            "factKey": "tassili-n-ajjer-F06",
            "text": "A altitude varia de 1.150 m a 2.158 m, e uma estação a 1.100 m registra média anual de 20,3 °C.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P07",
            "factKey": "tassili-n-ajjer-F07",
            "text": "Com cerca de 30 mm de chuva por ano, o planalto é hiperárido, mas abriga microclimas subáridos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P08",
            "factKey": "tassili-n-ajjer-F08",
            "text": "A água persiste em gargantas sombreadas, leitos de oueds e gueltas — poças que resistem depois das chuvas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P09",
            "factKey": "tassili-n-ajjer-F09",
            "text": "O Iherir é o único rio perene do Saara central, e o oued Iherir e as poças de Afilal são sítios Ramsar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_WCMC",
              "TASSILI_IUCN_WHO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
