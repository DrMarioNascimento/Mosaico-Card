            "clueType": "pesquisa",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P19",
            "factKey": "tassili-n-ajjer-F19",
            "text": "Grupos tuaregues ainda percorrem o planalto árido com seus rebanhos, e pecuária, agricultura e turismo sustentam a população local.",
