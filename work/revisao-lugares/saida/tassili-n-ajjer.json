              "TASSILI_ICOMOS"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P16",
            "factKey": "tassili-n-ajjer-F16",
            "text": "A arte é dividida em períodos — naturalista, arcaico, bovidiano, equidiano e camelino —, e o bovidiano (c. 4000–1500 a.C.) é o mais representado.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TASSILI_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tassili-n-ajjer-geografo-P17",
            "factKey": "tassili-n-ajjer-F17",
            "text": "O período camelino coincide com o início do clima desértico hiperárido.",
