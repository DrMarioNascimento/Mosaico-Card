      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-viajante-P09",
      "factKey": "fortaleza-F09",
      "text": "As chuvas se concentram entre janeiro e maio.",
