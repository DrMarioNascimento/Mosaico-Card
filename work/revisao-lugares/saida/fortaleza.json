      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-viajante-P11",
      "factKey": "fortaleza-F11",
      "text": "Esse centro tem planetário, cinemas, teatro e um museu da cultura do estado.",
