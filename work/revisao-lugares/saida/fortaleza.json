      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-viajante-P10",
      "factKey": "fortaleza-F10",
      "text": "Um centro cultural na Praia de Iracema foi inaugurado em 1999.",
