      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-viajante-P07",
      "factKey": "fortaleza-F07",
      "text": "O porto fica numa ponta de terra a leste do centro, onde há um farol antigo.",
