      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-viajante-P06",
      "factKey": "fortaleza-F06",
      "text": "Jangadas aparecem entre a Praia de Iracema e o porto.",
