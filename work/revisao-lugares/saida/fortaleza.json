   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "fortaleza-geografo-P01",
      "factKey": "fortaleza-F01",
      "text": "É uma capital costeira assentada numa planície baixa recoberta de dunas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGE1970"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P02",
      "factKey": "fortaleza-F02",
      "text": "A ocupação colonial começou na foz de um rio e depois se fixou junto a um riacho.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "FORTALEZA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P03",
      "factKey": "fortaleza-F03",
      "text": "Em média, as dunas do município não passam de 30 m de altura.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGE1970"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P04",
      "factKey": "fortaleza-F04",
      "text": "Rios como o Cocó, o Ceará e o Maranguapinho drenam o município.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGE1970"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P05",
      "factKey": "fortaleza-F05",
      "text": "Lagoas como as de Messejana e Parangaba pontilham a área municipal.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGE1970"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P06",
      "factKey": "fortaleza-F06",
      "text": "O período chuvoso concentra-se de janeiro a maio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGE1970"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P07",
      "factKey": "fortaleza-F07",
      "text": "O primeiro forte português, de 1612, ficava na foz do rio Ceará.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P08",
      "factKey": "fortaleza-F08",
      "text": "Holandeses tomaram esse forte em 1637, e indígenas o destruíram em 1644.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P09",
      "factKey": "fortaleza-F09",
      "text": "Em 1649, o Forte Schoonenborch foi erguido junto ao riacho Pajeú.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "FORTALEZA_IBGEHIST",
       "FORTALEZA_DNORIGENS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P10",
      "factKey": "fortaleza-F10",
      "text": "Com a derrota holandesa em Pernambuco, o forte passou a se chamar Nossa Senhora da Assunção.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "FORTALEZA_IBGEHIST",
       "FORTALEZA_DNORIGENS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P11",
      "factKey": "fortaleza-F11",
      "text": "O município foi instalado em 13 de abril de 1726, data oficial do aniversário.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGEHIST",
       "FORTALEZA_DNORIGENS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P12",
      "factKey": "fortaleza-F12",
      "text": "Em 1823, foi elevada a cidade e rebatizada com o acréscimo \"da Nova Bragança\".",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-geografo-P13",
      "factKey": "fortaleza-F13",
      "text": "Barra do Ceará e Mucuripe têm ocupação anterior ao início oficial da cidade, no Centro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "FORTALEZA_DNORIGENS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
