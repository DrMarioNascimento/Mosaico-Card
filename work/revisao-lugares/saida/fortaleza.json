      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-viajante-P12",
      "factKey": "fortaleza-F12",
      "text": "O nome do centro homenageia um jangadeiro que lutou contra a escravidão.",
