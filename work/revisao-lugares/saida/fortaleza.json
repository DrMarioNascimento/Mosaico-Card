      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "fortaleza-viajante-P13",
      "factKey": "fortaleza-F13",
      "text": "Esse jangadeiro, Chico da Matilde, ficou conhecido como Dragão do Mar.",
