      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "rio-paraguai-geografo-P10",
      "factKey": "rio-paraguai-F10",
      "text": "Antes de deixar o Brasil, o curso forma parte do limite natural com o país vizinho ao sul.",
