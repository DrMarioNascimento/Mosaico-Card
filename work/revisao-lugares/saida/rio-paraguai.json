      ],
      "sources": [
       "RPAR_ANA_NT2020",
       "RPAR_ANA_NT2019"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
