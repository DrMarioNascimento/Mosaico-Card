    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "komodo-viajante-P01",
            "factKey": "komodo-F01",
            "text": "Este destino protege ilhas tropicais e o mar ao redor delas, no Sudeste Asiático.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P02",
            "factKey": "komodo-F02",
            "text": "É uma das regiões mais secas do país: chove só de 800 a 1.000 mm por ano.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WIKI"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P03",
            "factKey": "komodo-F03",
            "text": "O parque fica na Indonésia, nas Pequenas Ilhas da Sonda.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_WIKI",
              "KOMODO_IUCN_WHO"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P04",
            "factKey": "komodo-F04",
            "text": "São três ilhas maiores e 26 menores, todas de origem vulcânica.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_WII",
              "KOMODO_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P05",
            "factKey": "komodo-F05",
            "text": "As ilhas ficam no estreito de Sape, entre Sumbawa e Flores.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_WII",
              "KOMODO_WIKI"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P06",
            "factKey": "komodo-F06",
            "text": "Parte da área protegida está nas costas oeste e norte da ilha de Flores.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P07",
            "factKey": "komodo-F07",
            "text": "Encostas secas contrastam com manchas verdes, praias brancas e águas cheias de corais.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WII"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P08",
            "factKey": "komodo-F08",
            "text": "Na savana crescem capins e palmeiras lontar, um tipo de palmeira-de-leque.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WIKI",
              "KOMODO_WII"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P09",
            "factKey": "komodo-F09",
            "text": "O relevo é acidentado, com morros que chegam a 735 metros.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WII"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P10",
            "factKey": "komodo-F10",
            "text": "Na estação seca, de maio a outubro, o calor pode chegar perto de 40 °C.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WIKI"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P11",
            "factKey": "komodo-F11",
            "text": "A estrela do lugar é um réptil enorme: o maior e mais pesado lagarto do mundo.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "KOMODO_IUCN_WHO",
              "KOMODO_WII"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P12",
            "factKey": "komodo-F12",
            "text": "Os machos desse lagarto chegam a uns 3 metros de comprimento.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "KOMODO_WIKI"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P13",
            "factKey": "komodo-F13",
            "text": "O cervo-de-timor é a principal presa desse lagarto.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "KOMODO_WIKI"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P14",
            "factKey": "komodo-F14",
            "text": "O parque foi criado em 1980, principalmente para proteger esse lagarto.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "KOMODO_WIKI",
              "KOMODO_WII"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P15",
            "factKey": "komodo-F15",
            "text": "Búfalos, javalis e macacos-cinomolgos também vivem nas ilhas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_IUCN_WHO",
              "KOMODO_WIKI"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P16",
            "factKey": "komodo-F16",
            "text": "Há mais de 70 espécies de aves, entre elas uma cacatua muito ameaçada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_IUCN_WHO",
              "KOMODO_WIKI"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P17",
            "factKey": "komodo-F17",
            "text": "Debaixo d’água vivem mais de mil espécies de peixes de recife.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_IUCN_WHO",
              "KOMODO_WII"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P18",
            "factKey": "komodo-F18",
            "text": "Raias-manta, dugongos e tartarugas marinhas nadam nessas águas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_IUCN_WHO",
              "KOMODO_WII",
              "KOMODO_WIKI"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P19",
            "factKey": "komodo-F19",
            "text": "Golfinhos de dez espécies e até baleias-azuis e cachalotes passam por ali.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P20",
            "factKey": "komodo-F20",
            "text": "As correntes marinhas no estreito são fortes e podem ser perigosas para guias inexperientes.",
