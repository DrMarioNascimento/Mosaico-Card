              "C1"
            ],
            "sources": [
              "KOMODO_WIKI"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P21",
            "factKey": "komodo-F21",
            "text": "Nas aldeias dentro do parque, quase todo mundo vive do mar.",
