            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-viajante-P22",
            "factKey": "komodo-F22",
            "text": "O turismo do parque tem como base a cidade vizinha de Labuan Bajo.",
