      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "komodo-geografo-P01",
            "factKey": "komodo-F01",
            "text": "A unidade protege ecossistemas insulares terrestres e marinhos num arquipélago tropical do Sudeste Asiático.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P02",
            "factKey": "komodo-F02",
            "text": "As ilhas são vulcânicas e ficam numa zona de fratura no encontro de duas placas, o que explica o relevo acidentado.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "KOMODO_IUCN_WHO",
              "KOMODO_WII"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P03",
            "factKey": "komodo-F03",
            "text": "Pertence a uma região biogeográfica de transição entre os ecossistemas da Plataforma de Sunda e os da Austrália.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "KOMODO_IUCN_WHO"
            ],
            "clueType": "biogeografia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P04",
            "factKey": "komodo-F04",
            "text": "Ocupa o estreito de Sape, entre Sumbawa e Flores, na província de Nusa Tenggara Oriental.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_WII",
              "KOMODO_IUCN_WHO"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P05",
            "factKey": "komodo-F05",
            "text": "Abrange três ilhas maiores, 26 menores e trechos costeiros do oeste e do norte de Flores.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KOMODO_WIKI",
              "KOMODO_WII",
              "KOMODO_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P06",
            "factKey": "komodo-F06",
            "text": "Com 800 a 1.000 mm de chuva por ano e seca de maio a outubro, é uma das áreas mais secas da Indonésia.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WIKI"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P07",
            "factKey": "komodo-F07",
            "text": "A falta de água favorece savanas com palmeiras-de-leque; a floresta de nuvens só aparece acima de 500 m.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WII",
              "KOMODO_WIKI"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P08",
            "factKey": "komodo-F08",
            "text": "Florestas decíduas com tamarindeiros e manguezais em baías abrigadas completam a vegetação.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WIKI",
              "KOMODO_WII"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P09",
            "factKey": "komodo-F09",
            "text": "Onze montanhas compõem o relevo; a mais alta, o monte Satalibo, atinge 735 m.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KOMODO_WII"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P10",
            "factKey": "komodo-F10",
            "text": "A conservação do maior lagarto vivo depende de suas presas: cervo-de-timor, búfalo-asiático e javali.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "KOMODO_IUCN_WHO",
              "KOMODO_WIKI"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "komodo-geografo-P11",
            "factKey": "komodo-F11",
            "text": "A caça ilegal de cervos ameaça indiretamente o lagarto gigante, ao reduzir sua principal presa.",
            "relatedFields": [
              "C2"
