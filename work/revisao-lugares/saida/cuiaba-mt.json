       "CUI_MPF"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P23",
      "factKey": "cuiaba-mt-F23",
      "text": "Um obelisco de mármore branco com cerca de 20 m fica numa praça central.",
