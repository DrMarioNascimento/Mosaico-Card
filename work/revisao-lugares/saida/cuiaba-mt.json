   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "cuiaba-mt-geografo-P01",
      "factKey": "cuiaba-mt-F01",
      "text": "Capital estadual do interior sul-americano cuja origem está ligada à mineração colonial.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P02",
      "factKey": "cuiaba-mt-F02",
      "text": "Situa-se numa zona de contato entre Cerrado, Pantanal e Amazônia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P03",
      "factKey": "cuiaba-mt-F03",
      "text": "O ouro foi achado primeiro no rio Coxipó, afluente do rio que dá nome à cidade.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "critical",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P04",
      "factKey": "cuiaba-mt-F04",
      "text": "A expedição de Pascoal Moreira Cabral chegou ao ouro guiada por informações de Antônio Pires de Campos.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P05",
      "factKey": "cuiaba-mt-F05",
      "text": "O termo de fundação de 1719 foi lavrado no arraial da Forquilha, onde se ergueu uma igreja a Nossa Senhora da Penha de França.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P06",
      "factKey": "cuiaba-mt-F06",
      "text": "A lavra mais rica, aberta por Miguel Sutil e João Francisco Barbado, deslocou o povoado para a foz do córrego da Prainha.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P07",
      "factKey": "cuiaba-mt-F07",
      "text": "Em 1748, a região foi separada de São Paulo para formar a capitania de Mato Grosso.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P08",
      "factKey": "cuiaba-mt-F08",
      "text": "Elevada a vila em 1726 como Vila Real do Senhor Bom Jesus, teve o município instalado em 1727.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P09",
      "factKey": "cuiaba-mt-F09",
      "text": "A sede da capitania ficou em Vila Bela a partir de 1752; a cidade só assumiu a capital no século XIX.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P10",
      "factKey": "cuiaba-mt-F10",
      "text": "O arruamento da antiga vila colonial segue praticamente intacto, com quase três séculos de evolução urbana.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IPDU"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P11",
      "factKey": "cuiaba-mt-F11",
      "text": "A área tombada pelo Iphan tem 13,1 ha e cerca de 400 edificações.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IPDU"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-geografo-P12",
      "factKey": "cuiaba-mt-F12",
      "text": "O tombamento federal do conjunto foi provisório em 1987 e definitivo depois, com homologação em 1992.",
      "relatedFields": [
       "C1"
      ],
