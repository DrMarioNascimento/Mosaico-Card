  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "cuiaba-mt-viajante-P01",
      "factKey": "cuiaba-mt-F01",
      "text": "É uma capital estadual brasileira com mais de três séculos de história.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST",
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P02",
      "factKey": "cuiaba-mt-F02",
      "text": "É uma das capitais mais quentes do país: em 2023 os termômetros marcaram 44,2 °C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P03",
      "factKey": "cuiaba-mt-F03",
      "text": "Fica entre três biomas: Cerrado, Pantanal e Amazônia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "critical",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P04",
      "factKey": "cuiaba-mt-F04",
      "text": "A Chapada dos Guimarães fica a cerca de 67 km dali.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P05",
      "factKey": "cuiaba-mt-F05",
      "text": "Um rio com o mesmo nome da cidade passa por ela.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST",
       "CUI_IPDU"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P06",
      "factKey": "cuiaba-mt-F06",
      "text": "A cidade surgiu com a descoberta de ouro num rio da região.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P07",
      "factKey": "cuiaba-mt-F07",
      "text": "A fundação foi registrada em 8 de abril de 1719.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CUI_IBGE_HIST",
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P08",
      "factKey": "cuiaba-mt-F08",
      "text": "O ouro mais farto apareceu depois junto a um córrego chamado Prainha.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P09",
      "factKey": "cuiaba-mt-F09",
      "text": "Ganhou o título de vila em 1726, com um nome em homenagem ao Senhor Bom Jesus.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P10",
      "factKey": "cuiaba-mt-F10",
      "text": "Virou cidade em 1818 e passou a ser capital ainda no século XIX.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P11",
      "factKey": "cuiaba-mt-F11",
      "text": "Antes dela, a capital da capitania ficava em Vila Bela da Santíssima Trindade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P12",
      "factKey": "cuiaba-mt-F12",
      "text": "O nome viria do tupi e lembraria um lugar de pesca com flecha.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P13",
      "factKey": "cuiaba-mt-F13",
      "text": "Os moradores ganharam o apelido de \"papa-peixe\".",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P14",
      "factKey": "cuiaba-mt-F14",
      "text": "Um prato famoso é a maria-isabel, arroz com carne-seca desfiada.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P15",
      "factKey": "cuiaba-mt-F15",
      "text": "Pacu assado na folha de bananeira e mojica de pintado também são pratos típicos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P16",
      "factKey": "cuiaba-mt-F16",
      "text": "A viola de cocho, típica da região, é feita de um tronco de árvore escavado.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "CUI_IPHAN_VIOLA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P17",
      "factKey": "cuiaba-mt-F17",
      "text": "Essa viola acompanha o siriri, dançado em pares, em roda ou em fileira.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "CUI_IPHAN_VIOLA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P18",
      "factKey": "cuiaba-mt-F18",
      "text": "No cururu, homens tocam viola de cocho e improvisam versos em desafio.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "CUI_IPHAN_VIOLA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P19",
      "factKey": "cuiaba-mt-F19",
      "text": "A Igreja de Nossa Senhora do Rosário e São Benedito é do século XVIII.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_CORREIO",
       "CUI_IPDU"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P20",
      "factKey": "cuiaba-mt-F20",
      "text": "A festa de São Benedito dura cerca de um mês e é a mais longa do estado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P21",
      "factKey": "cuiaba-mt-F21",
      "text": "Um antigo mercado de peixe à beira do rio virou o Museu do Rio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CUI_IPDU"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P22",
      "factKey": "cuiaba-mt-F22",
      "text": "O centro histórico, com cerca de 400 construções, é protegido pelo Iphan.",
