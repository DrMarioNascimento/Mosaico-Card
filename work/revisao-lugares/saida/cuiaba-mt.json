       "C1"
      ],
      "sources": [
       "CUI_CORREIO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cuiaba-mt-viajante-P24",
      "factKey": "cuiaba-mt-F24",
      "text": "Esse obelisco marca o Centro Geodésico da América do Sul, calculado por Rondon em 1909.",
