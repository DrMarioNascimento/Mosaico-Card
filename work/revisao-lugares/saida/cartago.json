            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-viajante-P16",
            "factKey": "cartago-F16",
            "text": "Entre as ruínas estão teatro, anfiteatro, circo, basílicas, necrópoles e as Termas de Antonino.",
