              "CARTAGO_UNESCO_ES"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-geografo-P06",
            "factKey": "cartago-F08",
            "text": "Foi a metrópole da civilização púnica na África, então o centro da bacia ocidental do Mediterrâneo.",
