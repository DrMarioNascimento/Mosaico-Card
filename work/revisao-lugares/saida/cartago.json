              "C1"
            ],
            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-viajante-P11",
            "factKey": "cartago-F11",
            "text": "No tempo dos romanos, ela foi a capital da província da África.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-viajante-P12",
            "factKey": "cartago-F12",
            "text": "Há vestígios deixados por púnicos, romanos, vândalos, primeiros cristãos e árabes.",
