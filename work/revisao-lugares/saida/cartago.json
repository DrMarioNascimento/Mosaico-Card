              "C2"
            ],
            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-geografo-P07",
            "factKey": "cartago-F07",
            "text": "A origem fenício-púnica da primeira cidade aparece na lenda de sua fundadora, uma princesa de Tiro.",
