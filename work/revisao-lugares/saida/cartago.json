            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-viajante-P10",
            "factKey": "cartago-F10",
            "text": "Sobre as ruínas da primeira cidade, os romanos ergueram uma segunda, por ordem de Júlio César.",
