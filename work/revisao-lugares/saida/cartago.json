            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-viajante-P14",
            "factKey": "cartago-F14",
            "text": "Esse santuário das estelas era dedicado ao deus Baal.",
