              "C1"
            ],
            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-viajante-P13",
            "factKey": "cartago-F13",
            "text": "Um santuário antigo guarda muitas estelas, pedras gravadas que mostram influências de várias culturas.",
