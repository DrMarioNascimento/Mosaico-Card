            ],
            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-geografo-P11",
            "factKey": "cartago-F28",
            "text": "A cidade antiga teve influência considerável no desenvolvimento das artes, da arquitetura e do urbanismo.",
