            ],
            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-geografo-P10",
            "factKey": "cartago-F11",
            "text": "Sob Roma, virou capital da província da África e um dos centros mais brilhantes da civilização afro-romana.",
