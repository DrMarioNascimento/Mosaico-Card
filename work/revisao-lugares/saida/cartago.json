            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-viajante-P15",
            "factKey": "cartago-F15",
            "text": "Os portos antigos contam mais de dez séculos de trocas comerciais e culturais.",
