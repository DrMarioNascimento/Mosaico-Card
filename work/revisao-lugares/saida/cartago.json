              "C1"
            ],
            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-geografo-P09",
            "factKey": "cartago-F10",
            "text": "A refundação romana, ordenada por Júlio César, assentou uma nova cidade diretamente sobre as ruínas da anterior.",
