              "C2"
            ],
            "sources": [
              "CARTAGO_UNESCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-geografo-P08",
            "factKey": "cartago-F09",
            "text": "Durante as longas Guerras Púnicas, a cidade ocupou territórios de Roma, que por fim destruiu a rival.",
