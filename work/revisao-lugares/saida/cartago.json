            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cartago-viajante-P09",
            "factKey": "cartago-F09",
            "text": "Depois de longas guerras contra Roma, a cidade acabou destruída pela rival.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "CARTAGO_UNESCO",
              "CARTAGO_UNESCO_ES"
            ],
            "clueType": "historia",
