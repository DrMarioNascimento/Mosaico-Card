   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "territorio-indigena-xingu-geografo-P01",
      "factKey": "territorio-indigena-xingu-F01",
      "text": "O objeto é um território indígena formado por mais de uma terra oficialmente reconhecida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "XINGU_PLANO"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "territorio-indigena-xingu-geografo-P02",
      "factKey": "territorio-indigena-xingu-F02",
      "text": "Situa-se no nordeste mato-grossense, no sul da Amazônia brasileira.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "XINGU_PIB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "territorio-indigena-xingu-geografo-P03",
      "factKey": "territorio-indigena-xingu-F03",
      "text": "Os povos falam línguas das famílias karib, aruak, tupi-guarani e jê, entre outras, além do trumai, sem classificação.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "XINGU_PIB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "territorio-indigena-xingu-geografo-P04",
      "factKey": "territorio-indigena-xingu-F04",
      "text": "Segundo o ISA, cerca de oito mil pessoas de 16 povos viviam no território em 2018.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "XINGU_ISA2018"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "territorio-indigena-xingu-geografo-P05",
      "factKey": "territorio-indigena-xingu-F05",
      "text": "Criado em 1961 por decreto de Jânio Quadros, o parque central foi a primeira grande terra indígena demarcada pelo governo federal.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "XINGU_PIB",
       "XINGU_ISA2018"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "territorio-indigena-xingu-geografo-P06",
      "factKey": "territorio-indigena-xingu-F06",
      "text": "Segundo o ISA, a inclusão das terras Wawi e Batovi, em 1998, levou a área a cerca de 2,8 milhões de hectares.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "XINGU_PIB",
       "XINGU_ISA2018"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "territorio-indigena-xingu-geografo-P07",
      "factKey": "territorio-indigena-xingu-F07",
      "text": "Wawi também nomeia um dos polos de apoio logístico, ao lado de Diauarum, Pavuru e Leonardo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "XINGU_PLANO"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "territorio-indigena-xingu-geografo-P08",
      "factKey": "territorio-indigena-xingu-F08",
      "text": "Batovi e Pequizal do Naruvôtu estão entre as três terras somadas ao parque criado em 1961.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "XINGU_PLANO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "territorio-indigena-xingu-geografo-P09",
      "factKey": "territorio-indigena-xingu-F09",
      "text": "Para a gestão, o território se divide em quatro regiões: Alto, Médio, Baixo e Leste.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
