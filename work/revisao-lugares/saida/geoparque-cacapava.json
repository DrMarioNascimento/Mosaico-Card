     },
     {
      "id": "geoparque-cacapava-geografo-P23",
      "factKey": "geoparque-cacapava-geografo-F23",
      "text": "Uma feira municipal de artesanato vende geoprodutos, ligando o patrimônio geológico à economia local.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_JC"
      ],
      "clueType": "territorio",
