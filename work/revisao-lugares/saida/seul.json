    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "seul-viajante-P01",
            "factKey": "seul-F01",
            "text": "Este destino é uma metrópole do Leste Asiático, cortada por um rio largo.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P02",
            "factKey": "seul-F02",
            "text": "O inverno é frio, com média perto de −3 °C em janeiro, e agosto, o mês mais quente, fica em torno de 25 °C.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P03",
            "factKey": "seul-F03",
            "text": "A chuva do ano, cerca de 1.370 mm, se concentra nos meses de verão.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P04",
            "factKey": "seul-F04",
            "text": "O centro fica numa baixada cercada de morros de uns 300 metros.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P05",
            "factKey": "seul-F05",
            "text": "O mar fica a cerca de 60 km a oeste do centro.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P06",
            "factKey": "seul-F06",
            "text": "Uma antiga muralha de pedra, de cerca de 18 km, acompanha o alto dos morros, e seus restos viraram um passeio popular.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SEUL_BRITANNICA",
              "SEUL_WIKI_HIST"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P07",
            "factKey": "seul-F07",
            "text": "Portões históricos da antiga muralha continuam de pé no meio da cidade moderna.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SEUL_WIKI_HIST",
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P08",
            "factKey": "seul-F08",
            "text": "No centro, ao norte do rio, as ruas formam basicamente uma grade retangular.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P09",
            "factKey": "seul-F09",
            "text": "Um riacho que corta o centro foi recuperado e virou parque e ponto turístico.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P10",
            "factKey": "seul-F10",
            "text": "Numa ilha do rio fica o prédio da Assembleia Nacional.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P11",
            "factKey": "seul-F11",
            "text": "A margem sul virou uma segunda área de negócios, com prédios altos, escritórios e empresas de tecnologia.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P12",
            "factKey": "seul-F12",
            "text": "O rio já foi muito poluído, mas melhorou a partir dos anos 1980 com grandes estações de tratamento de esgoto.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P13",
            "factKey": "seul-F13",
            "text": "Desde os anos 1970, um cinturão verde segura o crescimento da cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P14",
            "factKey": "seul-F14",
            "text": "Há sinais de gente vivendo à beira do rio desde cerca de 4000 a.C.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P15",
            "factKey": "seul-F15",
            "text": "Por volta de 18 a.C., um reino antigo fundou sua capital, Wiryeseong, que provavelmente ficava dentro da cidade atual.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_WIKI_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P16",
            "factKey": "seul-F16",
            "text": "Um grande palácio real, em ruínas por mais de dois séculos e meio, começou a ser reconstruído em 1865.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P17",
            "factKey": "seul-F17",
            "text": "Pouco depois, navios de guerra franceses apareceram no rio da cidade.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P18",
            "factKey": "seul-F18",
            "text": "Em 1897 ela virou capital de um império, ganhou parques públicos e uma linha de bonde.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P19",
            "factKey": "seul-F19",
            "text": "De 1910 a 1945, foi a capital colonial sob domínio japonês.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_WIKI_HIST",
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P20",
            "factKey": "seul-F20",
            "text": "Na guerra iniciada em 1950, a cidade trocou de mãos quatro vezes e terminou em ruínas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_WIKI_HIST",
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P21",
            "factKey": "seul-F21",
            "text": "Depois da guerra, a industrialização dos anos 1960 e 1970 trouxe um crescimento econômico acelerado.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_WIKI_HIST",
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P22",
            "factKey": "seul-F22",
            "text": "A cidade foi fundada em 1394 como capital de um reino unificado.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SEUL_BRITANNICA",
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P23",
            "factKey": "seul-F23",
            "text": "Sediou os Jogos Olímpicos de Verão de 1988 e foi uma das sedes da Copa do Mundo de 2002.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_WIKI_HIST"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P24",
            "factKey": "seul-F24",
            "text": "No tempo da dinastia Joseon, o nome oficial era Hanseong, algo como “cidade fortificada no rio Han”.",
            "relatedFields": [
              "C3",
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA",
              "SEUL_WIKI_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-viajante-P25",
            "factKey": "seul-F25",
            "text": "O bairro de Gangnam (Kangnam), ao sul do rio, reúne cerca de metade da população.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
