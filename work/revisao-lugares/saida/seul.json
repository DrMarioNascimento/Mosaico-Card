      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "seul-geografo-P01",
            "factKey": "seul-F01",
            "text": "Metrópole no interior de uma península do Leste Asiático, instalada no curso inferior de um grande rio.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA",
              "SEUL_WIKI_HIST"
            ],
            "clueType": "localizacao",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P02",
            "factKey": "seul-F02",
            "text": "A grande amplitude térmica anual e a chuva concentrada no verão dão ao clima um forte contraste entre as estações.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P03",
            "factKey": "seul-F26",
            "text": "O vale do rio era um eixo de transporte, e controlá-lo significava dominar estrategicamente a península.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_WIKI_HIST"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P04",
            "factKey": "seul-F04",
            "text": "O sítio é uma bacia baixa rodeada de morros de cerca de 300 m, uns 60 km a leste do mar Amarelo.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P05",
            "factKey": "seul-F22",
            "text": "Em 1394, o novo rei escolheu o lugar por ser acessível ao mar e central no reino.",
            "relatedFields": [
              "C3",
              "C4"
            ],
            "sources": [
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P06",
            "factKey": "seul-F27",
            "text": "Logo após a fundação, o palácio principal, o altar dos deuses do solo e dos grãos e o santuário dos ancestrais reais organizaram a capital.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P07",
            "factKey": "seul-F06",
            "text": "Dois anos após a fundação, uma muralha de cerca de 18 km foi erguida ao longo das cristas que cercam a bacia.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P08",
            "factKey": "seul-F07",
            "text": "As ruas irradiam dos quatro portões históricos, e vias circulares concêntricas ligam as áreas mais externas.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P09",
            "factKey": "seul-F28",
            "text": "Perto do pé dos morros, as irregularidades do relevo desviam o traçado das ruas.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P10",
            "factKey": "seul-F29",
            "text": "A população passou de cerca de 100 mil no censo de 1429 para uns 250 mil em 1910.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P11",
            "factKey": "seul-F30",
            "text": "Foi capital de 1394 até a divisão do país em 1948, com uma breve interrupção entre 1399 e 1405.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P12",
            "factKey": "seul-F31",
            "text": "Sob o domínio japonês, os recursos se concentraram ao sul do riacho Cheonggyecheon, onde viviam os japoneses, e os coreanos sofriam discriminação.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P13",
            "factKey": "seul-F19",
            "text": "Na colônia, chamava-se Gyeongseong (Keijō) e integrava a província de Gyeonggi.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_WIKI_HIST",
              "SEUL_BRITANNICA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P14",
            "factKey": "seul-F32",
            "text": "Refugiados do pós-guerra elevaram a população para cerca de 2,5 milhões, mais da metade sem moradia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_WIKI_HIST"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P15",
            "factKey": "seul-F33",
            "text": "O crescimento do pós-guerra abriu ruas ao sul do rio e exigiu redes de água e esgoto, metrô, moradias e escolas.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_MUSEU_HIST"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P16",
            "factKey": "seul-F34",
            "text": "O limite atual do município data de 1963, quando a área ficou cerca do dobro da de 1948.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P17",
            "factKey": "seul-F13",
            "text": "Desde os anos 1970, um cinturão verde conteve a mancha urbana e empurrou subúrbios e cidades-satélite para fora.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P18",
            "factKey": "seul-F11",
            "text": "A margem sul cresceu como segundo centro de negócios, com turismo, design, moda e tecnologia da informação.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P19",
            "factKey": "seul-F12",
            "text": "Controle do nível da água e grandes estações de tratamento reduziram a poluição do rio desde o início dos anos 1980.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA_CLIMA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P20",
            "factKey": "seul-F09",
            "text": "A recuperação do riacho Cheonggye criou um parque fluvial e uma atração turística no centro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P21",
            "factKey": "seul-F35",
            "text": "Em 1948 recebeu o status de Cidade Especial, que até hoje aparece em seu nome formal.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_MUSEU_HIST",
              "SEUL_BRITANNICA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P22",
            "factKey": "seul-F36",
            "text": "A borda noroeste do município fica a cerca de 40 km da zona desmilitarizada que divide a península.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P23",
            "factKey": "seul-F37",
            "text": "Em 1104, um rei de Goryeo construiu ali um palácio, numa área então chamada Namgyeong.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SEUL_WIKI_HIST"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P24",
            "factKey": "seul-F24",
            "text": "Na dinastia Joseon, Hanyang era o nome mais usado e Hanseong, o oficial.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "seul-geografo-P25",
            "factKey": "seul-F25",
            "text": "Ao sul do rio, Gangnam concentra cerca de metade da população e metade da arrecadação local.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SEUL_BRITANNICA"
            ],
            "clueType": "urbanismo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      }
