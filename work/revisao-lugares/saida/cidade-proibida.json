            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-proibida-viajante-P13",
            "factKey": "cidade-proibida-F13",
            "text": "Na parte da frente ficam três grandes salões de governo sobre um terraço de mármore.",
