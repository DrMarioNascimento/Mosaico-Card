      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "maceio-geografo-P07",
      "factKey": "maceio-F07",
      "text": "Portos lacustres, como Trapiche da Barra e Fernão Velho, complementavam o porto marítimo de Jaraguá.",
