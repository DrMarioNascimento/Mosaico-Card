       "C1",
       "C3"
      ],
      "sources": [
       "ROBBEN_RIM"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-robben-geografo-P18",
      "factKey": "ilha-robben-F19",
      "text": "O trabalho forçado na pedreira de cal expôs os presos ao brilho da rocha branca e a lesões nos olhos.",
