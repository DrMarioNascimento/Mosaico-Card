            ],
            "sources": [
              "RECIFE_IBGEHIST"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "recife-viajante-P08",
            "factKey": "recife-F08",
            "text": "Uma sinagoga de 1636, considerada a primeira documentada das Américas, fica numa rua do centro antigo.",
