            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "recife-viajante-P07",
            "factKey": "recife-F07",
            "text": "Na época holandesa, o conde Maurício de Nassau trouxe artistas e cientistas, como o pintor Frans Post.",
