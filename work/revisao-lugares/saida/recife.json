            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "recife-viajante-P06",
            "factKey": "recife-F06",
            "text": "Dois rios, o Capibaribe e o Beberibe, chegam ao mar junto ao centro antigo.",
