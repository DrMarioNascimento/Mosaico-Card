            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P21",
            "factKey": "parque-virunga-F21",
            "text": "Grupos armados controlam setores da unidade, e 14 funcionários do parque foram mortos em 2023.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_SOC2024"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P22",
            "factKey": "parque-virunga-F22",
            "text": "Inscrita em 1979 por critérios naturais, a unidade está desde 1994 na Lista do Patrimônio Mundial em Perigo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_SOC2024",
              "VIRUNGA_EB"
