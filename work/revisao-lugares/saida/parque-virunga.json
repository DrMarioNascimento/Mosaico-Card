    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "parque-virunga-viajante-P01",
            "factKey": "parque-virunga-F01",
            "text": "Este destino é uma área protegida africana cujas paisagens vão de pântanos e savanas a montanhas com neve.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P02",
            "factKey": "parque-virunga-F02",
            "text": "O parque foi criado há cerca de cem anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_EB",
              "VIRUNGA_ORG"
            ],
            "clueType": "historia",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P03",
            "factKey": "parque-virunga-F03",
            "text": "É uma faixa comprida e estreita: cerca de 300 km de comprimento e, em média, só 25 km de largura.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P04",
            "factKey": "parque-virunga-F04",
            "text": "A área total chega perto de 8 mil km².",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_EB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P05",
            "factKey": "parque-virunga-F05",
            "text": "Dentro do parque, a altitude vai de menos de 700 metros a mais de 5 mil metros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P06",
            "factKey": "parque-virunga-F06",
            "text": "Além de savanas e pântanos, há turfeiras e planícies de lava.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_EB"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P07",
            "factKey": "parque-virunga-F07",
            "text": "No sul, uma cadeia de vulcões domina a paisagem, e dois deles ainda estão ativos.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_EB"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P08",
            "factKey": "parque-virunga-F08",
            "text": "Um dos vulcões tem na cratera um lago de lava quase permanente, que de tempos em tempos se esvazia.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P09",
            "factKey": "parque-virunga-F09",
            "text": "A administração do parque diz que esse é o maior lago de lava do mundo, com cerca de 210 metros de largura.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VIRUNGA_ORG"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P10",
            "factKey": "parque-virunga-F10",
            "text": "Em 2002, um derrame de lava destruiu boa parte da cidade de Goma, vizinha ao parque.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P11",
            "factKey": "parque-virunga-F11",
            "text": "Esse vulcão voltou a entrar em erupção em maio de 2021.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P12",
            "factKey": "parque-virunga-F12",
            "text": "No norte, o parque sobe até picos com neve quase em cima da linha do equador.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_EB"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P13",
            "factKey": "parque-virunga-F13",
            "text": "O ponto mais alto do parque, a 5.109 metros, é o terceiro pico mais alto da África e é dividido com um parque de Uganda.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P14",
            "factKey": "parque-virunga-F14",
            "text": "As geleiras dessas montanhas encolheram de cerca de 600 hectares em 1906 para 200 hectares em 2005.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P15",
            "factKey": "parque-virunga-F15",
            "text": "Um grande lago ocupa boa parte da região central do parque.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "VIRUNGA_EB"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P16",
            "factKey": "parque-virunga-F16",
            "text": "O parque fica na República Democrática do Congo e está desde 1994 na lista do Patrimônio Mundial em Perigo, por causa de conflitos armados.",
            "relatedFields": [
              "C4",
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_SOC2024",
              "VIRUNGA_EB"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P17",
            "factKey": "parque-virunga-F17",
            "text": "A descrição da UNESCO fala em uns 20 mil hipopótamos nos rios, mas um levantamento recente contou cerca de 1.400.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P18",
            "factKey": "parque-virunga-F18",
            "text": "Aves vindas da Sibéria passam o inverno no parque.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P19",
            "factKey": "parque-virunga-F19",
            "text": "São mais de 700 espécies de aves, cerca de dois terços das registradas no país.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P20",
            "factKey": "parque-virunga-F20",
            "text": "Todos os gorilas-das-montanhas do parque vivem num só setor, o de Mikeno, nome de um dos vulcões adormecidos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_EB"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P21",
            "factKey": "parque-virunga-F21",
            "text": "Numa montanha isolada vive um pequeno grupo de gorilas-de-grauer, que passou de 7 para 11 em 2024 com a chegada de quatro fêmeas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P22",
            "factKey": "parque-virunga-F22",
            "text": "O ocapi, um animal raro, e chimpanzés vivem nas florestas úmidas do vale do rio Semliki.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P23",
            "factKey": "parque-virunga-F23",
            "text": "Elefantes e até um leão atravessam a fronteira entre este parque e o Parque Nacional Queen Elizabeth, em Uganda.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P24",
            "factKey": "parque-virunga-F24",
            "text": "Segundo a administração, é o único lugar do mundo onde vivem três tipos de grandes primatas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_ORG"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-viajante-P25",
            "factKey": "parque-virunga-F25",
            "text": "Foi o primeiro parque nacional criado na África, em 1925, com o nome de Parque Nacional Albert.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_ORG",
              "VIRUNGA_EB"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "parque-virunga-geografo-P01",
            "factKey": "parque-virunga-F01",
            "text": "O gradiente de altitude, de mais de 4 mil metros, explica a variedade de habitats, de pântanos e estepes a campos de neve.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P02",
            "factKey": "parque-virunga-F02",
            "text": "A unidade fica no centro do Rift Albertino, ramo do Grande Vale do Rift.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P03",
            "factKey": "parque-virunga-F03",
            "text": "A forma alongada — 300 km de extensão, largura média de 25 km e mínima de 2,5 km — gera mais de 1.150 km de limites a vigiar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P04",
            "factKey": "parque-virunga-F04",
            "text": "Dois vulcões ativos da unidade respondem por cerca de dois quintos das erupções históricas registradas na África.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P05",
            "factKey": "parque-virunga-F05",
            "text": "O maciço vulcânico do sul reúne oito vulcões, sete deles total ou parcialmente dentro da unidade; o mais alto chega a cerca de 4.500 m.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P06",
            "factKey": "parque-virunga-F06",
            "text": "A cratera de um desses vulcões guarda um lago de lava quase permanente, que se esvazia periodicamente.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P07",
            "factKey": "parque-virunga-F07",
            "text": "A atividade vulcânica ameaça o entorno: um derrame destruiu grande parte de Goma em 2002, e houve nova erupção em maio de 2021.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P08",
            "factKey": "parque-virunga-F08",
            "text": "No norte, a unidade divide com um parque ugandense o pico de 5.109 m, terceiro mais alto da África.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_EB"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P09",
            "factKey": "parque-virunga-F09",
            "text": "As geleiras desse maciço do norte caíram de 600 ha em 1906 para 200 ha em 2005 e hoje estão quase extintas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P10",
            "factKey": "parque-virunga-F10",
            "text": "Os rios Rwindi, Rutshuru e Semliki formam o habitat dos hipopótamos da unidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P11",
            "factKey": "parque-virunga-F11",
            "text": "As planícies do setor central já tiveram a maior densidade de hipopótamos conhecida na África.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P12",
            "factKey": "parque-virunga-F12",
            "text": "O lago que ocupa boa parte do centro da unidade produzia 15 a 16 mil toneladas de peixe por ano em 1989; hoje seriam menos de 400.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO",
              "VIRUNGA_EB"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P13",
            "factKey": "parque-virunga-F13",
            "text": "O direito de pesca das comunidades foi mantido na criação do parque, e o número de barcos no lago cresceu mais de 300%.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P14",
            "factKey": "parque-virunga-F14",
            "text": "Com 218 espécies de mamíferos, a unidade reúne mais da metade dos mamíferos do país.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P15",
            "factKey": "parque-virunga-F15",
            "text": "São 2.077 espécies de plantas superiores, num mosaico que vai de pântanos e estepes a planícies de lava.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P16",
            "factKey": "parque-virunga-F16",
            "text": "As florestas úmidas do vale do Semliki, onde vivem chimpanzés e ocapis, são ameaçadas pelo desmatamento.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P17",
            "factKey": "parque-virunga-F17",
            "text": "Os gorilas-das-montanhas da unidade se concentram no setor Mikeno, e o ebola é um risco sério para eles.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P18",
            "factKey": "parque-virunga-F18",
            "text": "A unidade integra uma colaboração transfronteiriça com Uganda e Ruanda e troca elefantes com o Parque Nacional Queen Elizabeth.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P19",
            "factKey": "parque-virunga-F19",
            "text": "O comércio ilegal de carvão vegetal movimenta, conforme a estimativa, de 35 milhões a mais de 170 milhões de dólares por ano.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "VIRUNGA_IUCN_WHO"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P20",
            "factKey": "parque-virunga-F20",
            "text": "Em 2007, cerca de 85% da área foi destinada a concessões de petróleo; o Comitê do Patrimônio Mundial pede o cancelamento definitivo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
