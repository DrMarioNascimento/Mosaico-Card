            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P24",
            "factKey": "parque-virunga-F24",
            "text": "É o único sítio do mundo com três grandes primatas: gorila-das-montanhas, gorila-de-grauer e chimpanzé-oriental.",
