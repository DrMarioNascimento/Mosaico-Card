            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-virunga-geografo-P23",
            "factKey": "parque-virunga-F23",
            "text": "A gestão cabe ao instituto congolês de conservação da natureza (ICCN), em cogestão com uma fundação até 2040.",
