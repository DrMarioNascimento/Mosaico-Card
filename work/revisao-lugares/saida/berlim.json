  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "berlim-viajante-P01",
      "factKey": "berlim-F01",
      "text": "É uma capital europeia com rio, canais e um cinturão de lagos a leste e a oeste.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P02",
      "factKey": "berlim-F02",
      "text": "A cidade fica no coração de uma grande planície do norte da Europa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT"
      ],
      "clueType": "relevo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P03",
      "factKey": "berlim-F03",
      "text": "O rio que atravessa o centro da cidade é o Spree.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT",
       "BERLIM_ICOMOS_MUSEUMSINSEL"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P04",
      "factKey": "berlim-F04",
      "text": "A cidade nasceu de duas vilas gêmeas que cresceram a partir do início do século XIII.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P05",
      "factKey": "berlim-F05",
      "text": "Foi capital de um reino e, a partir de 1871, de um país recém-unificado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P06",
      "factKey": "berlim-F06",
      "text": "Na madrugada de 13 de agosto de 1961, a cidade foi cortada por arame farpado, que dias depois virou muro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_STIFTUNG_MAUER",
       "BERLIM_VISITBERLIN_MURO"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P07",
      "factKey": "berlim-F07",
      "text": "O muro que dividia a cidade caiu em 9 de novembro de 1989.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_VISITBERLIN_MURO",
       "BERLIM_STIFTUNG_MAUER"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P08",
      "factKey": "berlim-F08",
      "text": "Uma fileira dupla de paralelepípedos no chão mostra por onde passava o muro no centro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_VISITBERLIN_MURO"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P09",
      "factKey": "berlim-F09",
      "text": "Em 1990, 118 artistas de 21 países pintaram a East Side Gallery num muro interno da antiga fronteira; a divisa real corria pela margem oposta.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_VISITBERLIN_MURO"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P10",
      "factKey": "berlim-F10",
      "text": "Uma trilha de cerca de 180 km, dividida em 14 trechos, acompanha a antiga faixa de fronteira.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_VISITBERLIN_MURO"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P11",
      "factKey": "berlim-F11",
      "text": "O posto de controle mais famoso entre as duas metades da cidade ficava na Friedrichstrasse.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P12",
      "factKey": "berlim-F12",
      "text": "Uma larga avenida liga as proximidades da Alexanderplatz a um portão monumental, cuja quadriga foi restaurada em 1958 e em 1991.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P13",
      "factKey": "berlim-F13",
      "text": "Logo a oeste desse portão fica o Tiergarten, grande parque perto do centro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P14",
      "factKey": "berlim-F14",
      "text": "Uma torre de televisão de 365 metros, concluída em 1969, é um dos marcos do centro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P15",
      "factKey": "berlim-F15",
      "text": "O velho prédio do parlamento, muito restaurado, voltou a receber o legislativo nacional em 1999.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P16",
      "factKey": "berlim-F16",
      "text": "Numa ilha do rio, no centro, cinco museus foram construídos entre 1824 e 1930.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "BERLIM_ICOMOS_MUSEUMSINSEL",
       "BERLIM_RP_MUSEUMSINSEL"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P17",
      "factKey": "berlim-F17",
      "text": "Entre os tesouros desses museus estão o busto de Nefertiti, o Portão de Ishtar e o Altar de Pérgamo.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "BERLIM_WELTERBE_MUSEUMSINSEL"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P18",
      "factKey": "berlim-F18",
      "text": "Um dos museus da ilha ficou em ruínas por cerca de 60 anos antes de ser reconstruído.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BERLIM_WELTERBE_MUSEUMSINSEL"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P19",
      "factKey": "berlim-F19",
      "text": "O bairro de Kreuzberg tem a maior comunidade turca da Europa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P20",
      "factKey": "berlim-F20",
      "text": "O Palácio de Charlottenburg, do fim do século XVII, é um dos grandes edifícios barrocos da cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P21",
      "factKey": "berlim-F21",
      "text": "Palácios e parques à beira do rio Havel e do lago Glienicke ligam a cidade à vizinha onde fica o palácio de Sanssouci.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BERLIM_UNESCO_POTSDAM"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P22",
      "factKey": "berlim-F22",
      "text": "Voltaire se hospedou em Sanssouci, palácio construído para Frederico II entre 1745 e 1747.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BERLIM_UNESCO_POTSDAM"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P23",
      "factKey": "berlim-F23",
      "text": "Os parques desse conjunto de palácios somam 500 hectares, com 150 edifícios erguidos entre 1730 e 1916.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BERLIM_UNESCO_POTSDAM"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P24",
      "factKey": "berlim-F24",
      "text": "A sala de concertos da Filarmônica da cidade foi projetada por Hans Scharoun.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-viajante-P25",
      "factKey": "berlim-F25",
      "text": "É a capital da Alemanha e seu principal centro urbano.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "berlim-geografo-P01",
      "factKey": "berlim-F01",
      "text": "Um rio que cruza o centro, canais e uma faixa de lagos a leste e a oeste estruturam a paisagem urbana.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "agua",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P02",
      "factKey": "berlim-F05",
      "text": "A posição num eixo comercial e geográfico leste–oeste ajudou a cidade a virar capital de um reino e, depois, de um país unificado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT"
      ],
      "clueType": "localizacao",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P03",
      "factKey": "berlim-F04",
      "text": "O tecido urbano original vem de duas cidades gêmeas que se desenvolveram desde o início do século XIII.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P04",
      "factKey": "berlim-F29",
      "text": "O centro histórico, o Mitte, concentrava funções administrativas, comerciais e culturais e ficou do lado oriental na divisão.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P05",
      "factKey": "berlim-F30",
      "text": "Na divisão, as duas metades tinham áreas parecidas, e a ocidental criou um novo centro em torno de um bulevar de um antigo subúrbio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P06",
      "factKey": "berlim-F06",
      "text": "O muro, erguido pelo governo da Alemanha Oriental em 1961, separava as duas metades e cercava toda a parte ocidental.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_BRIT_LAYOUT",
       "BERLIM_STIFTUNG_MAUER"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P07",
      "factKey": "berlim-F32",
      "text": "Entre as duas metades havia sete passagens rodoviárias e uma ferroviária.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_STIFTUNG_MAUER"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P08",
      "factKey": "berlim-F33",
      "text": "A faixa de fronteira, chamada de faixa da morte no lado ocidental, era mantida livre para dar visão e campo de tiro aos guardas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_STIFTUNG_MAUER"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P09",
      "factKey": "berlim-F34",
      "text": "Segundo a fundação do memorial, 140 pessoas morreram no muro entre 1961 e 1989; 91 foram baleadas por guardas, a maioria tentando fugir.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_STIFTUNG_MAUER"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P10",
      "factKey": "berlim-F07",
      "text": "Depois da queda do muro, em 1989, a demolição no centro terminou oficialmente em 30 de novembro de 1990.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BERLIM_VISITBERLIN_MURO"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "berlim-geografo-P11",
      "factKey": "berlim-F08",
      "text": "O antigo traçado do muro no centro está marcado no chão com paralelepípedos e placas de ferro fundido.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
