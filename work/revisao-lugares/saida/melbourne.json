            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P14",
            "factKey": "melbourne-F38",
            "text": "Depois da federação de 1901, a cidade foi sede provisória do governo, e o Parlamento se reuniu no salão de exposições até 1927.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
