            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P20",
            "factKey": "melbourne-F44",
            "text": "O Grande Salão foi erguido para as exposições internacionais de 1880 e 1888, os maiores eventos da Austrália colonial.",
