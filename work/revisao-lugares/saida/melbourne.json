            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P18",
            "factKey": "melbourne-F42",
            "text": "No Censo de 2021, 58,8% dos moradores tinham nascido na Austrália; a Índia vinha em seguida, com 4,9%.",
