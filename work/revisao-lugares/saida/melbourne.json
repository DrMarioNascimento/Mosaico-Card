    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "melbourne-viajante-P01",
            "factKey": "melbourne-F01",
            "text": "É uma metrópole litorânea do hemisfério sul, banhada por uma grande baía.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_BRIT"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P02",
            "factKey": "melbourne-F02",
            "text": "O tempo aqui é imprevisível: pode mudar mais de uma vez no mesmo dia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P03",
            "factKey": "melbourne-F03",
            "text": "Os verões são quentes, os invernos são frescos e raramente congelam; chove o ano todo e venta com frequência.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P04",
            "factKey": "melbourne-F04",
            "text": "O centro fica junto à foz de um rio, no fundo da baía.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "MELBOURNE_BRIT"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P05",
            "factKey": "melbourne-F05",
            "text": "O primeiro povoado nasceu na margem norte do rio Yarra.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P06",
            "factKey": "melbourne-F06",
            "text": "É a segunda maior cidade do país, atrás apenas de Sydney.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_BRIT",
              "MELBOURNE_EBSCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P07",
            "factKey": "melbourne-F07",
            "text": "É a capital do estado de Victoria.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_BRIT",
              "MELBOURNE_EBSCO"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P08",
            "factKey": "melbourne-F08",
            "text": "A rede de bondes é apontada como a maior do mundo, com cerca de 250 km de trilhos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P09",
            "factKey": "melbourne-F09",
            "text": "No centro, há uma zona em que andar de bonde é de graça.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P10",
            "factKey": "melbourne-F10",
            "text": "Cerca de quarenta vielas reúnem cafés, lojas e arte de rua.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P11",
            "factKey": "melbourne-F11",
            "text": "Um mercado público funciona no centro desde 1878.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P12",
            "factKey": "melbourne-F12",
            "text": "O maior estádio do país, para mais de 100 mil pessoas, é a casa do futebol australiano.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P13",
            "factKey": "melbourne-F13",
            "text": "Todo mês de janeiro, a cidade recebe o Aberto da Austrália de tênis.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P14",
            "factKey": "melbourne-F14",
            "text": "Todo novembro, o hipódromo de Flemington recebe uma grande corrida de cavalos que leva o nome da cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P15",
            "factKey": "melbourne-F15",
            "text": "Sediou os Jogos Olímpicos de 1956, os primeiros fora da Europa e dos Estados Unidos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P16",
            "factKey": "melbourne-F16",
            "text": "Em 1851, a descoberta de ouro fez a população saltar de cerca de 25 mil para 40 mil pessoas em poucos meses.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P17",
            "factKey": "melbourne-F17",
            "text": "Com a corrida do ouro chegaram imigrantes da China e da Europa, e no mesmo ano surgiu um bairro chinês.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P18",
            "factKey": "melbourne-F18",
            "text": "Tem a maior população de língua grega fora da Grécia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P19",
            "factKey": "melbourne-F19",
            "text": "Um grande salão de exposições do século XIX, com cúpula, fica entre jardins formais com fontes e lagos.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "MELBOURNE_HCV"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P20",
            "factKey": "melbourne-F20",
            "text": "Esse salão e seus jardins entraram para a Lista do Patrimônio Mundial em 2004.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "MELBOURNE_MV"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P21",
            "factKey": "melbourne-F21",
            "text": "Foi nesse salão que se abriu o primeiro Parlamento federal do país, em 9 de maio de 1901.",
            "relatedFields": [
              "C1",
              "C4"
            ],
            "sources": [
              "MELBOURNE_MV"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P22",
            "factKey": "melbourne-F22",
            "text": "De 1901 a 1927, a cidade foi a sede provisória do governo do país, até a mudança para Camberra.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO",
              "MELBOURNE_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P23",
            "factKey": "melbourne-F23",
            "text": "Os povos Wurundjeri Woi Wurrung e Bunurong Boon Wurrung, da nação Kulin, são os donos tradicionais destas terras.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_COM"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P24",
            "factKey": "melbourne-F24",
            "text": "À beira do rio, o parque Birrarung Marr guarda o nome aborígene do rio, que quer dizer \"rio de névoas\".",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "MELBOURNE_COM"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-viajante-P25",
            "factKey": "melbourne-F25",
            "text": "Em 1837, a cidade recebeu o nome de um primeiro-ministro britânico da época, William Lamb.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_BRIT",
              "MELBOURNE_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "melbourne-geografo-P01",
            "factKey": "melbourne-F26",
            "text": "Grande cidade costeira cuja ocupação europeia permanente começou na década de 1830.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_BRIT"
            ],
            "clueType": "historia",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P02",
            "factKey": "melbourne-F27",
            "text": "A área metropolitana cobre quase 10 mil km² e é administrada por 31 governos locais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P03",
            "factKey": "melbourne-F04",
            "text": "O núcleo urbano ocupa a cabeceira de uma grande baía, junto à foz do rio que corta a cidade.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "MELBOURNE_BRIT"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P04",
            "factKey": "melbourne-F28",
            "text": "Há cerca de 20 mil anos, com o mar mais baixo, a baía era uma bacia de planícies e áreas úmidas, e uma plataforma ligava o continente à Tasmânia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_DEECA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P05",
            "factKey": "melbourne-F29",
            "text": "Com o degelo do fim da última Era Glacial, o mar subiu e inundou essa bacia; a costa atual se formou há cerca de 5 a 6 mil anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_DEECA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P06",
            "factKey": "melbourne-F30",
            "text": "O delta do rio já foi bem mais largo: o atual lago do Albert Park fazia parte dele.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "MELBOURNE_DEECA"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P07",
            "factKey": "melbourne-F31",
            "text": "Para os povos tradicionais, o rio se chama Birrarung, e a baía se chamava Nerrm.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "MELBOURNE_DEECA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P08",
            "factKey": "melbourne-F32",
            "text": "O centro era ponto de encontro dos cinco grupos linguísticos kulin, que ali faziam cerimônias, trocas, casamentos e resolviam disputas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_DEECA"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P09",
            "factKey": "melbourne-F33",
            "text": "O \"tratado\" de 1835 entre John Batman e líderes tradicionais foi declarado inválido pelas autoridades britânicas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_DEECA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P10",
            "factKey": "melbourne-F34",
            "text": "Os colonos do primeiro assentamento permanente, em 1835, vieram da Terra de Van Diemen, a atual Tasmânia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_BRIT",
              "MELBOURNE_EBSCO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P11",
            "factKey": "melbourne-F35",
            "text": "A escalada administrativa foi rápida: assentamento da Coroa em 1837, vila em 1842, cidade em 1847 e capital de colônia em 1851.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
