            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P19",
            "factKey": "melbourne-F43",
            "text": "O conjunto Patrimônio Mundial da cidade é um raro testemunho intacto do movimento das exposições internacionais do século XIX.",
