            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P13",
            "factKey": "melbourne-F37",
            "text": "A corrida do ouro iniciada em 1851 acelerou o crescimento urbano e atraiu imigrantes da China e da Europa.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MELBOURNE_BRIT",
              "MELBOURNE_EBSCO"
            ],
            "clueType": "processo",
