            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P15",
            "factKey": "melbourne-F39",
            "text": "É um centro industrial, comercial e financeiro, sede de bancos como ANZ e National Australia Bank.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_BRIT",
              "MELBOURNE_EBSCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "melbourne-geografo-P16",
            "factKey": "melbourne-F40",
            "text": "Saúde e educação pesam na economia: são cerca de 30 hospitais públicos e sete universidades públicas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MELBOURNE_EBSCO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
