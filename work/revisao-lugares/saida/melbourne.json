          },
          {
            "id": "melbourne-geografo-P12",
            "factKey": "melbourne-F36",
            "text": "A área foi incorporada primeiro a Nova Gales do Sul; em 1851, a cidade virou capital da nova colônia de Victoria.",
            "relatedFields": [
