      ],
      "sources": [
       "NATAL_IBGE1973"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P15",
      "factKey": "natal-F15",
      "text": "O sítio urbano antigo dividia-se entre a Cidade Alta e a Ribeira, perto da foz.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
