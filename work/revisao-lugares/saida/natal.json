   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "natal-geografo-P01",
      "factKey": "natal-F01",
      "text": "É uma capital costeira nascida junto ao estuário de um rio, numa planície de dunas fixas.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "NATAL_IBGE1973",
       "NATAL_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P02",
      "factKey": "natal-F02",
      "text": "A defesa da barra do rio foi o ponto de partida da ocupação portuguesa.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "NATAL_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P03",
      "factKey": "natal-F03",
      "text": "Em 1535, a resistência potiguar e franceses ligados ao pau-brasil frustraram a primeira tentativa de colonização.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NATAL_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P04",
      "factKey": "natal-F04",
      "text": "Uma esquadra entrou na foz do rio em 25 de dezembro de 1597 para preparar a conquista.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "NATAL_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P05",
      "factKey": "natal-F05",
      "text": "O forte, iniciado em janeiro de 1598 sobre arrecifes, ficou pronto em junho do mesmo ano.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "NATAL_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P06",
      "factKey": "natal-F06",
      "text": "O povoado cresceu em torno do forte e talvez tenha se chamado Cidade dos Reis.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "NATAL_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P07",
      "factKey": "natal-F07",
      "text": "Sob os holandeses, entre 1633 e 1654, o forte passou a se chamar Forte de Keulen.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "NATAL_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P08",
      "factKey": "natal-F08",
      "text": "Após a saída holandesa, o crescimento foi lento: cerca de 6.400 moradores em 1805.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NATAL_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P09",
      "factKey": "natal-F09",
      "text": "O estuário, chamado Boca da Barra, fica entre as praias da Redinha e do Forte.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "NATAL_UFRN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P10",
      "factKey": "natal-F10",
      "text": "O rio é a principal bacia hidrográfica que atravessa o município.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "NATAL_UFRN"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P11",
      "factKey": "natal-F11",
      "text": "O porto fica no estuário; em 1973, seu canal tinha ao menos 3,7 m na maré baixa.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "NATAL_IBGE1973"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P12",
      "factKey": "natal-F12",
      "text": "O primeiro navio atracou no porto em 24 de outubro de 1932.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "NATAL_IBGE1973"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P13",
      "factKey": "natal-F13",
      "text": "Em 1973, a economia da cidade se baseava principalmente nas atividades portuárias.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NATAL_IBGE1973"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-geografo-P14",
      "factKey": "natal-F14",
      "text": "O núcleo original corresponde ao entorno da atual Praça André de Albuquerque.",
