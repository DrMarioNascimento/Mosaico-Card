      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "natal-viajante-P06",
      "factKey": "natal-F06",
      "text": "Um forte foi começado sobre arrecifes junto à barra do rio em 1598.",
