       "C1"
      ],
      "sources": [
       "ATS_DETAILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P16",
      "factKey": "ilha-detaille-F16",
      "text": "A estação é o Sítio e Monumento Histórico nº 83 do Tratado da Antártida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_DETAILLE",
       "DETAILLE_HSM"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P17",
      "factKey": "ilha-detaille-F17",
      "text": "Pouco alterada, a estação lembra as condições da pesquisa antártica na época da assinatura do Tratado.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ATS_DETAILLE",
       "DETAILLE_HSM"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P18",
      "factKey": "ilha-detaille-F18",
      "text": "As venezianas fixas das janelas deixam o interior às escuras e exigem lanternas elétricas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_DETAILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P19",
      "factKey": "ilha-detaille-F19",
      "text": "O acesso à cabana depende de autorização prévia de uma Parte e de aviso à Parte que administra o sítio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_DETAILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P20",
      "factKey": "ilha-detaille-F20",
      "text": "A lotação é de até 12 pessoas dentro da base, sob supervisão próxima, e de até 50 em terra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_DETAILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P21",
      "factKey": "ilha-detaille-F21",
      "text": "Fogo e pequenos vazamentos de combustível são os impactos potenciais que levam à proibição de chamas no local.",
