      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P14",
      "factKey": "ilha-detaille-F14",
      "text": "Os antigos canis evidenciam que cães faziam parte da logística da base.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_DETAILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P15",
      "factKey": "ilha-detaille-F15",
      "text": "Depósitos de emergência, de carga e de tambores de combustível completam o conjunto material.",
