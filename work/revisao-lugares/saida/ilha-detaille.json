       "C1"
      ],
      "sources": [
       "ATS_DETAILLE"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P22",
      "factKey": "ilha-detaille-F22",
      "text": "Cada visita deve ser registrada no livro de visitantes mantido dentro da estação.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
