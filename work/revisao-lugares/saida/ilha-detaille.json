      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "ilha-detaille-geografo-P23",
      "factKey": "ilha-detaille-F23",
      "text": "Rochas submersas na aproximação e superfícies escorregadias no desembarque condicionam a operação de botes.",
      "relatedFields": [
       "C1"
