      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P21",
      "factKey": "panama-antigo-F21",
      "text": "Em 1826, um salão do bairro sediou o congresso convocado por Simón Bolívar.",
