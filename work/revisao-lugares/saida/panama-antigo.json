      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P11",
      "factKey": "panama-antigo-F11",
      "text": "Pedras lavradas das ruínas foram reaproveitadas para erguer a cidade nova.",
