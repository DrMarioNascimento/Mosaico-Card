      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P12",
      "factKey": "panama-antigo-F12",
      "text": "Nas ruínas ficam restos da catedral, de conventos e de prédios públicos.",
