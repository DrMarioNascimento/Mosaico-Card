      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P19",
      "factKey": "panama-antigo-F19",
      "text": "O Palácio Presidencial, erguido no fim do século XVII, fica no bairro histórico.",
