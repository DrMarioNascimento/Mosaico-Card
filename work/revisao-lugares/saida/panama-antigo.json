      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P08",
      "factKey": "panama-antigo-F08",
      "text": "Em 1673, a cidade foi refundada em outro ponto da costa.",
