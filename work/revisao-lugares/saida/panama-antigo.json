      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P23",
      "factKey": "panama-antigo-F23",
      "text": "Uma via construída sobre o mar mudou a relação do bairro com a orla.",
