      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P18",
      "factKey": "panama-antigo-F18",
      "text": "As igrejas de San José, San Francisco e La Merced estão entre os destaques do bairro.",
