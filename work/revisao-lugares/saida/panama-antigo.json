      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P17",
      "factKey": "panama-antigo-F17",
      "text": "No bairro histórico, a catedral tem cinco naves e teto de madeira.",
