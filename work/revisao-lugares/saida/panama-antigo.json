      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P15",
      "factKey": "panama-antigo-F15",
      "text": "Outra ponte antiga marca o fim de um caminho que cruzava o istmo usando um rio.",
