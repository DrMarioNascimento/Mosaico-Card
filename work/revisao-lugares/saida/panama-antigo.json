      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P14",
      "factKey": "panama-antigo-F14",
      "text": "Uma ponte antiga, a do Rei, ligava a cidade a um caminho colonial.",
