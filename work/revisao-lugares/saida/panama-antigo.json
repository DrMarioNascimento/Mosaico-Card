   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "panama-antigo-geografo-P01",
      "factKey": "panama-antigo-F01",
      "text": "O bem combina um sítio arqueológico e o núcleo histórico para onde a cidade foi transferida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PANAMA_CR2017",
       "PANAMA_ICOMOS2025"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P02",
      "factKey": "panama-antigo-F02",
      "text": "A posição num istmo entre o Caribe e o Pacífico fez da cidade um elo das rotas do império espanhol.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PANAMA_CR2017",
       "PANAMA_ICOMOS2025"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P03",
      "factKey": "panama-antigo-F03",
      "text": "As duas áreas ficam na vertente pacífica do istmo.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "PANAMA_ICOMOS2025",
       "PANAMA_CR2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P04",
      "factKey": "panama-antigo-F04",
      "text": "Fundado em 1519, o núcleo original foi o primeiro assentamento europeu na costa pacífica das Américas.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "PANAMA_CR2017"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P05",
      "factKey": "panama-antigo-F05",
      "text": "Mesmo com a mudança de sítio, a cidade é considerada o assentamento europeu mais antigo em ocupação contínua na costa pacífica americana.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "PANAMA_CR2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P06",
      "factKey": "panama-antigo-F06",
      "text": "A malha do núcleo original é uma grade levemente irregular, com quarteirões de tamanhos variados.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PANAMA_CR2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P07",
      "factKey": "panama-antigo-F07",
      "text": "A arquitetura em pedra dos edifícios públicos e religiosos do sítio original tem paralelos no sul da Espanha.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PANAMA_CR2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P08",
      "factKey": "panama-antigo-F08",
      "text": "O núcleo original passou por rebelião de escravizados, incêndio e terremoto antes de ser destruído após o ataque pirata de 1671.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "PANAMA_CR2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P09",
      "factKey": "panama-antigo-F09",
      "text": "Em 1673 a cidade foi refeita cerca de 7,5 km adiante, numa pequena península ao pé do morro Ancón.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "PANAMA_CR2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P10",
      "factKey": "panama-antigo-F10",
      "text": "O novo sítio ficava mais perto das ilhas usadas como porto e da foz de um rio que viria a ser a entrada do canal.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "PANAMA_CR2017"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-geografo-P11",
      "factKey": "panama-antigo-F11",
      "text": "Pedras lavradas e outros materiais das ruínas foram levados para construir o novo núcleo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
