      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "panama-antigo-viajante-P13",
      "factKey": "panama-antigo-F13",
      "text": "As ruínas ficam junto da foz de um rio chamado Abajo.",
