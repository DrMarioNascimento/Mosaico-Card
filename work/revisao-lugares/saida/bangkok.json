    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "bangkok-viajante-P01",
            "factKey": "bangkok-F01",
            "text": "É uma cidade grande e quente o ano inteiro, à beira de um rio, no Sudeste Asiático.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT",
              "BANGKOK_BRIT_POVO"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P02",
            "factKey": "bangkok-F02",
            "text": "A temporada de chuvas vai de meados de maio a setembro, com pancadas fortes no fim da tarde.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P03",
            "factKey": "bangkok-F03",
            "text": "As temperaturas médias vão de cerca de 25 °C em dezembro a 30 °C em abril.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P04",
            "factKey": "bangkok-F04",
            "text": "A estação seca vai de dezembro a fevereiro, e a umidade do ar fica entre 60% e mais de 80%.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P05",
            "factKey": "bangkok-F05",
            "text": "A cidade fica no delta de um grande rio, a uns 40 km do mar.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P06",
            "factKey": "bangkok-F06",
            "text": "Os canais renderam à cidade o apelido de “Veneza do Oriente”, mas muitos foram aterrados para dar lugar a ruas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_POVO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P07",
            "factKey": "bangkok-F07",
            "text": "Perto de um templo, um mercado flutuante vende mercadorias em barcos nos canais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P08",
            "factKey": "bangkok-F08",
            "text": "Há mais de 300 templos budistas, os wats, exemplos clássicos da arquitetura do país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_POVO",
              "BANGKOK_BRIT"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P09",
            "factKey": "bangkok-F09",
            "text": "Até 1782, ali havia só uma pequena vila; a capital ficava em Thon Buri, na margem oposta do rio.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BANGKOK_BRIT_TAILANDIA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P10",
            "factKey": "bangkok-F10",
            "text": "Em 1782, um general subiu ao trono como Rama I e levou a corte da margem oeste para a margem leste do rio Chao Phraya.",
            "relatedFields": [
              "C2",
              "C3"
            ],
            "sources": [
              "BANGKOK_BRIT_HIST",
              "BANGKOK_BRIT_TAILANDIA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P11",
            "factKey": "bangkok-F11",
            "text": "Esse rei fundou a dinastia Chakri, que reina no país até hoje.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BANGKOK_BRIT_RAMA1"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P12",
            "factKey": "bangkok-F12",
            "text": "A fundação é celebrada em 21 de abril de 1782, dia em que foi erguido o pilar sagrado da cidade, feito de madeira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_KHAOSOD"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P13",
            "factKey": "bangkok-F13",
            "text": "No reinado de Rama IV, o britânico John Bowring calculou que a cidade não passava de 300 mil habitantes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_KHAOSOD"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P14",
            "factKey": "bangkok-F14",
            "text": "O Grande Palácio, cercado de muros, e o templo Wat Pho ficaram prontos ainda no reinado de Rama I.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BANGKOK_BRIT_HIST"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P15",
            "factKey": "bangkok-F15",
            "text": "Em 1882, no centenário da cidade, foi concluído o grande templo real que guarda o Buda de Esmeralda.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_HIST"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P16",
            "factKey": "bangkok-F16",
            "text": "O Wat Pho é considerado um centro tradicional de ensino.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_POVO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P17",
            "factKey": "bangkok-F17",
            "text": "O templo hoje conhecido como Wat Arun já se chamou Wat Makok.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_KHAOSOD"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P18",
            "factKey": "bangkok-F18",
            "text": "Em 1892, bondes elétricos começaram a circular pela Charoen Krung, a “Estrada Nova”.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_HIST"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P19",
            "factKey": "bangkok-F19",
            "text": "Em 1900, abriu a primeira linha da ferrovia estatal, ligando a cidade a Ayutthaya.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_HIST"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P20",
            "factKey": "bangkok-F20",
            "text": "O bairro mercantil chinês, Sam Peng, fica ao sul do núcleo original da cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P21",
            "factKey": "bangkok-F21",
            "text": "Lutas de muay thai acontecem nos estádios Ratchadamnoen e Lumphini.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_POVO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P22",
            "factKey": "bangkok-F22",
            "text": "O trem elevado, chamado Skytrain, começou a funcionar em 1999.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_POVO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P23",
            "factKey": "bangkok-F23",
            "text": "O porto de Khlong Toei, no rio, movimenta quase todas as importações e exportações do país.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BANGKOK_BRIT_POVO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P24",
            "factKey": "bangkok-F24",
            "text": "É a capital da Tailândia e o centro político, cultural e administrativo do país.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_KHAOSOD",
              "BANGKOK_BRIT"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-viajante-P25",
            "factKey": "bangkok-F25",
            "text": "O nome local da cidade, na forma abreviada, costuma ser traduzido como “Cidade dos Anjos”.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "cultura",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "bangkok-geografo-P01",
            "factKey": "bangkok-F26",
            "text": "Metrópole tropical de planície deltaica, com uma estação chuvosa de maio a setembro e uma seca de dezembro a fevereiro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P02",
            "factKey": "bangkok-F27",
            "text": "Chove em média 1.500 mm por ano, quase tudo em aguaceiros curtos e fortes no fim da tarde.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "clima",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P03",
            "factKey": "bangkok-F05",
            "text": "Ocupa o delta do Chao Phraya, a cerca de 40 km do golfo da Tailândia.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BANGKOK_BRIT"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P04",
            "factKey": "bangkok-F09",
            "text": "Entre 1767 e 1782, a capital ficou na margem ocidental do mesmo rio, posição favorável ao comércio marítimo.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BANGKOK_BRIT_TAILANDIA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P05",
            "factKey": "bangkok-F28",
            "text": "Em meados do século XIX, a população já chegava a uns 400 mil, engrossada pela chegada de muitos chineses.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_TAILANDIA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P06",
            "factKey": "bangkok-F10",
            "text": "Em 1782, a corte trocou a margem oeste pela leste, onde então havia apenas uma pequena vila.",
            "relatedFields": [
              "C3",
              "C4"
            ],
            "sources": [
              "BANGKOK_BRIT_HIST",
              "BANGKOK_BRIT_TAILANDIA"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P07",
            "factKey": "bangkok-F29",
            "text": "Os novos templos e palácios seguiram os estilos da antiga capital Ayutthaya e chegaram a reaproveitar seus tijolos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BANGKOK_BRIT_TAILANDIA"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P08",
            "factKey": "bangkok-F30",
            "text": "Nos reinados de Rama II e Rama III (1809–1851), o rio e a rede de canais interligados faziam o papel de ruas.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BANGKOK_BRIT_HIST"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P09",
            "factKey": "bangkok-F31",
            "text": "No reinado de Rama IV (1851–1868), abriu-se a Charoen Krung rumo ao sul e cavou-se um novo fosso ao redor da cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_HIST"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P10",
            "factKey": "bangkok-F06",
            "text": "Para aliviar o trânsito, muitos canais foram aterrados, apagando parte da paisagem aquática que deu fama à cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BANGKOK_BRIT_POVO"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "bangkok-geografo-P11",
            "factKey": "bangkok-F32",
            "text": "Em 1937, a área foi dividida em duas municipalidades, uma em cada margem; cerca de quatro quintos da população viviam na margem leste.",
            "relatedFields": [
              "C4"
            ],
