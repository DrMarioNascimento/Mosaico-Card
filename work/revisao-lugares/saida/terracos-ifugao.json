    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "terracos-ifugao-viajante-P01",
            "factKey": "terracos-ifugao-F01",
            "text": "Este lugar é uma paisagem de plantações em degraus nas montanhas da Ásia.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_PR2"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P02",
            "factKey": "terracos-ifugao-F02",
            "text": "Os degraus foram esculpidos acompanhando as curvas naturais dos morros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_PR2"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P03",
            "factKey": "terracos-ifugao-F03",
            "text": "O cultivo principal é o arroz, em geral com uma única safra por ano.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001",
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "agricultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P04",
            "factKey": "terracos-ifugao-F04",
            "text": "Muitos degraus ficam em encostas muito íngremes, algumas com mais de 45 graus.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P05",
            "factKey": "terracos-ifugao-F05",
            "text": "A água vem das florestas no alto das montanhas e desce por canais de irrigação.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IFUGAO_PR2",
              "IFUGAO_WIKI"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P06",
            "factKey": "terracos-ifugao-F06",
            "text": "Os muros que seguram os degraus são de pedra ou de terra.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_PR2",
              "IFUGAO_WIKI"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P07",
            "factKey": "terracos-ifugao-F07",
            "text": "O povo que construiu esses campos é o mesmo que ainda cuida deles.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P08",
            "factKey": "terracos-ifugao-F08",
            "text": "Cada etapa do plantio e da colheita é marcada por cerimônias.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P09",
            "factKey": "terracos-ifugao-F09",
            "text": "Do arroz colhido se faz um vinho de arroz usado nas festas da comunidade e da família.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "comida",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P10",
            "factKey": "terracos-ifugao-F10",
            "text": "Cantos tradicionais chamados hudhud, entoados por mulheres mais velhas, acompanham o plantio e a colheita.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "IFUGAO_WIKI"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P11",
            "factKey": "terracos-ifugao-F11",
            "text": "Segundo os relatórios à UNESCO, essa forma de cultivo passa de geração em geração há cerca de 2.000 anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_PR2"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P12",
            "factKey": "terracos-ifugao-F12",
            "text": "A paisagem fica nas montanhas do norte de uma grande ilha de um arquipélago asiático.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P13",
            "factKey": "terracos-ifugao-F13",
            "text": "O conjunto reconhecido reúne cinco grupos de terraços em quatro municípios.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001",
              "IFUGAO_PR2"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P14",
            "factKey": "terracos-ifugao-F14",
            "text": "Cada família ou clã cuida também de um pedaço de mata, herdado junto com os campos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IFUGAO_PR2",
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P15",
            "factKey": "terracos-ifugao-F15",
            "text": "Em alguns grupos, os campos ficam entre 800 e 900 metros de altitude.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P16",
            "factKey": "terracos-ifugao-F16",
            "text": "Tufões e chuvas fortes podem derrubar muros e destruir canais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN",
              "IFUGAO_WIKI"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P17",
            "factKey": "terracos-ifugao-F17",
            "text": "Minhocas gigantes e caramujos são pragas que estragam os muros e diques dos campos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001",
              "IFUGAO_WIKI"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P18",
            "factKey": "terracos-ifugao-F18",
            "text": "Muitos jovens saíram da região, e faltam braços para cuidar dos campos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2005",
              "IFUGAO_WIKI"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P19",
            "factKey": "terracos-ifugao-F19",
            "text": "Já em 2001, as casas tradicionais de madeira e palha eram raras, e o zinco ondulado tinha virado regra.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P20",
            "factKey": "terracos-ifugao-F20",
            "text": "A UNESCO reconheceu a paisagem como Patrimônio Mundial em 1995.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2005",
              "IFUGAO_WIKI"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P21",
            "factKey": "terracos-ifugao-F21",
            "text": "Entre 2001 e 2012, a paisagem esteve na lista do Patrimônio Mundial em Perigo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_SOC2012",
              "IFUGAO_WIKI"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P22",
            "factKey": "terracos-ifugao-F22",
            "text": "Os conhecidos Terraços de Banaue não fazem parte da inscrição, por causa de construções modernas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_WIKI"
            ],
            "clueType": "turismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P23",
            "factKey": "terracos-ifugao-F23",
            "text": "Bangaan é ponto de partida para quem vai visitar Batad.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "turismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P24",
            "factKey": "terracos-ifugao-F24",
            "text": "Em Batad, os terraços têm forma de anfiteatro e atraem visitantes do mundo todo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "turismo",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-viajante-P25",
            "factKey": "terracos-ifugao-F25",
            "text": "A paisagem fica nas Filipinas, na província de Ifugao.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "IFUGAO_MISSION2001",
              "IFUGAO_PR2"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "terracos-ifugao-geografo-P01",
            "factKey": "terracos-ifugao-F01",
            "text": "A unidade é uma paisagem agrícola de montanha ainda manejada pelo povo que a criou.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P02",
            "factKey": "terracos-ifugao-F02",
            "text": "O terraceamento converte encostas íngremes, algumas acima de 45°, em campos inundados planos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001",
              "IFUGAO_PR2"
            ],
            "clueType": "processo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P03",
            "factKey": "terracos-ifugao-F03",
            "text": "A água captada nas florestas dos cumes é distribuída por uma rede indígena de canais que ainda funciona.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IFUGAO_PR2",
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P04",
            "factKey": "terracos-ifugao-F04",
            "text": "O sistema integra água, solo e floresta e permite cultivar arroz ano após ano, apesar de tufões e terremotos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P05",
            "factKey": "terracos-ifugao-F05",
            "text": "Os terraços funcionam como filtros da chuva e ficam saturados de água o ano inteiro.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IFUGAO_WIKI"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P06",
            "factKey": "terracos-ifugao-F06",
            "text": "O muyong, mata manejada no alto de cada conjunto, protege as nascentes e fornece madeira e lenha.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN",
              "IFUGAO_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P07",
            "factKey": "terracos-ifugao-F07",
            "text": "A posse do muyong é ligada à dos terraços, e ambos passam por herança aos parentes.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IFUGAO_PR2"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P08",
            "factKey": "terracos-ifugao-F08",
            "text": "Os cinco conjuntos ficam nas montanhas do norte de Luzon, em quatro municípios de uma mesma província.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "IFUGAO_MISSION2001",
              "IFUGAO_MISSION2005",
              "IFUGAO_PR2"
            ],
            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P09",
            "factKey": "terracos-ifugao-F09",
            "text": "O bem é formado por cinco conjuntos separados de terraços, e não por uma área contínua.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001",
              "IFUGAO_MISSION2005"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P10",
            "factKey": "terracos-ifugao-F10",
            "text": "Os terraços alcançam altitudes maiores e encostas mais íngremes do que muitos outros sistemas de terraços.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_PR2",
              "IFUGAO_WIKI"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P11",
            "factKey": "terracos-ifugao-F11",
            "text": "O calendário agrícola segue as fases da lua, e ervas processadas são usadas no controle de pragas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_PR2"
            ],
            "clueType": "agricultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P12",
            "factKey": "terracos-ifugao-F12",
            "text": "Os mumbaki, sacerdotes que conduzem o ritual baki, são responsáveis pela lei tradicional da comunidade.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "IFUGAO_PR2"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P13",
            "factKey": "terracos-ifugao-F13",
            "text": "Rituais como o bakle, celebrado no fim da colheita do arroz, ainda são praticados.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P14",
            "factKey": "terracos-ifugao-F14",
            "text": "Quando os campos são abandonados, os muros desabam depressa, e uma minhoca gigante acelera o colapso.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P15",
            "factKey": "terracos-ifugao-F15",
            "text": "Em 2001, estimava-se que 25% a 30% dos terraços estavam abandonados, sobretudo por emigração e falta de manutenção da irrigação.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P16",
            "factKey": "terracos-ifugao-F16",
            "text": "O preço baixo do arroz nativo empurra agricultores para variedades híbridas.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "IFUGAO_MISSION2005"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P17",
            "factKey": "terracos-ifugao-F17",
            "text": "O desmatamento causou erosão em algumas das bacias que alimentam o sistema.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "IFUGAO_MISSION2001"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P18",
            "factKey": "terracos-ifugao-F18",
            "text": "Estradas como a Kiangan–Tinoc danificaram terraços, canais e florestas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P19",
            "factKey": "terracos-ifugao-F19",
            "text": "Inscrita em 1995, a paisagem entrou na Lista em Perigo em 2001 e saiu dela em 2012.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MISSION2005",
              "IFUGAO_SOC2012"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P20",
            "factKey": "terracos-ifugao-F20",
            "text": "Abandono, desenvolvimento desordenado, turismo sem planejamento e gestão ineficaz justificaram a inclusão na Lista em Perigo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_SOC2012"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P21",
            "factKey": "terracos-ifugao-F21",
            "text": "Em Hungduan, quase metade do município é floresta, e os terraços aparecem em manchas entre capim e arbustos.",
            "relatedFields": [
              "C1",
              "C3"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P22",
            "factKey": "terracos-ifugao-F22",
            "text": "No conjunto de Mayoyao, cerca de 78% da área agrícola é ocupada por arroz.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_MASTERPLAN"
            ],
            "clueType": "agricultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "terracos-ifugao-geografo-P23",
            "factKey": "terracos-ifugao-F23",
            "text": "Os relatórios à UNESCO falam em cerca de 2.000 anos, mas pesquisas arqueológicas recentes situam a construção há uns 400 anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "IFUGAO_PR2",
              "IFUGAO_WIKI"
