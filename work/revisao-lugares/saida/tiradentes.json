      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "tiradentes-geografo-P01",
            "factKey": "tiradentes-F26",
            "text": "O núcleo urbano surgiu na bacia do rio das Mortes, para onde o ouro atraiu os primeiros povoadores paulistas.",
