    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "tiradentes-viajante-P01",
            "factKey": "tiradentes-F01",
            "text": "É uma pequena cidade colonial do interior do Sudeste, nascida da corrida do ouro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TIRADENTES_TUPI",
              "TIRADENTES_IBGE"
            ],
            "clueType": "historia",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P02",
            "factKey": "tiradentes-F02",
            "text": "Casarões coloniais e igrejas barrocas formam um conjunto que parece parado no século XVIII.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TIRADENTES_CATRACA",
              "TIRADENTES_CORREIO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P03",
            "factKey": "tiradentes-F03",
            "text": "Cerca de 90% do casario original do século XVIII continua de pé.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TIRADENTES_CORREIO",
              "TIRADENTES_TUPI"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P04",
            "factKey": "tiradentes-F04",
            "text": "Uma serra de paredões de pedra emoldura a cidade e oferece vistas do centro histórico.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TIRADENTES_UNESP",
              "TIRADENTES_TUPI"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P05",
            "factKey": "tiradentes-F05",
            "text": "Trilhas pela serra levam a lugares como o Poço do Grito, a Mãe d'Água e o Balaio.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TIRADENTES_CORREIO",
              "TIRADENTES_AGMINAS_MOSAICO"
            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P06",
            "factKey": "tiradentes-F06",
            "text": "A Cachoeira do Mangue está entre as atrações dessa serra.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "TIRADENTES_AGMINAS_MOSAICO"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P07",
            "factKey": "tiradentes-F07",
            "text": "Na praça principal, o Largo das Forras, charretes coloridas esperam os turistas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TIRADENTES_UNESP",
              "TIRADENTES_TUPI"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P08",
            "factKey": "tiradentes-F08",
            "text": "Um chafariz de pedra com três bicas foi construído pela Câmara em 1749.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TIRADENTES_CORREIO",
              "TIRADENTES_TUPI",
              "TIRADENTES_IBGE_MONO"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P09",
            "factKey": "tiradentes-F09",
            "text": "Esse chafariz guarda uma rara imagem de terracota de São José de Botas.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "TIRADENTES_CORREIO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P10",
            "factKey": "tiradentes-F10",
            "text": "A igreja matriz, no alto de uma colina, tem duas torres e altares cobertos de ouro.",
