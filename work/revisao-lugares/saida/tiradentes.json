              "TIRADENTES_CORREIO",
              "TIRADENTES_TUPI"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P11",
            "factKey": "tiradentes-F11",
            "text": "A construção dessa matriz começou em 1710.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "TIRADENTES_CORREIO",
              "TIRADENTES_IBGE_MONO"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P12",
            "factKey": "tiradentes-F12",
            "text": "A fachada da matriz tem esculturas atribuídas ao Aleijadinho.",
