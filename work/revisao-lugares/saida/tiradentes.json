              "TIRADENTES_CORREIO"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P14",
            "factKey": "tiradentes-F14",
            "text": "Um trem a vapor, a Maria Fumaça, faz um passeio de 12 km até a cidade vizinha.",
