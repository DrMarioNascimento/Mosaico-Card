            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "tiradentes-viajante-P17",
            "factKey": "tiradentes-F17",
            "text": "Em janeiro, uma mostra de cinema realizada desde 1998 reúne dezenas de milhares de pessoas.",
