            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-geografo-P24",
            "factKey": "parque-kruger-F24",
            "text": "Proclamado em 1926, homenageia o ex-presidente da República Sul-Africana (Transvaal), cuja estátua fica no portão que leva seu nome.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
