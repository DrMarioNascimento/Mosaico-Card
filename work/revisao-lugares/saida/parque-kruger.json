      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "parque-kruger-geografo-P01",
            "factKey": "parque-kruger-F26",
            "text": "É uma savana seca, onde gramíneas e árvores dividem o espaço, num clima com uma estação chuvosa e outra seca.",
