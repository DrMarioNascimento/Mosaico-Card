              "KRUGER_SAHO"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-geografo-P25",
            "factKey": "parque-kruger-F25",
            "text": "Maior parque nacional sul-africano, estende-se a oeste dos montes Lebombo, com sede em Skukuza, a antiga Sabie Bridge.",
