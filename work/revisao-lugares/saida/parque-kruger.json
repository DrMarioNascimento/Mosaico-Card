              "C2",
              "C3"
            ],
            "sources": [
              "KRUGER_EB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P23",
            "factKey": "parque-kruger-F23",
            "text": "A primeira reserva de caça, de 1898, ficava entre os rios Sabie e Crocodile.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SAHO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P24",
            "factKey": "parque-kruger-F24",
            "text": "Em 1926 virou parque nacional e ganhou o nome de um ex-presidente do Transvaal, líder dos bôeres.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_EB",
              "KRUGER_SAHO"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P25",
            "factKey": "parque-kruger-F25",
            "text": "É o maior parque nacional da África do Sul, com sede em Skukuza e colado à fronteira de Moçambique.",
            "relatedFields": [
              "C1",
              "C3",
              "C4"
            ],
            "sources": [
