    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "parque-kruger-viajante-P01",
            "factKey": "parque-kruger-F01",
            "text": "Aqui vivem os chamados \"cinco grandes\": elefante, leão, leopardo, búfalo e rinoceronte.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_DEIMS",
              "KRUGER_EB"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P02",
            "factKey": "parque-kruger-F02",
            "text": "A paisagem vai de campos abertos de capim a mato fechado, com árvores como o baobá e a marula.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_EB"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P03",
            "factKey": "parque-kruger-F03",
            "text": "Foi criado para proteger os animais do Lowveld, as terras baixas sul-africanas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P04",
            "factKey": "parque-kruger-F04",
            "text": "Ocupa partes de duas províncias: Limpopo e Mpumalanga.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_EB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P05",
            "factKey": "parque-kruger-F05",
            "text": "É o maior parque nacional do país, com quase 2 milhões de hectares.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_EB",
              "KRUGER_SANPARKS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P06",
            "factKey": "parque-kruger-F06",
            "text": "É comprido e estreito: tem cerca de 320 km de extensão e de 40 a 80 km de largura.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_EB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P07",
            "factKey": "parque-kruger-F07",
            "text": "O terreno é quase todo plano, com algumas fileiras de morros baixos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_EB"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P08",
            "factKey": "parque-kruger-F08",
            "text": "Seis rios correm o ano todo pelo parque, mas nas secas é preciso oferecer água aos animais.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_EB"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P09",
            "factKey": "parque-kruger-F09",
            "text": "Já foram registradas ali 147 espécies de mamíferos e 507 de aves.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS",
              "KRUGER_DEIMS"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P10",
            "factKey": "parque-kruger-F10",
            "text": "Guepardos, zebras, gnus e impalas também fazem parte da fauna.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_EB"
            ],
            "clueType": "biodiversidade",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P11",
            "factKey": "parque-kruger-F11",
            "text": "Dá para percorrer o parque dirigindo o próprio carro e dormir em acampamentos lá dentro.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P12",
            "factKey": "parque-kruger-F12",
            "text": "São 12 acampamentos principais, além de acampamentos menores no mato e alguns lodges privados.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P13",
            "factKey": "parque-kruger-F13",
            "text": "Os primeiros turistas chegaram de trem em 1923, dormiam nos vagões e tinham a companhia de um guarda-parque em volta da fogueira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS_TURISMO",
              "KRUGER_SAHO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P14",
            "factKey": "parque-kruger-F14",
            "text": "As primeiras cabanas para visitantes foram erguidas em 1928, em Satara, Pretoriuskop e no acampamento da sede.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS_TURISMO",
              "KRUGER_SAHO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P15",
            "factKey": "parque-kruger-F15",
            "text": "A água quente nos banheiros dos acampamentos só foi aprovada em 1933, a um xelim por banho.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS_TURISMO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P16",
            "factKey": "parque-kruger-F16",
            "text": "Hoje há mais de 850 km de estradas asfaltadas e cerca de 1.444 km de estradas de terra para os safáris.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS_TURISMO"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P17",
            "factKey": "parque-kruger-F17",
            "text": "Pinturas rupestres dos povos san, os \"bosquímanos\", estão entre os tesouros culturais protegidos ali.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SANPARKS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P18",
            "factKey": "parque-kruger-F18",
            "text": "Mais de 255 sítios arqueológicos já foram registrados dentro do parque.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SAHO"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P19",
            "factKey": "parque-kruger-F19",
            "text": "Nas ruínas de Masorini, abertas à visita, o povo BaPhalaborwa fundia ferro no século XIX.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "KRUGER_SAHO",
              "KRUGER_SANPARKS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P20",
            "factKey": "parque-kruger-F20",
            "text": "A sede fica num acampamento que antes se chamava Sabie Bridge.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "KRUGER_SANPARKS_TURISMO",
              "KRUGER_EB"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P21",
            "factKey": "parque-kruger-F21",
            "text": "A borda leste segue a fronteira com o país vizinho, a oeste dos montes Lebombo.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "KRUGER_EB"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-kruger-viajante-P22",
            "factKey": "parque-kruger-F22",
            "text": "Desde 2002 faz parte de um parque enorme que atravessa fronteiras, junto com áreas de Moçambique e do Zimbábue.",
