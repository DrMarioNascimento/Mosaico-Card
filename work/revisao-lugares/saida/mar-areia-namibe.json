            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mar-areia-namibe-geografo-P03",
            "factKey": "mar-areia-namibe-F03",
            "text": "Há dois sistemas de dunas superpostos: um antigo, semiconsolidado, coberto por outro mais jovem e ativo.",
