      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "mar-areia-namibe-geografo-P01",
            "factKey": "mar-areia-namibe-F01",
            "text": "A unidade é um deserto costeiro hiperárido, em que a vida depende da umidade que vem do oceano.",
