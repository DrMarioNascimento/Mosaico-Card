            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mar-areia-namibe-geografo-P02",
            "factKey": "mar-areia-namibe-F02",
            "text": "A paisagem é dominada por grandes dunas móveis, em transformação contínua.",
