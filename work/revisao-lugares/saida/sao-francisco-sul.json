            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sao-francisco-sul-viajante-P05",
            "factKey": "sao-francisco-sul-viajante-F05",
            "text": "O porto é a principal atividade econômica da cidade.",
