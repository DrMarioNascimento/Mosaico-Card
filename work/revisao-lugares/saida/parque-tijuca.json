        "label": "Viajante",
        "cards": [
          {
            "id": "parque-tijuca-viajante-P01",
            "factKey": "parque-tijuca-F01",
            "text": "É um parque nacional de Mata Atlântica cercado por uma grande cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
