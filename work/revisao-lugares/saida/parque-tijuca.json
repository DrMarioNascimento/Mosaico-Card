            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-tijuca-geografo-P03",
            "factKey": "parque-tijuca-F28",
            "text": "Em 1817, Dom João VI proibiu o corte de árvores em volta das nascentes do rio Carioca.",
