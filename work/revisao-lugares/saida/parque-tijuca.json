              "TIJUCA_OECO"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-tijuca-geografo-P04",
            "factKey": "parque-tijuca-F29",
            "text": "Entre 1846 e 1847, plantios experimentais de cerca de 3 mil mudas deram origem à mata das Paineiras.",
