      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "parque-tijuca-geografo-P01",
            "factKey": "parque-tijuca-F26",
            "text": "O ICMBio o descreve como o menor parque nacional em área continental do país.",
