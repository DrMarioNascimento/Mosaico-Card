            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "parque-tijuca-geografo-P12",
            "factKey": "parque-tijuca-F21",
            "text": "Subordinado de início ao Serviço Florestal do Ministério da Agricultura, no então estado da Guanabara, o parque ganhou o nome atual em 1967.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
