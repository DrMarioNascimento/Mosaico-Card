            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "calcada-gigantes-viajante-P06",
            "factKey": "calcada-gigantes-F06",
            "text": "As colunas ficam ao pé de falésias de basalto, na borda de um planalto.",
