            ],
            "clueType": "paisagem",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "calcada-gigantes-viajante-P04",
            "factKey": "calcada-gigantes-F04",
            "text": "As colunas são de basalto, uma rocha de origem vulcânica.",
