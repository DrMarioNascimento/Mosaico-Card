            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "calcada-gigantes-viajante-P05",
            "factKey": "calcada-gigantes-F05",
            "text": "A maioria das colunas tem seis lados, mas há algumas com quatro, cinco, sete e oito.",
