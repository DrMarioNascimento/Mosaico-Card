            "sources": [
              "CALCADA_UNESCO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "calcada-gigantes-viajante-P07",
            "factKey": "calcada-gigantes-F07",
            "text": "Em média, cada coluna tem cerca de 45 cm de diâmetro.",
