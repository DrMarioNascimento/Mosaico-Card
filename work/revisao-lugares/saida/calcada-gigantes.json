    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "calcada-gigantes-viajante-P01",
            "factKey": "calcada-gigantes-F01",
            "text": "É uma paisagem natural europeia à beira-mar, famosa por suas formações de pedra.",
