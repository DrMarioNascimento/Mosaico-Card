              "CALCADA_BGS"
            ],
            "clueType": "cultura",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "calcada-gigantes-viajante-P03",
            "factKey": "calcada-gigantes-F03",
            "text": "Ali, cerca de 40 mil grandes colunas de pedra escura saem do mar.",
