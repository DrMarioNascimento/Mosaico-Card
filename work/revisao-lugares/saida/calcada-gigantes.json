            "sources": [
              "CALCADA_UNESCO"
            ],
            "clueType": "paisagem",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "calcada-gigantes-viajante-P02",
            "factKey": "calcada-gigantes-F02",
            "text": "Há pelo menos 300 anos o lugar atrai visitantes.",
