            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "calcada-gigantes-viajante-P08",
            "factKey": "calcada-gigantes-F08",
            "text": "Um grupo de cerca de 60 colunas regulares, com uns 12 metros de altura, é chamado de Órgão do Gigante.",
