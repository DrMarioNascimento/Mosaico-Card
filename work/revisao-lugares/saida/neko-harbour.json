      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P16",
      "factKey": "neko-harbour-F16",
      "text": "A flora registrada se resume a tapetes de musgo, à alga verde Prasiola crispa e a algas de neve.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_NEKO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P17",
      "factKey": "neko-harbour-F17",
      "text": "Fundações visíveis são o que resta de um refúgio argentino que existia no sítio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
