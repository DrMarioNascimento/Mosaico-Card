      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P15",
      "factKey": "neko-harbour-F15",
      "text": "A foca-de-weddell usa regularmente a costa como área de repouso.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
