      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P18",
      "factKey": "neko-harbour-F18",
      "text": "Danificado pelas intempéries, o refúgio foi removido em 2010 e a área foi limpa.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
