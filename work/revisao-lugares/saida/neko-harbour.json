      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P19",
      "factKey": "neko-harbour-F19",
      "text": "Um banco de neve permanente liga a orla a um afloramento rochoso superior, usado como mirante.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_NEKO",
       "NEKO_ATCM29"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P20",
      "factKey": "neko-harbour-F20",
      "text": "Como neve e gelo ao redor têm fendas, a rota ao afloramento superior só deve ser avaliada por guias de montanha treinados e equipados.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_NEKO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P21",
      "factKey": "neko-harbour-F21",
      "text": "Uma praia de seixos de cerca de 500 m ocupa o extremo sudoeste da pequena baía.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "NEKO_ATCM29"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P22",
      "factKey": "neko-harbour-F22",
      "text": "O ponto de desembarque preferido fica a sudoeste de um grande matacão, junto a um pequeno recife.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_NEKO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "neko-harbour-geografo-P23",
      "factKey": "neko-harbour-F23",
      "text": "No início da temporada, a neve acumulada na ponta sul permite desembarcar sobre um matacão e abrir degraus.",
