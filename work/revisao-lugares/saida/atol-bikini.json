            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P22",
            "factKey": "atol-bikini-F19",
            "text": "Em 1977, a água dos poços da ilha principal tinha estrôncio-90 acima dos limites americanos; em setembro de 1978, os moradores foram retirados de novo.",
            "relatedFields": [
