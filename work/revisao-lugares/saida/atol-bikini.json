          },
          {
            "id": "atol-bikini-geografo-P11",
            "factKey": "atol-bikini-F33",
            "text": "Bombas e combustível ainda guardados nos naufrágios da laguna ameaçam a segurança das visitas e podem aumentar a poluição.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BIKINI_UNESCO_DEC"
            ],
            "clueType": "agua",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P12",
            "factKey": "atol-bikini-F34",
            "text": "A mudança climática aparece, ao lado dos restos de bombas e combustível, entre as principais ameaças ao bem.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BIKINI_UNESCO_DEC"
            ],
            "clueType": "clima",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P13",
            "factKey": "atol-bikini-F35",
            "text": "A série de testes de 1946 envolveu cerca de 5.400 animais de experimento.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BIKINI_BKA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P14",
            "factKey": "atol-bikini-F36",
            "text": "Os dois testes de 1946, Able e Baker, tiveram cada um potência parecida com a da bomba de Nagasaki.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BIKINI_BKA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P15",
            "factKey": "atol-bikini-F37",
            "text": "A série de 1946 começou em 1º de julho e terminou em 10 de agosto.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BIKINI_AHF"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P16",
            "factKey": "atol-bikini-F14",
            "text": "O teste de 1954 foi o primeiro de uma bomba de hidrogênio transportável, com 15 megatons.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BIKINI_AHF",
              "BIKINI_BKA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P17",
            "factKey": "atol-bikini-F38",
            "text": "A bola de fogo de 1954 subiu a cerca de 480 km/h, e a nuvem passou de 32 km de altura.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BIKINI_BKA"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P18",
            "factKey": "atol-bikini-F17",
            "text": "A precipitação do teste de 1954 chegou ao atol de Rongelap, cujos moradores só foram retirados dois dias depois.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BIKINI_AHF"
            ],
            "clueType": "processo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P19",
            "factKey": "atol-bikini-F16",
            "text": "A cratera gigante preservada no atol foi aberta pelo teste Bravo.",
