          {
            "id": "atol-bikini-geografo-P24",
            "factKey": "atol-bikini-F24",
            "text": "Foi inscrito no Patrimônio Mundial na 34ª sessão do Comitê, em Brasília, em 2010, como o primeiro bem das Ilhas Marshall.",
