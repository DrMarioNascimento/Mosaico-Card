              "C4"
            ],
            "sources": [
              "BIKINI_UNESCO"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P20",
            "factKey": "atol-bikini-F39",
            "text": "Em junho de 1968, o presidente Lyndon Johnson prometeu aos 540 membros da comunidade que eles poderiam voltar.",
            "relatedFields": [
