          },
          {
            "id": "atol-bikini-geografo-P23",
            "factKey": "atol-bikini-F40",
            "text": "Em 2001, um tribunal de reivindicações nucleares concedeu à comunidade mais de US$ 563 milhões.",
            "relatedFields": [
