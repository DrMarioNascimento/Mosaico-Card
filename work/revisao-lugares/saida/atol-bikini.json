              "C3"
            ],
            "sources": [
              "BIKINI_BKA"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "atol-bikini-geografo-P21",
            "factKey": "atol-bikini-F07",
            "text": "A comunidade passou por Rongerik (1946) e Kwajalein (1948) até chegar a uma ilha de um terço de milha quadrada, sem laguna.",
