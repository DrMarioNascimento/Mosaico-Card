      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-geografo-P11",
      "factKey": "peninsula-byers-F29",
      "text": "O permafrost fica sob uma camada ativa de 30 a 70 cm.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "relevo",
