      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P12",
      "factKey": "peninsula-byers-F12",
      "text": "Chove bastante no verão: são uns 800 mm de precipitação por ano.",
