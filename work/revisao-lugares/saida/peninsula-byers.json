      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P10",
      "factKey": "peninsula-byers-F10",
      "text": "Nas rochas há fósseis de conchas marinhas e de plantas antigas.",
