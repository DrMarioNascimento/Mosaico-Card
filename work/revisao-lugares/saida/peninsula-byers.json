       "C1"
      ],
      "sources": [
       "BYERS_ASPA126",
       "BYERS_ACAP"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-geografo-P07",
      "factKey": "peninsula-byers-F08",
      "text": "Praias elevadas de 3 a 54 m de altitude registram antigos níveis do mar, mais altos que o atual.",
