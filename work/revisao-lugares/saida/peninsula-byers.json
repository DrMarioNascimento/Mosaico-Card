      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-geografo-P04",
      "factKey": "peninsula-byers-F03",
      "text": "É a maior área livre de gelo das Shetland do Sul, com ~9 km de oeste a leste e ~18 km de noroeste a sudeste.",
