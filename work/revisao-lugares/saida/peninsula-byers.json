       "C1"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-geografo-P08",
      "factKey": "peninsula-byers-F11",
      "text": "Ossos subfósseis de baleia nessas praias, com cerca de 2.000 a 2.400 anos, servem para datar os antigos níveis do mar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-geografo-P09",
      "factKey": "peninsula-byers-F10",
      "text": "O embasamento, do Jurássico Superior ao Cretáceo Inferior, reúne rochas sedimentares marinhas, vulcânicas e vulcanoclásticas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-geografo-P10",
      "factKey": "peninsula-byers-F28",
      "text": "Moluscos marinhos e floras fósseis desses estratos são chave para estudar as ligações com outros continentes do sul entre o Jurássico e o Cretáceo Inferior.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "pesquisa",
