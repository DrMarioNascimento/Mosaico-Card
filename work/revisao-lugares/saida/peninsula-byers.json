    "cards": [
     {
      "id": "peninsula-byers-viajante-P01",
      "factKey": "peninsula-byers-F01",
      "text": "Este destino é uma área baixa e sem gelo na ponta de uma ilha antártica.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126",
       "BYERS_ACAP"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P02",
      "factKey": "peninsula-byers-F02",
      "text": "O relevo é suave, com morros que não passam de 265 m.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126",
       "BYERS_KBA"
      ],
      "clueType": "relevo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P03",
      "factKey": "peninsula-byers-F03",
      "text": "É a maior área sem gelo do seu arquipélago.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P04",
      "factKey": "peninsula-byers-F04",
      "text": "A área protegida tem cerca de 85 km².",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P05",
      "factKey": "peninsula-byers-F05",
      "text": "A ilha onde fica é a segunda maior do arquipélago das Shetland do Sul.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P06",
      "factKey": "peninsula-byers-F06",
      "text": "Há mais de 60 lagos e muitas poças, que congelam até o fundo no inverno.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P07",
      "factKey": "peninsula-byers-F07",
      "text": "O maior lago tem uns 587 m de uma margem à outra e até 9 m de fundura.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BYERS_ASPA126"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P08",
      "factKey": "peninsula-byers-F08",
      "text": "Praias antigas ficaram a até 54 m de altitude.",
