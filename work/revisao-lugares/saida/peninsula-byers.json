       "BYERS_KBA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-geografo-P06",
      "factKey": "peninsula-byers-F27",
      "text": "Protegida desde 1966, virou sítio de interesse científico em 1975, teve os limites ampliados em 1991 e é hoje a ASPA nº 126.",
