      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "peninsula-byers-viajante-P11",
      "factKey": "peninsula-byers-F11",
      "text": "Ossos de baleia antigos, presos nas praias elevadas, ajudam a datar o terreno.",
