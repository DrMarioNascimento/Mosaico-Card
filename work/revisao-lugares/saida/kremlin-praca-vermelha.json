  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "kremlin-praca-vermelha-viajante-P01",
      "factKey": "kremlin-praca-vermelha-F01",
      "text": "É um conjunto de muralhas, torres, catedrais e palácios no centro de uma capital europeia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007",
       "KREMLIN_RP2014"
      ],
      "clueType": "patrimonio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P02",
      "factKey": "kremlin-praca-vermelha-F02",
      "text": "Foi inscrito como patrimônio mundial em 1990.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_DOCS",
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "patrimonio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P03",
      "factKey": "kremlin-praca-vermelha-F03",
      "text": "A cidadela tem muralhas em forma de triângulo, com cinco portões.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P04",
      "factKey": "kremlin-praca-vermelha-F04",
      "text": "As muralhas e torres de hoje são de tijolo vermelho.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P05",
      "factKey": "kremlin-praca-vermelha-F05",
      "text": "Em 1156, um príncipe ergueu ali fortificações de madeira no alto de uma colina.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P06",
      "factKey": "kremlin-praca-vermelha-F06",
      "text": "A cidadela fica onde dois rios se encontram; um deles hoje está coberto por um jardim.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P07",
      "factKey": "kremlin-praca-vermelha-F07",
      "text": "Um campanário terminado no início do século XVI ganhou um terceiro andar em 1600 e chegou a 81 metros.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P08",
      "factKey": "kremlin-praca-vermelha-F08",
      "text": "Dentro das muralhas há as catedrais da Anunciação, da Dormição e do Arcanjo Miguel.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P09",
      "factKey": "kremlin-praca-vermelha-F09",
      "text": "Desde 1991, as catedrais e igrejas voltaram a receber cultos ortodoxos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_RP2014"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P10",
      "factKey": "kremlin-praca-vermelha-F10",
      "text": "O Palácio das Facetas, de 1485, foi construído por dois arquitetos italianos.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P11",
      "factKey": "kremlin-praca-vermelha-F11",
      "text": "Arquitetos italianos também reconstruíram a catedral da Dormição no fim do século XV.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P12",
      "factKey": "kremlin-praca-vermelha-F12",
      "text": "Ao lado da cidadela, uma grande praça reúne uma catedral de cúpulas, um museu de história e um mausoléu.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P13",
      "factKey": "kremlin-praca-vermelha-F13",
      "text": "Essa catedral de cúpulas foi encomendada por um czar para celebrar uma vitória militar de 1552.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P14",
      "factKey": "kremlin-praca-vermelha-F14",
      "text": "A catedral ficou pronta em 1561 e é atribuída ao arquiteto Postnik Yakovlev.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P15",
      "factKey": "kremlin-praca-vermelha-F15",
      "text": "O czar que a encomendou foi Ivan, o Terrível, depois de conquistar Kazan.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P16",
      "factKey": "kremlin-praca-vermelha-F16",
      "text": "Na praça fica o mausoléu de Lênin, grande exemplo de arquitetura monumental soviética.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "patrimonio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P17",
      "factKey": "kremlin-praca-vermelha-F17",
      "text": "Urnas com cinzas de heróis da revolução foram embutidas nas muralhas.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P18",
      "factKey": "kremlin-praca-vermelha-F18",
      "text": "Na praça, galerias comerciais com pátios cobertos de vidro foram construídas entre 1889 e 1893.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P19",
      "factKey": "kremlin-praca-vermelha-F19",
      "text": "No século XVII, ali havia fileiras de barracas de comércio de madeira, que pegavam fogo com frequência.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P20",
      "factKey": "kremlin-praca-vermelha-F20",
      "text": "Um grande palácio com fachada de 125 metros voltada para o sul foi construído sob a direção do arquiteto Konstantin Ton.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P21",
      "factKey": "kremlin-praca-vermelha-F21",
      "text": "O mesmo arquiteto projetou o prédio da Armaria, erguido de 1844 a 1851.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P22",
      "factKey": "kremlin-praca-vermelha-F22",
      "text": "Duas torres da muralha, a do Salvador e a de São Nicolau, são de 1491.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P23",
      "factKey": "kremlin-praca-vermelha-F23",
      "text": "A demolição de um grande hotel vizinho, em 2010, devolveu a vista do lado leste do conjunto.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_RP2014"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P24",
      "factKey": "kremlin-praca-vermelha-F24",
      "text": "Fica no centro de Moscou, capital da Rússia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_RP2014"
      ],
      "clueType": "localizacao",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-viajante-P25",
      "factKey": "kremlin-praca-vermelha-F25",
      "text": "Festivais e grandes eventos na praça chegam a produzir barulho muito acima do limite permitido.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_RP2014"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "kremlin-praca-vermelha-geografo-P01",
      "factKey": "kremlin-praca-vermelha-F26",
      "text": "O traçado do conjunto expressa dois centros de poder lado a lado: o espiritual e o civil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_RP2014"
      ],
      "clueType": "urbanismo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P02",
      "factKey": "kremlin-praca-vermelha-F27",
      "text": "Formado ao longo de cerca de 500 anos, o conjunto reflete a passagem de um território feudal fragmentado para um império.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_RP2014"
      ],
      "clueType": "processo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P03",
      "factKey": "kremlin-praca-vermelha-F02",
      "text": "A UNESCO o inscreveu em 1990 pelos critérios (i), (ii), (iv) e (vi).",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_SOC2015",
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P04",
      "factKey": "kremlin-praca-vermelha-F06",
      "text": "A cidadela ocupa uma colina na confluência de dois rios; um deles foi coberto e hoje corre sob um jardim.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P05",
      "factKey": "kremlin-praca-vermelha-F30",
      "text": "Camadas arqueológicas que podem remontar ao século XII continuam inexploradas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "KREMLIN_SOC2015"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P06",
      "factKey": "kremlin-praca-vermelha-F31",
      "text": "O recinto triangular de tijolo, com torres e cinco portões, sucedeu às fortificações de madeira do século XII.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P07",
      "factKey": "kremlin-praca-vermelha-F32",
      "text": "As inovações de construtores italianos se somaram à evolução da arquitetura russa antiga.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "KREMLIN_RP2014"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P08",
      "factKey": "kremlin-praca-vermelha-F10",
      "text": "O Palácio das Facetas foi encomendado por Ivan III em 1485 a Marco Ruffo e Pietro Solario.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "KREMLIN_MISSAO2007"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
