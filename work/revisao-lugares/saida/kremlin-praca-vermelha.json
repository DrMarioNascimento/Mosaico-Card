       "KREMLIN_RP2014"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P23",
      "factKey": "kremlin-praca-vermelha-F48",
      "text": "A prefeitura da cidade controla a grande zona de amortecimento ao redor do conjunto.",
      "relatedFields": [
       "C1"
