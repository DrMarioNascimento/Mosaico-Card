      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "kremlin-praca-vermelha-geografo-P24",
      "factKey": "kremlin-praca-vermelha-F23",
      "text": "No terreno do antigo hotel Rossiya, demolido, surgiu o complexo Zaryadye.",
