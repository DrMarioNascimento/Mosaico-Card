      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P17",
      "factKey": "norte-tumucumaque-F17",
      "text": "Cinco expedições entre 2004 e 2006 inventariaram mais de 1.600 espécies, entre elas 366 aves e 207 peixes.",
