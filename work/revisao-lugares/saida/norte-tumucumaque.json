      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P19",
      "factKey": "norte-tumucumaque-F19",
      "text": "A população de angelim-vermelho, com árvores de mais de 80 m, é destaque botânico da unidade.",
