      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P18",
      "factKey": "norte-tumucumaque-F18",
      "text": "O catálogo oficial registra 664 espécies de plantas, nove ameaçadas, usando só coletas posteriores à criação.",
