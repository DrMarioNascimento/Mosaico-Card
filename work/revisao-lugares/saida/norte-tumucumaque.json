       "C3"
      ],
      "sources": [
       "TUMUC_PA_CONHECA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P07",
      "factKey": "norte-tumucumaque-F07",
      "text": "No estado minoritário, a unidade ocupa parte de um único município.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "TUMUC_JBRJ_NEWS",
       "TUMUC_PA_PLANTAS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P08",
      "factKey": "norte-tumucumaque-F08",
      "text": "Cinco municípios do estado principal, entre eles Calçoene e Serra do Navio, dividem a maior parte da área.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "TUMUC_JBRJ_NEWS",
       "TUMUC_PA_CONHECA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P09",
      "factKey": "norte-tumucumaque-F09",
      "text": "O perímetro do decreto parte de uma fronteira internacional, acompanha o limite com um segundo território e volta à primeira fronteira.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "TUMUC_DECRETO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P10",
      "factKey": "norte-tumucumaque-F10",
      "text": "O parque ocupa o oeste de seu estado principal e o norte do estado vizinho.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "TUMUC_PA_CONHECA"
      ],
      "clueType": "localizacao",
