       "TUMUC_CATRACA"
      ],
      "clueType": "conservacao",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P02",
      "factKey": "norte-tumucumaque-F02",
      "text": "A unidade conserva uma das florestas tropicais menos impactadas do mundo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TUMUC_PA_CONHECA"
      ],
      "clueType": "conservacao",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P03",
      "factKey": "norte-tumucumaque-F03",
      "text": "Um decreto federal de 22 de agosto de 2002 criou a unidade, com área aproximada de 3.867.000 ha.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TUMUC_DECRETO"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P04",
      "factKey": "norte-tumucumaque-F04",
      "text": "É apontada como a maior unidade de conservação de floresta tropical do mundo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "TUMUC_JBRJ_NEWS",
       "TUMUC_PA_PLANTAS"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P05",
      "factKey": "norte-tumucumaque-F05",
      "text": "Cerca de 98,8% da área está em um estado e 1,2% em outro.",
