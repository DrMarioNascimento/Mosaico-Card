   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "norte-tumucumaque-geografo-P01",
      "factKey": "norte-tumucumaque-F01",
      "text": "A área é uma unidade de conservação federal gerida pelo ICMBio.",
