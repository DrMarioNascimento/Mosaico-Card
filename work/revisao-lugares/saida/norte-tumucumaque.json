      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P14",
      "factKey": "norte-tumucumaque-F14",
      "text": "Escarpas graníticas ao longo da cordilheira criam microclimas e funcionam como mirantes naturais.",
