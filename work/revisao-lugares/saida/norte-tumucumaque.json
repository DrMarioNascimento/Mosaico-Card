       "TUMUC_CATRACA"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P12",
      "factKey": "norte-tumucumaque-F12",
      "text": "No Escudo das Guianas, o relevo é suavemente ondulado, com altitudes de 100 a 400 m.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
