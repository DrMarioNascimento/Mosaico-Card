       "C3"
      ],
      "sources": [
       "TUMUC_JBRJ_NEWS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P06",
      "factKey": "norte-tumucumaque-F06",
      "text": "A unidade equivale a 26,4% do território de seu estado principal.",
