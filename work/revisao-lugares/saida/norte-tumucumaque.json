      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P16",
      "factKey": "norte-tumucumaque-F16",
      "text": "Além da terra firme, há florestas de igapó e de encosta, associadas à rede fluvial e ao relevo.",
