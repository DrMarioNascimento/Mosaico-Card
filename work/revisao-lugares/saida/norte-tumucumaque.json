      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "norte-tumucumaque-geografo-P13",
      "factKey": "norte-tumucumaque-F13",
      "text": "Inselbergs se projetam acima do dossel e chegam a cerca de 700 m perto das fronteiras do norte.",
      "relatedFields": [
