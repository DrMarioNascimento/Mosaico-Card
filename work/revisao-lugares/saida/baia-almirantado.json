  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "baia-almirantado-viajante-P01",
      "factKey": "baia-almirantado-F01",
      "text": "Uma grande baía cercada de geleiras se abre na costa de uma ilha antártica.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P02",
      "factKey": "baia-almirantado-F02",
      "text": "O clima é frio e úmido, típico do litoral antártico, com média anual perto de –2 °C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "clima",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P03",
      "factKey": "baia-almirantado-F03",
      "text": "Fica num arquipélago a cerca de 125 km da ponta norte da Península Antártica.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P04",
      "factKey": "baia-almirantado-F04",
      "text": "Quase 90% da terra em volta da baía fica coberta de gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P05",
      "factKey": "baia-almirantado-F05",
      "text": "No fundo da baía, o gelo desce até o mar por três enseadas.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P06",
      "factKey": "baia-almirantado-F06",
      "text": "A baía tem a forma de um fiorde: um antigo vale de geleira invadido pelo mar.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P07",
      "factKey": "baia-almirantado-F07",
      "text": "Praias antigas ficaram “penduradas” até uns 20 m acima do nível do mar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P08",
      "factKey": "baia-almirantado-F08",
      "text": "Entre as rochas vulcânicas da margem aparecem camadas com fósseis de plantas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P09",
      "factKey": "baia-almirantado-F09",
      "text": "Pinguins-de-adélia, de-barbicha e gentoo são as aves que mais fazem ninho por ali.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P10",
      "factKey": "baia-almirantado-F10",
      "text": "Nas últimas décadas, os gentoos aumentaram, enquanto adélias e barbichas diminuíram.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P11",
      "factKey": "baia-almirantado-F11",
      "text": "Elefantes-marinhos e focas-de-weddell têm filhotes nas praias.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P12",
      "factKey": "baia-almirantado-F12",
      "text": "No verão, a baleia-jubarte é a baleia vista com mais frequência.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P13",
      "factKey": "baia-almirantado-F13",
      "text": "Musgos, centenas de tipos de líquen e duas plantas com flor nativas ocupam os trechos sem gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P14",
      "factKey": "baia-almirantado-F14",
      "text": "Algas gigantes crescem no fundo da baía, entre 15 e 30 m de profundidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P15",
      "factKey": "baia-almirantado-F15",
      "text": "Entre 1956 e 2000, o ar ali ficou cerca de 1,1 °C mais quente, e as geleiras recuaram.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P16",
      "factKey": "baia-almirantado-F16",
      "text": "Uma estação polonesa funciona o ano inteiro na baía desde 1977.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P17",
      "factKey": "baia-almirantado-F17",
      "text": "O Peru tem uma base usada só no verão na mesma baía.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P18",
      "factKey": "baia-almirantado-F18",
      "text": "Um túmulo com monumento de bronze, perto de uma das estações, é sítio histórico protegido.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P19",
      "factKey": "baia-almirantado-F19",
      "text": "Um velho bote baleeiro e um esqueleto de baleia montado ficam perto de uma das estações.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P20",
      "factKey": "baia-almirantado-F20",
      "text": "Uma base brasileira foi inaugurada ali em fevereiro de 1984.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_NATGEO"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P21",
      "factKey": "baia-almirantado-F21",
      "text": "Em 2012, um incêndio destruiu 70% dessa base, e dois militares morreram.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_NATGEO",
       "ALMIRANTADO_MARINHA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P22",
      "factKey": "baia-almirantado-F22",
      "text": "Cruzes numa península da baía homenageiam militares, dois deles mortos nesse incêndio.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P23",
      "factKey": "baia-almirantado-F23",
      "text": "A nova estação, aberta em janeiro de 2020, tem cerca de 4.500 m² e recebe até 64 pessoas.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_NATGEO",
       "ALMIRANTADO_MARINHA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P24",
      "factKey": "baia-almirantado-F24",
      "text": "O projeto da nova estação é de um escritório de arquitetura de Curitiba.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_MARINHA",
       "ALMIRANTADO_FAPESP"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-viajante-P25",
      "factKey": "baia-almirantado-F25",
      "text": "A estação usa vento e sol para gerar parte da sua energia.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_MARINHA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "baia-almirantado-geografo-P01",
      "factKey": "baia-almirantado-F01",
      "text": "Um fiorde amplo entalha a costa sul de uma ilha quase toda coberta por calota de gelo.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "relevo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P02",
      "factKey": "baia-almirantado-F02",
      "text": "O clima é o típico da Antártida marítima: média anual de –1,8 °C, umidade de 82% e cerca de 508 mm de precipitação por ano.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "clima",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P03",
      "factKey": "baia-almirantado-F03",
      "text": "O Estreito de Bransfield separa a área, por uns 125 km, da extremidade norte da Península Antártica.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P04",
      "factKey": "baia-almirantado-F04",
      "text": "Dos 360 km² da área gerida, só uns 37 km² de terra estão livres de gelo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P05",
      "factKey": "baia-almirantado-F05",
      "text": "Na cabeceira, a calota transborda para três enseadas — Ezcurra, Mackellar e Martel —, onde geleiras de maré muito fendilhadas chegam ao mar.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P06",
      "factKey": "baia-almirantado-F26",
      "text": "O fundo da baía tem relevo muito variado, e as macroalgas chegam a uns 50–60 m de profundidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P07",
      "factKey": "baia-almirantado-F07",
      "text": "Praias elevadas até ~20 m registram o soerguimento glacioisostático do Holoceno: aliviada do peso do gelo, a crosta subiu.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P08",
      "factKey": "baia-almirantado-F08",
      "text": "Andesitos basálticos intercalados a sedimentos com plantas fósseis registram a evolução cenozoica de um arco de ilhas vulcânico.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P09",
      "factKey": "baia-almirantado-F27",
      "text": "Um tilito do Eoceno numa das enseadas é interpretado como evidência de uma glaciação de tipo alpino naquela época.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P10",
      "factKey": "baia-almirantado-F28",
      "text": "O permafrost aparece, em geral, nas encostas voltadas para o norte acima de uns 30 m de altitude.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P11",
      "factKey": "baia-almirantado-F09",
      "text": "Pinguins do gênero Pygoscelis somam 91% das aves reprodutoras, entre as 14 espécies que nidificam na área.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P12",
      "factKey": "baia-almirantado-F10",
      "text": "Em cerca de 30 anos, adélias e barbichas caíram uns 57%, enquanto os gentoos cresceram uns 64% desde a criação da área gerida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P13",
      "factKey": "baia-almirantado-F11",
      "text": "Seis espécies de pinípedes frequentam a área; elefante-marinho e foca-de-weddell se reproduzem nela.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P14",
      "factKey": "baia-almirantado-F12",
      "text": "A jubarte é o cetáceo mais frequente no verão, e houve pesca de krill dentro da baía na temporada 2009–2010.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P15",
      "factKey": "baia-almirantado-F13",
      "text": "Mais de 300 espécies de líquens e cerca de 60 de musgos convivem com as duas vasculares nativas, Deschampsia antarctica e Colobanthus quitensis.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P16",
      "factKey": "baia-almirantado-F15",
      "text": "O aquecimento de 1,1 °C entre 1956 e 2000 foi associado a um recuo de 12% das frentes de geleira.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P17",
      "factKey": "baia-almirantado-F29",
      "text": "A gramínea exótica Poa annua foi registrada no verão de 1985–86 junto à estação polonesa da baía.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P18",
      "factKey": "baia-almirantado-F16",
      "text": "Duas estações operam o ano todo: a polonesa Henryk Arctowski, na Ponta Thomas desde 1977, e a brasileira da Península Keller.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "pesquisa",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P19",
      "factKey": "baia-almirantado-F17",
      "text": "Peru (estação de verão na Ponta Crépin, de 1988) e Equador (refúgio na Ponta Hennequin, de 1989) completam a presença sul-americana.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P20",
      "factKey": "baia-almirantado-F30",
      "text": "Um acampamento de verão dos EUA, usado desde 1977, fica dentro da ASPA 128, na margem oeste; ali só se desembarca em emergência.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P21",
      "factKey": "baia-almirantado-F31",
      "text": "A gestão conjunta, proposta por Brasil e Polônia com Equador e Peru, foi adotada em 1996 e revista em 2006 como a ASMA nº 1.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P22",
      "factKey": "baia-almirantado-F21",
      "text": "O incêndio de 25 de fevereiro de 2012 destruiu 70% da estação brasileira; a nova, inaugurada em 15 de janeiro de 2020, ocupa o mesmo sítio.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_NATGEO",
       "ALMIRANTADO_FAPESP"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P23",
      "factKey": "baia-almirantado-F25",
      "text": "A nova estação combina energia eólica, solar fotovoltaica, cogeração com o calor dos motores e geradores a diesel.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_MARINHA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P24",
      "factKey": "baia-almirantado-F32",
      "text": "As fundações foram dimensionadas considerando um sismo de magnitude 5,6 registrado em 27 de agosto de 2018.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ALMIRANTADO_MARINHA"
      ],
      "clueType": "construcao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "baia-almirantado-geografo-P25",
      "factKey": "baia-almirantado-F33",
      "text": "Uma base britânica, a Base G, funcionou na Península Keller de 1947 a 1961, antes das estações atuais.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ALMIRANTADO_ASMA1"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   }
