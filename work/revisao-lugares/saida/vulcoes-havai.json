              "C1"
            ],
            "sources": [
              "HAVO_GOHAWAII"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "vulcoes-havai-viajante-P06",
            "factKey": "vulcoes-havai-F06",
            "text": "Perto da costa, o mar esculpiu um arco de pedra na lava.",
