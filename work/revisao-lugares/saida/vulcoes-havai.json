            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "vulcoes-havai-viajante-P04",
            "factKey": "vulcoes-havai-F04",
            "text": "Outra estrada desce 18,8 milhas (uns 30 km) até o fim, sem comida, água nem combustível pelo caminho.",
