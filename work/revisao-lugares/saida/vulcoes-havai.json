            "clueType": "localizacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "vulcoes-havai-viajante-P05",
            "factKey": "vulcoes-havai-F05",
            "text": "Dá para caminhar por dentro de um tubo de lava, um túnel deixado por um antigo fluxo de lava.",
