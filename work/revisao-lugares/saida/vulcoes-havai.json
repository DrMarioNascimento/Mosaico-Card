            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "vulcoes-havai-viajante-P02",
            "factKey": "vulcoes-havai-F02",
            "text": "É um destino numa ilha vulcânica do meio do oceano, onde a terra ainda está se formando.",
