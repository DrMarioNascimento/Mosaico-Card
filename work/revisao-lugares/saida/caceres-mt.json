  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "caceres-mt-viajante-P01",
      "factKey": "caceres-mt-F01",
      "text": "É uma cidade do interior do Brasil, à beira de um grande rio.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
