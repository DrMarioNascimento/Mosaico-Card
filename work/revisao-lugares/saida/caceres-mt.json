      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P02",
      "factKey": "caceres-mt-F02",
      "text": "A criação de gado é a principal atividade econômica do município.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P03",
      "factKey": "caceres-mt-F03",
      "text": "Fica perto da fronteira do Brasil com a Bolívia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P04",
      "factKey": "caceres-mt-F04",
      "text": "A cidade fica no sudoeste de Mato Grosso.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P05",
      "factKey": "caceres-mt-F05",
      "text": "Fica a cerca de 215 km da capital do estado.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P06",
      "factKey": "caceres-mt-F06",
      "text": "Está na parte mais a oeste do Pantanal mato-grossense.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P07",
      "factKey": "caceres-mt-F07",
      "text": "A cidade cresceu na margem esquerda do rio.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CAC_IBGE_HIST",
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P08",
      "factKey": "caceres-mt-F08",
      "text": "O rio da cidade é o Paraguai.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "CAC_IBGE_HIST",
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P09",
      "factKey": "caceres-mt-F09",
      "text": "O rio é palco de um festival internacional de pesca esportiva organizado pela prefeitura.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P10",
      "factKey": "caceres-mt-F10",
      "text": "As ruas antigas acompanham o curso do rio, num traçado em xadrez.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA",
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P11",
      "factKey": "caceres-mt-F11",
      "text": "O centro histórico mistura casas coloniais, prédios neoclássicos e art déco.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P12",
      "factKey": "caceres-mt-F12",
      "text": "O centro histórico é protegido pelo Iphan.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_IPHAN_EXT",
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P13",
      "factKey": "caceres-mt-F13",
      "text": "A praça principal já se chamou Largo da Matriz.",
      "relatedFields": [
       "C1",
       "C3"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P14",
      "factKey": "caceres-mt-F14",
      "text": "De frente para a praça fica uma catedral em estilo neogótico.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P15",
      "factKey": "caceres-mt-F15",
      "text": "A catedral demorou: a obra começou em 1919 e só foi inaugurada em 1965.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P16",
      "factKey": "caceres-mt-F16",
      "text": "O antigo mercado público, um prédio neoclássico, virou o museu histórico da cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P17",
      "factKey": "caceres-mt-F17",
      "text": "A primeira escola pública da cidade, do começo do século XX, segue funcionando como escola estadual.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P18",
      "factKey": "caceres-mt-F18",
      "text": "Na praça há um marco de pedra ligado a um antigo tratado de limites.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P19",
      "factKey": "caceres-mt-F19",
      "text": "Esse marco foi lavrado em Lisboa e é um dos poucos vestígios do Tratado de Madri.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P20",
      "factKey": "caceres-mt-F20",
      "text": "O marco ficava antes na foz de outro rio da região e chegou à cidade em 1883.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P21",
      "factKey": "caceres-mt-F21",
      "text": "Antes da vila, havia ali um posto de controle na travessia do rio, criado em 1772.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CAC_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P22",
      "factKey": "caceres-mt-F22",
      "text": "Esse posto ficava no caminho entre Cuiabá e Vila Bela.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "CAC_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P23",
      "factKey": "caceres-mt-F23",
      "text": "A cidade foi fundada em 6 de outubro de 1778.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P24",
      "factKey": "caceres-mt-F24",
      "text": "O fundador foi um governador da capitania, e o sobrenome dele virou o nome da cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-viajante-P25",
      "factKey": "caceres-mt-F25",
      "text": "O primeiro nome do lugar foi Vila Maria do Paraguai.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_IBGE_HIST",
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "caceres-mt-geografo-P01",
      "factKey": "caceres-mt-F01",
      "text": "Núcleo urbano ribeirinho do Brasil central cuja origem combina controle fiscal e defesa de fronteira.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P02",
      "factKey": "caceres-mt-F02",
      "text": "Até meados do século XX, a economia local girava em torno de couro e carne bovina, com poaia e borracha como produtos complementares.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P03",
      "factKey": "caceres-mt-F03",
      "text": "A proximidade da fronteira Brasil-Bolívia ajuda a explicar a função estratégica do núcleo desde o período colonial.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_ES2022",
       "CAC_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P04",
      "factKey": "caceres-mt-F04",
      "text": "O município integra a microrregião do Alto Paraguai, no sudoeste de seu estado.",
      "relatedFields": [
       "C1",
       "C2",
       "C4"
      ],
      "sources": [
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P05",
      "factKey": "caceres-mt-F05",
      "text": "O sítio urbano ocupa a margem esquerda de um rio que nasce na Chapada dos Parecis e deságua no Paraná.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "CAC_IBGE_HIST",
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P06",
      "factKey": "caceres-mt-F06",
      "text": "O traçado em xadrez, de matriz portuguesa, organiza ruas paralelas e perpendiculares ao rio.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA",
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P07",
      "factKey": "caceres-mt-F07",
      "text": "Depois da Guerra do Paraguai, a navegação fluvial impulsionou o comércio local até o início do século XX.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CAC_ES2022"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P08",
      "factKey": "caceres-mt-F08",
      "text": "No século XIX, casas comerciais faziam da cidade um elo de comércio fluvial com Corumbá.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P09",
      "factKey": "caceres-mt-F09",
      "text": "A cidade fica na borda mais ocidental do Pantanal mato-grossense, com fauna pantaneira em baías próximas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_UNEMAT_GUIA"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P10",
      "factKey": "caceres-mt-F10",
      "text": "O registro fiscal de 1772 na travessia do rio buscava coibir o descaminho do ouro entre Cuiabá e Vila Bela.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "CAC_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P11",
      "factKey": "caceres-mt-F11",
      "text": "O mesmo posto servia ao plano defensivo da capitania e mais tarde justificou um núcleo militar.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CAC_IBGE_HIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "caceres-mt-geografo-P12",
      "factKey": "caceres-mt-F12",
      "text": "Pelo Tratado de Madri (1750), a área cabia à Coroa espanhola; a fundação portuguesa buscou assegurá-la.",
