      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P20",
      "factKey": "cabo-adare-F20",
      "text": "O Grupo do Norte da expedição de Scott, chefiado por Victor Campbell, invernou ali em 1911.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_HSM_LISTA",
       "ADARE_ASPA159"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P21",
      "factKey": "cabo-adare-F21",
      "text": "Nicolai Hanson, biólogo norueguês da expedição, foi a primeira pessoa sepultada no continente antártico.",
      "relatedFields": [
