      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P13",
      "factKey": "cabo-adare-F13",
      "text": "A flora terrestre da península se resume a algas, líquens crostosos e musgos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_ADARE"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P14",
      "factKey": "cabo-adare-F14",
      "text": "As cabanas mais antigas do sítio foram as primeiras estruturas erguidas no continente antártico.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "ATS_ADARE"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P15",
      "factKey": "cabo-adare-F15",
      "text": "Duas das três cabanas históricas datam de fevereiro de 1899; a terceira, de fevereiro de 1911.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ATS_HSM_LISTA",
       "ADARE_ASPA159"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P16",
      "factKey": "cabo-adare-F16",
      "text": "As cabanas de 1899 pertencem à Expedição Antártica Britânica de 1898–1900.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ATS_HSM_LISTA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P17",
      "factKey": "cabo-adare-F17",
      "text": "A liderança da expedição de 1898–1900 coube a Carsten E. Borchgrevink.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "ATS_HSM_LISTA"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P18",
      "factKey": "cabo-adare-F18",
      "text": "A ocupação das cabanas em 1899 corresponde ao primeiro inverno passado no continente antártico.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "ADARE_ASPA159"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "essential",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P19",
      "factKey": "cabo-adare-F19",
      "text": "A cabana de 1911 entrou em colapso; em 2002 restava de pé praticamente só o alpendre.",
