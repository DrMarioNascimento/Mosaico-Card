     },
     {
      "id": "cabo-adare-geografo-P24",
      "factKey": "cabo-adare-F24",
      "text": "As cabanas formam a Área Antártica Especialmente Protegida nº 159, com entrada apenas por permissão e acompanhamento de guia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_ADARE"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
