       "ATS_ADARE"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P22",
      "factKey": "cabo-adare-F22",
      "text": "O túmulo é marcado por um grande matacão com cruz e placa, e o contorno é feito de pedras de quartzo branco.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_HSM_LISTA",
       "ADARE_ASPA159"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "cabo-adare-geografo-P23",
      "factKey": "cabo-adare-F23",
      "text": "O acesso ao túmulo é íngreme e perigoso, e as encostas ficam fechadas no verão por estarem ocupadas por ninhos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "ATS_ADARE"
      ],
      "clueType": "conservacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
