            "twoPlayerSuitable": true
          },
          {
            "id": "colonia-sacramento-geografo-P17",
            "factKey": "colonia-sacramento-F17",
            "text": "O Portón de Campo, com ponte levadiça, marca a entrada da cidade antiga.",
