            "twoPlayerSuitable": true
          },
          {
            "id": "colonia-sacramento-geografo-P15",
            "factKey": "colonia-sacramento-F15",
            "text": "Tradições construtivas portuguesas e espanholas se combinam em edifícios modestos.",
