      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P04",
      "factKey": "parna-brasilia-F04",
      "text": "Foi criado em 29 de novembro de 1961.",
