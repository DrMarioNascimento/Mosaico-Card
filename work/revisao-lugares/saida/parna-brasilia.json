   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "parna-brasilia-geografo-P01",
      "factKey": "parna-brasilia-F01",
      "text": "Unidade de conservação federal num planalto ondulado do Cerrado, criada para proteger mananciais.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "PNB_WIKI",
       "PNB_ICMBIO_2017"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P02",
      "factKey": "parna-brasilia-F02",
      "text": "A criação respondeu à construção da nova capital: proteger recursos hídricos, garantir água potável e manter a biodiversidade.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "PNB_ICMBIO_2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P03",
      "factKey": "parna-brasilia-F03",
      "text": "O decreto federal de 29 de novembro de 1961 criou a unidade com cerca de 28 mil ha.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P04",
      "factKey": "parna-brasilia-F04",
      "text": "Uma lei de 2006 alterou os limites e incorporou áreas como o vale do rio da Palma; hoje são cerca de 42,4 mil ha.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_LEI2006",
       "PNB_ICMBIO_CARAC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P05",
      "factKey": "parna-brasilia-F05",
      "text": "Cerca de 98,8% da área fica no DF; o restante se divide entre Padre Bernardo e Planaltina, em Goiás.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_ICMBIO_CARAC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P06",
      "factKey": "parna-brasilia-F06",
      "text": "A unidade se reparte entre duas grandes bacias: 68,6% drena para o Paraná e 31,4% para o Tocantins-Araguaia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_ICMBIO_CARAC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P07",
      "factKey": "parna-brasilia-F07",
      "text": "Localmente, a drenagem se divide entre as bacias do Maranhão e do Paranoá.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "PNB_ICMBIO_CARAC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P08",
      "factKey": "parna-brasilia-F08",
      "text": "O relevo é um planalto ondulado com quartzitos e calcários, cavernas e nascentes, entre 700 e 1.300 m de altitude.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P09",
      "factKey": "parna-brasilia-F09",
      "text": "Formações savânicas cobrem cerca de 48% da área, campestres 40% e florestais 13%.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PNB_ICMBIO_CARAC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P10",
      "factKey": "parna-brasilia-F10",
      "text": "Matas de galeria acompanham nascentes e córregos, com buritis e plantas da família Velloziaceae.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PNB_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P11",
      "factKey": "parna-brasilia-F11",
      "text": "As chuvas de outubro a abril somam 84% do total anual; a estação seca vai de maio a setembro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-geografo-P12",
      "factKey": "parna-brasilia-F12",
      "text": "A precipitação média anual fica na casa de 1.500 mm, com temperatura média de 22 °C.",
