      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P12",
      "factKey": "parna-brasilia-F12",
      "text": "A água das piscinas se renova o tempo todo graças a nascentes.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "PNB_ICMBIO_2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P13",
      "factKey": "parna-brasilia-F13",
      "text": "As piscinas surgiram de poços abertos na extração de areia, antes da construção da capital.",
