       "PNB_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P02",
      "factKey": "parna-brasilia-F02",
      "text": "As chuvas vão de outubro a abril, e o inverno é seco.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_WIKI"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P03",
      "factKey": "parna-brasilia-F03",
      "text": "Quase todo o território fica no Distrito Federal, com pequenas partes em Goiás.",
