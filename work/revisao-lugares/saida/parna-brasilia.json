      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P05",
      "factKey": "parna-brasilia-F05",
      "text": "A criação do parque está ligada à construção da cidade vizinha.",
