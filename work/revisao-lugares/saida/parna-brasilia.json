      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P06",
      "factKey": "parna-brasilia-F06",
      "text": "Os limites foram ampliados em 2006.",
