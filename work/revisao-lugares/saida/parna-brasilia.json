      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P19",
      "factKey": "parna-brasilia-F19",
      "text": "Lobo-guará, tamanduá-bandeira e tatu-canastra estão entre os mamíferos.",
