       "C3"
      ],
      "sources": [
       "PNB_ICMBIO_2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P14",
      "factKey": "parna-brasilia-F14",
      "text": "A trilha da Capivara, de 1,3 km, fica perto de uma das piscinas.",
