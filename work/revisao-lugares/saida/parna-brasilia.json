    "cards": [
     {
      "id": "parna-brasilia-viajante-P01",
      "factKey": "parna-brasilia-F01",
      "text": "É uma área protegida do Brasil central, com muitas nascentes e vegetação de savana.",
      "relatedFields": [
       "C1",
