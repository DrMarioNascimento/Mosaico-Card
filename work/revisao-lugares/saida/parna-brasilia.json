      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P21",
      "factKey": "parna-brasilia-F21",
      "text": "Já foram registradas 312 espécies de aves.",
