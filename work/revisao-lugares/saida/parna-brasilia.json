      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P17",
      "factKey": "parna-brasilia-F17",
      "text": "Os córregos Bananal, Torto e Santa Maria correm pelo parque.",
