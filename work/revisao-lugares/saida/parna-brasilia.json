      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P20",
      "factKey": "parna-brasilia-F20",
      "text": "Emas, seriemas e tucanos estão entre as aves.",
