      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P16",
      "factKey": "parna-brasilia-F16",
      "text": "Essa trilha leva a um lugar chamado Ilha da Meditação.",
