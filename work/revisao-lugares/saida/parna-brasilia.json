      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P07",
      "factKey": "parna-brasilia-F07",
      "text": "Hoje tem cerca de 42 mil hectares.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_ICMBIO_CARAC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P08",
      "factKey": "parna-brasilia-F08",
      "text": "Tem tantas nascentes que ganhou um apelido ligado à água.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
