      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P18",
      "factKey": "parna-brasilia-F18",
      "text": "Buritis e matas de galeria acompanham nascentes e córregos.",
