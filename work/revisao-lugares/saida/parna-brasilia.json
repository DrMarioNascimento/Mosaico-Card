      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P09",
      "factKey": "parna-brasilia-F09",
      "text": "A temperatura média do ano fica em torno de 20 a 22 °C.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PNB_WIKI",
       "PNB_ICMBIO_CARAC"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P10",
      "factKey": "parna-brasilia-F10",
      "text": "As piscinas de água natural são a principal atração.",
