      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P11",
      "factKey": "parna-brasilia-F11",
      "text": "As duas piscinas se chamam Areal e Pedreira.",
      "relatedFields": [
       "C3"
      ],
