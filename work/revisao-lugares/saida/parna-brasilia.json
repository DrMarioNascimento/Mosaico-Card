      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "parna-brasilia-viajante-P15",
      "factKey": "parna-brasilia-F15",
      "text": "A trilha Cristal Água tem 15 km e aceita bicicletas.",
