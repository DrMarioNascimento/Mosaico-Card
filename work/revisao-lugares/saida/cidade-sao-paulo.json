    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "cidade-sao-paulo-viajante-P01",
            "factKey": "cidade-sao-paulo-F01",
            "text": "É uma capital do Sudeste que fica num planalto, acima de uma serra que desce até o litoral.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_1"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P02",
            "factKey": "cidade-sao-paulo-F02",
            "text": "A cidade nasceu em volta de uma escola de padres jesuítas.",
            "relatedFields": [
              "C1",
              "C2"
            ],
            "sources": [
              "SP_ALESP450",
              "SP_PATIO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P03",
            "factKey": "cidade-sao-paulo-F03",
            "text": "O aniversário da cidade é 25 de janeiro, dia da missa que inaugurou o colégio, em 1554.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P04",
            "factKey": "cidade-sao-paulo-F04",
            "text": "Nessa missa, José de Anchieta tinha só 19 anos e servia como sacristão.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P05",
            "factKey": "cidade-sao-paulo-F05",
            "text": "A primeira cabana do colégio media cerca de 14 passos por 10.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P06",
            "factKey": "cidade-sao-paulo-F06",
            "text": "No lugar do antigo colégio, a igreja que desabou em 1896 foi reconstruída a partir de 1953.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SP_PATIO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P07",
            "factKey": "cidade-sao-paulo-F07",
            "text": "O núcleo inicial ficava num alto entre dois rios, o que ajudava na defesa.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SP_ALESP450",
              "SP_PATIO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P08",
            "factKey": "cidade-sao-paulo-F08",
            "text": "O principal rio da cidade antes se chamava Anhembi.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P09",
            "factKey": "cidade-sao-paulo-F09",
            "text": "O cacique Tibiriçá, aliado dos jesuítas, está sepultado na cripta da catedral.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_1"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P10",
            "factKey": "cidade-sao-paulo-F10",
            "text": "O primeiro europeu a subir a serra até o planalto foi João Ramalho.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_1"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P11",
            "factKey": "cidade-sao-paulo-F11",
            "text": "A avenida mais famosa da cidade foi inaugurada em 8 de dezembro de 1891.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP450",
              "SP_ALESP460_5"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P12",
            "factKey": "cidade-sao-paulo-F12",
            "text": "Essa avenida foi a primeira via asfaltada e arborizada da cidade e teve casarões de barões do café.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_5"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P13",
            "factKey": "cidade-sao-paulo-F13",
            "text": "Um museu de arte nessa avenida tem embaixo do prédio um grande vão livre, pensado como praça.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_MASP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P14",
            "factKey": "cidade-sao-paulo-F14",
            "text": "Em 1968 o museu se mudou para esse prédio de vidro e concreto, projetado por Lina Bo Bardi.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_MASP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P15",
            "factKey": "cidade-sao-paulo-F15",
            "text": "Lá dentro, as pinturas ficam em cavaletes de cristal, longe das paredes.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_MASP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P16",
            "factKey": "cidade-sao-paulo-F16",
            "text": "Um grande parque foi preparado para a festa dos 400 anos da cidade, em 1954.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SP_IBIRA_PMSP",
              "SP_IBIRA_ALESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P17",
            "factKey": "cidade-sao-paulo-F17",
            "text": "Oscar Niemeyer desenhou para esse parque pavilhões ligados por uma marquise, além da Oca.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SP_IBIRA_PMSP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P18",
            "factKey": "cidade-sao-paulo-F18",
            "text": "O nome do parque vem do tupi e quer dizer \"pau podre\", porque ali era um brejo.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SP_IBIRA_ALESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P19",
            "factKey": "cidade-sao-paulo-F19",
            "text": "Em 1927, centenas de eucaliptos foram plantados para secar o terreno alagado do futuro parque.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SP_IBIRA_ALESP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P20",
            "factKey": "cidade-sao-paulo-F20",
            "text": "O parque abriga uma bienal internacional de arte e recebe a maratona internacional da cidade.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "SP_IBIRA_PMSP"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P21",
            "factKey": "cidade-sao-paulo-F21",
            "text": "A primeira linha de bonde, puxada por animais, começou a circular em 1872.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P22",
            "factKey": "cidade-sao-paulo-F22",
            "text": "Os bondes elétricos rodaram por 68 anos e, a partir de 1973, foram substituídos aos poucos pelo metrô.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP450",
              "SP_ALESP460_5"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P23",
            "factKey": "cidade-sao-paulo-F23",
            "text": "No fim do século XIX, a maioria dos moradores era de imigrantes europeus, sobretudo italianos, espanhóis e portugueses.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_5"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P24",
            "factKey": "cidade-sao-paulo-F24",
            "text": "Um museu de arte da cidade guarda o acervo de arte europeia considerado o mais importante do Hemisfério Sul.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_MASP"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-viajante-P25",
            "factKey": "cidade-sao-paulo-F25",
            "text": "A população passou de 300 mil habitantes em 1905 para mais de 10 milhões em 2000.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_5"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "cidade-sao-paulo-geografo-P01",
            "factKey": "cidade-sao-paulo-F01",
            "text": "O sítio original fica num planalto do interior, alcançado a partir do litoral pela subida da serra.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_1"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P02",
            "factKey": "cidade-sao-paulo-F02",
            "text": "Já em 1602 partiam dali bandeiras rumo ao interior, em busca de ouro e de indígenas para aprisionar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P03",
            "factKey": "cidade-sao-paulo-F03",
            "text": "O colégio se instalou num alto cercado por dois rios, escolha que favorecia a defesa do núcleo.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SP_ALESP450",
              "SP_ALESP460_1"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P04",
            "factKey": "cidade-sao-paulo-F04",
            "text": "Nessa colina, entre os mesmos dois rios, ficava antes a aldeia indígena de Inhapuambuçu, no atual centro antigo.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "SP_ALESP460_1"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P05",
            "factKey": "cidade-sao-paulo-F05",
            "text": "A aldeia jesuítica de Piratininga, criada em 1553, reunia cerca de 50 catecúmenos.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P06",
            "factKey": "cidade-sao-paulo-F06",
            "text": "Em 1560, a vila de Santo André da Borda do Campo foi extinta e seus moradores, transferidos para o núcleo jesuíta.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_1"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P07",
            "factKey": "cidade-sao-paulo-F07",
            "text": "Também em 1560 o aldeamento passou a vila, com Câmara e pelourinho.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP460_1",
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P08",
            "factKey": "cidade-sao-paulo-F08",
            "text": "O ataque indígena de 1562, de guaianases, tamoios e carijós, foi repelido com ajuda de João Ramalho e do cacique Tibiriçá.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP450",
              "SP_ALESP460_1"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P09",
            "factKey": "cidade-sao-paulo-F09",
            "text": "Em 1681 a vila foi elevada a cabeça da capitania de São Vicente; em 1711, tornou-se cidade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "cidade-sao-paulo-geografo-P10",
            "factKey": "cidade-sao-paulo-F10",
            "text": "Em 1720, a descoberta de ouro em Minas Gerais levou à separação daquela região da capitania.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "SP_ALESP450"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
