    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "sitio-burle-marx-viajante-P01",
            "factKey": "sitio-burle-marx-F01",
            "text": "É um lugar de jardins, com casa, outras construções e uma enorme coleção de plantas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO",
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P02",
            "factKey": "sitio-burle-marx-F02",
            "text": "Fica numa área de morros de uma grande cidade brasileira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P03",
            "factKey": "sitio-burle-marx-F03",
            "text": "Está na zona oeste de uma capital do Sudeste.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BURLE_UNESCO",
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P04",
            "factKey": "sitio-burle-marx-F04",
            "text": "Um artista e paisagista desenvolveu o lugar por mais de 40 anos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P05",
            "factKey": "sitio-burle-marx-F05",
            "text": "Tudo começou em 1949, quando ele comprou a propriedade junto com um irmão.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022",
              "BURLE_BDF_2021"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P06",
            "factKey": "sitio-burle-marx-F06",
            "text": "Algumas espécies novas que o criador encontrou em expedições levam o nome dele.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P07",
            "factKey": "sitio-burle-marx-F07",
            "text": "Cerca de 3.500 espécies de plantas tropicais e subtropicais crescem ali.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO",
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P08",
            "factKey": "sitio-burle-marx-F08",
            "text": "Os jardins têm formas curvas, plantas em grandes massas e contrastes fortes de cor.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P09",
            "factKey": "sitio-burle-marx-F09",
            "text": "Quadros abstratos serviram de base para o desenho dos jardins.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P10",
            "factKey": "sitio-burle-marx-F10",
            "text": "Muitas plantas vieram de expedições pelos biomas brasileiros.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P11",
            "factKey": "sitio-burle-marx-F11",
            "text": "A diretora do lugar diz que o jardim tropical moderno criado ali foi \"uma mudança de paradigma no paisagismo\".",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P12",
            "factKey": "sitio-burle-marx-F12",
            "text": "A casa onde o artista morou guarda objetos pessoais, obras de arte e uma coleção de arte popular.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P13",
            "factKey": "sitio-burle-marx-F13",
            "text": "Calçamentos, cascatas, portas e fachadas foram feitos com materiais de prédios demolidos.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P14",
            "factKey": "sitio-burle-marx-F14",
            "text": "A área florestal soma cerca de 407 mil m².",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_BDF_2021"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P15",
            "factKey": "sitio-burle-marx-F15",
            "text": "Em 1985, o dono doou o sítio ao governo federal, ainda em vida.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BURLE_ABR_2022",
              "BURLE_BDF_2021"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P16",
            "factKey": "sitio-burle-marx-F16",
            "text": "Desde 1994, a gestão é do instituto federal do patrimônio histórico e artístico.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "BURLE_BDF_2021",
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P17",
            "factKey": "sitio-burle-marx-F17",
            "text": "Em julho de 2021, a UNESCO o incluiu na lista do Patrimônio Mundial como paisagem cultural.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BURLE_BDF_2021",
              "BURLE_UNESCO_DEC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P18",
            "factKey": "sitio-burle-marx-F18",
            "text": "Foi o 23º bem brasileiro a entrar na lista do Patrimônio Mundial.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_BDF_2021"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P19",
            "factKey": "sitio-burle-marx-F19",
            "text": "O criador queria fazer jardins em que \"o povo pudesse participar\".",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P20",
            "factKey": "sitio-burle-marx-F20",
            "text": "Além do órgão federal, um instituto estadual do patrimônio também protege o local.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P21",
            "factKey": "sitio-burle-marx-F21",
            "text": "Dentro da área há Mata Atlântica, manguezal e restinga.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P22",
            "factKey": "sitio-burle-marx-F22",
            "text": "O criador, que viveu de 1909 a 1994, fez do lugar um laboratório para conhecer o comportamento da flora brasileira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO",
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P23",
            "factKey": "sitio-burle-marx-F23",
            "text": "A UNESCO pediu reforço na prevenção de incêndios no local e no entorno.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO_DEC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P24",
            "factKey": "sitio-burle-marx-F24",
            "text": "Fica numa área montanhosa do bairro de Barra de Guaratiba.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BURLE_UNESCO",
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-viajante-P25",
            "factKey": "sitio-burle-marx-F25",
            "text": "O lugar recebe visitantes, que podem percorrer a propriedade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          }
        ]
      },
      "geografo": {
        "label": "Geógrafo",
        "cards": [
          {
            "id": "sitio-burle-marx-geografo-P01",
            "factKey": "sitio-burle-marx-F01",
            "text": "Bem cultural que reúne jardins projetados, edificações e coleções botânicas vivas numa só propriedade.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P02",
            "factKey": "sitio-burle-marx-F02",
            "text": "A propriedade ocupa área montanhosa entre manguezais e Mata Atlântica nativa, com trechos de restinga, a planície arenosa costeira.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P03",
            "factKey": "sitio-burle-marx-F03",
            "text": "Localiza-se na zona oeste de uma metrópole do Sudeste.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P04",
            "factKey": "sitio-burle-marx-F04",
            "text": "Serviu de laboratório paisagístico em que ideias da arte moderna europeia foram adaptadas à flora tropical nativa.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO",
              "BURLE_UNESCO_DEC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P05",
            "factKey": "sitio-burle-marx-F05",
            "text": "Pelo critério (iv), a UNESCO o considera exemplo de um novo tipo de paisagismo, depois chamado de jardim tropical moderno.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "BURLE_UNESCO_DEC",
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P06",
            "factKey": "sitio-burle-marx-F06",
            "text": "Pelo critério (ii), o intercâmbio de ideias ali gestado influenciou parques e jardins pelo mundo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO_DEC"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P07",
            "factKey": "sitio-burle-marx-F07",
            "text": "Traçados sinuosos e arranjos arquitetônicos de plantas estruturam o desenho dos jardins.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P08",
            "factKey": "sitio-burle-marx-F08",
            "text": "Muitas plantas tropicais nativas coletadas e cultivadas ali foram popularizadas no paisagismo.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_UNESCO"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P09",
            "factKey": "sitio-burle-marx-F09",
            "text": "Expedições pelos biomas brasileiros alimentaram a coleção e renderam cerca de 50 espécies novas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "BURLE_ABR_2022"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "sitio-burle-marx-geografo-P10",
            "factKey": "sitio-burle-marx-F10",
            "text": "No fim da década de 1960, abrigava a coleção mais representativa de plantas brasileiras.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
