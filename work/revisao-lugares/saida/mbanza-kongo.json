              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P03",
            "factKey": "mbanza-kongo-F03",
            "text": "O reino, ativo dos séculos XIV ao XIX, ia do Atlântico ao rio Kwango no fim do século XV.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MBANZA_41COM",
              "MBANZA_ICOMOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P04",
            "factKey": "mbanza-kongo-F04",
            "text": "A área de influência do antigo reino abrange hoje partes de Angola, do Gabão e da República Democrática do Congo.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P05",
            "factKey": "mbanza-kongo-F05",
            "text": "A capital manteve autoridade ritual e simbólica enquanto o reino adotava o cristianismo sem abandonar costumes antigos.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P06",
            "factKey": "mbanza-kongo-F06",
            "text": "A UNESCO a considera uma porta de entrada do cristianismo na África Central.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P07",
            "factKey": "mbanza-kongo-F07",
            "text": "Os contatos diplomáticos começaram logo após a chegada dos portugueses à foz do grande rio da região, em 1482.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P08",
            "factKey": "mbanza-kongo-F08",
            "text": "Mvemba Nzinga (Afonso I) firmou acordo com o rei Manuel I de Portugal sobre missionários e comércio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P09",
            "factKey": "mbanza-kongo-F09",
            "text": "O conjunto mostra como o cristianismo e o contato com os portugueses, a partir do século XV, transformaram a arquitetura de um centro político africano.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P10",
            "factKey": "mbanza-kongo-F10",
            "text": "A catedral do Santo Salvador foi consagrada em 1596, e o cemitério dos soberanos fica dentro de seus limites.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P11",
            "factKey": "mbanza-kongo-F11",
            "text": "As ruínas dessa catedral, o Kulumbimbi, marcam a primeira sede episcopal da África ao sul do equador.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
