          },
          {
            "id": "mbanza-kongo-geografo-P19",
            "factKey": "mbanza-kongo-F19",
            "text": "A gestão participativa, criada em 2015, reúne Ministério da Cultura, governo provincial, município e autoridades tradicionais.",
            "relatedFields": [
