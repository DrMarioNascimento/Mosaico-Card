    "profiles": {
      "viajante": {
        "label": "Viajante",
        "cards": [
          {
            "id": "mbanza-kongo-viajante-P01",
            "factKey": "mbanza-kongo-F01",
            "text": "Este destino é uma cidade histórica africana no alto de um planalto.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM",
              "MBANZA_ICOMOS"
            ],
            "clueType": "relevo",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P02",
            "factKey": "mbanza-kongo-F02",
            "text": "Ali ficava a capital de um antigo reino africano.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "historia",
            "signalStrength": "abertura",
            "recommendedMoment": "early",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P03",
            "factKey": "mbanza-kongo-F03",
            "text": "A cidade está a cerca de 570 metros de altitude.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM",
              "MBANZA_ICOMOS"
            ],
            "clueType": "relevo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P04",
            "factKey": "mbanza-kongo-F04",
            "text": "Acredita-se que ela tenha sido fundada no século XIII.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P05",
            "factKey": "mbanza-kongo-F05",
            "text": "O reino esteve ativo do século XIV ao século XIX.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P06",
            "factKey": "mbanza-kongo-F06",
            "text": "No fim do século XV, o território do reino ia do oceano Atlântico, a oeste, até o rio Kwango, a leste.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P07",
            "factKey": "mbanza-kongo-F07",
            "text": "Hoje, a antiga área de influência do reino se espalha por três países.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P08",
            "factKey": "mbanza-kongo-F08",
            "text": "Navegadores portugueses chegaram à foz do grande rio da região em 1482, e logo começaram relações diplomáticas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P09",
            "factKey": "mbanza-kongo-F09",
            "text": "Em 1491, o rei se converteu ao catolicismo e adotou o nome de João I.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P10",
            "factKey": "mbanza-kongo-F10",
            "text": "Os portugueses ergueram ali construções de pedra em estilo europeu, entre elas várias igrejas.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "construcao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P11",
            "factKey": "mbanza-kongo-F11",
            "text": "Mesmo com o cristianismo entre as elites, a cidade manteve sua cultura local.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P12",
            "factKey": "mbanza-kongo-F12",
            "text": "Pouco depois de ganhar um nome português, a cidade teve sua catedral consagrada, em 1596.",
            "relatedFields": [
              "C2"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P13",
            "factKey": "mbanza-kongo-F13",
            "text": "As ruínas dessa antiga catedral são chamadas hoje de Kulumbimbi.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS",
              "MBANZA_41COM"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P14",
            "factKey": "mbanza-kongo-F14",
            "text": "A catedral foi a primeira sede de bispado da África ao sul do equador.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P15",
            "factKey": "mbanza-kongo-F15",
            "text": "O cemitério dos reis fica dentro dos limites da antiga catedral.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "patrimonio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P16",
            "factKey": "mbanza-kongo-F16",
            "text": "Os reis faziam justiça à sombra de uma árvore sagrada, num recinto que faz parte do sítio.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MBANZA_ICOMOS",
              "MBANZA_PR"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P17",
            "factKey": "mbanza-kongo-F17",
            "text": "O primeiro catecismo na língua local foi escrito ali, num colégio jesuíta, em 1624.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM",
              "MBANZA_ICOMOS"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P18",
            "factKey": "mbanza-kongo-F18",
            "text": "A cidade foi tomada e reduzida a ruínas entre 1568 e 1571.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_ICOMOS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P19",
            "factKey": "mbanza-kongo-F19",
            "text": "A rua principal ainda segue o traçado original, e o antigo espaço real nunca foi ocupado por novas construções.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "urbanismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P20",
            "factKey": "mbanza-kongo-F20",
            "text": "O reino estava no centro de uma das principais rotas do tráfico de pessoas escravizadas, mas não se acharam vestígios materiais disso no sítio.",
            "relatedFields": [
              "C3"
            ],
            "sources": [
              "MBANZA_41COM",
              "MBANZA_ICOMOS"
            ],
            "clueType": "historia",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P21",
            "factKey": "mbanza-kongo-F21",
            "text": "Uma antiga pista de pouso perto do centro histórico deve ser desmontada quando o novo aeroporto funcionar.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM",
              "MBANZA_PR"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P22",
            "factKey": "mbanza-kongo-F22",
            "text": "O museu dos reis guarda objetos da história do reino, e a visita não cobra entrada.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_PR"
            ],
            "clueType": "turismo",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P23",
            "factKey": "mbanza-kongo-F23",
            "text": "Um tribunal tradicional voltou a funcionar depois de quatro décadas de conflito.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM",
              "MBANZA_PR"
            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P24",
            "factKey": "mbanza-kongo-F24",
            "text": "A cidade fica no noroeste de Angola, na província do Zaire, e virou Patrimônio Mundial em 2017.",
