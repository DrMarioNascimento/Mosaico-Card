            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P20",
            "factKey": "mbanza-kongo-F20",
            "text": "A irmandade do Leopardo (Ngo) ainda detém poder ritual e simbólico, e parte do saber tradicional só existe na forma oral.",
            "relatedFields": [
