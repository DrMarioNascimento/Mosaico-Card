            ],
            "clueType": "conservacao",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P18",
            "factKey": "mbanza-kongo-F18",
            "text": "Algas, umidade, poeira e enxurradas desgastam as estruturas de pedra, e as tempestades se concentram de meados de março a meados de maio.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
