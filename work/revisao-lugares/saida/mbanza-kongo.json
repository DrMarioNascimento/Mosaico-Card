            ],
            "clueType": "cultura",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-geografo-P21",
            "factKey": "mbanza-kongo-F21",
            "text": "O reino estava no centro da principal rota do tráfico de escravizados, mas nenhum vestígio material desse tráfico foi achado na área inscrita.",
            "relatedFields": [
