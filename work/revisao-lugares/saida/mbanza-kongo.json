              "C4"
            ],
            "sources": [
              "MBANZA_ICOMOS",
              "MBANZA_41COM"
            ],
            "clueType": "localizacao",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "mbanza-kongo-viajante-P25",
            "factKey": "mbanza-kongo-F25",
            "text": "A catedral já estava de pé em 1608, quando o papa credenciou no Vaticano o primeiro embaixador da África subsaariana, enviado pelo reino.",
            "relatedFields": [
              "C1"
            ],
            "sources": [
              "MBANZA_41COM"
            ],
            "clueType": "historia",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
