      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "terra-ronca-go-geografo-P23",
      "factKey": "terra-ronca-go-F23",
      "text": "O uso público exige condutor credenciado e agendamento de visitas técnicas e de grupos grandes.",
      "relatedFields": [
