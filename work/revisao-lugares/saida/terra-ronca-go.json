      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "terra-ronca-go-geografo-P20",
      "factKey": "terra-ronca-go-F20",
      "text": "A tiriba-do-paranã, endêmica do Cerrado e de distribuição restrita, ocorre na estreita faixa de mata seca.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "CENTRO_TER_APA",
