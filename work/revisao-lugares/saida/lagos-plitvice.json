       "PLITV_RP2014"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P22",
      "factKey": "lagos-plitvice-F21",
      "text": "Esteve na Lista do Patrimônio em Perigo de 1992 a 1997, por causa do conflito armado, e saiu após reparos.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_MISSAO2017",
       "PLITV_SOC2017"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
