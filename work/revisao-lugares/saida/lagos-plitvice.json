      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P21",
      "factKey": "lagos-plitvice-F46",
      "text": "Criado em 1949, o parque é gerido por uma instituição pública com conselho de administração.",
