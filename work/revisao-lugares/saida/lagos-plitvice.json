  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "lagos-plitvice-viajante-P01",
      "factKey": "lagos-plitvice-F01",
      "text": "É uma paisagem natural europeia de lagos, florestas e prados sobre um relevo cárstico.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P02",
      "factKey": "lagos-plitvice-F02",
      "text": "Entrou na lista do patrimônio mundial em 1979 e foi ampliado em 2000.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP2014",
       "PLITV_MISSAO2017"
      ],
      "clueType": "patrimonio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P03",
      "factKey": "lagos-plitvice-F03",
      "text": "Os lagos ficam em degraus, separados por barreiras naturais que funcionam como represas.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P04",
      "factKey": "lagos-plitvice-F04",
      "text": "Essas barreiras se formam com o calcário que a própria água carrega e deposita.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P05",
      "factKey": "lagos-plitvice-F05",
      "text": "Musgos, algas e bactérias ajudam esse calcário a se depositar.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P06",
      "factKey": "lagos-plitvice-F06",
      "text": "Dezesseis lagos podem ser vistos na superfície.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI",
       "PLITV_RP3"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P07",
      "factKey": "lagos-plitvice-F07",
      "text": "Os lagos de baixo são menores e mais rasos e ficam em cânions.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P08",
      "factKey": "lagos-plitvice-F08",
      "text": "Uma das quedas d'água, chamada Grande Cachoeira, tem 78 metros.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P09",
      "factKey": "lagos-plitvice-F09",
      "text": "Os dois maiores lagos somam cerca de 80% da área de água e chegam a 37 e 47 metros de profundidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P10",
      "factKey": "lagos-plitvice-F10",
      "text": "O nome de um dos grandes lagos vem das cercas de estacas que os camponeses usavam para separar as lavouras da água.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P11",
      "factKey": "lagos-plitvice-F11",
      "text": "As águas que alimentam os lagos vêm do encontro de dois rios, o Rio Branco e o Rio Preto.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P12",
      "factKey": "lagos-plitvice-F12",
      "text": "Ursos-pardos, lobos e linces vivem nas florestas do parque.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3",
       "PLITV_WIKI"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P13",
      "factKey": "lagos-plitvice-F13",
      "text": "Cerca de 157 espécies de aves foram registradas no parque.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P14",
      "factKey": "lagos-plitvice-F14",
      "text": "Nadar nos lagos é proibido desde 2006.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P15",
      "factKey": "lagos-plitvice-F15",
      "text": "No verão, perto do meio-dia, o parque chega a receber mais de 10 mil visitantes por dia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_MISSAO2017"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P16",
      "factKey": "lagos-plitvice-F16",
      "text": "Hoje os ingressos têm horário marcado, com limite de pessoas por hora em cada entrada.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P17",
      "factKey": "lagos-plitvice-F17",
      "text": "Faroestes baseados nos livros de Karl May foram filmados ali nos anos 1960.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P18",
      "factKey": "lagos-plitvice-F18",
      "text": "Cerca de 84 hectares de floresta antiga de faias e abetos estão protegidos no parque.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P19",
      "factKey": "lagos-plitvice-F19",
      "text": "Cerca de 1.500 pessoas vivem em 21 povoados total ou parcialmente dentro do parque.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_MISSAO2017"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P20",
      "factKey": "lagos-plitvice-F20",
      "text": "Em março de 1991, ali aconteceu o primeiro confronto armado com mortes da guerra de independência do país.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P21",
      "factKey": "lagos-plitvice-F21",
      "text": "Por causa da guerra, o parque ficou na lista do patrimônio em perigo de 1992 a 1997.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_SOC2017",
       "PLITV_MISSAO2017"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P22",
      "factKey": "lagos-plitvice-F22",
      "text": "A tufa endurecida, chamada travertino, é porosa e sensível a pisadas e impactos.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P23",
      "factKey": "lagos-plitvice-F23",
      "text": "Em 2011, a obra de uma trilha num cânion danificou formações de tufa.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PLITV_MISSAO2017"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P24",
      "factKey": "lagos-plitvice-F24",
      "text": "É o maior parque nacional da Croácia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-viajante-P25",
      "factKey": "lagos-plitvice-F25",
      "text": "Fica numa região de montanhas cársticas da Croácia, quase todo no condado de Lika-Senj.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI",
       "PLITV_MISSAO2017"
      ],
      "clueType": "localizacao",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "lagos-plitvice-geografo-P01",
      "factKey": "lagos-plitvice-F01",
      "text": "A paisagem combina relevo cárstico, florestas e prados numa área de cerca de 30 mil hectares.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P02",
      "factKey": "lagos-plitvice-F02",
      "text": "O bem foi inscrito pelos critérios de beleza natural, processos geológicos e processos ecológicos (vii, viii e ix).",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP2014",
       "PLITV_SOC2017"
      ],
      "clueType": "patrimonio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P03",
      "factKey": "lagos-plitvice-F03",
      "text": "O sistema de lagos resulta de milênios de processos geológicos e bioquímicos que criam represas naturais.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P04",
      "factKey": "lagos-plitvice-F04",
      "text": "O carbonato de cálcio dissolvido na água se deposita e forma as barreiras, que continuam em formação.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "PLITV_RP3",
       "PLITV_MISSAO2017"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P05",
      "factKey": "lagos-plitvice-F05",
      "text": "Musgos, algas e bactérias altamente especializados possibilitam e aceleram a sedimentação do calcário.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P06",
      "factKey": "lagos-plitvice-F31",
      "text": "Florestas bem conservadas mantêm a química da água de que depende a formação das barreiras.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P07",
      "factKey": "lagos-plitvice-F07",
      "text": "Os lagos superiores ficam sobre dolomito; os inferiores, em cânions de calcário.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "PLITV_RP3",
       "PLITV_WIKI"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P08",
      "factKey": "lagos-plitvice-F33",
      "text": "Do primeiro ao último lago, a água desce 133 metros.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_WIKI"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P09",
      "factKey": "lagos-plitvice-F34",
      "text": "A ampliação de 2000 levou o bem de 19.462 ha para cerca de 29.631 ha e incluiu toda a bacia e quase todo o sistema subterrâneo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_MISSAO2017",
       "PLITV_RP3"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P10",
      "factKey": "lagos-plitvice-F35",
      "text": "O bem não tem zona de amortecimento, e a missão de 2017 recomendou criar uma.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP2014",
       "PLITV_MISSAO2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P11",
      "factKey": "lagos-plitvice-F36",
      "text": "Em 2017, esgoto sem tratamento era lançado na rocha cárstica, porque não havia estação de tratamento.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_MISSAO2017"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P12",
      "factKey": "lagos-plitvice-F37",
      "text": "A retirada de água de um dos lagos chegou a 5% da vazão nos anos mais secos; um novo sistema de abastecimento deve acabar com ela.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "agua",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P13",
      "factKey": "lagos-plitvice-F38",
      "text": "Mudanças hidrológicas trazem níveis de água extremos, altos e baixos, com mais frequência.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P14",
      "factKey": "lagos-plitvice-F39",
      "text": "Peixes exóticos invasores são combatidos com manejo e monitoramento.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P15",
      "factKey": "lagos-plitvice-F40",
      "text": "Uma estrada que atravessa o parque recebe em média 4.217 veículos por dia.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP3"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P16",
      "factKey": "lagos-plitvice-F15",
      "text": "Com quase 1,5 milhão de visitantes por ano, a missão de 2017 concluiu que o sistema tinha chegado à capacidade de carga.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_MISSAO2017"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P17",
      "factKey": "lagos-plitvice-F42",
      "text": "As licenças para novas hospedagens saltaram depois do plano territorial de 2014, e a UNESCO pediu uma avaliação ambiental estratégica.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_MISSAO2017",
       "PLITV_SOC2017"
      ],
      "clueType": "urbanismo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P18",
      "factKey": "lagos-plitvice-F43",
      "text": "O abandono da pequena agricultura ameaça os prados, a biodiversidade e os saberes tradicionais.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_MISSAO2017"
      ],
      "clueType": "cultura",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P19",
      "factKey": "lagos-plitvice-F44",
      "text": "O parque se autofinancia: cerca de 98% dos recursos vinham dos ingressos, segundo o relatório de 2014.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "PLITV_RP2014",
       "PLITV_MISSAO2017"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "lagos-plitvice-geografo-P20",
      "factKey": "lagos-plitvice-F45",
      "text": "Até 6,5% da receita dos ingressos vai a cada ano para os municípios do entorno.",
      "relatedFields": [
