            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parque-monte-alegre-geografo-P20",
            "factKey": "norte-parque-monte-alegre-F20",
            "text": "A característica arenosa do solo condiciona o acesso, que exige veículos com tração.",
