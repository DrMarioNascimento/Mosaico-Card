            ],
            "sources": [
              "MONTEALEGRE_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parque-monte-alegre-geografo-P17",
            "factKey": "norte-parque-monte-alegre-F17",
            "text": "A Pedra do Cogumelo situa-se no flanco oeste da Serra da Paituna.",
