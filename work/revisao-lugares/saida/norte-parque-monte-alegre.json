            ],
            "sources": [
              "MONTEALEGRE_WIKI",
              "MONTEALEGRE_DIARIO"
            ],
            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parque-monte-alegre-geografo-P13",
            "factKey": "norte-parque-monte-alegre-F13",
            "text": "As serras do Ererê e da Paituna estruturam o relevo e concentram os sítios arqueológicos.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "MONTEALEGRE_WIKI",
              "MONTEALEGRE_LEI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parque-monte-alegre-geografo-P14",
            "factKey": "norte-parque-monte-alegre-F14",
            "text": "A Caverna da Pedra Pintada, no flanco leste da Serra da Paituna, tem 89 metros de profundidade.",
            "relatedFields": [
