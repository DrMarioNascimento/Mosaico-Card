            "clueType": "territorio",
            "signalStrength": "decisiva",
            "recommendedMoment": "late",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parque-monte-alegre-geografo-P15",
            "factKey": "norte-parque-monte-alegre-F15",
            "text": "A Gruta Itatupaoca, também chamada Gruta da Capela, fica na encosta sul da Serra do Ererê.",
            "relatedFields": [
              "C4"
            ],
            "sources": [
              "MONTEALEGRE_WIKI"
            ],
            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parque-monte-alegre-geografo-P16",
            "factKey": "norte-parque-monte-alegre-F16",
            "text": "Várias grutas se abrem dezenas de metros acima do nível do Amazonas, algumas a cerca de 120 metros.",
            "relatedFields": [
