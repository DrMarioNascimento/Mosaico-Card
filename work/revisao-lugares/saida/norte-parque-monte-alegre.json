            "clueType": "territorio",
            "signalStrength": "conexao",
            "recommendedMoment": "middle",
            "importance": "relevant",
            "twoPlayerSuitable": true
          },
          {
            "id": "norte-parque-monte-alegre-geografo-P19",
            "factKey": "norte-parque-monte-alegre-F19",
            "text": "A cobertura combina floresta densa, campos rupestres e afloramentos rochosos.",
