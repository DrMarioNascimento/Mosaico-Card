  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "geleira-beardmore-viajante-P01",
      "factKey": "geleira-beardmore-F01",
      "text": "Este destino é um rio de gelo que desce entre montanhas, no interior da Antártida.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P02",
      "factKey": "geleira-beardmore-F02",
      "text": "É uma das maiores geleiras de vale conhecidas no mundo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P03",
      "factKey": "geleira-beardmore-F03",
      "text": "Desce uns 2.200 m, do planalto polar até a grande plataforma de gelo lá embaixo.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P04",
      "factKey": "geleira-beardmore-F04",
      "text": "Na parte de baixo, ela encontra a Plataforma de Gelo Ross.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BEARD_BRIT",
       "BEARD_NZGAZ"
      ],
      "clueType": "localizacao",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P05",
      "factKey": "geleira-beardmore-F05",
      "text": "É mais estreita perto da foz e bem mais larga perto do planalto.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_NZGAZ"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P06",
      "factKey": "geleira-beardmore-F06",
      "text": "Dos dois lados ficam grupos de montanhas que homenageiam duas rainhas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT",
       "BEARD_AAJ"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P07",
      "factKey": "geleira-beardmore-F07",
      "text": "Foi descoberta em dezembro de 1908 por uma expedição britânica.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BEARD_NZGAZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P08",
      "factKey": "geleira-beardmore-F08",
      "text": "O nome homenageia um generoso patrocinador do líder dessa expedição.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BEARD_NZGAZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P09",
      "factKey": "geleira-beardmore-F09",
      "text": "Esse patrocinador mais tarde recebeu o título de Lord Invernairn.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BEARD_NZGAZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P10",
      "factKey": "geleira-beardmore-F10",
      "text": "Shackleton subiu por ela rumo ao Polo Sul, mas não chegou lá.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BEARD_BRIT",
       "BEARD_AAJ"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P11",
      "factKey": "geleira-beardmore-F11",
      "text": "Depois, a equipe de Scott também usou esse caminho para chegar ao Polo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT",
       "BEARD_AAJ",
       "BEARD_NZGAZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P12",
      "factKey": "geleira-beardmore-F12",
      "text": "Os cinco homens da equipe polar de Scott nunca voltaram dessa viagem.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_AAJ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P13",
      "factKey": "geleira-beardmore-F13",
      "text": "Na volta, em fevereiro de 1912, o grupo de Scott parou para recolher pedras perto de um monte.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BEARD_SCIAM",
       "BEARD_LINNEAN"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P14",
      "factKey": "geleira-beardmore-F14",
      "text": "Eles arrastaram uns 16 kg de rochas e fósseis, achados depois ao lado da barraca onde morreram.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BEARD_SCIAM",
       "BEARD_LINNEAN"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P15",
      "factKey": "geleira-beardmore-F15",
      "text": "Entre as pedras havia pedaços de carvão com marcas de folhas antigas.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BEARD_SCIAM",
       "BEARD_LINNEAN"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P16",
      "factKey": "geleira-beardmore-F16",
      "text": "Hoje essas amostras estão no Museu de História Natural de Londres.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BEARD_LINNEAN"
      ],
      "clueType": "patrimonio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P17",
      "factKey": "geleira-beardmore-F17",
      "text": "As folhas fósseis são de uma planta que se espalhava pelo antigo supercontinente do sul.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BEARD_LINNEAN"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P18",
      "factKey": "geleira-beardmore-F18",
      "text": "Esses fósseis ajudaram a mostrar que a Antártida já esteve ligada à Australásia.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BEARD_SCIAM"
      ],
      "clueType": "pesquisa",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P19",
      "factKey": "geleira-beardmore-F19",
      "text": "A geleira e as montanhas em volta guardam madeira petrificada.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P20",
      "factKey": "geleira-beardmore-F20",
      "text": "Ali também já apareceram fósseis de dinossauros.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P21",
      "factKey": "geleira-beardmore-F21",
      "text": "Esses fósseis mostram que a região já teve clima temperado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "clima",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P22",
      "factKey": "geleira-beardmore-F22",
      "text": "Scott anotou paredões de arenito que se desfaziam rápido com o tempo.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_LINNEAN"
      ],
      "clueType": "paisagem",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P23",
      "factKey": "geleira-beardmore-F23",
      "text": "Do outro lado da geleira, acharam folhas parecidas com as de faia, bem mais recentes.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BEARD_LINNEAN"
      ],
      "clueType": "biodiversidade",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P24",
      "factKey": "geleira-beardmore-F24",
      "text": "Tudo o que eles recolheram estava solto sobre o gelo, em montes de pedras trazidas pela geleira.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "BEARD_LINNEAN"
      ],
      "clueType": "processo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-viajante-P25",
      "factKey": "geleira-beardmore-F25",
      "text": "Foi por ela que Shackleton, em 1908, abriu caminho da Plataforma Ross até o planalto polar.",
      "relatedFields": [
       "C2",
       "C3"
      ],
      "sources": [
       "BEARD_NZGAZ",
       "BEARD_BRIT"
      ],
      "clueType": "historia",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "geleira-beardmore-geografo-P01",
      "factKey": "geleira-beardmore-F01",
      "text": "Geleira de vale de grande porte que desce do Planalto Polar Sul atravessando uma cordilheira.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "relevo",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P02",
      "factKey": "geleira-beardmore-F02",
      "text": "Figura entre as maiores geleiras de vale conhecidas do planeta.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "paisagem",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P03",
      "factKey": "geleira-beardmore-F03",
      "text": "O desnível de ~2.200 m vai do Planalto Polar Sul à Plataforma de Gelo Ross.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P04",
      "factKey": "geleira-beardmore-F05",
      "text": "A largura média é de ~19 km (12 milhas), de ~13 km perto da foz a ~40 km perto do planalto.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_NZGAZ"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P05",
      "factKey": "geleira-beardmore-F06",
      "text": "Separa as Montanhas Rainha Maud, a leste, da cordilheira Rainha Alexandra.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT",
       "BEARD_AAJ"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P06",
      "factKey": "geleira-beardmore-F26",
      "text": "Corta a grande cordilheira que atravessa o continente, entre dois de seus grupos de montanhas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_BRIT"
      ],
      "clueType": "relevo",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P07",
      "factKey": "geleira-beardmore-F07",
      "text": "Foi descoberta em dezembro de 1908 pela Expedição Antártica Britânica de 1907–09.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BEARD_NZGAZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P08",
      "factKey": "geleira-beardmore-F08",
      "text": "O nome, dado pelo líder da expedição, homenageia seu generoso patrono, mais tarde Lord Invernairn.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "BEARD_NZGAZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P09",
      "factKey": "geleira-beardmore-F11",
      "text": "Serviu de corredor natural até o planalto nas tentativas de Shackleton (1908) e de Scott (1911–1912) de chegar ao Polo Sul.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "BEARD_BRIT",
       "BEARD_AAJ",
       "BEARD_NZGAZ"
      ],
      "clueType": "historia",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "geleira-beardmore-geografo-P10",
      "factKey": "geleira-beardmore-F12",
      "text": "A tentativa de Shackleton fracassou; da viagem polar de Scott, os cinco homens não voltaram.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "BEARD_AAJ"
