  "profiles": {
   "viajante": {
    "label": "Viajante",
    "cards": [
     {
      "id": "joao-pessoa-viajante-P01",
      "factKey": "joao-pessoa-F01",
      "text": "É uma capital litorânea do Nordeste.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P02",
      "factKey": "joao-pessoa-F02",
      "text": "É uma das capitais mais antigas do Brasil.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P03",
      "factKey": "joao-pessoa-F03",
      "text": "Fica na Paraíba.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P04",
      "factKey": "joao-pessoa-F04",
      "text": "Foi fundada em 5 de agosto de 1585.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST",
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P05",
      "factKey": "joao-pessoa-F05",
      "text": "Nasceu num morro à beira de um pequeno rio chamado Sanhauá.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P06",
      "factKey": "joao-pessoa-F06",
      "text": "O primeiro nome homenageava Nossa Senhora das Neves, até hoje a padroeira.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST",
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P07",
      "factKey": "joao-pessoa-F07",
      "text": "Já se chamou Felipeia, em homenagem a um rei espanhol.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P08",
      "factKey": "joao-pessoa-F08",
      "text": "Os holandeses ocuparam a cidade em 1634 e lhe deram outro nome.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P09",
      "factKey": "joao-pessoa-F09",
      "text": "O nome atual, adotado em 1930, homenageia um presidente do estado que foi assassinado.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P10",
      "factKey": "joao-pessoa-F10",
      "text": "O centro antigo tem uma parte baixa, do comércio, e uma alta, do governo e das igrejas.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_AUCENTRO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P11",
      "factKey": "joao-pessoa-F11",
      "text": "O centro histórico foi tombado pelo Iphan em 2007.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_JPB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P12",
      "factKey": "joao-pessoa-F12",
      "text": "Igrejas barrocas, como a de São Francisco, ficam no centro histórico.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_AUCENTRO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P13",
      "factKey": "joao-pessoa-F13",
      "text": "Um antigo hotel construído em 1928 e 1929 virou centro cultural.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_AUGLOBO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P14",
      "factKey": "joao-pessoa-F14",
      "text": "Desse antigo hotel se vê o pôr do sol sobre o rio Sanhauá.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "JOAOPESSOA_AUGLOBO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P15",
      "factKey": "joao-pessoa-F15",
      "text": "Casarões coloridos em estilo art déco cercam a Praça Antenor Navarro.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_AUCENTRO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P16",
      "factKey": "joao-pessoa-F16",
      "text": "O antigo porto da cidade é chamado de Porto do Capim.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "JOAOPESSOA_AUGLOBO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P17",
      "factKey": "joao-pessoa-F17",
      "text": "Uma mata atlântica de cerca de 515 hectares fica dentro da área urbana.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P18",
      "factKey": "joao-pessoa-F18",
      "text": "Tambaú é a praia mais movimentada da cidade.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P19",
      "factKey": "joao-pessoa-F19",
      "text": "Cabo Branco e Manaíra também têm calçadões cheios de restaurantes.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P20",
      "factKey": "joao-pessoa-F20",
      "text": "Catamarãs levam a piscinas naturais formadas por corais no Seixas.",
      "relatedFields": [
       "C1",
       "C4"
      ],
      "sources": [
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P21",
      "factKey": "joao-pessoa-F21",
      "text": "Um farol em forma de torre triangular fica no alto de uma falésia.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P22",
      "factKey": "joao-pessoa-F22",
      "text": "Um centro cultural projetado por Oscar Niemeyer foi inaugurado em 2008.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "JOAOPESSOA_CB",
       "JOAOPESSOA_VITRUVIUS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P23",
      "factKey": "joao-pessoa-F23",
      "text": "Esse centro cultural fica sobre a falésia do Cabo Branco.",
      "relatedFields": [
       "C3"
      ],
      "sources": [
       "JOAOPESSOA_VITRUVIUS"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P24",
      "factKey": "joao-pessoa-F24",
      "text": "A Ponta do Seixas fica no fim da praia do Cabo Branco.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "JOAOPESSOA_CB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-viajante-P25",
      "factKey": "joao-pessoa-F25",
      "text": "A Ponta do Seixas é apontada como o ponto mais oriental das Américas.",
      "relatedFields": [
       "C4"
      ],
      "sources": [
       "JOAOPESSOA_CB",
       "JOAOPESSOA_VITRUVIUS"
      ],
      "clueType": "territorio",
      "signalStrength": "decisiva",
      "recommendedMoment": "late",
      "importance": "relevant",
      "twoPlayerSuitable": true
     }
    ]
   },
   "geografo": {
    "label": "Geógrafo",
    "cards": [
     {
      "id": "joao-pessoa-geografo-P01",
      "factKey": "joao-pessoa-F01",
      "text": "É uma capital litorânea cujo núcleo fundador se instalou num morro à beira de um rio.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P02",
      "factKey": "joao-pessoa-F02",
      "text": "O rio do núcleo original é um pequeno afluente do rio Paraíba.",
      "relatedFields": [
       "C2"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "abertura",
      "recommendedMoment": "early",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P03",
      "factKey": "joao-pessoa-F03",
      "text": "A fundação selou um pacto entre o capitão João Tavares e o chefe tabajara Piragibe.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P04",
      "factKey": "joao-pessoa-F04",
      "text": "Fortes na barra do rio Paraíba protegiam o acesso contra os franceses.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P05",
      "factKey": "joao-pessoa-F05",
      "text": "Quando os holandeses chegaram, em 1634, viviam ali cerca de 1.500 pessoas, com 18 engenhos ao redor.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P06",
      "factKey": "joao-pessoa-F06",
      "text": "A ocupação holandesa só terminou em 1654.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P07",
      "factKey": "joao-pessoa-F07",
      "text": "Os nomes da cidade seguiram o domínio político: Felipeia sob o rei espanhol, Frederikstadt sob os holandeses.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P08",
      "factKey": "joao-pessoa-F08",
      "text": "O nome atual data de 1930 e substituiu o de Paraíba do Norte.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_IBGEHIST"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P09",
      "factKey": "joao-pessoa-F09",
      "text": "O traçado colonial separava a ribeira comercial, embaixo, das funções administrativas e religiosas, no alto.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_AUCENTRO"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P10",
      "factKey": "joao-pessoa-F10",
      "text": "O perímetro tombado, de 37 hectares, vai do Varadouro, junto ao rio, ao entorno da rua Duque de Caxias.",
      "relatedFields": [
       "C1",
       "C2"
      ],
      "sources": [
       "JOAOPESSOA_AUCENTRO",
       "JOAOPESSOA_JPB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P11",
      "factKey": "joao-pessoa-F11",
      "text": "O tombamento federal foi aprovado em 6 de dezembro de 2007.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
       "JOAOPESSOA_JPB"
      ],
      "clueType": "territorio",
      "signalStrength": "conexao",
      "recommendedMoment": "middle",
      "importance": "relevant",
      "twoPlayerSuitable": true
     },
     {
      "id": "joao-pessoa-geografo-P12",
      "factKey": "joao-pessoa-F12",
      "text": "Obras de modernização no início do século XX deram ao centro sua forma urbana atual.",
      "relatedFields": [
       "C1"
      ],
      "sources": [
