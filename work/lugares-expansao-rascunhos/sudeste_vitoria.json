              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-geografo-P07",
              "factKey": "cidade-vitoria-F07",
              "text": "O sistema estuarino relaciona a drenagem fluvial às águas marinhas.",
