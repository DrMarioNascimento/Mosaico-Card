              ],
              "clueType": "territorio",
              "signalStrength": "abertura",
              "recommendedMoment": "early",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-geografo-P04",
              "factKey": "cidade-vitoria-F04",
              "text": "Seu território integra uma porção continental e ilhas, não apenas uma ilha.",
