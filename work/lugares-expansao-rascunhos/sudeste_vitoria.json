                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-geografo-P08",
              "factKey": "cidade-vitoria-F08",
              "text": "O estado no qual fica limita-se ao norte com a Bahia e ao sul com o Rio de Janeiro.",
