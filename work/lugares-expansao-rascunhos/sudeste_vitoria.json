              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-geografo-P03",
              "factKey": "cidade-vitoria-F03",
              "text": "Sua frente oriental está associada ao litoral atlântico.",
