                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-geografo-P05",
              "factKey": "cidade-vitoria-F05",
              "text": "A baía constitui elemento de articulação do sítio urbano costeiro.",
