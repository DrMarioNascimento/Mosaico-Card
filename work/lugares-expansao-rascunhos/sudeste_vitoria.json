      "profiles": {
        "viajante": {
          "label": "Viajante",
          "cards": [
            {
              "id": "cidade-vitoria-viajante-P01",
              "factKey": "cidade-vitoria-F01",
              "text": "É uma capital estadual brasileira.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "abertura",
              "recommendedMoment": "early",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P02",
              "factKey": "cidade-vitoria-F02",
              "text": "A cidade fica na região Sudeste.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "abertura",
              "recommendedMoment": "early",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P03",
              "factKey": "cidade-vitoria-F03",
              "text": "O mar está presente em sua paisagem.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "abertura",
              "recommendedMoment": "early",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P04",
              "factKey": "cidade-vitoria-F04",
              "text": "O município inclui ilhas e uma parte continental.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P05",
              "factKey": "cidade-vitoria-F05",
              "text": "Uma baía faz parte da paisagem urbana.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P06",
              "factKey": "cidade-vitoria-F06",
              "text": "Manguezais e praias também integram o cenário local.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P07",
              "factKey": "cidade-vitoria-F07",
              "text": "Um estuário recebe águas de rios e do mar.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P08",
              "factKey": "cidade-vitoria-F08",
              "text": "O estado do qual é capital fica entre a Bahia e o Rio de Janeiro.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P09",
              "factKey": "cidade-vitoria-F09",
              "text": "A cidade é capital do Espírito Santo.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P10",
              "factKey": "cidade-vitoria-F10",
              "text": "Ao norte, seu território encontra o município da Serra.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P11",
              "factKey": "cidade-vitoria-F11",
              "text": "Ao sul, faz divisa com Vila Velha.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P12",
              "factKey": "cidade-vitoria-F12",
              "text": "Cariacica é município vizinho a oeste.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P13",
              "factKey": "cidade-vitoria-F13",
              "text": "A fundação oficial da cidade é datada de 1551.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P14",
              "factKey": "cidade-vitoria-F14",
              "text": "O sítio foi ocupado por povos indígenas antes da colonização portuguesa.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P15",
              "factKey": "cidade-vitoria-F15",
              "text": "Seu antigo núcleo colonial cresceu em uma ilha.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P16",
              "factKey": "cidade-vitoria-F16",
              "text": "A ocupação urbana chegou também à área continental.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_URB"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P17",
              "factKey": "cidade-vitoria-F17",
              "text": "Nas áreas centrais existem igrejas, praças e escadarias antigas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P18",
              "factKey": "cidade-vitoria-F18",
              "text": "O centro histórico passou por aterros e abertura de vias.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_URB"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P19",
              "factKey": "cidade-vitoria-F19",
              "text": "Um edifício histórico chamado Palácio Anchieta abriga a sede do governo estadual.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_PALACIO"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P20",
              "factKey": "cidade-vitoria-F20",
              "text": "A Ponte da Passagem conecta a ilha à parte continental.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_PONTE"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P21",
              "factKey": "cidade-vitoria-F21",
              "text": "A ponte atual foi inaugurada em 2009.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SE_VITORIA_PONTE"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P22",
              "factKey": "cidade-vitoria-F22",
              "text": "Uma passarela para pedestres e ciclistas acompanha essa ponte.",
