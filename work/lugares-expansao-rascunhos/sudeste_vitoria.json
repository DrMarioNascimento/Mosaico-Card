                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-geografo-P09",
              "factKey": "cidade-vitoria-F09",
              "text": "A cidade sedia o governo do Espírito Santo.",
