                "C1"
              ],
              "sources": [
                "SE_VITORIA_MUN"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-geografo-P06",
              "factKey": "cidade-vitoria-F06",
              "text": "Manguezais, praias e encostas compõem o mosaico ambiental municipal.",
