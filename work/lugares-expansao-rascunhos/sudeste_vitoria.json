              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidade-vitoria-viajante-P24",
              "factKey": "cidade-vitoria-F24",
              "text": "O município tinha mais de 300 mil habitantes no Censo 2022 do IBGE.",
