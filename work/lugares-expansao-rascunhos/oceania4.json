                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P24",
              "factKey": "oceania-levuka-F24",
              "text": "A cidade histórica recebeu o título de Patrimônio Mundial em 2013.",
