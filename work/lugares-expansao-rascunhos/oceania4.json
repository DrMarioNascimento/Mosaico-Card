                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            }
          ]
        },
        "geografo": {
          "label": "Geógrafo",
          "cards": [
            {
              "id": "oceania-levuka-geografo-P01",
              "factKey": "oceania-levuka-F01",
              "text": "A paisagem urbana ilustra o desenvolvimento de um porto colonial insular do Pacífico.",
