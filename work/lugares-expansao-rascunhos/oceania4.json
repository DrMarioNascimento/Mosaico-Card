                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P02",
              "factKey": "oceania-levuka-F02",
              "text": "O sítio inscrito localiza-se no arquipélago de Fiji.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P03",
              "factKey": "oceania-levuka-F03",
              "text": "O núcleo protegido ocupa uma faixa costeira da ilha vulcânica de Ovalau.",
