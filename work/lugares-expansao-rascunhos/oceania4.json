                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P25",
              "factKey": "oceania-levuka-F25",
              "text": "A conservação protege ruas, edifícios e a paisagem das encostas.",
