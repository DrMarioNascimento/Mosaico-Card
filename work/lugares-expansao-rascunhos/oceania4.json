                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P06",
              "factKey": "oceania-levuka-F06",
              "text": "O casario litorâneo apresenta escala predominantemente baixa e acompanha a orla.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P07",
              "factKey": "oceania-levuka-F07",
              "text": "A partir dos anos 1820, comerciantes e colonizadores desenvolveram ali atividades portuárias.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P08",
              "factKey": "oceania-levuka-F08",
              "text": "Redes comerciais americanas e europeias instalaram depósitos e atividades ligadas ao porto.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P09",
              "factKey": "oceania-levuka-F09",
              "text": "O núcleo portuário tornou-se a primeira sede da administração colonial de Fiji.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P10",
              "factKey": "oceania-levuka-F10",
              "text": "Em 1874 Fiji foi cedido à Grã-Bretanha, marco da formação colonial vinculada ao lugar.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P11",
              "factKey": "oceania-levuka-F11",
              "text": "A transferência da capital para Suva em 1882 não interrompeu o desenvolvimento local.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P12",
              "factKey": "oceania-levuka-F12",
              "text": "Beach Street estrutura o eixo de ocupação paralelo à linha costeira.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P13",
              "factKey": "oceania-levuka-F13",
              "text": "Uma estrutura longitudinal de pedra e concreto separa a via principal do mar.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "LEVUKA_UNESCO"
