                "C2"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P04",
              "factKey": "oceania-levuka-F04",
              "text": "As encostas de um vulcão extinto delimitam o assentamento em direção ao interior.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-geografo-P05",
              "factKey": "oceania-levuka-F05",
              "text": "O ambiente costeiro é descrito pela UNESCO com coqueiros e mangueiras.",
