                "C4"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P14",
              "factKey": "oceania-levuka-F14",
              "text": "Outras ruas partem da orla rumo ao interior.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P15",
              "factKey": "oceania-levuka-F15",
              "text": "Antigas aldeias indígenas existiam na área que hoje integra a cidade.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P16",
              "factKey": "oceania-levuka-F16",
              "text": "A população indígena superava em número os colonos europeus.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P17",
              "factKey": "oceania-levuka-F17",
              "text": "Armazéns de copra faziam parte do porto.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P18",
              "factKey": "oceania-levuka-F18",
              "text": "Casas, igrejas e escolas surgiram perto das aldeias.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P19",
              "factKey": "oceania-levuka-F19",
              "text": "Muitos edifícios históricos usam madeira e revestimento de chapa ondulada.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P20",
              "factKey": "oceania-levuka-F20",
              "text": "Várias edificações têm apenas um ou dois pavimentos.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P21",
              "factKey": "oceania-levuka-F21",
              "text": "Há uma catedral e uma casa paroquial históricas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P22",
              "factKey": "oceania-levuka-F22",
              "text": "Um hotel histórico foi fundado no fim da década de 1860.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P23",
              "factKey": "oceania-levuka-F23",
              "text": "Há vestígios de trilhos associados ao antigo cais.",
