            },
            {
              "id": "oceania-levuka-viajante-P02",
              "factKey": "oceania-levuka-F02",
              "text": "A cidade fica no país de Fiji.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P03",
              "factKey": "oceania-levuka-F03",
              "text": "O município histórico se encontra na ilha de Ovalau.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P04",
              "factKey": "oceania-levuka-F04",
              "text": "Atrás da cidade há encostas cobertas por floresta.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P05",
              "factKey": "oceania-levuka-F05",
              "text": "Coqueiros e mangueiras aparecem ao longo da praia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P06",
              "factKey": "oceania-levuka-F06",
              "text": "As construções históricas formam uma linha baixa perto da praia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P07",
              "factKey": "oceania-levuka-F07",
              "text": "O porto tornou-se centro de comércio a partir da década de 1820.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P08",
              "factKey": "oceania-levuka-F08",
              "text": "Americanos e europeus construíram armazéns e estabelecimentos comerciais.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P09",
              "factKey": "oceania-levuka-F09",
              "text": "A cidade foi a primeira capital colonial de Fiji.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P10",
              "factKey": "oceania-levuka-F10",
              "text": "A cessão de Fiji à Grã-Bretanha ocorreu em 1874.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P11",
              "factKey": "oceania-levuka-F11",
              "text": "Em 1882 a capital foi transferida para Suva.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P12",
              "factKey": "oceania-levuka-F12",
              "text": "Uma via chamada Beach Street acompanha a frente marítima.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "LEVUKA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-levuka-viajante-P13",
              "factKey": "oceania-levuka-F13",
              "text": "Um paredão de pedra e concreto acompanha a rua da praia.",
