              "sources": [
                "MONTEALEGRE_MPEG"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P07",
              "factKey": "norte-parque-monte-alegre-F07",
              "text": "Há pinturas feitas em rochas.",
