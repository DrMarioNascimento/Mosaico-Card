              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P16",
              "factKey": "norte-parque-monte-alegre-F16",
              "text": "A entrada dessa gruta é dividida por uma parte de rocha.",
