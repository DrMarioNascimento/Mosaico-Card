                "C4"
              ],
              "sources": [
                "MONTEALEGRE_IDE"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P05",
              "factKey": "norte-parque-monte-alegre-F05",
              "text": "A área também tem cavernas e grutas.",
