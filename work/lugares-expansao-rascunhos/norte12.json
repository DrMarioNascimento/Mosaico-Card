              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P17",
              "factKey": "norte-parque-monte-alegre-F17",
              "text": "Uma formação de pedra lembra o formato de um cogumelo.",
