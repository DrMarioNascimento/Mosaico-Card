                "C2"
              ],
              "sources": [
                "MONTEALEGRE_MPEG"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P12",
              "factKey": "norte-parque-monte-alegre-F12",
              "text": "Uma das serras tem um sítio com nome ligado à Lua.",
