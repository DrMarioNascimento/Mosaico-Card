              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P13",
              "factKey": "norte-parque-monte-alegre-F13",
              "text": "A Serra do Ererê abriga parte dos sítios.",
