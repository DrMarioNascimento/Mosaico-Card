                "C2"
              ],
              "sources": [
                "MONTEALEGRE_IDE"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P08",
              "factKey": "norte-parque-monte-alegre-F08",
              "text": "Algumas pinturas estão em paredões abertos.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "MONTEALEGRE_IDE"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P09",
              "factKey": "norte-parque-monte-alegre-F09",
              "text": "Outros desenhos aparecem em cavernas e abrigos.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "MONTEALEGRE_MPEG"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P10",
              "factKey": "norte-parque-monte-alegre-F10",
              "text": "Pesquisadores estudam marcas com milhares de anos.",
