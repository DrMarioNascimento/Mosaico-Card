              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P21",
              "factKey": "norte-parque-monte-alegre-F21",
              "text": "O parque foi criado por lei estadual em 2001.",
