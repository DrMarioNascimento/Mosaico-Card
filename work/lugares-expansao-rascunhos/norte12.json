              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P15",
              "factKey": "norte-parque-monte-alegre-F15",
              "text": "Outra gruta recebe o nome de Itatupaoca.",
