              "sources": [
                "MONTEALEGRE_MPEG"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P11",
              "factKey": "norte-parque-monte-alegre-F11",
              "text": "Alguns vestígios humanos da área têm mais de 12 mil anos, segundo pesquisadores.",
