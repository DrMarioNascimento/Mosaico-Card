                "C4"
              ],
              "sources": [
                "MONTEALEGRE_IDE"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parque-monte-alegre-viajante-P06",
              "factKey": "norte-parque-monte-alegre-F06",
              "text": "O parque reúne vestígios de ocupações humanas antigas.",
