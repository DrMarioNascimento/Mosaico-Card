      "profiles": {
        "viajante": {
          "label": "Viajante",
          "cards": [
            {
              "id": "norte-parna-araguaia-viajante-P01",
              "factKey": "norte-parna-araguaia-F01",
              "text": "Este parque conserva uma grande área úmida no interior do Brasil.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P02",
              "factKey": "norte-parna-araguaia-F02",
              "text": "A água muda a paisagem em diferentes épocas do ano.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P03",
              "factKey": "norte-parna-araguaia-F03",
              "text": "Rios alagam partes da área durante as cheias.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P04",
              "factKey": "norte-parna-araguaia-F04",
              "text": "Na época seca, surgem praias fluviais.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P05",
              "factKey": "norte-parna-araguaia-F05",
              "text": "O parque fica em uma ilha formada por braços de rio.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "ARAGUAIA_MUSEU"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P06",
              "factKey": "norte-parna-araguaia-F06",
              "text": "Essa ilha se chama Ilha do Bananal.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "ARAGUAIA_MUSEU"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P07",
              "factKey": "norte-parna-araguaia-F07",
              "text": "A ilha é banhada pelo rio Araguaia e pelo Javaés.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P08",
              "factKey": "norte-parna-araguaia-F08",
              "text": "O Javaés fica no lado leste da ilha.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P09",
              "factKey": "norte-parna-araguaia-F09",
              "text": "A parte da ilha onde fica o parque pertence ao Tocantins.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P10",
              "factKey": "norte-parna-araguaia-F10",
              "text": "O parque nacional foi criado em 1959.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P11",
              "factKey": "norte-parna-araguaia-F11",
              "text": "A área recebeu reconhecimento internacional por suas zonas úmidas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P12",
              "factKey": "norte-parna-araguaia-F12",
              "text": "O reconhecimento como sítio Ramsar ocorreu em 1993.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P13",
              "factKey": "norte-parna-araguaia-F13",
              "text": "O parque reúne paisagens de Cerrado e Amazônia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P14",
              "factKey": "norte-parna-araguaia-F14",
              "text": "Também há características de ambientes de planície inundável.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P15",
              "factKey": "norte-parna-araguaia-F15",
              "text": "Vários lagos fazem parte da paisagem.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P16",
              "factKey": "norte-parna-araguaia-F16",
              "text": "Alguns lagos têm vegetação em suas margens.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P17",
              "factKey": "norte-parna-araguaia-F17",
              "text": "Há ilhas de mata chamadas ipucas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P18",
              "factKey": "norte-parna-araguaia-F18",
              "text": "As ipucas acumulam água no começo da estação chuvosa.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P19",
              "factKey": "norte-parna-araguaia-F19",
              "text": "A conservação também envolve espécies de peixes.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P20",
              "factKey": "norte-parna-araguaia-F20",
              "text": "O pirarucu é uma das espécies consideradas no planejamento da área.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P21",
              "factKey": "norte-parna-araguaia-F21",
              "text": "A área guarda locais importantes para povos indígenas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MUSEU"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P22",
              "factKey": "norte-parna-araguaia-F22",
              "text": "Entre os povos relacionados ao território estão Javaé e Karajá.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MUSEU"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P23",
              "factKey": "norte-parna-araguaia-F23",
              "text": "A Terra Indígena Inãwébohona se sobrepõe a parte do parque.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MUSEU",
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P24",
              "factKey": "norte-parna-araguaia-F24",
              "text": "A conservação inclui respeitar modos de vida e práticas culturais locais.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-viajante-P25",
              "factKey": "norte-parna-araguaia-F25",
              "text": "O documento de conservação destaca a ligação entre rios e lagos.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            }
          ]
        },
        "geografo": {
          "label": "Geógrafo",
          "cards": [
            {
              "id": "norte-parna-araguaia-geografo-P01",
              "factKey": "norte-parna-araguaia-F01",
              "text": "O sítio integra uma extensa planície úmida no interior do território brasileiro.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P02",
              "factKey": "norte-parna-araguaia-F02",
              "text": "O pulso sazonal de inundação transforma a conexão entre ambientes da planície.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P03",
              "factKey": "norte-parna-araguaia-F03",
              "text": "As cheias fluviais inundam periodicamente trechos da unidade de conservação.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P04",
              "factKey": "norte-parna-araguaia-F04",
              "text": "A vazante expõe praias fluviais onde antes havia água.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P05",
              "factKey": "norte-parna-araguaia-F05",
              "text": "A bifurcação e o reencontro de braços fluviais formam a ilha que abriga a unidade.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "ARAGUAIA_MUSEU"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P06",
              "factKey": "norte-parna-araguaia-F06",
              "text": "A Ilha do Bananal abriga tanto a unidade quanto terras indígenas.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "ARAGUAIA_MUSEU"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P07",
              "factKey": "norte-parna-araguaia-F07",
              "text": "O braço principal do Araguaia e o rio Javaés definem setores da ilha fluvial.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P08",
              "factKey": "norte-parna-araguaia-F08",
              "text": "O Javaés acompanha o setor oriental da ilha, enquanto o braço maior fica a oeste.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P09",
              "factKey": "norte-parna-araguaia-F09",
              "text": "A unidade integra os municípios de Pium e Lagoa da Confusão, no Tocantins.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-parna-araguaia-geografo-P10",
              "factKey": "norte-parna-araguaia-F10",
              "text": "A unidade foi instituída por decreto federal em 31 de dezembro de 1959.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ARAGUAIA_MMA"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
