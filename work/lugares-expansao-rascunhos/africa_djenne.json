                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P14",
              "factKey": "cidades-antigas-djenne-F14",
              "text": "Escavações revelaram vestígios muito antigos.",
