              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-geografo-P02",
              "factKey": "cidades-antigas-djenne-F02",
              "text": "O conjunto protegido situa-se no território malinês.",
