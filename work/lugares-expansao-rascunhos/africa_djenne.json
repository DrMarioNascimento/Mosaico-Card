                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-geografo-P06",
              "factKey": "cidades-antigas-djenne-F06",
              "text": "A Grande Mesquita é um marco religioso e arquitetônico do conjunto urbano.",
