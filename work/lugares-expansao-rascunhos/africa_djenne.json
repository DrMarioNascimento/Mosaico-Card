              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P04",
              "factKey": "cidades-antigas-djenne-F04",
              "text": "A região está ligada ao delta interior do rio Níger.",
