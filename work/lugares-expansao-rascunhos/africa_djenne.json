              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P16",
              "factKey": "cidades-antigas-djenne-F16",
              "text": "Foram encontrados restos de moradias antigas.",
