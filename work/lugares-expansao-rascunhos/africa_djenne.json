                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-geografo-P10",
              "factKey": "cidades-antigas-djenne-F10",
              "text": "Contrafortes e pilastras marcam fachadas de casas históricas.",
