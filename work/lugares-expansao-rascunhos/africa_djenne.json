                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P09",
              "factKey": "cidades-antigas-djenne-F09",
              "text": "Muitas casas históricas têm fachadas altas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P10",
              "factKey": "cidades-antigas-djenne-F10",
              "text": "Algumas fachadas têm estruturas de apoio salientes.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P11",
              "factKey": "cidades-antigas-djenne-F11",
              "text": "Há casas históricas de dois andares.",
