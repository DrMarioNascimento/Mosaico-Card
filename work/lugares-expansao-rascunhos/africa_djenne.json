                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-geografo-P12",
              "factKey": "cidades-antigas-djenne-F12",
              "text": "As entradas e seus elementos decorativos participam da composição das fachadas.",
