              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P05",
              "factKey": "cidades-antigas-djenne-F05",
              "text": "O bem inclui a cidade histórica e quatro sítios arqueológicos.",
