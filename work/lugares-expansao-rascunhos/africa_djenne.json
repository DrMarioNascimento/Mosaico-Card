                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P07",
              "factKey": "cidades-antigas-djenne-F07",
              "text": "As construções tradicionais usam terra.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P08",
              "factKey": "cidades-antigas-djenne-F08",
              "text": "A grande mesquita foi reconstruída entre 1906 e 1907.",
