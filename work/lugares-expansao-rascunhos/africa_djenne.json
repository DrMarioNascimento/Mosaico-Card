              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P15",
              "factKey": "cidades-antigas-djenne-F15",
              "text": "Alguns vestígios remontam ao século III antes da era comum.",
