        "geografo": {
          "label": "Geógrafo",
          "cards": [
            {
              "id": "cidades-antigas-djenne-geografo-P01",
              "factKey": "cidades-antigas-djenne-F01",
              "text": "A carta representa um bem cultural seriado com centro urbano e sítios arqueológicos africanos.",
