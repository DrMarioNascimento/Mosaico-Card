              "sources": [
                "DJENNE_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "cidades-antigas-djenne-viajante-P06",
              "factKey": "cidades-antigas-djenne-F06",
              "text": "Um dos pontos conhecidos é uma grande mesquita.",
