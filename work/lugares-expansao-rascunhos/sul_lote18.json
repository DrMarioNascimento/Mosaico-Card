              "sources": [
                "TRFURNAS"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "torres-rs-viajante-P07",
              "factKey": "torres-rs-viajante-F07",
              "text": "A Torre do Meio fica entre o Morro do Farol e a Torre Sul.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "TRFURNAS"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "torres-rs-viajante-P08",
              "factKey": "torres-rs-viajante-F08",
              "text": "Suas falésias têm paredões de basalto.",
