      "profiles": {
        "viajante": {
          "label": "Viajante",
          "cards": [
            {
              "id": "torres-rs-viajante-P01",
              "factKey": "torres-rs-viajante-F01",
              "text": "É uma cidade litorânea no Sul do Brasil.",
