                "C1"
              ],
              "sources": [
                "TRPARQUE"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "torres-rs-viajante-P06",
              "factKey": "torres-rs-viajante-F06",
              "text": "O Morro das Furnas também é chamado Torre do Meio.",
