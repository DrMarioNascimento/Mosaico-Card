                "C1"
              ],
              "sources": [
                "TRVIS"
              ],
              "clueType": "territorio",
              "signalStrength": "abertura",
              "recommendedMoment": "early",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "torres-rs-viajante-P04",
              "factKey": "torres-rs-viajante-F04",
              "text": "A praia da Guarita é um de seus atrativos.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "TRPARQUE"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "torres-rs-viajante-P05",
              "factKey": "torres-rs-viajante-F05",
              "text": "O Parque da Guarita tem falésias junto ao mar.",
