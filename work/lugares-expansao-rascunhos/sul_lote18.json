              ],
              "clueType": "territorio",
              "signalStrength": "abertura",
              "recommendedMoment": "early",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "torres-rs-viajante-P03",
              "factKey": "torres-rs-viajante-F03",
              "text": "O rio Mampituba marca a divisa com Santa Catarina.",
