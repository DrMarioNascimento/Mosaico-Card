              "sources": [
                "TRFURNAS"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "torres-rs-viajante-P10",
              "factKey": "torres-rs-viajante-F10",
              "text": "A Ilha dos Lobos fica no mar em frente à cidade.",
