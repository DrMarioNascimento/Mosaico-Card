              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "torres-rs-viajante-P09",
              "factKey": "torres-rs-viajante-F09",
              "text": "O mar e as chuvas esculpem essas formações.",
