      "profiles": {
        "viajante": {
          "label": "Viajante",
          "cards": [
            {
              "id": "oceania-rennell-oriental-viajante-P01",
              "factKey": "oceania-rennell-oriental-F01",
              "text": "Este destino protegido fica em uma ilha do Pacífico.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P02",
              "factKey": "oceania-rennell-oriental-F02",
              "text": "O território pertence a um país formado por muitas ilhas.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P03",
              "factKey": "oceania-rennell-oriental-F03",
              "text": "O país é conhecido como Ilhas Salomão.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P04",
              "factKey": "oceania-rennell-oriental-F04",
              "text": "A área protegida ocupa apenas parte de uma ilha maior.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P05",
              "factKey": "oceania-rennell-oriental-F05",
              "text": "A ilha se formou a partir de um antigo atol.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P06",
              "factKey": "oceania-rennell-oriental-F06",
              "text": "A antiga formação tinha uma lagoa central.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P07",
              "factKey": "oceania-rennell-oriental-F07",
              "text": "Depois da elevação, a antiga lagoa tornou-se um lago.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P08",
              "factKey": "oceania-rennell-oriental-F08",
              "text": "Um grande lago faz parte da área protegida.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P09",
              "factKey": "oceania-rennell-oriental-F09",
              "text": "O nome desse lago é Tegano.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P10",
              "factKey": "oceania-rennell-oriental-F10",
              "text": "A água do lago é salobra.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P11",
              "factKey": "oceania-rennell-oriental-F11",
              "text": "Pequenas ilhas rochosas aparecem dentro do lago.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P12",
              "factKey": "oceania-rennell-oriental-F12",
              "text": "As rochas calcárias também aparecem na paisagem ao redor.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P13",
              "factKey": "oceania-rennell-oriental-F13",
              "text": "Grande parte da ilha é coberta por floresta densa.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P14",
              "factKey": "oceania-rennell-oriental-F14",
              "text": "O lugar tem espécies que vivem naturalmente apenas nessa região.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P15",
              "factKey": "oceania-rennell-oriental-F15",
              "text": "Há aves terrestres e aquáticas próprias da região.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P16",
              "factKey": "oceania-rennell-oriental-F16",
              "text": "Morcegos também fazem parte da fauna.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P17",
              "factKey": "oceania-rennell-oriental-F17",
              "text": "Alguns caracóis terrestres são exclusivos da região.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P18",
              "factKey": "oceania-rennell-oriental-F18",
              "text": "Uma serpente marinha endêmica vive no lago.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P19",
              "factKey": "oceania-rennell-oriental-F19",
              "text": "O sítio também inclui uma área marinha.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P20",
              "factKey": "oceania-rennell-oriental-F20",
              "text": "Ciclones podem afetar a ilha e seus habitantes.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P21",
              "factKey": "oceania-rennell-oriental-F21",
              "text": "Comunidades vivem dentro dos limites do sítio.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P22",
              "factKey": "oceania-rennell-oriental-F22",
              "text": "A vida local inclui cultivo, pesca e caça.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P23",
              "factKey": "oceania-rennell-oriental-F23",
              "text": "A terra é administrada segundo práticas tradicionais.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P24",
              "factKey": "oceania-rennell-oriental-F24",
              "text": "O lugar foi reconhecido como Patrimônio Mundial em 1998.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-viajante-P25",
              "factKey": "oceania-rennell-oriental-F25",
              "text": "A conservação depende também da participação das comunidades.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            }
          ]
        },
        "geografo": {
          "label": "Geógrafo",
          "cards": [
            {
              "id": "oceania-rennell-oriental-geografo-P01",
              "factKey": "oceania-rennell-oriental-F01",
              "text": "O bem natural ocupa parte de uma ilha no Pacífico ocidental.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P02",
              "factKey": "oceania-rennell-oriental-F02",
              "text": "A unidade faz parte de um país arquipelágico da Oceania.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P03",
              "factKey": "oceania-rennell-oriental-F03",
              "text": "O país soberano associado ao sítio é Ilhas Salomão.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P04",
              "factKey": "oceania-rennell-oriental-F04",
              "text": "A delimitação reconhecida cobre aproximadamente o terço sul da ilha.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P05",
              "factKey": "oceania-rennell-oriental-F05",
              "text": "A ilha constitui um atol coralíneo elevado acima do nível do mar.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P06",
              "factKey": "oceania-rennell-oriental-F06",
              "text": "O antigo atol incluía uma laguna cercada por formações coralíneas.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P07",
              "factKey": "oceania-rennell-oriental-F07",
              "text": "A elevação do atol transformou sua antiga laguna no lago atual.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P08",
              "factKey": "oceania-rennell-oriental-F08",
              "text": "O bem inclui um lago insular e florestas que o cercam.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P09",
              "factKey": "oceania-rennell-oriental-F09",
              "text": "O Lago Tegano ocupa a antiga laguna do atol elevado.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "decisiva",
              "recommendedMoment": "late",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P10",
              "factKey": "oceania-rennell-oriental-F10",
              "text": "A salinidade intermediária caracteriza as águas do lago.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P11",
              "factKey": "oceania-rennell-oriental-F11",
              "text": "O lago abriga ilhotas calcárias de relevo irregular.",
              "relatedFields": [
                "C2"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-rennell-oriental-geografo-P12",
              "factKey": "oceania-rennell-oriental-F12",
              "text": "O relevo cárstico calcário envolve o lago e sustenta cobertura florestal.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "RENNELL_UNESCO"
              ],
              "clueType": "territorio",
