                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P20",
              "factKey": "rio-tocantins-F20",
              "text": "O saneamento é uma das questões de gestão da bacia.",
