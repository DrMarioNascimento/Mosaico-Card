              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P23",
              "factKey": "rio-tocantins-F23",
              "text": "Os níveis do rio variam ao longo do ano.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P24",
              "factKey": "rio-tocantins-F24",
              "text": "Seu curso é acompanhado por órgãos de gestão de recursos hídricos.",
