                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P25",
              "factKey": "rio-tocantins-F25",
              "text": "É um rio compartilhado entre diferentes estados brasileiros.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
