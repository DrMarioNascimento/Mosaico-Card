                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P21",
              "factKey": "rio-tocantins-F21",
              "text": "A navegação é outro tema de gestão das águas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P22",
              "factKey": "rio-tocantins-F22",
              "text": "Há praias fluviais frequentadas para turismo na região.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
