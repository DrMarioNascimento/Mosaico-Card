            },
            {
              "id": "rio-tocantins-viajante-P02",
              "factKey": "rio-tocantins-F02",
              "text": "Sua nascente fica em Goiás.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P03",
              "factKey": "rio-tocantins-F03",
              "text": "O curso segue em direção ao norte do Brasil.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P04",
              "factKey": "rio-tocantins-F04",
              "text": "Seu percurso é totalmente brasileiro.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P05",
              "factKey": "rio-tocantins-F05",
              "text": "Deságua no Pará, próximo da capital estadual.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P06",
              "factKey": "rio-tocantins-F06",
              "text": "Recebe as águas de um grande rio chamado Araguaia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P07",
              "factKey": "rio-tocantins-F07",
              "text": "Os dois rios dão nome a uma região hidrográfica.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P08",
              "factKey": "rio-tocantins-F08",
              "text": "Há grandes usinas hidrelétricas ao longo de seu curso.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P09",
              "factKey": "rio-tocantins-F09",
              "text": "Uma dessas usinas é Tucuruí.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P10",
              "factKey": "rio-tocantins-F10",
              "text": "Outra é chamada Serra da Mesa.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P11",
              "factKey": "rio-tocantins-F11",
              "text": "A usina de Lajeado também está em seu curso.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P12",
              "factKey": "rio-tocantins-F12",
              "text": "A usina de Estreito aproveita suas águas.",
