                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P13",
              "factKey": "rio-tocantins-F13",
              "text": "Peixe Angical é outra usina associada ao rio.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P14",
              "factKey": "rio-tocantins-F14",
              "text": "Há trechos usados para navegação.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P15",
              "factKey": "rio-tocantins-F15",
              "text": "Uma eclusa auxilia embarcações a transpor uma barragem.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P16",
              "factKey": "rio-tocantins-F16",
              "text": "No período seco, certas passagens fluviais ficam mais difíceis para embarcações grandes.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P17",
              "factKey": "rio-tocantins-F17",
              "text": "A bacia inclui áreas de Cerrado.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P18",
              "factKey": "rio-tocantins-F18",
              "text": "A região hidrográfica também abrange áreas amazônicas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "CENTRO_RTO_ANA",
                "CENTRO_RTO_ANA_REG",
                "CENTRO_RTO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-tocantins-viajante-P19",
              "factKey": "rio-tocantins-F19",
              "text": "A irrigação é um dos usos da água na região.",
