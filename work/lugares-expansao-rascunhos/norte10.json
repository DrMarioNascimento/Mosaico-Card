              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-rds-mamiraua-viajante-P09",
              "factKey": "norte-rds-mamiraua-F09",
              "text": "O rio Japurá também está ligado à região.",
