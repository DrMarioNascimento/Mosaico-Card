              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-rds-mamiraua-viajante-P11",
              "factKey": "norte-rds-mamiraua-F11",
              "text": "Fonte Boa também é um dos municípios abrangidos.",
