      "profiles": {
        "viajante": {
          "label": "Viajante",
          "cards": [
            {
              "id": "rio-sao-francisco-viajante-P01",
              "factKey": "rio-sao-francisco-F01",
              "text": "Este destino é um rio brasileiro.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
