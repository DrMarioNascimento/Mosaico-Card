              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P02",
              "factKey": "rio-sao-francisco-F02",
              "text": "Sua nascente histórica fica em Minas Gerais.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P03",
              "factKey": "rio-sao-francisco-F03",
              "text": "A nascente histórica fica na Serra da Canastra.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P04",
              "factKey": "rio-sao-francisco-F04",
              "text": "O rio chega ao oceano Atlântico.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P05",
              "factKey": "rio-sao-francisco-F05",
              "text": "A foz fica entre Alagoas e Sergipe.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P06",
              "factKey": "rio-sao-francisco-F06",
              "text": "O curso principal passa por Minas Gerais e Bahia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P07",
              "factKey": "rio-sao-francisco-F07",
              "text": "Ele também banha Pernambuco, Alagoas e Sergipe.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P08",
              "factKey": "rio-sao-francisco-F08",
              "text": "O rio liga paisagens do Sudeste e do Nordeste.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P09",
              "factKey": "rio-sao-francisco-F09",
              "text": "Sua bacia alcança terras de Goiás.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P10",
              "factKey": "rio-sao-francisco-F10",
              "text": "A bacia também alcança parte do Distrito Federal.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P11",
              "factKey": "rio-sao-francisco-F11",
              "text": "Em 2020, cerca de 20,3 milhões de pessoas viviam na bacia desse rio, segundo Codevasf e IBGE.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P12",
              "factKey": "rio-sao-francisco-F12",
              "text": "O Rio Paracatu é um de seus afluentes.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
