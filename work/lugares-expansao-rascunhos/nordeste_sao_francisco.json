              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P13",
              "factKey": "rio-sao-francisco-F13",
              "text": "O Rio das Velhas também é um afluente.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P14",
              "factKey": "rio-sao-francisco-F14",
              "text": "O Rio Urucuia é outro afluente.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P15",
              "factKey": "rio-sao-francisco-F15",
              "text": "A chuva varia bastante ao longo da bacia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P16",
              "factKey": "rio-sao-francisco-F16",
              "text": "A região das nascentes recebe mais chuva que partes do semiárido.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P17",
              "factKey": "rio-sao-francisco-F17",
              "text": "Parte de sua bacia fica no Cerrado.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P18",
              "factKey": "rio-sao-francisco-F18",
              "text": "O curso é dividido em quatro trechos.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P19",
              "factKey": "rio-sao-francisco-F19",
              "text": "O trecho alto vai das cabeceiras até Pirapora.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P20",
              "factKey": "rio-sao-francisco-F20",
              "text": "O trecho médio vai de Pirapora até Remanso.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P21",
              "factKey": "rio-sao-francisco-F21",
              "text": "O trecho submédio vai até Paulo Afonso.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P22",
              "factKey": "rio-sao-francisco-F22",
              "text": "O trecho baixo segue de Paulo Afonso até a foz.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P23",
              "factKey": "rio-sao-francisco-F23",
              "text": "Em alguns trechos o rio permite a navegação.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P24",
              "factKey": "rio-sao-francisco-F24",
              "text": "Petrolina e Juazeiro ficam em margens ligadas ao rio.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "rio-sao-francisco-viajante-P25",
              "factKey": "rio-sao-francisco-F25",
              "text": "O rio faz parte da divisa entre Bahia e Pernambuco.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "SFRANCISCO_CODEVASF",
                "SFRANCISCO_MIDR",
                "SFRANCISCO_DNIT"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
