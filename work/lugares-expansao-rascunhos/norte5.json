              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-palmas-viajante-P06",
              "factKey": "norte-palmas-F06",
              "text": "Antes da nova capital, o governo estadual ficou provisoriamente em outra cidade.",
