                "PALMAS_MTUR"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-palmas-viajante-P07",
              "factKey": "norte-palmas-F07",
              "text": "O estado é o Tocantins.",
              "relatedFields": [
                "C3"
              ],
              "sources": [
                "PALMAS_MTUR"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-palmas-viajante-P08",
              "factKey": "norte-palmas-F08",
              "text": "A instalação da capital aconteceu em 1990.",
