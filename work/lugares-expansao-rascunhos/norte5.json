              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-palmas-viajante-P05",
              "factKey": "norte-palmas-F05",
              "text": "O estado que abriga a capital foi criado em 1988.",
