              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-palmas-viajante-P04",
              "factKey": "norte-palmas-F04",
              "text": "A pedra fundamental da cidade foi lançada em 1989.",
