              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "norte-palmas-viajante-P10",
              "factKey": "norte-palmas-F10",
              "text": "Um grande rio faz parte da paisagem da região.",
