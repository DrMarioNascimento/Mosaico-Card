              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P06",
              "factKey": "atol-rocas-F06",
              "text": "A forma do conjunto recifal corresponde a um atol oceânico.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P07",
              "factKey": "atol-rocas-F07",
              "text": "A formação recifal apresenta contorno aproximadamente elíptico.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P08",
              "factKey": "atol-rocas-F08",
              "text": "O recife elíptico inclui duas pequenas ilhas dentro da área marinha protegida.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P09",
              "factKey": "atol-rocas-F09",
              "text": "A unidade situa-se a aproximadamente 150 quilômetros a oeste de Fernando de Noronha.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P10",
              "factKey": "atol-rocas-F10",
              "text": "O plano de manejo situa a unidade a cerca de 267 quilômetros da costa potiguar.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P11",
              "factKey": "atol-rocas-F11",
              "text": "A formação é descrita como de origem predominantemente associada a algas calcárias.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P12",
              "factKey": "atol-rocas-F12",
              "text": "A baixa-mar expõe lagunas e piscinas de maré no interior do recife.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P13",
              "factKey": "atol-rocas-F13",
              "text": "Peixes e invertebrados ocupam piscinas de maré no conjunto recifal.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P14",
              "factKey": "atol-rocas-F14",
              "text": "Moluscos compõem a diversidade de invertebrados do ambiente recifal.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P15",
              "factKey": "atol-rocas-F15",
              "text": "Esponjas são parte da comunidade marinha associada aos recifes.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P16",
              "factKey": "atol-rocas-F16",
              "text": "A área protegida funciona como habitat e local de reprodução de tartarugas marinhas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P17",
              "factKey": "atol-rocas-F17",
              "text": "Chelonia mydas, a tartaruga-verde, é uma espécie protegida pela unidade.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P18",
              "factKey": "atol-rocas-F18",
              "text": "Eretmochelys imbricata integra a lista de espécies protegidas na unidade.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P19",
              "factKey": "atol-rocas-F19",
              "text": "Aves oceânicas utilizam a formação insular para abrigo e reprodução.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P20",
              "factKey": "atol-rocas-F20",
              "text": "Negaprion brevirostris, o tubarão-limão, é mencionado na lista do órgão gestor.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P21",
              "factKey": "atol-rocas-F21",
              "text": "A gestão da reserva biológica cabe ao Instituto Chico Mendes de Conservação da Biodiversidade.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P22",
              "factKey": "atol-rocas-F22",
              "text": "A categoria e o manejo priorizam proteção e pesquisa autorizada, sem visitação turística pública.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P23",
              "factKey": "atol-rocas-F23",
              "text": "A proteção integral permite a realização de pesquisas conforme as regras da unidade.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P24",
              "factKey": "atol-rocas-F24",
              "text": "A UNESCO inscreveu a reserva em conjunto com áreas de Fernando de Noronha em 2001.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "atol-rocas-geografo-P25",
              "factKey": "atol-rocas-F25",
              "text": "O reconhecimento patrimonial é seriado e envolve duas áreas protegidas oceânicas distintas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "ROCAS_ICM",
                "ROCAS_PM",
                "ROCAS_UNESCO",
                "ROCAS_JBRJ"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            }
          ]
        }
