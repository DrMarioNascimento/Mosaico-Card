        "geografo": {
          "label": "Geógrafo",
          "cards": [
            {
              "id": "ruinas-kilwa-songo-geografo-P01",
              "factKey": "ruinas-kilwa-songo-F01",
              "text": "A carta representa dois sítios portuários arqueológicos na costa oriental africana.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P02",
              "factKey": "ruinas-kilwa-songo-F02",
              "text": "O bem seriado é composto por remanescentes em duas ilhas próximas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P03",
              "factKey": "ruinas-kilwa-songo-F03",
              "text": "O conjunto arqueológico situa-se na República Unida da Tanzânia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P04",
              "factKey": "ruinas-kilwa-songo-F04",
              "text": "Sua posição costeira permitiu integração às redes comerciais do oceano Índico.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P05",
              "factKey": "ruinas-kilwa-songo-F05",
              "text": "Os sítios registram a expansão da cultura urbana suaíli no litoral oriental africano.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P06",
              "factKey": "ruinas-kilwa-songo-F06",
              "text": "As rotas marítimas ligavam a costa oriental africana a portos asiáticos.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P07",
              "factKey": "ruinas-kilwa-songo-F07",
              "text": "As trocas no Índico incluíam conexões com a região árabe.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P08",
              "factKey": "ruinas-kilwa-songo-F08",
              "text": "O comércio marítimo conectava os portos a mercados do subcontinente indiano.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P09",
              "factKey": "ruinas-kilwa-songo-F09",
              "text": "A circulação de porcelanas chinesas mostra o alcance das redes comerciais.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P10",
              "factKey": "ruinas-kilwa-songo-F10",
              "text": "A circulação de ouro ligava o interior africano às rotas do Índico.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P11",
              "factKey": "ruinas-kilwa-songo-F11",
              "text": "O marfim figurava entre os produtos negociados provenientes do interior.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-geografo-P12",
              "factKey": "ruinas-kilwa-songo-F12",
              "text": "As importações incluíam prata e perfumes, segundo a UNESCO.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
