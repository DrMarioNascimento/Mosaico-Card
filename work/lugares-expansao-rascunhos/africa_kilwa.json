                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P24",
              "factKey": "ruinas-kilwa-songo-F24",
              "text": "A UNESCO reconheceu as duas áreas juntas em 1981.",
