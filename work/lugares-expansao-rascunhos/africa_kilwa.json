              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P25",
              "factKey": "ruinas-kilwa-songo-F25",
