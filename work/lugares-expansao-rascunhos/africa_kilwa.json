      "profiles": {
        "viajante": {
          "label": "Viajante",
          "cards": [
            {
              "id": "ruinas-kilwa-songo-viajante-P01",
              "factKey": "ruinas-kilwa-songo-F01",
              "text": "O destino reúne ruínas de duas cidades africanas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P02",
              "factKey": "ruinas-kilwa-songo-F02",
              "text": "Os dois núcleos ficam em ilhas próximas uma da outra.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P03",
              "factKey": "ruinas-kilwa-songo-F03",
              "text": "As ilhas estão junto à costa da Tanzânia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P04",
              "factKey": "ruinas-kilwa-songo-F04",
              "text": "As cidades ficavam na costa do oceano Índico.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P05",
              "factKey": "ruinas-kilwa-songo-F05",
              "text": "Foram cidades comerciais suaílis.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P06",
              "factKey": "ruinas-kilwa-songo-F06",
              "text": "Houve comércio com regiões da Ásia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P07",
              "factKey": "ruinas-kilwa-songo-F07",
              "text": "A Arábia era uma das regiões com que comerciantes negociavam.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P08",
              "factKey": "ruinas-kilwa-songo-F08",
              "text": "Também havia contatos com a Índia.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P09",
              "factKey": "ruinas-kilwa-songo-F09",
              "text": "Produtos da China chegavam à região.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P10",
              "factKey": "ruinas-kilwa-songo-F10",
              "text": "O ouro vindo do interior africano era negociado.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P11",
              "factKey": "ruinas-kilwa-songo-F11",
              "text": "O marfim também era comercializado.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P12",
              "factKey": "ruinas-kilwa-songo-F12",
              "text": "Prata e perfumes chegavam nas trocas.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P13",
              "factKey": "ruinas-kilwa-songo-F13",
              "text": "Uma das cidades teve moedas próprias.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P14",
              "factKey": "ruinas-kilwa-songo-F14",
              "text": "A cidade maior foi ocupada entre os séculos IX e XIX.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P15",
              "factKey": "ruinas-kilwa-songo-F15",
              "text": "O auge da cidade maior ocorreu nos séculos XIII e XIV.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P16",
              "factKey": "ruinas-kilwa-songo-F16",
              "text": "O viajante Ibn Battuta visitou uma das cidades no século XIV.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P17",
              "factKey": "ruinas-kilwa-songo-F17",
              "text": "Há ruínas de uma Grande Mesquita.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P18",
              "factKey": "ruinas-kilwa-songo-F18",
              "text": "A mesquita começou a ser construída no século XI.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P19",
              "factKey": "ruinas-kilwa-songo-F19",
              "text": "A mesquita foi ampliada no século XIII.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P20",
              "factKey": "ruinas-kilwa-songo-F20",
              "text": "Um antigo palácio tinha uma piscina de formato octogonal.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P21",
              "factKey": "ruinas-kilwa-songo-F21",
              "text": "Pedra coralina e argamassa de cal foram usadas em construções.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P22",
              "factKey": "ruinas-kilwa-songo-F22",
              "text": "Há vestígios de casas, praças e áreas funerárias.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KILWA_UNESCO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "ruinas-kilwa-songo-viajante-P23",
              "factKey": "ruinas-kilwa-songo-F23",
              "text": "No século XVI portugueses construíram um forte em uma das ilhas.",
