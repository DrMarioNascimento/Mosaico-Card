                "C2"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-viajante-P07",
              "factKey": "oceania-kuk-F07",
              "text": "Os estudos indicam práticas agrícolas de muitos milhares de anos.",
