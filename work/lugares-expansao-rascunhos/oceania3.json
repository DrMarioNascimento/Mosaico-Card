                "C1"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-geografo-P08",
              "factKey": "oceania-kuk-F08",
              "text": "Segundo a UNESCO, a sequência revela manejo agrícola por cerca de 7.000 anos e possivelmente mais.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-geografo-P09",
              "factKey": "oceania-kuk-F09",
              "text": "O registro sugere desenvolvimento agrícola independente de outros centros conhecidos.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-geografo-P10",
              "factKey": "oceania-kuk-F10",
              "text": "Grãos de amido em ferramentas sustentam o uso antigo do taro.",
              "relatedFields": [
                "C4"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
