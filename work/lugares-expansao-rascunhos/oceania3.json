                "C1"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-viajante-P09",
              "factKey": "oceania-kuk-F09",
              "text": "Ali, pessoas aprenderam a cultivar plantas de forma independente.",
              "relatedFields": [
                "C1"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-viajante-P10",
              "factKey": "oceania-kuk-F10",
              "text": "O taro estava entre as plantas cultivadas na região.",
