                "C2"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-geografo-P07",
              "factKey": "oceania-kuk-F07",
              "text": "As evidências apontam práticas agrícolas que remontam a vários milênios.",
