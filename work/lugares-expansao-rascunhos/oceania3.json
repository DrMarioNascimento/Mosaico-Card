                "C1"
              ],
              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-viajante-P08",
              "factKey": "oceania-kuk-F08",
              "text": "A UNESCO destaca uma história agrícola de pelo menos sete mil anos.",
