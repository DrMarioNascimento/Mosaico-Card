              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-viajante-P15",
              "factKey": "oceania-kuk-F15",
              "text": "Mais tarde, valas ajudaram a lidar com o excesso de água.",
