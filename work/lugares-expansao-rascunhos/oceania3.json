              "sources": [
                "KUK_UNESCO",
                "KUK_FAO"
              ],
              "clueType": "territorio",
              "signalStrength": "conexao",
              "recommendedMoment": "middle",
              "importance": "relevant",
              "twoPlayerSuitable": true
            },
            {
              "id": "oceania-kuk-geografo-P06",
              "factKey": "oceania-kuk-F06",
              "text": "A área úmida localiza-se a aproximadamente 1.500 metros acima do nível do mar.",
